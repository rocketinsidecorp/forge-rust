//! `%%TYPE%%Mailer`, generated by `forge generate mailer`: one typed method
//! per email, rendered from the askama templates in
//! `templates/mailers/%%NAME%%/` (subject and text parts are `.txt`, where
//! nothing is escaped; the HTML part is `.html`, where every value is
//! escaped), and browser previews with fixture data (docs/mail.md).
//!
//! An email is rendered completely before anything is sent, and passes the
//! validation every message does: a header injection is refused before a
//! byte leaves the process. Without a sender every send fails with
//! [`MailError::NotConfigured`]; nothing pretends to deliver.

use std::sync::Arc;

use askama::Template;
use forge::mail::{Address, MailError, Message, Preview, Sender, Templates};
%%DATA%%
/// Sends the %%WORDS%% emails through a mail [`Sender`].
#[derive(Clone)]
pub struct %%TYPE%%Mailer {
    sender: Option<Arc<dyn Sender>>,
    from: Address,
}

impl %%TYPE%%Mailer {
    /// Sends through `sender`, from `from`.
    #[must_use]
    pub fn new(sender: Arc<dyn Sender>, from: Address) -> Self {
        Self {
            sender: Some(sender),
            from,
        }
    }

    /// A mailer whose every send fails with [`MailError::NotConfigured`]:
    /// what an application without `FORGE_MAIL_URL` gets.
    #[must_use]
    pub fn unconfigured(from: Address) -> Self {
        Self { sender: None, from }
    }

    /// The sender `FORGE_MAIL_URL` selects (instrumented when `telemetry` is
    /// on) from `FORGE_MAIL_FROM`, or [`%%TYPE%%Mailer::unconfigured`] when
    /// no URL is set. A URL that is set but invalid is an error.
    pub fn from_config(
        config: &forge::config::AppConfig,
        telemetry: Option<&forge::telemetry::Telemetry>,
    ) -> Result<Self, MailError> {
        match forge::mail::from_config(config) {
            Ok(sender) => Ok(Self::new(
                forge::mail::instrument(sender, telemetry)?,
                forge::mail::default_from(config)?,
            )),
            Err(MailError::NotConfigured) => {
                let from = match forge::mail::default_from(config) {
                    Ok(from) => from,
                    Err(_) => Address::new(env!("CARGO_PKG_NAME"), "no-reply@example.com")?,
                };
                Ok(Self::unconfigured(from))
            }
            Err(error) => Err(error),
        }
    }

    /// Whether emails are delivered (`false`: every send fails).
    #[must_use]
    pub fn is_configured(&self) -> bool {
        self.sender.is_some()
    }
%%METHODS%%
    /// Previews of every email with fixture data, for a
    /// `forge::mail::PreviewHandler` at `/_mail/%%NAME%%` (development and
    /// test only, with `FORGE_MAIL_PREVIEW=true`).
    #[must_use]
    pub fn previews(&self) -> Vec<Preview> {
%%PREVIEW_CLONES%%
        vec![
%%PREVIEWS%%
        ]
    }

    async fn deliver(&self, message: &Message) -> Result<(), MailError> {
        match &self.sender {
            Some(sender) => sender.send(message).await,
            None => Err(MailError::NotConfigured),
        }
    }
}

/// The recipient of every preview.
fn preview_recipient() -> Result<Address, MailError> {
    Address::new("Ada Lovelace", "ada@example.com")
}
