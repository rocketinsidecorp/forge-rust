//! `%%TYPE%%Mailer` through the test recorder (`forge::mail::testing`), which
//! runs the real encoder: headers and both parts of every email, escaping
//! in the HTML part, failures that send nothing and previews that exist
//! only in development. Generated by `forge generate mailer`.

use std::error::Error;
use std::sync::Arc;

use app::adapters::email::%%NAME%%_mailer::{%%IMPORTS%%};
use forge::config::{AppConfig, Environment, MailConfig};
use forge::http::{HeaderMap, Method, Request, StatusCode};
use forge::mail::testing::Recorder;
use forge::mail::{Address, MailError, PreviewHandler};

type TestResult = Result<(), Box<dyn Error>>;

fn mailer(outbox: &Arc<Recorder>) -> Result<%%TYPE%%Mailer, MailError> {
    Ok(%%TYPE%%Mailer::new(
        Arc::<Recorder>::clone(outbox),
        Address::new("App", "app@example.com")?,
    ))
}

fn recipient() -> Result<Address, MailError> {
    Address::new("Ada", "ada@example.org")
}
%%TESTS%%

#[tokio::test]
async fn a_failing_sender_records_nothing_and_an_unconfigured_mailer_fails() -> TestResult {
    let outbox = Arc::new(Recorder::new());
    outbox.fail_with(Some(MailError::NotConfigured));
    let failed = mailer(&outbox)?.%%FIRST%%(recipient()?, &%%FIRST_DATA%%).await;
    assert!(failed.is_err());
    assert!(outbox.is_empty());

    let unconfigured = %%TYPE%%Mailer::unconfigured(Address::new("App", "app@example.com")?);
    assert!(!unconfigured.is_configured());
    let refused = unconfigured.%%FIRST%%(recipient()?, &%%FIRST_DATA%%).await;
    assert!(matches!(refused, Err(MailError::NotConfigured)));
    Ok(())
}

#[test]
fn a_header_injecting_recipient_is_refused() {
    assert!(Address::new("Ada", "ada@example.org\r\nBcc: eve@example.com").is_err());
    assert!(Address::new("Ada\r\nBcc: eve@example.com", "ada@example.org").is_err());
}

#[test]
fn previews_render_and_exist_only_in_development() -> TestResult {
    let outbox = Arc::new(Recorder::new());
    let previews = mailer(&outbox)?.previews();
    assert_eq!(previews.len(), %%COUNT%%);

    let config = AppConfig {
        environment: Environment::Development,
        mail: MailConfig {
            preview: true,
            ..MailConfig::default()
        },
        ..AppConfig::default()
    };
    let handler = PreviewHandler::new(&config, "/_mail/%%NAME%%", previews.clone())?;
    for preview in &previews {
        let path = format!("/_mail/%%NAME%%/{}", preview.name());
        let request = Request::new_for_test(
            Method::GET,
            path.parse()?,
            HeaderMap::new(),
            String::new().into(),
            "127.0.0.1:4000".parse()?,
            forge::core::Id::<Request>::new().into_uuid(),
        );
        let response = handler.serve(&request).ok_or("the preview is served")?;
        assert_eq!(response.status(), StatusCode::OK, "{path}");
    }
    assert!(outbox.is_empty(), "previews send nothing");

    let production = AppConfig {
        environment: Environment::Production,
        ..config
    };
    assert!(PreviewHandler::new(&production, "/_mail/%%NAME%%", previews).is_err());
    Ok(())
}
