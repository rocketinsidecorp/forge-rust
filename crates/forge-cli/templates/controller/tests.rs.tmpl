/// Lets every request in and records the permission it was asked for.
#[derive(Default)]
struct Recording {
    asked: Mutex<Vec<String>>,
}

#[async_trait]
impl GlobalAccess for Recording {
    async fn authorize(
        &self,
        _: &Request,
        permission: &Permission,
    ) -> Result<Option<PrincipalId>, AccessDenied> {
        self.asked
            .lock()
            .map_err(|_| AccessDenied::Unavailable)?
            .push(permission.as_str().to_owned());
        Ok(None)
    }
}

impl Recording {
    fn asked(&self) -> Vec<String> {
        self.asked
            .lock()
            .map(|asked| asked.clone())
            .unwrap_or_default()
    }
}
%%end%%

