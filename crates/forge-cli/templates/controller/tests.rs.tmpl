fn request(method: Method, path: &str) -> Result<Request, Box<dyn Error>> {
    Ok(Request::new_for_test(
        method,
        path.parse()?,
        HeaderMap::new(),
        String::new().into(),
        "127.0.0.1:4000".parse()?,
        forge::core::Id::<Request>::new().into_uuid(),
    ))
}

fn body(response: &Response) -> String {
    String::from_utf8_lossy(response.body()).into_owned()
}

#[tokio::test]
async fn every_action_answers() -> TestResult {
%%if guarded%%
    let router = router(Arc::new(Recording::default()))?;
%%end%%
%%if public%%
    let router = router()?;
%%end%%
    for (path, text) in ROUTES {
        let response = router.dispatch(request(Method::GET, path)?).await;
        assert_eq!(response.status(), StatusCode::OK, "{path}");
        assert!(body(&response).contains(text), "{path}: {}", body(&response));
    }
    Ok(())
}

#[tokio::test]
async fn only_get_is_routed() -> TestResult {
%%if guarded%%
    let access = Arc::new(Recording::default());
    let router = router(Arc::<Recording>::clone(&access))?;
%%end%%
%%if public%%
    let router = router()?;
%%end%%
    for (path, _) in ROUTES {
        for method in [Method::POST, Method::PUT, Method::PATCH, Method::DELETE] {
            let response = router.dispatch(request(method.clone(), path)?).await;
            assert!(
                !response.status().is_success(),
                "{method} {path}: {}",
                response.status()
            );
        }
    }
%%if guarded%%
    assert!(access.asked().is_empty(), "{:?}", access.asked());
%%end%%
    Ok(())
}
%%if guarded%%

#[tokio::test]
async fn every_route_asks_for_the_read_permission_once() -> TestResult {
    assert_eq!(READ_PERMISSION, "%%NAME%%:read");
    let access = Arc::new(Recording::default());
    let router = router(Arc::<Recording>::clone(&access))?;
    for (path, _) in ROUTES {
        router.dispatch(request(Method::GET, path)?).await;
    }
    assert_eq!(access.asked(), vec![READ_PERMISSION.to_owned(); ROUTES.len()]);
    Ok(())
}

#[tokio::test]
async fn the_generated_deny_all_default_refuses_every_action() -> TestResult {
    let router = router(Arc::new(DenyAll))?;
    for (path, text) in ROUTES {
        let response = router.dispatch(request(Method::GET, path)?).await;
        assert_eq!(response.status(), StatusCode::FORBIDDEN, "{path}");
        assert!(!body(&response).contains(text), "{path}");
    }
    Ok(())
}
%%end%%
