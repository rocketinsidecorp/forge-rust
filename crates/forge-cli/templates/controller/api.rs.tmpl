//! The `%%NAME%%` controller, generated by `forge generate controller --api`:
//! read-only JSON endpoints, one per action.
//!
//! | Method | Path | Action | Permission |
//! | --- | --- | --- | --- |
%%ROUTE_TABLE%%
//!
//! Every route is described in the OpenAPI document (`GET /openapi.json`,
//! `forge openapi`, ADR 0039) by [`operation`]: change the response type
//! there when an action answers something else.
//!
//! Replace [`%%TYPE%%Body`] and the handler bodies with your own. Actions
//! that change data (create, update, destroy) belong to `forge generate
//! scaffold`, which also generates the model they change.

%%if guarded%%
use std::future::Future;
use std::sync::Arc;

%%end%%
use forge::ComposeError;
use forge::http::{Method, Request, Response, Router, StatusCode};
use forge::openapi::{OpenApiSchema, Operation, describe};
%%if guarded%%
use forge::security::Permission;
%%end%%
use serde::Serialize;
%%if guarded%%

use crate::adapters::http::access::GlobalAccess;
%%end%%
%%if reuse%%

/// The permission every route asks the access policy for. The
/// `%%NAME%%` use cases declare it (a permission has one owner).
pub use crate::application::use_cases::%%NAME%%::READ_PERMISSION;
%%end%%
%%if own%%

/// The permission every route asks the access policy for.
pub const READ_PERMISSION: &str = "%%NAME%%:read";
%%end%%

/// The JSON document every action answers with.
#[derive(Debug, Serialize, OpenApiSchema)]
pub struct %%TYPE%%Body {
    pub controller: &'static str,
    pub action: &'static str,
    pub message: &'static str,
}
%%if guarded%%

/// What every handler of the controller shares.
struct %%TYPE%%Controller {
    access: Arc<dyn GlobalAccess>,
    read: Permission,
}

/// Registers the routes. `access` decides who may call them (see
/// `crate::adapters::http::access`): nothing is served before it grants
/// [`READ_PERMISSION`].
pub fn routes(router: &mut Router, access: Arc<dyn GlobalAccess>) -> Result<(), ComposeError> {
    let state = Arc::new(%%TYPE%%Controller {
        access,
        read: Permission::new(READ_PERMISSION).map_err(ComposeError::other)?,
    });
%%ROUTES%%
    Ok(())
}

/// Routes `GET path` to `handler`, described as `action`. The controller is
/// read-only: no other method is routed.
fn route<H, F>(
    router: &mut Router,
    state: &Arc<%%TYPE%%Controller>,
    path: &str,
    action: &str,
    handler: H,
) -> Result<(), ComposeError>
where
    H: Fn(Arc<%%TYPE%%Controller>, Request) -> F + Send + Sync + 'static,
    F: Future<Output = Response> + Send + 'static,
{
    let state = Arc::clone(state);
    router.route(
        Method::GET,
        path,
        describe(
            move |request: Request| handler(Arc::clone(&state), request),
            operation(action),
        ),
    )?;
    Ok(())
}

/// Asks the access policy for [`READ_PERMISSION`]: `None` when it grants
/// it, otherwise the response of the refusal.
async fn authorize(state: &%%TYPE%%Controller, request: &Request) -> Option<Response> {
    match state.access.authorize(request, &state.read).await {
        Ok(_) => None,
        Err(denied) => Some(denied.response()),
    }
}
%%end%%
%%if public%%

/// Registers the routes. They are public (`--public`): anyone who can reach
/// the server can call them.
pub fn routes(router: &mut Router) -> Result<(), ComposeError> {
%%ROUTES%%
    Ok(())
}
%%end%%

/// How `action` is described in the OpenAPI document.
fn operation(action: &str) -> Operation {
    Operation::new()
        .summary(format!("%%NAME%% {action}"))
        .tag("%%NAME%%")
%%if guarded%%
        // The access policy's refusals: 401, 403 (implied by the
        // permission) and 503 when it cannot decide.
        .permission(READ_PERMISSION)
        .response(
            forge::openapi::Response::text(503).description("The access policy is unavailable"),
        )
%%end%%
        .json::<%%TYPE%%Body>(200)
}

/// `200 OK` with `body` as JSON.
fn respond(body: &%%TYPE%%Body) -> Response {
    Response::json(StatusCode::OK, body)
        .unwrap_or_else(|_| Response::empty(StatusCode::INTERNAL_SERVER_ERROR))
}
%%HANDLERS%%
