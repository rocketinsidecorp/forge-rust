//! The `%%NAME%%` job of the persistent PostgreSQL queue (`forge::jobs`,
//! docs/jobs.md), generated by `forge generate job --queue`: its payload,
//! handler, registration and enqueue function.
//!
//! [`perform`] fails permanently until you write it, so a placeholder can
//! never report work it did not do: the job goes straight to `dead`, where
//! `cargo run -- jobs dead` shows it. Delivery is at-least-once, so make the
//! work idempotent.

use std::time::Duration;

use async_trait::async_trait;
use forge::db::DbTransaction;
use forge::jobs::{
    EnqueueOptions, Enqueued, Job, JobContext, JobError, JobHandler, Jobs, JobsError,
};
use serde::{Deserialize, Serialize};

/// The payload of one `%%NAME%%` job: its schema, stored as JSON. Put
/// references in it, never secrets.
#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
pub struct %%TYPE%% {
%%FIELDS%%
}

impl Job for %%TYPE%% {
    /// Stored with every job: keep it stable once jobs were enqueued.
    const NAME: &'static str = "%%NAME%%";
    /// Then the job is `dead` until an operator retries or discards it.
    const MAX_ATTEMPTS: u16 = 5;
    /// One attempt is cancelled after this long.
    const TIMEOUT: Duration = Duration::from_secs(60);
}

/// Runs `%%NAME%%` jobs. Give it the use cases [`perform`] needs.
#[derive(Clone, Copy, Debug, Default)]
pub struct %%TYPE%%Handler;

#[async_trait]
impl JobHandler for %%TYPE%%Handler {
    type Job = %%TYPE%%;

    async fn perform(&self, _context: &JobContext, job: %%TYPE%%) -> Result<(), JobError> {
        perform(job).await
    }
}

/// Registers the handler with the application's jobs
/// (`composition.jobs()?` in `jobs_configure`, src/bootstrap/mod.rs).
pub fn register(jobs: &mut Jobs) -> Result<(), JobsError> {
    jobs.register(%%TYPE%%Handler)?;
    Ok(())
}

/// Stores a `%%NAME%%` job in `transaction`, atomically with the business
/// state the transaction writes: rolled back, no job.
pub async fn enqueue(
    transaction: &mut DbTransaction<sqlx::Postgres>,
    job: &%%TYPE%%,
    options: EnqueueOptions,
) -> Result<Enqueued, JobsError> {
    forge::jobs::postgres::enqueue(transaction, job, options).await
}

/// One attempt. Replace the body with calls to your use cases: return
/// `JobError::retry(..)` for a failure worth retrying and
/// `JobError::permanent(..)` for one that is not.
pub async fn perform(job: %%TYPE%%) -> Result<(), JobError> {
    let _ = job;
    Err(JobError::permanent(
        "%%NAME%% is not implemented yet: write `perform` in src/adapters/jobs/%%NAME%%.rs",
    ))
}
