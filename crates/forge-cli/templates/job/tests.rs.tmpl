//! The `%%NAME%%` job without a database: a stable name, a handler that
//! registers once, and a placeholder that fails permanently instead of
//! pretending to work. Generated by `forge generate job --queue`.

use std::error::Error;

use app::adapters::jobs::%%NAME%%::{%%TYPE%%, perform, register};
use forge::jobs::{Job, Jobs, JobsError, MAX_JOB_NAME, is_valid_name};

type TestResult = Result<(), Box<dyn Error>>;

fn payload() -> %%TYPE%% {
    %%TYPE%% {
%%SAMPLES%%
    }
}

#[test]
fn the_job_has_a_stable_valid_name_and_bounded_attempts() {
    assert_eq!(%%TYPE%%::NAME, "%%NAME%%");
    assert!(is_valid_name(%%TYPE%%::NAME, MAX_JOB_NAME));
    assert_eq!(%%TYPE%%::QUEUE, "default");
    assert_eq!(%%TYPE%%::MAX_ATTEMPTS, 5);
    assert!(!%%TYPE%%::TIMEOUT.is_zero());
}

#[test]
fn the_handler_registers_once() -> TestResult {
    let mut jobs = Jobs::new();
    register(&mut jobs)?;
    assert!(matches!(
        register(&mut jobs),
        Err(JobsError::DuplicateHandler("%%NAME%%"))
    ));
    Ok(())
}

#[tokio::test]
async fn the_placeholder_fails_permanently() -> TestResult {
    let Err(error) = perform(payload()).await else {
        return Err("the generated placeholder must not report success".into());
    };
    assert!(!error.is_retryable());
    Ok(())
}
