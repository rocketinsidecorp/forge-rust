//! Who may call the HTML resources generated by `forge generate scaffold`.
//!
//! Every generated handler asks an access policy before it reads or changes
//! anything, with the permission of the action (`<plural>:read` or
//! `<plural>:write`). Access is **deny by default**: the generator wires
//! [`DenyAll`] unless the application provides the identity stores that a
//! real policy needs, so a new resource is never public by accident.
//!
//! - Tenant-scoped resources use a [`TenantAccess`]. [`SessionTenantAccess`]
//!   authenticates the `__Host-forge_session` cookie, enforces the
//!   session-bound CSRF token on unsafe methods, loads the membership of the
//!   tenant the session signed in to (the `__Host-forge_tenant` cookie, or
//!   the `{tenant_id}` of a route that has one) and evaluates the RBAC
//!   policy, producing an authorized [`TenantContext`]. The generated wiring
//!   grants the `owner` role (the role `forge setup` gives the first member)
//!   every permission of the resource; other roles are denied until granted.
//!   It authorizes the JSON API under `/v1` the same way
//!   ([`ApiTenantAccess`]), with the CSRF token in `X-CSRF-Token`.
//! - Global resources use a [`GlobalAccess`]. Their rows are shared by every
//!   tenant, so tenant roles cannot authorize them. Implement
//!   [`GlobalAccess`] with your own rule (for example signed-in operators)
//!   and replace [`DenyAll`] in `src/bootstrap/mod.rs`; that replacement is
//!   the explicit decision to open the routes. It returns the signed-in
//!   principal it admitted (`None` only for anonymous callers of a public
//!   resource), so live-update streams limit each person's connections
//!   rather than every caller behind one address. [`Public`] lets everyone
//!   in: `forge generate scaffold --global --public` wires it in
//!   applications without Forge identity, and only there.
//!
//! A refused request without a valid session answers `401`. In applications
//! with the sign-in pages (`forge new` on PostgreSQL, or
//! `forge generate authentication`), the `SignInRedirect` layer turns that
//! `401` into a `303` to `/session/new?return_to=...` for browsers; JSON
//! clients keep the `401`.

use std::sync::Arc;
use std::time::{SystemTime, UNIX_EPOCH};

use async_trait::async_trait;
use forge::auth::{SessionStore, UnixTimestamp};
use forge::http::{Request, Response, StatusCode};
use forge::security::{Permission, PrincipalId, RbacPolicy};
use forge::tenancy::{BearerDenied, MembershipStore, TenantContext, TenantId};

use crate::adapters::http::api_access::{ApiGlobalAccess, ApiTenantAccess};
use crate::infrastructure::security::{
    RequestAuthError, authenticate_request, enforce_csrf, tenant_from_request,
};

/// Why a request was refused. The response never says which proof failed.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum AccessDenied {
    /// No valid session: `401 Unauthorized` (browsers are redirected to the
    /// sign-in page by `SignInRedirect` when the application has one).
    Unauthenticated,
    /// Authenticated but not allowed (or no tenant membership): `403 Forbidden`.
    Forbidden,
    /// An identity store failed: `503 Service Unavailable`.
    Unavailable,
}

impl AccessDenied {
    /// The generic `text/plain` response for this refusal, as the OpenAPI
    /// document declares it.
    #[must_use]
    pub fn response(self) -> Response {
        match self {
            Self::Unauthenticated => {
                Response::text(StatusCode::UNAUTHORIZED, "authentication required")
            }
            Self::Forbidden => Response::text(StatusCode::FORBIDDEN, "forbidden"),
            Self::Unavailable => {
                Response::text(StatusCode::SERVICE_UNAVAILABLE, "service unavailable")
            }
        }
    }
}

/// Authorizes requests to a global resource.
#[async_trait]
pub trait GlobalAccess: Send + Sync {
    /// Allows `request` to use `permission`, or refuses it.
    ///
    /// On success, returns the signed-in principal making the request, or
    /// `None` for an anonymous caller of a public resource. Live-update
    /// streams count a principal's open streams against that principal and
    /// anonymous ones by client address, which every caller behind one
    /// reverse proxy shares: return the principal whenever there is one.
    async fn authorize(
        &self,
        request: &Request,
        permission: &Permission,
    ) -> Result<Option<PrincipalId>, AccessDenied>;
}

/// Authorizes requests to a tenant-scoped resource.
#[async_trait]
pub trait TenantAccess: Send + Sync {
    /// The tenant context that allows `request` to use `permission`.
    async fn authorize(
        &self,
        request: &Request,
        permission: &Permission,
    ) -> Result<TenantContext, AccessDenied>;
}

/// Refuses every request (`403`). The fail-closed default of every generated
/// resource until the application decides who may use it.
#[derive(Clone, Copy, Debug, Default)]
pub struct DenyAll;

#[async_trait]
impl GlobalAccess for DenyAll {
    async fn authorize(
        &self,
        _: &Request,
        _: &Permission,
    ) -> Result<Option<PrincipalId>, AccessDenied> {
        Err(AccessDenied::Forbidden)
    }
}

#[async_trait]
impl TenantAccess for DenyAll {
    async fn authorize(&self, _: &Request, _: &Permission) -> Result<TenantContext, AccessDenied> {
        Err(AccessDenied::Forbidden)
    }
}

/// Lets every request in, signed in or not: the explicit choice of
/// `--public` for a global resource of an application without Forge
/// identity. Forms still need their CSRF token.
#[derive(Clone, Copy, Debug, Default)]
pub struct Public;

#[async_trait]
impl GlobalAccess for Public {
    async fn authorize(
        &self,
        _: &Request,
        _: &Permission,
    ) -> Result<Option<PrincipalId>, AccessDenied> {
        Ok(None)
    }
}

#[async_trait]
impl ApiGlobalAccess for Public {
    async fn authorize(&self, _: &Request, _: &Permission) -> Result<(), BearerDenied> {
        Ok(())
    }
}

/// Session, membership and RBAC authorization for tenant-scoped routes.
///
/// For each request: the session cookie must name a live session, unsafe
/// methods must present that session's CSRF token, the tenant (the route's
/// `{tenant_id}`, else the tenant cookie set at sign-in) must be one where
/// the principal has an active membership, and the policy must grant one of
/// the membership's roles the permission. Anything else is refused.
#[derive(Clone)]
pub struct SessionTenantAccess {
    sessions: Arc<dyn SessionStore>,
    memberships: Arc<dyn MembershipStore>,
    policy: RbacPolicy,
}

impl SessionTenantAccess {
    /// `policy` grants permissions to tenant roles; an empty policy denies
    /// everything.
    #[must_use]
    pub fn new(
        sessions: Arc<dyn SessionStore>,
        memberships: Arc<dyn MembershipStore>,
        policy: RbacPolicy,
    ) -> Self {
        Self {
            sessions,
            memberships,
            policy,
        }
    }
}

#[async_trait]
impl TenantAccess for SessionTenantAccess {
    async fn authorize(
        &self,
        request: &Request,
        permission: &Permission,
    ) -> Result<TenantContext, AccessDenied> {
        let now = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map(|elapsed| UnixTimestamp::from_secs(elapsed.as_secs()))
            .map_err(|_| AccessDenied::Unavailable)?;
        let principal = authenticate_request(self.sessions.as_ref(), request, now)
            .await
            .map_err(denied)?;
        enforce_csrf(self.sessions.as_ref(), request, principal)
            .await
            .map_err(denied)?;
        let tenant_id: TenantId = match request.path_param_as("tenant_id") {
            Ok(tenant_id) => tenant_id,
            Err(forge::http::PathParamError::Missing { .. }) => tenant_from_request(request)
                .map_err(|_| AccessDenied::Forbidden)?
                .ok_or(AccessDenied::Forbidden)?,
            Err(_) => return Err(AccessDenied::Forbidden),
        };
        let membership = self
            .memberships
            .find(tenant_id, principal.principal_id())
            .await
            .map_err(|_| AccessDenied::Unavailable)?
            .ok_or(AccessDenied::Forbidden)?;
        TenantContext::authorize(principal, &membership, &self.policy, permission)
            .map_err(|_| AccessDenied::Forbidden)
    }
}

/// The JSON API under `/v1` with the pages' session: the same proofs, with
/// the JSON API's refusals.
#[async_trait]
impl ApiTenantAccess for SessionTenantAccess {
    async fn authorize(
        &self,
        request: &Request,
        permission: &Permission,
    ) -> Result<TenantContext, BearerDenied> {
        TenantAccess::authorize(self, request, permission)
            .await
            .map_err(|denied| match denied {
                AccessDenied::Unauthenticated => BearerDenied::MissingCredentials,
                AccessDenied::Forbidden => BearerDenied::Forbidden,
                AccessDenied::Unavailable => BearerDenied::Unavailable,
            })
    }
}

fn denied(error: RequestAuthError) -> AccessDenied {
    match error {
        RequestAuthError::MissingSession | RequestAuthError::InvalidSession => {
            AccessDenied::Unauthenticated
        }
        RequestAuthError::MissingCsrf | RequestAuthError::InvalidCsrf => AccessDenied::Forbidden,
        RequestAuthError::AuthenticationUnavailable => AccessDenied::Unavailable,
    }
}

#[cfg(test)]
mod tests {
    //! `SessionTenantAccess` with in-memory session and membership stores:
    //! every proof it requires is checked separately.

    use std::error::Error;
    use std::sync::Mutex;

    use forge::auth::{
        CsrfTokenDigest, Session, SessionCredentialDigest, SessionId, SessionStoreError,
    };
    use forge::http::{HeaderMap, HeaderValue, Method, Router};
    use forge::security::{PrincipalId, Role};
    use forge::tenancy::{Membership, MembershipState, MembershipStoreError, MembershipStoreErrorKind};

    use super::*;
    use crate::infrastructure::security::{SESSION_COOKIE_NAME, issue_session_secrets};

    type TestResult = Result<(), Box<dyn Error>>;

    const PERMISSION: &str = "probes:write";

    #[derive(Default)]
    struct Sessions {
        rows: Mutex<Vec<(Session, SessionCredentialDigest, CsrfTokenDigest)>>,
    }

    #[async_trait]
    impl SessionStore for Sessions {
        async fn insert(
            &self,
            session: &Session,
            credential: &SessionCredentialDigest,
            csrf: &CsrfTokenDigest,
        ) -> Result<(), SessionStoreError> {
            self.rows
                .lock()
                .map_err(|_| SessionStoreError::Unavailable)?
                .push((session.clone(), *credential, *csrf));
            Ok(())
        }

        async fn find_by_credential(
            &self,
            credential: &SessionCredentialDigest,
        ) -> Result<Option<Session>, SessionStoreError> {
            Ok(self
                .rows
                .lock()
                .map_err(|_| SessionStoreError::Unavailable)?
                .iter()
                .find(|(_, stored, _)| stored == credential)
                .map(|(session, _, _)| session.clone()))
        }

        async fn verify_csrf(
            &self,
            session_id: SessionId,
            csrf: &CsrfTokenDigest,
        ) -> Result<bool, SessionStoreError> {
            Ok(self
                .rows
                .lock()
                .map_err(|_| SessionStoreError::Unavailable)?
                .iter()
                .any(|(session, _, stored)| session.id() == session_id && stored == csrf))
        }

        async fn revoke(&self, _: SessionId, _: UnixTimestamp) -> Result<(), SessionStoreError> {
            Err(SessionStoreError::Unavailable)
        }

        async fn rotate(
            &self,
            _: SessionId,
            _: UnixTimestamp,
            _: &Session,
            _: &SessionCredentialDigest,
            _: &CsrfTokenDigest,
        ) -> Result<(), SessionStoreError> {
            Err(SessionStoreError::Unavailable)
        }
    }

    #[derive(Default)]
    struct Memberships {
        rows: Mutex<Vec<Membership>>,
    }

    fn unavailable() -> MembershipStoreError {
        MembershipStoreError::new(MembershipStoreErrorKind::Unavailable, "unavailable", true)
    }

    #[async_trait]
    impl MembershipStore for Memberships {
        async fn find(
            &self,
            tenant_id: TenantId,
            principal_id: PrincipalId,
        ) -> Result<Option<Membership>, MembershipStoreError> {
            Ok(self
                .rows
                .lock()
                .map_err(|_| unavailable())?
                .iter()
                .find(|membership| {
                    membership.tenant_id() == tenant_id && membership.principal_id() == principal_id
                })
                .cloned())
        }

        async fn upsert(&self, membership: &Membership) -> Result<(), MembershipStoreError> {
            self.rows
                .lock()
                .map_err(|_| unavailable())?
                .push(membership.clone());
            Ok(())
        }

        async fn suspend(&self, _: TenantId, _: PrincipalId) -> Result<(), MembershipStoreError> {
            Err(unavailable())
        }
    }

    /// One signed-in principal with a membership in `tenant`, and a router
    /// whose `/tenants/{tenant_id}/probe` answers 200 only when
    /// `SessionTenantAccess` grants `probes:write`.
    struct Fixture {
        router: Router,
        tenant: TenantId,
        bearer: String,
        csrf: String,
    }

    async fn fixture(state: MembershipState, granted: bool) -> Result<Fixture, Box<dyn Error>> {
        let now = SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs();
        let principal = PrincipalId::new();
        let session = Session::new(
            principal,
            UnixTimestamp::from_secs(now - 60),
            UnixTimestamp::from_secs(now + 3_600),
        )?;
        let secrets = issue_session_secrets()?;
        let sessions = Arc::new(Sessions::default());
        sessions
            .insert(&session, &secrets.bearer_digest, &secrets.csrf_digest)
            .await?;

        let tenant = TenantId::new();
        let role = Role::new("member")?;
        let memberships = Arc::new(Memberships::default());
        memberships
            .upsert(&Membership::restore(
                tenant,
                principal,
                vec![role.clone()],
                state,
            ))
            .await?;

        let permission = Permission::new(PERMISSION)?;
        let mut policy = RbacPolicy::new();
        if granted {
            policy.allow(role, permission.clone());
        }
        let access = Arc::new(SessionTenantAccess::new(sessions, memberships, policy));
        let mut router = Router::new();
        for method in [Method::GET, Method::POST] {
            let access = Arc::clone(&access);
            let permission = permission.clone();
            router.route(method, "/tenants/{tenant_id}/probe", move |request: Request| {
                let access = Arc::clone(&access);
                let permission = permission.clone();
                async move {
                    match TenantAccess::authorize(access.as_ref(), &request, &permission).await {
                        Ok(context) => Response::new(StatusCode::OK, context.tenant_id().to_string()),
                        Err(denied) => denied.response(),
                    }
                }
            })?;
        }
        Ok(Fixture {
            router,
            tenant,
            bearer: secrets.bearer.expose().to_owned(),
            csrf: secrets.csrf.expose().to_owned(),
        })
    }

    impl Fixture {
        async fn status(
            &self,
            method: Method,
            tenant: &str,
            bearer: Option<&str>,
            csrf: Option<&str>,
        ) -> Result<StatusCode, Box<dyn Error>> {
            let mut headers = HeaderMap::new();
            if let Some(bearer) = bearer {
                headers.insert(
                    "cookie",
                    HeaderValue::from_str(&format!("{SESSION_COOKIE_NAME}={bearer}"))?,
                );
            }
            if let Some(csrf) = csrf {
                headers.insert("x-csrf-token", HeaderValue::from_str(csrf)?);
            }
            let request = Request::new_for_test(
                method,
                format!("/tenants/{tenant}/probe").parse()?,
                headers,
                String::new().into(),
                "127.0.0.1:4000".parse()?,
                forge::core::Id::<Request>::new().into_uuid(),
            );
            Ok(self.router.dispatch(request).await.status())
        }

        fn tenant(&self) -> String {
            self.tenant.to_string()
        }
    }

    #[tokio::test]
    async fn an_active_member_with_the_grant_is_authorized_for_its_tenant() -> TestResult {
        let fixture = fixture(MembershipState::Active, true).await?;
        let tenant = fixture.tenant();
        let bearer = Some(fixture.bearer.as_str());
        let csrf = Some(fixture.csrf.as_str());

        assert_eq!(fixture.status(Method::GET, &tenant, bearer, None).await?, StatusCode::OK);
        assert_eq!(fixture.status(Method::POST, &tenant, bearer, csrf).await?, StatusCode::OK);
        Ok(())
    }

    #[tokio::test]
    async fn a_missing_or_unknown_session_is_unauthenticated() -> TestResult {
        let fixture = fixture(MembershipState::Active, true).await?;
        let tenant = fixture.tenant();
        let unknown = "ab".repeat(32);

        for bearer in [None, Some(unknown.as_str()), Some("not-a-token")] {
            assert_eq!(
                fixture.status(Method::GET, &tenant, bearer, None).await?,
                StatusCode::UNAUTHORIZED,
                "{bearer:?}"
            );
        }
        Ok(())
    }

    #[tokio::test]
    async fn unsafe_methods_need_the_session_csrf_token() -> TestResult {
        let fixture = fixture(MembershipState::Active, true).await?;
        let tenant = fixture.tenant();
        let bearer = Some(fixture.bearer.as_str());
        let other = "cd".repeat(32);

        for csrf in [None, Some(other.as_str()), Some("not-a-token")] {
            assert_eq!(
                fixture.status(Method::POST, &tenant, bearer, csrf).await?,
                StatusCode::FORBIDDEN,
                "{csrf:?}"
            );
        }
        Ok(())
    }

    #[tokio::test]
    async fn another_tenant_or_a_malformed_tenant_is_forbidden() -> TestResult {
        let fixture = fixture(MembershipState::Active, true).await?;
        let bearer = Some(fixture.bearer.as_str());

        for tenant in [TenantId::new().to_string(), "not-a-tenant".to_owned()] {
            assert_eq!(
                fixture.status(Method::GET, &tenant, bearer, None).await?,
                StatusCode::FORBIDDEN,
                "{tenant}"
            );
        }
        Ok(())
    }

    #[tokio::test]
    async fn a_suspended_membership_is_forbidden() -> TestResult {
        let fixture = fixture(MembershipState::Suspended, true).await?;
        let tenant = fixture.tenant();

        let status = fixture
            .status(Method::GET, &tenant, Some(fixture.bearer.as_str()), None)
            .await?;

        assert_eq!(status, StatusCode::FORBIDDEN);
        Ok(())
    }

    #[tokio::test]
    async fn a_role_without_the_grant_is_forbidden() -> TestResult {
        let fixture = fixture(MembershipState::Active, false).await?;
        let tenant = fixture.tenant();

        let status = fixture
            .status(Method::GET, &tenant, Some(fixture.bearer.as_str()), None)
            .await?;

        assert_eq!(status, StatusCode::FORBIDDEN);
        Ok(())
    }

    #[tokio::test]
    async fn deny_all_refuses_both_kinds_of_resource() -> TestResult {
        let request = Request::new_for_test(
            Method::GET,
            "/".parse()?,
            HeaderMap::new(),
            String::new().into(),
            "127.0.0.1:4000".parse()?,
            forge::core::Id::<Request>::new().into_uuid(),
        );
        let permission = Permission::new(PERMISSION)?;

        assert_eq!(
            GlobalAccess::authorize(&DenyAll, &request, &permission).await,
            Err(AccessDenied::Forbidden)
        );
        assert!(matches!(
            TenantAccess::authorize(&DenyAll, &request, &permission).await,
            Err(AccessDenied::Forbidden)
        ));
        Ok(())
    }
}
