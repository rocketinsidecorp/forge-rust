%%if postgresql%%

/// PostgreSQL's `42501`, also raised for a row that violates a row-level
/// security policy.
fn insufficient_privilege<T>(result: &Result<T, sqlx::Error>) -> bool {
    matches!(
        result,
        Err(sqlx::Error::Database(error)) if error.code().as_deref() == Some("42501")
    )
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn postgres_round_trip_locking_and_pages() -> TestResult {
    let database = RlsTestDatabase::create([&MIGRATOR]).await?;
    exercise(database.runtime()).await?;
    database.cleanup().await?;
    Ok(())
}

/// The runtime role holds data privileges only: whatever an attacker makes
/// the application run, it cannot create, change, empty or drop a
/// table%%RLS_DDL_SUMMARY%%.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn postgres_runtime_role_cannot_change_the_schema() -> TestResult {
    let database = RlsTestDatabase::create([&MIGRATOR]).await?;
    for statement in [
        r#"CREATE TABLE "intruders" ("id" uuid)"#,
        r#"CREATE TEMPORARY TABLE "scratch" ("id" uuid)"#,
        r#"ALTER TABLE "%%RESOURCES%%" ADD COLUMN "intruder" text"#,
%%if rls%%
        r#"ALTER TABLE "%%RESOURCES%%" DISABLE ROW LEVEL SECURITY"#,
        r#"ALTER TABLE "%%RESOURCES%%" NO FORCE ROW LEVEL SECURITY"#,
        r#"DROP POLICY "%%RESOURCES%%_tenant_isolation" ON "%%RESOURCES%%""#,
%%end%%
        r#"TRUNCATE "%%RESOURCES%%""#,
        r#"DROP TABLE "%%RESOURCES%%""#,
    ] {
        let refused = sqlx::query(statement)
            .execute(database.runtime().pool())
            .await;
        assert!(
            insufficient_privilege(&refused),
            "the runtime role ran {statement}: {refused:?}"
        );
    }
    database.cleanup().await?;
    Ok(())
}
%%end%%
%%if rls%%

/// Row-level security isolates tenants even for SQL that forgets the tenant
/// predicate: as the runtime role the application serves with, a
/// transaction without `forge.tenant_id` sees no row, another tenant's sees
/// none either, the tenant's own sees its row, and no row can move to
/// another tenant.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn postgres_row_level_security_isolates_tenants() -> TestResult {
    let database = RlsTestDatabase::create([&MIGRATOR]).await?;
    let repository = %%REPOSITORY%%::new(database.runtime().clone());
    let tenant = context(TenantId::new())?;
    let other = TenantId::new();
    repository
        .insert(&tenant, &%%TYPE%%::new(attributes()?)?)
        .await?;

    let mut transaction = database.runtime().pool().begin().await?;
    let count = r#"SELECT count(*) FROM "%%RESOURCES%%""#;
    let set_tenant = "SELECT set_config('forge.tenant_id', $1, true)";

    let visible: i64 = sqlx::query_scalar(count)
        .fetch_one(&mut *transaction)
        .await?;
    assert_eq!(visible, 0, "no tenant setting: no row is visible");

    sqlx::query(set_tenant)
        .bind(other.to_string())
        .execute(&mut *transaction)
        .await?;
    let visible: i64 = sqlx::query_scalar(count)
        .fetch_one(&mut *transaction)
        .await?;
    assert_eq!(visible, 0, "another tenant sees no row");

    sqlx::query(set_tenant)
        .bind(tenant.tenant_id().to_string())
        .execute(&mut *transaction)
        .await?;
    let visible: i64 = sqlx::query_scalar(count)
        .fetch_one(&mut *transaction)
        .await?;
    assert_eq!(visible, 1, "the tenant sees its row");

    let moved = sqlx::query(r#"UPDATE "%%RESOURCES%%" SET "tenant_id" = $1"#)
        .bind(other)
        .execute(&mut *transaction)
        .await;
    assert!(
        insufficient_privilege(&moved),
        "a row must not move to another tenant: {moved:?}"
    );

    transaction.rollback().await?;
    database.cleanup().await?;
    Ok(())
}
