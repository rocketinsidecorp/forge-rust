type TestResult = Result<(), Box<dyn Error>>;

static MIGRATOR: sqlx::migrate::Migrator = sqlx::migrate!();

fn attributes() -> Result<%%TYPE%%Attributes, Box<dyn Error>> {
    Ok(%%TYPE%%Attributes {
%%TEST_ATTRIBUTES%%
    })
}
%%if tenant%%

/// An authorized context of `tenant`, built like the HTTP adapter builds it.
fn context(tenant: TenantId) -> Result<TenantContext, Box<dyn Error>> {
    let principal = PrincipalId::new();
    let authenticated = Session::new(
        principal,
        UnixTimestamp::from_secs(10),
        UnixTimestamp::from_secs(20),
    )?
    .authenticate(UnixTimestamp::from_secs(11))?;
    let role = Role::new("member")?;
    let permission = Permission::new(WRITE_PERMISSION)?;
    let mut policy = RbacPolicy::new();
    policy.allow(role.clone(), permission.clone());
    let membership = Membership::active(tenant, principal, vec![role]);
    Ok(TenantContext::authorize(
        authenticated,
        &membership,
        &policy,
        &permission,
    )?)
}
%%end%%

async fn exercise(database: TestDatabase<%%SQLX_DATABASE%%>) -> TestResult {
    let repository = %%REPOSITORY%%::new(database.database().clone());
%%if tenant%%
    let tenant = context(TenantId::new())?;
    let other = context(TenantId::new())?;
%%end%%
    let %%RESOURCE%% = %%TYPE%%::new(attributes()?)?;

    repository.insert(%%TENANT_ARG%%&%%RESOURCE%%).await?;
    assert_eq!(
        repository.find(%%TENANT_ARG%%%%RESOURCE%%.id()).await?,
        Some(%%RESOURCE%%.clone())
    );

    let version = repository.update(%%TENANT_ARG%%&%%RESOURCE%%).await?;
    assert_eq!(version.get(), 2);
    assert!(matches!(
        repository.update(%%TENANT_ARG%%&%%RESOURCE%%).await,
        Err(%%TYPE%%StoreError::Conflict)
    ));
    assert!(matches!(
        repository
            .delete(%%TENANT_ARG%%%%RESOURCE%%.id(), Version::INITIAL)
            .await,
        Err(%%TYPE%%StoreError::Conflict)
    ));
    let stored = repository.find(%%TENANT_ARG%%%%RESOURCE%%.id()).await?;
    assert_eq!(stored.map(|stored| stored.version()), Some(version));

    for _ in 0..2 {
        repository
            .insert(%%TENANT_ARG%%&%%TYPE%%::new(attributes()?)?)
            .await?;
    }
    let first = repository.page(%%TENANT_ARG%%None, 2).await?;
    assert_eq!(first.%%RESOURCES%%.len(), 2);
    assert_eq!(first.%%RESOURCES%%[0].id(), %%RESOURCE%%.id());
    assert!(first.next.is_some());
    let rest = repository.page(%%TENANT_ARG%%first.next, 2).await?;
    assert_eq!(rest.%%RESOURCES%%.len(), 1);
    assert!(rest.next.is_none());
%%if tenant%%

    // Another tenant sees nothing and cannot change or delete the row.
    assert_eq!(repository.find(&other, %%RESOURCE%%.id()).await?, None);
    assert!(repository.page(&other, None, 10).await?.%%RESOURCES%%.is_empty());
    let current = %%RESOURCE%%.clone().with_version(version);
    assert!(matches!(
        repository.update(&other, &current).await,
        Err(%%TYPE%%StoreError::Conflict)
    ));
    assert!(matches!(
        repository.delete(&other, %%RESOURCE%%.id(), version).await,
        Err(%%TYPE%%StoreError::Conflict)
    ));
    assert!(repository.find(&tenant, %%RESOURCE%%.id()).await?.is_some());
%%end%%

    repository
        .delete(%%TENANT_ARG%%%%RESOURCE%%.id(), version)
        .await?;
    assert_eq!(repository.find(%%TENANT_ARG%%%%RESOURCE%%.id()).await?, None);
    database.cleanup().await?;
    Ok(())
}
%%if sqlite%%

#[tokio::test]
async fn sqlite_round_trip_locking_and_pages() -> TestResult {
    exercise(TestDatabase::create(&MIGRATOR).await?).await
}
