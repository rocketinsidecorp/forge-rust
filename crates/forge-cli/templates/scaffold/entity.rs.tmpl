//! The %%NOUN%% entity of the `%%RESOURCES%%` resource, generated by
//! `forge generate scaffold`. Business rules only: no HTTP, SQL or runtime
//! types, so the rules are unit-testable and shared by every adapter.

use std::fmt;

use forge::core::{%%CORE_IMPORTS%%};

/// Identifier of a [`%%TYPE%%`]: a typed UUIDv7 generated in Rust, never by
/// the database.
pub type %%TYPE%%Id = Id<%%TYPE%%>;
%%if string%%

/// Maximum length, in characters, of a `string` field.
pub const STRING_MAX_CHARS: usize = 255;
%%end%%
%%if text%%

/// Maximum length, in characters, of a `text` field.
pub const TEXT_MAX_CHARS: usize = 65_535;
%%end%%

/// The values a %%NOUN%% is made of. [`%%TYPE%%`] only holds values that pass
/// [`%%TYPE%%Attributes::validate`].
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct %%TYPE%%Attributes {
%%ATTRIBUTE_FIELDS%%
}

impl %%TYPE%%Attributes {
    /// Checks every business rule and reports all violations at once.
%%if rules%%
    pub fn validate(&self) -> Result<(), %%TYPE%%ValidationErrors> {
        let mut errors = %%TYPE%%ValidationErrors::default();
%%VALIDATIONS%%
        errors.into_result()
    }
%%end%%
%%if !rules%%
    pub fn validate(&self) -> Result<(), %%TYPE%%ValidationErrors> {
        Ok(())
    }
%%end%%
}
%%if rules%%

/// Text must not be blank and must fit `max` characters.
fn check_text(
    errors: &mut %%TYPE%%ValidationErrors,
    field: %%TYPE%%Field,
    value: &str,
    max: usize,
) {
    if value.trim().is_empty() {
        errors.push(field, %%TYPE%%Violation::Blank);
    } else if value.chars().count() > max {
        errors.push(field, %%TYPE%%Violation::TooLong { max });
    }
}
%%end%%

/// A %%NOUN%%: an identity, an optimistic-locking version and valid
/// attributes.
#[derive(Clone, Debug, Eq, PartialEq)]
pub struct %%TYPE%% {
    id: %%TYPE%%Id,
    version: Version,
    attributes: %%TYPE%%Attributes,
}

impl %%TYPE%% {
    /// A new %%NOUN%% with a fresh UUIDv7 and the initial version.
    pub fn new(attributes: %%TYPE%%Attributes) -> Result<Self, %%TYPE%%ValidationErrors> {
        Self::restore(%%TYPE%%Id::new(), Version::INITIAL, attributes)
    }

    /// A %%NOUN%% read from storage or about to replace a stored one,
    /// validated like a new one.
    pub fn restore(
        id: %%TYPE%%Id,
        version: Version,
        attributes: %%TYPE%%Attributes,
    ) -> Result<Self, %%TYPE%%ValidationErrors> {
        attributes.validate()?;
        Ok(Self {
            id,
            version,
            attributes,
        })
    }

    /// The same %%NOUN%% at `version`, after storage accepted a change.
    #[must_use]
    pub fn with_version(self, version: Version) -> Self {
        Self { version, ..self }
    }

    #[must_use]
    pub fn id(&self) -> %%TYPE%%Id {
        self.id
    }

    /// The optimistic-locking version: an update or delete must present it.
    #[must_use]
    pub fn version(&self) -> Version {
        self.version
    }

    #[must_use]
    pub fn attributes(&self) -> &%%TYPE%%Attributes {
        &self.attributes
    }
%%GETTERS%%
}

/// A field of [`%%TYPE%%Attributes`].
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum %%TYPE%%Field {
%%FIELD_VARIANTS%%
}

impl %%TYPE%%Field {
    /// The field's name in forms and storage.
    #[must_use]
    pub const fn name(self) -> &'static str {
        match self {
%%FIELD_NAMES%%
        }
    }
}

/// A broken business rule.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub enum %%TYPE%%Violation {
    /// The value is empty or only whitespace.
    Blank,
    /// The value has more than `max` characters.
    TooLong { max: usize },
}

impl fmt::Display for %%TYPE%%Violation {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Blank => formatter.write_str("can't be blank"),
            Self::TooLong { max } => write!(formatter, "is too long (at most {max} characters)"),
        }
    }
}

/// Every broken rule of a %%NOUN%%, in field order.
#[derive(Clone, Debug, Default, Eq, PartialEq)]
pub struct %%TYPE%%ValidationErrors {
    violations: Vec<(%%TYPE%%Field, %%TYPE%%Violation)>,
}

impl %%TYPE%%ValidationErrors {
    /// Records that `field` breaks a rule.
    pub fn push(&mut self, field: %%TYPE%%Field, violation: %%TYPE%%Violation) {
        self.violations.push((field, violation));
    }

    /// Whether no rule is broken.
    #[must_use]
    pub fn is_empty(&self) -> bool {
        self.violations.is_empty()
    }

    /// The first violation of `field`.
    #[must_use]
    pub fn get(&self, field: %%TYPE%%Field) -> Option<%%TYPE%%Violation> {
        self.violations
            .iter()
            .find(|(candidate, _)| *candidate == field)
            .map(|(_, violation)| *violation)
    }

    /// Every violation in the order it was found.
    pub fn iter(&self) -> impl Iterator<Item = (%%TYPE%%Field, %%TYPE%%Violation)> + '_ {
        self.violations.iter().copied()
    }

    /// `Ok` when no rule is broken.
    pub fn into_result(self) -> Result<(), Self> {
        if self.is_empty() { Ok(()) } else { Err(self) }
    }
}

impl fmt::Display for %%TYPE%%ValidationErrors {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        formatter.write_str("%%NOUN%% is invalid")?;
        for (index, (field, violation)) in self.violations.iter().enumerate() {
            let separator = if index == 0 { ": " } else { ", " };
            write!(formatter, "{separator}{} {violation}", field.name())?;
        }
        Ok(())
    }
}

impl std::error::Error for %%TYPE%%ValidationErrors {}

#[cfg(test)]
mod tests {
    use super::*;

    fn valid() -> %%TYPE%%Attributes {
        %%TYPE%%Attributes {
%%SAMPLE_ATTRIBUTES%%
        }
    }

    #[test]
    fn new_%%RESOURCES%%_get_a_uuidv7_and_the_initial_version() {
        let created = %%TYPE%%::new(valid());

        let Ok(entity) = created else {
            panic!("valid attributes must be accepted: {created:?}");
        };
        assert_eq!(entity.id().as_uuid().get_version_num(), 7);
        assert_eq!(entity.version(), Version::INITIAL);
        assert_eq!(entity.attributes(), &valid());
    }
%%if rules%%

    #[test]
    fn blank_and_too_long_text_is_rejected_with_every_violation() {
        let mut attributes = valid();
%%BLANK_ASSIGNMENTS%%

        let Err(errors) = %%TYPE%%::new(attributes) else {
            panic!("blank and too long values must be rejected");
        };
%%BLANK_ASSERTIONS%%
    }
%%end%%

    #[test]
    fn restore_validates_and_with_version_keeps_the_identity()
    -> Result<(), %%TYPE%%ValidationErrors> {
        let entity = %%TYPE%%::new(valid())?;
        let restored = %%TYPE%%::restore(entity.id(), entity.version(), valid())?;
        assert_eq!(restored, entity);

        let Ok(next) = Version::INITIAL.next() else {
            panic!("version 2 exists");
        };
        let moved = restored.with_version(next);
        assert_eq!(moved.id(), entity.id());
        assert_eq!(moved.version().get(), 2);
        Ok(())
    }
}
