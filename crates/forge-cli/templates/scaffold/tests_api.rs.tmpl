/// The router with only the %%NOUN%% API, checked against its OpenAPI
/// document.
struct Harness {
    router: Router,
%%if tenant%%
    sessions: Arc<MemoryBearerSessionStore>,
    memberships: Arc<MemoryMembershipStore>,
%%end%%
}

impl Harness {
%%if tenant%%
    /// The API behind `BearerTenantAccess`, whose policy grants `owner`
    /// read and write and `viewer` read only.
    fn new() -> Result<Self, Box<dyn Error>> {
        let sessions = Arc::new(MemoryBearerSessionStore::default());
        let memberships = Arc::new(MemoryMembershipStore::default());
        let mut policy = RbacPolicy::new();
        let owner = Role::new("owner")?;
        policy.allow(owner.clone(), Permission::new(READ_PERMISSION)?);
        policy.allow(owner, Permission::new(WRITE_PERMISSION)?);
        policy.allow(Role::new("viewer")?, Permission::new(READ_PERMISSION)?);
        let access = BearerTenantAccess::new(sessions.clone(), memberships.clone(), policy);
        let mut harness = Self::with_access(Arc::new(access))?;
        harness.sessions = sessions;
        harness.memberships = memberships;
        Ok(harness)
    }

    fn with_access(access: Arc<dyn ApiTenantAccess>) -> Result<Self, Box<dyn Error>> {
%%end%%
%%if global%%
    fn new() -> Result<Self, Box<dyn Error>> {
        Self::with_access(Arc::new(AllowAll))
    }

    fn with_access(access: Arc<dyn ApiGlobalAccess>) -> Result<Self, Box<dyn Error>> {
%%end%%
        let mut router = Router::new();
        app::adapters::http::%%RESOURCES%%_api::routes(
            &mut router,
            %%TYPE%%Service::new(Arc::new(InMemory%%TYPES%%::default())),
            access,
        )?;
        let document = router.openapi(&forge::openapi::Info::new("app", "0.0.0"))?;
        router.layer(forge::openapi::CheckResponses::new(document, |failure| {
            panic!("{failure}")
        }));
        Ok(Self {
            router,
%%if tenant%%
            sessions: Arc::new(MemoryBearerSessionStore::default()),
            memberships: Arc::new(MemoryMembershipStore::default()),
%%end%%
        })
    }
%%if tenant%%

    /// A new principal with `role` in `tenant` and a live bearer token for
    /// it, as `POST /auth/login` issues: the `Authorization` value.
    async fn token(&self, tenant: TenantId, role: &str) -> Result<String, Box<dyn Error>> {
        let principal = PrincipalId::new();
        self.memberships
            .upsert(&Membership::active(tenant, principal, vec![Role::new(role)?]))
            .await?;
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)?
            .as_secs();
        let session = Session::new(
            principal,
            UnixTimestamp::from_secs(now - 60),
            UnixTimestamp::from_secs(now + 3_600),
        )?;
        let token = SessionBearerToken::generate()?;
        self.sessions
            .insert(&BearerSession::new(session, tenant), &token.digest())
            .await?;
        Ok(format!("Bearer {}", token.expose()))
    }
%%end%%

    async fn send(
        &self,
        method: Method,
        path: &str,
        authorization: Option<&str>,
        body: Option<&str>,
    ) -> Result<Response, Box<dyn Error>> {
        let mut headers = HeaderMap::new();
        if let Some(authorization) = authorization {
            headers.insert(header::AUTHORIZATION, HeaderValue::from_str(authorization)?);
        }
        if body.is_some() {
            headers.insert(header::CONTENT_TYPE, HeaderValue::from_static("application/json"));
        }
        let request = Request::new_for_test(
            method,
            path.parse()?,
            headers,
            body.unwrap_or_default().to_owned().into(),
            "127.0.0.1:4000".parse()?,
            forge::core::Id::<Request>::new().into_uuid(),
        );
        Ok(self.router.dispatch(request).await)
    }
}

fn json_body(response: &Response) -> Value {
    serde_json::from_slice(response.body()).unwrap_or(Value::Null)
}

fn id_of(response: &Response) -> Result<String, Box<dyn Error>> {
    Ok(json_body(response)["id"]
        .as_str()
        .ok_or("the response has an id")?
        .to_owned())
}

#[tokio::test]
async fn create_show_list_update_and_delete() -> TestResult {
    let harness = Harness::new()?;
%%if tenant%%
    let token = harness.token(TenantId::new(), "owner").await?;
    let token = Some(token.as_str());
%%end%%
%%if global%%
    let token = None;
%%end%%

    let created = harness
        .send(Method::POST, "/v1/%%RESOURCES%%", token, Some(VALID))
        .await?;
    assert_eq!(created.status(), StatusCode::CREATED, "{:?}", json_body(&created));
    let id = id_of(&created)?;
    let path = format!("/v1/%%RESOURCES%%/{id}");
    assert_eq!(
        created
            .headers()
            .get(header::LOCATION)
            .and_then(|value| value.to_str().ok()),
        Some(path.as_str())
    );
    assert_eq!(json_body(&created)["version"], 1);
    assert_eq!(json_body(&created)["%%API_FIRST_FIELD%%"], json!(%%API_FIRST_VALUE%%));

    let shown = harness.send(Method::GET, &path, token, None).await?;
    assert_eq!(shown.status(), StatusCode::OK);
    assert_eq!(json_body(&shown), json_body(&created));

    let listed = harness
        .send(Method::GET, "/v1/%%RESOURCES%%", token, None)
        .await?;
    assert_eq!(listed.status(), StatusCode::OK);
    assert_eq!(json_body(&listed)["items"][0]["id"], json!(id));
    assert_eq!(json_body(&listed)["next_cursor"], Value::Null);

    let changes = json!({"version": 1, "%%API_FIRST_FIELD%%": %%API_CHANGED_VALUE%%}).to_string();
    let updated = harness
        .send(Method::PATCH, &path, token, Some(&changes))
        .await?;
    assert_eq!(updated.status(), StatusCode::OK, "{:?}", json_body(&updated));
    assert_eq!(json_body(&updated)["version"], 2);
    assert_eq!(json_body(&updated)["%%API_FIRST_FIELD%%"], json!(%%API_CHANGED_VALUE%%));

    let deleted = harness
        .send(Method::DELETE, &format!("{path}?version=2"), token, None)
        .await?;
    assert_eq!(deleted.status(), StatusCode::NO_CONTENT);
    let gone = harness.send(Method::GET, &path, token, None).await?;
    assert_eq!(gone.status(), StatusCode::NOT_FOUND);
    assert_eq!(json_body(&gone)["code"], "%%RESOURCE%%_not_found");
    Ok(())
}

#[tokio::test]
async fn invalid_values_and_bodies_are_unprocessable() -> TestResult {
    let harness = Harness::new()?;
%%if tenant%%
    let token = harness.token(TenantId::new(), "owner").await?;
    let token = Some(token.as_str());
%%end%%
%%if global%%
    let token = None;
%%end%%
    let invalid = harness
        .send(Method::POST, "/v1/%%RESOURCES%%", token, Some(INVALID))
        .await?;
    assert_eq!(invalid.status(), StatusCode::UNPROCESSABLE_ENTITY);
    assert_eq!(json_body(&invalid)["code"], INVALID_CODE);
    for body in [%%API_EMPTY_BODY%%"not json", r#"{"unknown": 1}"#] {
        let refused = harness
            .send(Method::POST, "/v1/%%RESOURCES%%", token, Some(body))
            .await?;
        assert_eq!(refused.status(), StatusCode::UNPROCESSABLE_ENTITY, "{body}");
        assert_eq!(json_body(&refused)["code"], "invalid_json", "{body}");
    }
    let listed = harness
        .send(Method::GET, "/v1/%%RESOURCES%%", token, None)
        .await?;
    assert_eq!(json_body(&listed)["items"], json!([]), "nothing was stored");
    Ok(())
}

#[tokio::test]
async fn a_stale_version_conflicts_and_unknown_ids_are_not_found() -> TestResult {
    let harness = Harness::new()?;
%%if tenant%%
    let token = harness.token(TenantId::new(), "owner").await?;
    let token = Some(token.as_str());
%%end%%
%%if global%%
    let token = None;
%%end%%
    let created = harness
        .send(Method::POST, "/v1/%%RESOURCES%%", token, Some(VALID))
        .await?;
    let path = format!("/v1/%%RESOURCES%%/{}", id_of(&created)?);
    let stale = json!({"version": 7}).to_string();
    let conflict = harness.send(Method::PATCH, &path, token, Some(&stale)).await?;
    assert_eq!(conflict.status(), StatusCode::CONFLICT);
    assert_eq!(json_body(&conflict)["code"], "%%RESOURCE%%_conflict");
    let conflict = harness
        .send(Method::DELETE, &format!("{path}?version=7"), token, None)
        .await?;
    assert_eq!(conflict.status(), StatusCode::CONFLICT);

    let unknown = format!("/v1/%%RESOURCES%%/{}", %%TYPE%%Id::new());
    for method in [Method::GET, Method::PATCH] {
        let body = (method == Method::PATCH).then_some(r#"{"version": 1}"#);
        let missing = harness.send(method, &unknown, token, body).await?;
        assert_eq!(missing.status(), StatusCode::NOT_FOUND);
    }
    let malformed = harness
        .send(Method::GET, "/v1/%%RESOURCES%%/not-an-id", token, None)
        .await?;
    assert_eq!(malformed.status(), StatusCode::BAD_REQUEST);
    assert_eq!(json_body(&malformed)["code"], "invalid_id");
    Ok(())
}
