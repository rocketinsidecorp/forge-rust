/// No `Authorization` header, a malformed one, an unknown token or a token
/// sent as a cookie: `401` with the bearer challenge, before anything is
/// read or stored.
#[tokio::test]
async fn a_request_without_a_valid_token_is_unauthorized() -> TestResult {
    let harness = Harness::new()?;
    let unknown = format!("Bearer {}", "ab".repeat(32));
    for (authorization, code) in [
        (None, "credentials_required"),
        (Some("Basic dXNlcjpwYXNz"), "credentials_invalid"),
        (Some("Bearer not-a-token"), "credentials_invalid"),
        (Some(unknown.as_str()), "credentials_invalid"),
    ] {
        for (method, body) in [(Method::GET, None), (Method::POST, Some(VALID))] {
            let response = harness
                .send(method, "/v1/%%RESOURCES%%", authorization, body)
                .await?;
            assert_eq!(response.status(), StatusCode::UNAUTHORIZED, "{authorization:?}");
            assert_eq!(json_body(&response)["code"], code);
            assert_eq!(
                response
                    .headers()
                    .get(header::WWW_AUTHENTICATE)
                    .and_then(|value| value.to_str().ok()),
                Some("Bearer realm=\"forge\"")
            );
        }
    }
    Ok(())
}

/// A role granted only `%%RESOURCES%%:read` reads but cannot write, and a
/// token without a membership in its tenant can do neither.
#[tokio::test]
async fn a_role_without_the_permission_is_forbidden() -> TestResult {
    let harness = Harness::new()?;
    let tenant = TenantId::new();
    let viewer = harness.token(tenant, "viewer").await?;
    let listed = harness
        .send(Method::GET, "/v1/%%RESOURCES%%", Some(&viewer), None)
        .await?;
    assert_eq!(listed.status(), StatusCode::OK);
    let refused = harness
        .send(Method::POST, "/v1/%%RESOURCES%%", Some(&viewer), Some(VALID))
        .await?;
    assert_eq!(refused.status(), StatusCode::FORBIDDEN);
    assert_eq!(json_body(&refused)["code"], "permission_denied");

    let stranger = harness.token(tenant, "guest").await?;
    let refused = harness
        .send(Method::GET, "/v1/%%RESOURCES%%", Some(&stranger), None)
        .await?;
    assert_eq!(refused.status(), StatusCode::FORBIDDEN);
    Ok(())
}

/// A token works only in the tenant it was issued for: another tenant's
/// %%NOUNS%% are neither listed nor found, changed or deleted.
#[tokio::test]
async fn another_tenants_rows_are_invisible() -> TestResult {
    let harness = Harness::new()?;
    let ours = harness.token(TenantId::new(), "owner").await?;
    let theirs = harness.token(TenantId::new(), "owner").await?;
    let created = harness
        .send(Method::POST, "/v1/%%RESOURCES%%", Some(&ours), Some(VALID))
        .await?;
    assert_eq!(created.status(), StatusCode::CREATED);
    let path = format!("/v1/%%RESOURCES%%/{}", id_of(&created)?);

    let listed = harness
        .send(Method::GET, "/v1/%%RESOURCES%%", Some(&theirs), None)
        .await?;
    assert_eq!(json_body(&listed)["items"], json!([]));
    let changes = json!({"version": 1}).to_string();
    for (method, path, body) in [
        (Method::GET, path.clone(), None),
        (Method::PATCH, path.clone(), Some(changes.as_str())),
        (Method::DELETE, format!("{path}?version=1"), None),
    ] {
        let response = harness.send(method, &path, Some(&theirs), body).await?;
        assert_eq!(response.status(), StatusCode::NOT_FOUND, "{path}");
    }
    let still = harness.send(Method::GET, &path, Some(&ours), None).await?;
    assert_eq!(still.status(), StatusCode::OK);
    Ok(())
}

/// The use cases check the grant again: a context authorized for another
/// permission is refused even if a policy let the request through.
#[tokio::test]
async fn the_use_cases_refuse_a_context_granted_for_another_permission() -> TestResult {
    let tenant = TenantId::new();
    let principal = PrincipalId::new();
    let authenticated = Session::new(
        principal,
        UnixTimestamp::from_secs(10),
        UnixTimestamp::from_secs(20),
    )?
    .authenticate(UnixTimestamp::from_secs(11))?;
    let role = Role::new("viewer")?;
    let read = Permission::new(READ_PERMISSION)?;
    let mut policy = RbacPolicy::new();
    policy.allow(role.clone(), read.clone());
    let context = TenantContext::authorize(
        authenticated,
        &Membership::active(tenant, principal, vec![role]),
        &policy,
        &read,
    )?;
    let service = %%TYPE%%Service::new(Arc::new(InMemory%%TYPES%%::default()));
    let refused = service
        .delete(&context, %%TYPE%%Id::new(), Version::INITIAL)
        .await;
    assert!(refused.is_err());
    Ok(())
}
%%end%%

#[tokio::test]
async fn the_generated_deny_all_default_refuses_every_route() -> TestResult {
    let harness = Harness::with_access(Arc::new(DenyAll))?;
    let member = format!("/v1/%%RESOURCES%%/{}", %%TYPE%%Id::new());
    let changes = json!({"version": 1}).to_string();
    for (method, path, body) in [
        (Method::GET, "/v1/%%RESOURCES%%".to_owned(), None),
        (Method::POST, "/v1/%%RESOURCES%%".to_owned(), Some(VALID)),
        (Method::GET, member.clone(), None),
        (Method::PATCH, member.clone(), Some(changes.as_str())),
        (Method::DELETE, format!("{member}?version=1"), None),
    ] {
        let response = harness.send(method, &path, None, body).await?;
        assert_eq!(response.status(), StatusCode::FORBIDDEN, "{path}");
    }
    Ok(())
}
