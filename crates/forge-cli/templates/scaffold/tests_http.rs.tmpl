%%if tenant%%

/// A tenant's stream never reaches another tenant: its token presented under
/// another tenant's path (where that tenant's member is authorized) is
/// refused, and another tenant's channel hears nothing of the change.
#[tokio::test]
async fn broadcasts_stay_in_their_tenant() -> TestResult {
    let harness = Harness::allowing()?;
    let token = harness.csrf_token().await?;
    let source = stream_source(&body(&harness.get(&harness.collection).await?)?)?;
    let other = TenantId::new();
    let elsewhere = source.replace(&harness.tenant.to_string(), &other.to_string());
    assert_ne!(elsewhere, source);

    let refused = harness.get(&elsewhere).await?;
    assert_eq!(refused.status(), StatusCode::FORBIDDEN);

    let mut other_list = harness
        .streams
        .broker()
        .subscribe(&Channel::for_tenant(other, "%%RESOURCES%%")?)?;
    let mut own_list = harness.streams.broker().subscribe(&harness.channel()?)?;
    harness.create(&token).await?;
    assert!(own_list.next().await.is_ok(), "the tenant's own list hears it");
    let quiet = tokio::select! {
        biased;
        received = other_list.next() => received.is_err(),
        () = std::future::ready(()) => true,
    };
    assert!(quiet, "another tenant's list hears nothing");
    Ok(())
}
