/// The URL of the `<turbo-stream-source>` a page renders.
fn stream_source(page: &str) -> Result<String, Box<dyn Error>> {
    const OPEN: &str = "<turbo-stream-source src=\"";
    let start = page.find(OPEN).ok_or("the page subscribes")? + OPEN.len();
    let end = start + page[start..].find('"').ok_or("the attribute is closed")?;
    Ok(page[start..end].replace("&amp;", "&"))
}

/// The next chunk of an event stream (published before it is read).
async fn next_event(stream: &mut Response) -> Result<String, Box<dyn Error>> {
    let chunk = stream.next_chunk().await.ok_or("the stream ended")?;
    Ok(String::from_utf8(chunk.to_vec())?)
}

/// `--broadcast`: the index subscribes, and create, update and delete reach
/// the open stream as Turbo Streams with nothing specific to the person who
/// made the change.
#[tokio::test]
async fn changes_are_broadcast_to_open_lists() -> TestResult {
    let harness = Harness::allowing()?;
    let token = harness.csrf_token().await?;
    let index = body(&harness.get(&harness.collection).await?)?;
    let source = stream_source(&index)?;
%%if tenant%%
    let streams_path = format!("/tenants/{}/streams?stream=", harness.tenant);
%%end%%
%%if global%%
    let streams_path = "/streams?stream=".to_owned();
%%end%%
    assert!(source.starts_with(&streams_path), "{source}");
    assert!(index.contains("<tr id=\"%%RESOURCES%%_empty\">"), "{index}");

    let mut stream = harness.get(&source).await?;
    assert_eq!(stream.status(), StatusCode::OK);
    assert_eq!(
        stream.headers().get(header::CONTENT_TYPE).map(HeaderValue::as_bytes),
        Some(&b"text/event-stream; charset=utf-8"[..])
    );
    assert_eq!(next_event(&mut stream).await?, "retry: 3000\n: connected\n\n");

    let member = harness.create(&token).await?;
    let id = member.rsplit('/').next().ok_or("an id")?.to_owned();
    let created = next_event(&mut stream).await?;
    assert!(
        created.contains(
            "data: <turbo-stream action=\"remove\" target=\"%%RESOURCES%%_empty\"></turbo-stream>"
        ),
        "{created}"
    );
    assert!(
        created.contains(&format!(
            "data: <turbo-stream action=\"append\" target=\"%%RESOURCES%%\"><template><tr id=\"%%RESOURCE%%_{id}\">"
        )),
        "{created}"
    );
    assert!(created.contains(&member), "{created}");
    assert!(!created.contains(&token) && !created.contains("csrf"), "{created}");
    let index = body(&harness.get(&harness.collection).await?)?;
    assert!(index.contains(&format!("<tr id=\"%%RESOURCE%%_{id}\">")), "{index}");

    let updated = harness
        .submit(&member, &token, &format!("{VALID}&_method=patch&version=1"))
        .await?;
    assert_eq!(updated.status(), StatusCode::SEE_OTHER);
    let replaced = next_event(&mut stream).await?;
    assert!(
        replaced.starts_with(&format!(
            "data: <turbo-stream action=\"replace\" target=\"%%RESOURCE%%_{id}\"><template>"
        )),
        "{replaced}"
    );

    let deleted = harness
        .submit(&member, &token, "_method=delete&version=2")
        .await?;
    assert_eq!(deleted.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        next_event(&mut stream).await?,
        format!(
            "data: <turbo-stream action=\"remove\" target=\"%%RESOURCE%%_{id}\"></turbo-stream>\ndata: \n\n"
        )
    );
    Ok(())
}

/// Streams fail closed: a forged token, a channel no resource registered and
/// a caller the access policy refuses get `403`, and nothing is subscribed.
#[tokio::test]
async fn streams_refuse_forged_unknown_and_unauthorized_subscriptions() -> TestResult {
    let harness = Harness::allowing()?;
    let source = stream_source(
        &harness
            .streams
            .source(&harness.channel()?)
            .ok_or("signs")?,
    )?;
    let path = source
        .split_once('?')
        .map(|(path, _)| path.to_owned())
        .ok_or("a stream URL")?;
    let unknown = stream_source(
        &harness
            .streams
            .source(&Channel::global("unregistered")?)
            .ok_or("signs")?,
    )?;

    for uri in [format!("{path}?stream=forged"), path.clone(), unknown] {
        let refused = harness.get(&uri).await?;
        assert_eq!(refused.status(), StatusCode::FORBIDDEN, "{uri}");
    }

    let denied = Harness::new(Arc::new(DenyAll))?;
    let denied_source = stream_source(
        &denied
            .streams
            .source(&denied.channel()?)
            .ok_or("signs")?,
    )?;
    assert_eq!(
        denied.get(&denied_source).await?.status(),
        StatusCode::FORBIDDEN
    );
    Ok(())
}
%%if global%%

/// Admits the principal named by the `x-principal` header, and callers
/// without it as anonymous: a policy with signed-in and public readers.
struct SignedInOrAnonymous;

#[async_trait]
impl GlobalAccess for SignedInOrAnonymous {
    async fn authorize(
        &self,
        request: &Request,
        _: &Permission,
    ) -> Result<Option<PrincipalId>, AccessDenied> {
        request
            .headers()
            .get("x-principal")
            .map(|value| {
                value
                    .to_str()
                    .ok()
                    .and_then(|principal| principal.parse().ok())
                    .ok_or(AccessDenied::Unauthenticated)
            })
            .transpose()
    }
}

/// Opens the stream at `source` as `principal` (anonymous without one).
/// Every test request comes from the same address, like browsers behind
/// one reverse proxy.
async fn subscribe_as(
    harness: &Harness,
    source: &str,
    principal: Option<PrincipalId>,
) -> Result<Response, Box<dyn Error>> {
    let principal = principal.map(|principal| principal.to_string());
    let headers: Vec<(&'static str, &str)> = principal
        .iter()
        .map(|principal| ("x-principal", principal.as_str()))
        .collect();
    Ok(harness
        .router
        .dispatch(request(Method::GET, source, &headers, "")?)
        .await)
}

/// Signed-in viewers of the global channel each have their own stream limit,
/// even from one address: behind a reverse proxy a per-address limit would
/// refuse everyone once one person opened enough tabs.
#[tokio::test]
async fn signed_in_viewers_from_one_address_each_have_their_own_stream_limit() -> TestResult {
    let harness = Harness::new(Arc::new(SignedInOrAnonymous))?;
    let source = stream_source(
        &harness
            .streams
            .source(&harness.channel()?)
            .ok_or("signs")?,
    )?;
    let (first, second) = (PrincipalId::new(), PrincipalId::new());

    let mut open = Vec::new();
    for _ in 0..forge::broadcast::DEFAULT_MAX_PER_PRINCIPAL {
        let stream = subscribe_as(&harness, &source, Some(first)).await?;
        assert_eq!(stream.status(), StatusCode::OK);
        open.push(stream);
    }
    let over = subscribe_as(&harness, &source, Some(first)).await?;
    assert_eq!(over.status(), StatusCode::TOO_MANY_REQUESTS);

    let other = subscribe_as(&harness, &source, Some(second)).await?;
    assert_eq!(other.status(), StatusCode::OK, "another person has their own limit");
    let anonymous = subscribe_as(&harness, &source, None).await?;
    assert_eq!(anonymous.status(), StatusCode::OK, "anonymous viewers are counted by address");
    Ok(())
}
