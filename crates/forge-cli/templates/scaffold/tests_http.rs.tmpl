/// Lets every request in; stands for the policy the application chooses.
struct AllowAll;

#[async_trait]
impl GlobalAccess for AllowAll {
    async fn authorize(&self, _: &Request, _: &Permission) -> Result<(), AccessDenied> {
        Ok(())
    }
}
%%end%%
%%if tenant%%
/// Treats every caller as an active member of the route's tenant whose role
/// is granted the requested permission, through the real
/// `TenantContext::authorize`.
struct MemberOfRouteTenant;

#[async_trait]
impl TenantAccess for MemberOfRouteTenant {
    async fn authorize(
        &self,
        request: &Request,
        permission: &Permission,
    ) -> Result<TenantContext, AccessDenied> {
        let tenant: TenantId = request
            .path_param_as("tenant_id")
            .map_err(|_| AccessDenied::Forbidden)?;
        member_context(tenant, permission).map_err(|_| AccessDenied::Forbidden)
    }
}

fn member_context(
    tenant: TenantId,
    permission: &Permission,
) -> Result<TenantContext, Box<dyn Error>> {
    let principal = PrincipalId::new();
    let authenticated = Session::new(
        principal,
        UnixTimestamp::from_secs(10),
        UnixTimestamp::from_secs(20),
    )?
    .authenticate(UnixTimestamp::from_secs(11))?;
    let role = Role::new("member")?;
    let mut policy = RbacPolicy::new();
    policy.allow(role.clone(), permission.clone());
    let membership = Membership::active(tenant, principal, vec![role]);
    Ok(TenantContext::authorize(
        authenticated,
        &membership,
        &policy,
        permission,
    )?)
}
%%end%%

/// The router of the application with only the %%NOUN%% routes, and the
/// path of the collection.
struct Harness {
    router: Router,
    collection: String,
}

impl Harness {
    fn new(access: Arc<dyn %%ACCESS_TRAIT%%>) -> Result<Self, Box<dyn Error>> {
        let repository = Arc::new(InMemory%%TYPES%%::default());
        let mut router = Router::new();
        let site = app::adapters::http::site(&mut router)?;
        app::adapters::http::%%RESOURCES%%::routes(
            &mut router,
            &site,
            %%TYPE%%Service::new(repository),
            access,
        )?;
%%if tenant%%
        let collection = format!("/tenants/{}/%%RESOURCES%%", TenantId::new());
%%end%%
%%if global%%
        let collection = "/%%RESOURCES%%".to_owned();
%%end%%
        Ok(Self { router, collection })
    }

    fn allowing() -> Result<Self, Box<dyn Error>> {
        Self::new(Arc::new(%%ALLOW_ACCESS%%))
    }

    async fn get(&self, path: &str) -> Result<Response, Box<dyn Error>> {
        Ok(self
            .router
            .dispatch(request(Method::GET, path, &[], "")?)
            .await)
    }

    /// The CSRF token the new-%%NOUN%% page issues, as a browser keeps it.
    async fn csrf_token(&self) -> Result<String, Box<dyn Error>> {
        let page = self.get(&format!("{}/new", self.collection)).await?;
        csrf_cookie(&page).ok_or_else(|| "the form page sets the CSRF cookie".into())
    }

    /// Submits `form` like the browser: cookie plus `csrf_token` field.
    async fn submit(&self, path: &str, token: &str, form: &str) -> Result<Response, Box<dyn Error>> {
        let cookie = format!("__Host-forge_csrf={token}");
        let body = format!("{form}&csrf_token={token}");
        Ok(self
            .router
            .dispatch(request(
                Method::POST,
                path,
                &[("cookie", cookie.as_str()), ("content-type", FORM)],
                &body,
            )?)
            .await)
    }

    /// Creates a %%NOUN%% and returns its path.
    async fn create(&self, token: &str) -> Result<String, Box<dyn Error>> {
        let created = self.submit(&self.collection, token, VALID).await?;
        assert_eq!(created.status(), StatusCode::SEE_OTHER);
        location(&created)
    }
}

fn request(
    method: Method,
    uri: &str,
    headers: &[(&'static str, &str)],
    body: &str,
) -> Result<Request, Box<dyn Error>> {
    let mut map = HeaderMap::new();
    for (name, value) in headers {
        map.append(*name, HeaderValue::from_str(value)?);
    }
    Ok(Request::new_for_test(
        method,
        uri.parse()?,
        map,
        body.to_owned().into(),
        "127.0.0.1:4000".parse()?,
        forge::core::Id::<Request>::new().into_uuid(),
    ))
}

fn body(response: &Response) -> Result<String, Box<dyn Error>> {
    Ok(String::from_utf8(response.body().to_vec())?)
}

fn location(response: &Response) -> Result<String, Box<dyn Error>> {
    let value = response
        .headers()
        .get(header::LOCATION)
        .ok_or("a redirect has a Location")?;
    Ok(value.to_str()?.to_owned())
}

/// The value of the cookie `name` that a response sets.
fn set_cookie(response: &Response, name: &str) -> Option<String> {
    let prefix = format!("{name}=");
    response
        .headers()
        .get_all(header::SET_COOKIE)
        .iter()
        .filter_map(|value| value.to_str().ok())
        .find_map(|value| value.strip_prefix(prefix.as_str()).map(str::to_owned))
        .and_then(|value| value.split(';').next().map(str::to_owned))
}

fn csrf_cookie(response: &Response) -> Option<String> {
    set_cookie(response, "__Host-forge_csrf")
}

#[tokio::test]
async fn forms_without_the_page_csrf_token_are_refused() -> TestResult {
    let harness = Harness::allowing()?;

    let forged = harness
        .router
        .dispatch(request(
            Method::POST,
            &harness.collection,
            &[("content-type", FORM)],
            VALID,
        )?)
        .await;

    assert_eq!(forged.status(), StatusCode::FORBIDDEN);
    assert!(!body(&harness.get(&harness.collection).await?)?.contains(SHOWN));
    Ok(())
}

#[tokio::test]
async fn invalid_input_is_shown_again_with_422() -> TestResult {
    let harness = Harness::allowing()?;
    let token = harness.csrf_token().await?;

    let response = harness
        .submit(&harness.collection, &token, &invalid())
        .await?;

    assert_eq!(response.status(), StatusCode::UNPROCESSABLE_ENTITY);
    let page = body(&response)?;
    assert!(page.contains(INVALID_MESSAGE), "{page}");
    assert!(page.contains("name=\"csrf_token\""), "{page}");
    Ok(())
}

#[tokio::test]
async fn create_show_edit_update_and_delete() -> TestResult {
    let harness = Harness::allowing()?;
    let token = harness.csrf_token().await?;

    let created = harness.submit(&harness.collection, &token, VALID).await?;
    assert_eq!(created.status(), StatusCode::SEE_OTHER);
    assert!(set_cookie(&created, "__Host-forge_flash").is_some());
    let member = location(&created)?;
    assert!(member.starts_with(&harness.collection), "{member}");

    let shown = harness.get(&member).await?;
    assert_eq!(shown.status(), StatusCode::OK);
    assert!(body(&shown)?.contains(SHOWN));
    let index = harness.get(&harness.collection).await?;
    assert!(body(&index)?.contains(&member));
    let edit = harness.get(&format!("{member}/edit")).await?;
    assert_eq!(edit.status(), StatusCode::OK);
    assert!(body(&edit)?.contains("name=\"version\" value=\"1\""));

    let updated = harness
        .submit(&member, &token, &format!("{VALID}&_method=patch&version=1"))
        .await?;
    assert_eq!(updated.status(), StatusCode::SEE_OTHER);
    assert_eq!(location(&updated)?, member);

    let deleted = harness
        .submit(&member, &token, "_method=delete&version=2")
        .await?;
    assert_eq!(deleted.status(), StatusCode::SEE_OTHER);
    assert_eq!(location(&deleted)?, harness.collection);
    assert_eq!(harness.get(&member).await?.status(), StatusCode::NOT_FOUND);
    Ok(())
}

#[tokio::test]
async fn stale_versions_are_conflicts() -> TestResult {
    let harness = Harness::allowing()?;
    let token = harness.csrf_token().await?;
    let member = harness.create(&token).await?;
    let first = harness
        .submit(&member, &token, &format!("{VALID}&_method=patch&version=1"))
        .await?;
    assert_eq!(first.status(), StatusCode::SEE_OTHER);

    let stale = harness
        .submit(&member, &token, &format!("{VALID}&_method=patch&version=1"))
        .await?;
    assert_eq!(stale.status(), StatusCode::CONFLICT);
    let page = body(&stale)?;
    assert!(page.contains("changed by someone else"), "{page}");
    assert!(page.contains("name=\"version\" value=\"2\""), "{page}");

    let stale_delete = harness
        .submit(&member, &token, "_method=delete&version=1")
        .await?;
    assert_eq!(stale_delete.status(), StatusCode::SEE_OTHER);
    assert_eq!(location(&stale_delete)?, member);
    assert_eq!(harness.get(&member).await?.status(), StatusCode::OK);
    Ok(())
}

#[tokio::test]
async fn unknown_and_malformed_ids_are_not_found() -> TestResult {
    let harness = Harness::allowing()?;

    for path in [
        format!("{}/{}", harness.collection, %%TYPE%%Id::new()),
        format!("{}/not-an-id", harness.collection),
        format!("{}/{}/edit", harness.collection, %%TYPE%%Id::new()),
    ] {
        let response = harness.get(&path).await?;
        assert_eq!(response.status(), StatusCode::NOT_FOUND, "{path}");
        assert!(body(&response)?.contains("not found"), "{path}");
    }
    Ok(())
}

#[tokio::test]
async fn the_generated_deny_all_default_refuses_every_page() -> TestResult {
    let harness = Harness::new(Arc::new(DenyAll))?;
    let id = %%TYPE%%Id::new();

    for path in [
        harness.collection.clone(),
        format!("{}/new", harness.collection),
        format!("{}/{id}", harness.collection),
        format!("{}/{id}/edit", harness.collection),
    ] {
        assert_eq!(
            harness.get(&path).await?.status(),
            StatusCode::FORBIDDEN,
            "{path}"
        );
    }
    Ok(())
}
