/// %%LABELS%% in memory, with the same optimistic locking as the SQL
/// repository.
#[derive(Default)]
struct InMemory%%TYPES%% {
    rows: Mutex<Vec<%%MEMORY_ROW%%>>,
}

impl InMemory%%TYPES%% {
    fn rows(&self) -> Result<MutexGuard<'_, Vec<%%MEMORY_ROW%%>>, %%TYPE%%StoreError> {
        self.rows.lock().map_err(|_| %%TYPE%%StoreError::Corrupt)
    }
}

#[async_trait]
impl %%TYPE%%Repository for InMemory%%TYPES%% {
    async fn find(
        &self,
%%if tenant%%
        context: &TenantContext,
%%end%%
        id: %%TYPE%%Id,
    ) -> Result<Option<%%TYPE%%>, %%TYPE%%StoreError> {
        Ok(self
            .rows()?
            .iter()
%%if tenant%%
            .filter(|(tenant, _)| *tenant == context.tenant_id())
            .map(|(_, stored)| stored)
%%end%%
            .find(|stored| stored.id() == id)
            .cloned())
    }

    async fn page(
        &self,
%%if tenant%%
        context: &TenantContext,
%%end%%
        after: Option<%%TYPE%%Id>,
        limit: u16,
    ) -> Result<%%TYPE%%Page, %%TYPE%%StoreError> {
        let mut %%RESOURCES%%: Vec<%%TYPE%%> = self
            .rows()?
            .iter()
%%if tenant%%
            .filter(|(tenant, _)| *tenant == context.tenant_id())
            .map(|(_, stored)| stored)
%%end%%
            .filter(|stored| after.is_none_or(|after| stored.id() > after))
            .cloned()
            .collect();
        %%RESOURCES%%.sort_by_key(%%TYPE%%::id);
        let next = if %%RESOURCES%%.len() > usize::from(limit) {
            %%RESOURCES%%.truncate(usize::from(limit));
            %%RESOURCES%%.last().map(%%TYPE%%::id)
        } else {
            None
        };
        Ok(%%TYPE%%Page { %%RESOURCES%%, next })
    }

    async fn insert(
        &self,
%%if tenant%%
        context: &TenantContext,
%%end%%
        %%RESOURCE%%: &%%TYPE%%,
    ) -> Result<(), %%TYPE%%StoreError> {
%%if tenant%%
        self.rows()?
            .push((context.tenant_id(), %%RESOURCE%%.clone()));
%%end%%
%%if global%%
        self.rows()?.push(%%RESOURCE%%.clone());
%%end%%
        Ok(())
    }

    async fn update(
        &self,
%%if tenant%%
        context: &TenantContext,
%%end%%
        %%RESOURCE%%: &%%TYPE%%,
    ) -> Result<Version, %%TYPE%%StoreError> {
        let next = %%RESOURCE%%
            .version()
            .next()
            .map_err(|_| %%TYPE%%StoreError::Conflict)?;
        let mut rows = self.rows()?;
        let stored = rows
            .iter_mut()
%%if tenant%%
            .filter(|(tenant, _)| *tenant == context.tenant_id())
            .map(|(_, stored)| stored)
%%end%%
            .find(|stored| stored.id() == %%RESOURCE%%.id() && stored.version() == %%RESOURCE%%.version())
            .ok_or(%%TYPE%%StoreError::Conflict)?;
        *stored = %%RESOURCE%%.clone().with_version(next);
        Ok(next)
    }

    async fn delete(
        &self,
%%if tenant%%
        context: &TenantContext,
%%end%%
        id: %%TYPE%%Id,
        expected: Version,
    ) -> Result<(), %%TYPE%%StoreError> {
        let mut rows = self.rows()?;
        let before = rows.len();
%%if tenant%%
        rows.retain(|(tenant, stored)| {
            !(*tenant == context.tenant_id() && stored.id() == id && stored.version() == expected)
        });
%%end%%
%%if global%%
        rows.retain(|stored| !(stored.id() == id && stored.version() == expected));
%%end%%
        if rows.len() == before {
            Err(%%TYPE%%StoreError::Conflict)
        } else {
            Ok(())
        }
    }
}

