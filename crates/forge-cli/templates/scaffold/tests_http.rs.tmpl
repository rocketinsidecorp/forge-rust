/// The tenant the harness's caller signed in to.
fn signed_in_tenant() -> TenantId {
    static TENANT: OnceLock<TenantId> = OnceLock::new();
    *TENANT.get_or_init(TenantId::new)
}

/// Treats every caller as an active member, whose role is granted the
/// requested permission, of the tenant it signed in to (or of the route's
/// `{tenant_id}`, as the live-update streams have one), through the real
/// `TenantContext::authorize`.
struct MemberOfSessionTenant;

#[async_trait]
impl TenantAccess for MemberOfSessionTenant {
    async fn authorize(
        &self,
        request: &Request,
        permission: &Permission,
    ) -> Result<TenantContext, AccessDenied> {
        let tenant: TenantId = match request.path_param_as("tenant_id") {
            Ok(tenant) => tenant,
            Err(forge::http::PathParamError::Missing { .. }) => signed_in_tenant(),
            Err(_) => return Err(AccessDenied::Forbidden),
        };
        member_context(tenant, permission).map_err(|_| AccessDenied::Forbidden)
    }
}

fn member_context(
    tenant: TenantId,
    permission: &Permission,
) -> Result<TenantContext, Box<dyn Error>> {
    let principal = PrincipalId::new();
    let authenticated = Session::new(
        principal,
        UnixTimestamp::from_secs(10),
        UnixTimestamp::from_secs(20),
    )?
    .authenticate(UnixTimestamp::from_secs(11))?;
    let role = Role::new("member")?;
    let mut policy = RbacPolicy::new();
    policy.allow(role.clone(), permission.clone());
    let membership = Membership::active(tenant, principal, vec![role]);
    Ok(TenantContext::authorize(
        authenticated,
        &membership,
        &policy,
        permission,
    )?)
}
%%end%%

