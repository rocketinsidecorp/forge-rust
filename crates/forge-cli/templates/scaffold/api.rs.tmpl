//! JSON API of the `%%RESOURCES%%` resource, generated by
//! `forge generate resource` (and `forge generate scaffold`). Handlers stay
//! thin: authorize, decode the request, call [`%%TYPE%%Service`], answer
//! JSON.
//!
//! | Method | Path | Action | Permission |
//! | --- | --- | --- | --- |
//! | `GET` | `/v1/%%RESOURCES%%?cursor=ID` | list, in creation order, %%PAGE_SIZE_DOC%% per page | `%%RESOURCES%%:read` |
//! | `POST` | `/v1/%%RESOURCES%%` | create: `201` with `Location` | `%%RESOURCES%%:write` |
//! | `GET` | `/v1/%%RESOURCES%%/{id}` | show | `%%RESOURCES%%:read` |
//! | `PATCH` | `/v1/%%RESOURCES%%/{id}` | change the members sent, with the `version` read | `%%RESOURCES%%:write` |
//! | `DELETE` | `/v1/%%RESOURCES%%/{id}?version=N` | delete the version read: `204` | `%%RESOURCES%%:write` |
//!
%%if tenant%%
//! %%LABELS%% belong to a tenant: the tenant is the one the bearer token was
//! issued for (`crate::adapters::http::api_access`), never a path, query or
//! header value, and every statement binds it.
//!
%%end%%
//! A stale `version` answers `409`, an invalid value `422` with a message
//! per member in `metadata`, an unknown `{id}` `404`. `PATCH` changes only
//! the members it names; `null` clears an optional one. Every route is
//! described in the OpenAPI document (`GET /openapi.json`, `forge openapi`).

use std::future::Future;
use std::sync::Arc;

use forge::ComposeError;
use forge::core::{%%API_CORE_IMPORTS%%};
use forge::http::{HeaderValue, Method, Request, Response, Router, StatusCode, header};
use forge::openapi::{OpenApiSchema, Operation, Param, describe};
use forge::security::Permission;
%%if tenant%%
use forge::tenancy::BearerDenied;
%%end%%
use forge::web::Patch;
use serde::{Deserialize, Serialize};

use crate::adapters::http::api_access::%%API_ACCESS_TRAIT%%;
use crate::application::use_cases::%%RESOURCES%%::{
    READ_PERMISSION, WRITE_PERMISSION, %%TYPE%%Error, %%TYPE%%Service,
};
use crate::domain::entities::%%RESOURCE%%::{%%TYPE%%, %%TYPE%%Attributes, %%TYPE%%Id};

/// The collection's path.
pub const COLLECTION_PATH: &str = "/v1/%%RESOURCES%%";

/// A %%NOUN%% as the API answers it.
#[derive(Debug, Serialize, OpenApiSchema)]
pub struct %%TYPE%%Json {
    /// The %%NOUN%%'s UUIDv7.
    pub id: %%TYPE%%Id,
%%API_JSON_FIELDS%%
    /// The optimistic-locking version: `PATCH` and `DELETE` send it back.
    pub version: i64,
}

impl From<&%%TYPE%%> for %%TYPE%%Json {
    fn from(%%RESOURCE%%: &%%TYPE%%) -> Self {
        let %%TYPE%%Attributes { %%API_FIELD_LIST%% } = %%RESOURCE%%.attributes().clone();
        Self {
            id: %%RESOURCE%%.id(),
            %%API_FIELD_LIST%%,
            version: %%RESOURCE%%.version().get(),
        }
    }
}

/// One page of %%NOUNS%%.
#[derive(Debug, Serialize, OpenApiSchema)]
pub struct %%TYPE%%List {
    pub items: Vec<%%TYPE%%Json>,
    /// The `cursor` of the next page; `null` on the last one.
    pub next_cursor: Option<%%TYPE%%Id>,
}

/// The body of `POST`: every required member.
#[derive(Debug, Deserialize, OpenApiSchema)]
pub struct New%%TYPE%% {
%%API_NEW_FIELDS%%
}

impl From<New%%TYPE%%> for %%TYPE%%Attributes {
    fn from(body: New%%TYPE%%) -> Self {
        let New%%TYPE%% { %%API_FIELD_LIST%% } = body;
        Self { %%API_FIELD_LIST%% }
    }
}

/// The body of `PATCH`: the version read and the members to change. A member
/// left out stays as it is; `null` clears an optional one.
#[derive(Debug, Deserialize, OpenApiSchema)]
pub struct %%TYPE%%Changes {
    /// The version the client last read.
    pub version: i64,
%%API_PATCH_FIELDS%%
}

impl %%TYPE%%Changes {
    /// Applies the members sent to `attributes`; `null` for a required
    /// member is refused.
    fn apply(self, attributes: &mut %%TYPE%%Attributes) -> Result<(), ForgeError> {
%%API_APPLY_FIELDS%%
        Ok(())
    }
}

/// The query of `GET /v1/%%RESOURCES%%`.
#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct ListQuery {
    cursor: Option<%%TYPE%%Id>,
}

/// The query of `DELETE`: the version the client last read.
#[derive(Deserialize)]
#[serde(deny_unknown_fields)]
struct DeleteQuery {
    version: i64,
}

/// What every handler shares.
struct %%TYPE%%Api {
    service: %%TYPE%%Service,
    access: Arc<dyn %%API_ACCESS_TRAIT%%>,
    read: Permission,
    write: Permission,
}

/// Registers the routes. `access` decides who may call them (see
/// `crate::adapters::http::api_access`); nothing is served before it agrees.
pub fn routes(
    router: &mut Router,
    service: %%TYPE%%Service,
    access: Arc<dyn %%API_ACCESS_TRAIT%%>,
) -> Result<(), ComposeError> {
    let state = Arc::new(%%TYPE%%Api {
        service,
        access,
        read: Permission::new(READ_PERMISSION).map_err(ComposeError::other)?,
        write: Permission::new(WRITE_PERMISSION).map_err(ComposeError::other)?,
    });
    let member = format!("{COLLECTION_PATH}/{{id}}");
    let id = || Param::path::<%%TYPE%%Id>("id").doc("The %%NOUN%%'s ID.");
    route(
        router,
        &state,
        Method::GET,
        COLLECTION_PATH,
        list,
        operation("list%%TYPES%%", "List %%NOUNS%%, in creation order", READ_PERMISSION)
            .param(Param::query::<Option<%%TYPE%%Id>>("cursor").doc("The next_cursor of the previous page."))
            .json::<%%TYPE%%List>(200)
            .errors([422]),
    )?;
    route(
        router,
        &state,
        Method::POST,
        COLLECTION_PATH,
        create,
        operation("create%%TYPE%%", "Create a %%NOUN%%", WRITE_PERMISSION)
            .request::<New%%TYPE%%>()
            .response(forge::openapi::Response::json::<%%TYPE%%Json>(201).header("Location")),
    )?;
    route(
        router,
        &state,
        Method::GET,
        &member,
        show,
        operation("get%%TYPE%%", "Get a %%NOUN%%", READ_PERMISSION)
            .param(id())
            .json::<%%TYPE%%Json>(200)
            .errors([400, 404]),
    )?;
    route(
        router,
        &state,
        Method::PATCH,
        &member,
        update,
        operation("update%%TYPE%%", "Change some members of a %%NOUN%%", WRITE_PERMISSION)
            .param(id())
            .request::<%%TYPE%%Changes>()
            .json::<%%TYPE%%Json>(200)
            .errors([400, 404, 409]),
    )?;
    route(
        router,
        &state,
        Method::DELETE,
        &member,
        destroy,
        operation("delete%%TYPE%%", "Delete a %%NOUN%%", WRITE_PERMISSION)
            .param(id())
            .param(
                Param::query::<i64>("version")
                    .required()
                    .doc("The version the client last read."),
            )
            .response(forge::openapi::Response::empty(204))
            .errors([400, 404, 409, 422]),
    )?;
    Ok(())
}

/// The description every route shares: bearer authentication, the
/// permission and the access policy's `503`.
fn operation(id: &str, summary: &str, permission: &str) -> Operation {
    Operation::new()
        .id(id)
        .summary(summary)
        .tag("%%RESOURCES%%")
        .bearer()
        .permission(permission)
        .errors([503])
}

fn route<H, F>(
    router: &mut Router,
    state: &Arc<%%TYPE%%Api>,
    method: Method,
    path: &str,
    handler: H,
    operation: Operation,
) -> Result<(), ComposeError>
where
    H: Fn(Arc<%%TYPE%%Api>, Request) -> F + Send + Sync + 'static,
    F: Future<Output = Response> + Send + 'static,
{
    let state = Arc::clone(state);
    router.route(
        method,
        path,
        describe(
            move |request: Request| handler(Arc::clone(&state), request),
            operation,
        ),
    )?;
    Ok(())
}

async fn list(state: Arc<%%TYPE%%Api>, request: Request) -> Response {
%%API_AUTHORIZE_READ%%
    let query: ListQuery = match forge::web::decode_query(&request) {
        Ok(query) => query,
        Err(failure) => return forge::web::error(&failure),
    };
    match state.service.list(%%CONTEXT_ARG_REF%%query.cursor).await {
        Ok(page) => forge::web::json(
            StatusCode::OK,
            &%%TYPE%%List {
                items: page.%%RESOURCES%%.iter().map(%%TYPE%%Json::from).collect(),
                next_cursor: page.next,
            },
        ),
        Err(error) => failure(error),
    }
}

async fn create(state: Arc<%%TYPE%%Api>, request: Request) -> Response {
%%API_AUTHORIZE_WRITE%%
    let body: New%%TYPE%% = match forge::web::decode_json_strict(&request) {
        Ok(body) => body,
        Err(failure) => return forge::web::error(&failure),
    };
    match state.service.create(%%CONTEXT_ARG_REF%%body.into()).await {
        Ok(%%RESOURCE%%) => {
            let mut response =
                forge::web::json(StatusCode::CREATED, &%%TYPE%%Json::from(&%%RESOURCE%%));
            if let Ok(location) =
                HeaderValue::from_str(&format!("{COLLECTION_PATH}/{}", %%RESOURCE%%.id()))
            {
                response.headers_mut().insert(header::LOCATION, location);
            }
            response
        }
        Err(error) => failure(error),
    }
}

async fn show(state: Arc<%%TYPE%%Api>, request: Request) -> Response {
%%API_AUTHORIZE_READ%%
    let Some(id) = path_id(&request) else {
        return invalid_id();
    };
    match state.service.find(%%CONTEXT_ARG_REF%%id).await {
        Ok(%%RESOURCE%%) => forge::web::json(StatusCode::OK, &%%TYPE%%Json::from(&%%RESOURCE%%)),
        Err(error) => failure(error),
    }
}

async fn update(state: Arc<%%TYPE%%Api>, request: Request) -> Response {
%%API_AUTHORIZE_WRITE%%
    let Some(id) = path_id(&request) else {
        return invalid_id();
    };
    let changes: %%TYPE%%Changes = match forge::web::decode_json_strict(&request) {
        Ok(changes) => changes,
        Err(failure) => return forge::web::error(&failure),
    };
    let expected = match Version::new(changes.version) {
        Ok(expected) => expected,
        Err(failure) => return forge::web::error(&failure),
    };
    // The stored attributes with the members sent; the update itself checks
    // that the version read is still the stored one.
    let mut attributes = match state.service.find(%%CONTEXT_ARG_REF%%id).await {
        Ok(%%RESOURCE%%) => %%RESOURCE%%.attributes().clone(),
        Err(error) => return failure(error),
    };
    if let Err(failure) = changes.apply(&mut attributes) {
        return forge::web::error(&failure);
    }
    match state
        .service
        .update(%%CONTEXT_ARG_REF%%id, expected, attributes)
        .await
    {
        Ok(%%RESOURCE%%) => forge::web::json(StatusCode::OK, &%%TYPE%%Json::from(&%%RESOURCE%%)),
        Err(error) => failure(error),
    }
}

async fn destroy(state: Arc<%%TYPE%%Api>, request: Request) -> Response {
%%API_AUTHORIZE_WRITE%%
    let Some(id) = path_id(&request) else {
        return invalid_id();
    };
    let expected = match forge::web::decode_query::<DeleteQuery>(&request)
        .and_then(|query| Version::new(query.version))
    {
        Ok(expected) => expected,
        Err(failure) => return forge::web::error(&failure),
    };
    match state.service.delete(%%CONTEXT_ARG_REF%%id, expected).await {
        Ok(()) => Response::empty(StatusCode::NO_CONTENT),
        Err(error) => failure(error),
    }
}

/// The route's `{id}`, when it is a UUIDv7.
fn path_id(request: &Request) -> Option<%%TYPE%%Id> {
    request.path_param_as("id").ok()
}

/// `400 invalid_id`: the `{id}` is not a UUIDv7.
fn invalid_id() -> Response {
    let failure = ForgeError::new(
        ErrorCategory::Validation,
        "invalid_id",
        "the %%NOUN%% ID is not a UUIDv7",
    );
    forge::web::json(StatusCode::BAD_REQUEST, &failure.report())
}

/// The JSON answer to a failed use case.
fn failure(error: %%TYPE%%Error) -> Response {
    match error {
        %%TYPE%%Error::Invalid(violations) => {
            let mut failure = ForgeError::new(
                ErrorCategory::Validation,
                "validation_failed",
                "the %%NOUN%% is invalid",
            );
            for (field, violation) in violations.iter() {
                failure = failure.with_metadata(field.name(), violation.to_string());
            }
            forge::web::error(&failure)
        }
        %%TYPE%%Error::NotFound => forge::web::error(&ForgeError::new(
            ErrorCategory::NotFound,
            "%%RESOURCE%%_not_found",
            "%%NOUN%% not found",
        )),
        %%TYPE%%Error::Conflict => forge::web::error(&ForgeError::new(
            ErrorCategory::Conflict,
            "%%RESOURCE%%_conflict",
            "the %%NOUN%% was changed by someone else",
        )),
%%if tenant%%
        %%TYPE%%Error::Forbidden => forge::web::bearer_refusal(BearerDenied::Forbidden),
%%end%%
        // Logged with its cause chain; the client sees a generic report.
        %%TYPE%%Error::Store(error) => forge::web::error(
            &ForgeError::new(
                ErrorCategory::Infrastructure,
                "%%RESOURCE%%_storage_failed",
                "service temporarily unavailable",
            )
            .with_source(error),
        ),
    }
}
%%if required_fields%%

/// `null` for a member that cannot be empty.
fn not_null(member: &str) -> ForgeError {
    ForgeError::new(
        ErrorCategory::Validation,
        "validation_failed",
        "the %%NOUN%% is invalid",
    )
    .with_metadata(member, "can't be null")
}
%%end%%
