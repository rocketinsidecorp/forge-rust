//! HTML pages of the `%%RESOURCES%%` resource, generated by
//! `forge generate scaffold`: index, show, new/create, edit/update and
//! delete. Handlers stay thin: authorize, decode the form, call
//! [`%%TYPE%%Service`], then render a view or redirect.
//!
//! | Method | Path | Action | Permission |
//! | --- | --- | --- | --- |
//! | `GET` | `%%COLLECTION_PATTERN%%` | index | `%%RESOURCES%%:read` |
//! | `GET` | `%%COLLECTION_PATTERN%%/new` | new | `%%RESOURCES%%:write` |
//! | `POST` | `%%COLLECTION_PATTERN%%` | create | `%%RESOURCES%%:write` |
//! | `GET` | `%%COLLECTION_PATTERN%%/{id}` | show | `%%RESOURCES%%:read` |
//! | `GET` | `%%COLLECTION_PATTERN%%/{id}/edit` | edit | `%%RESOURCES%%:write` |
//! | `PATCH`, `PUT` | `%%COLLECTION_PATTERN%%/{id}` | update | `%%RESOURCES%%:write` |
//! | `DELETE` | `%%COLLECTION_PATTERN%%/{id}` | delete | `%%RESOURCES%%:write` |
//!
//! HTML forms send `PATCH` and `DELETE` as `POST` with `_method`; the CSRF
//! layer applies the override after checking the token. Invalid input is
//! shown again with `422`, a stale version with `409`, success redirects
//! with `303` and a flash notice.

use std::future::Future;
use std::sync::Arc;

use forge::ComposeError;
use forge::core::{%%HTTP_CORE_IMPORTS%%};
use forge::http::{FormError, Method, Request, Response, Router, StatusCode};
use forge::security::Permission;
%%if tenant%%
use forge::tenancy::TenantContext;
%%end%%
use forge::views::{BASE_FIELD, FieldErrors, Flash, csrf_field, csrf_token, see_other};

%%if tenant%%
use crate::adapters::http::access::{AccessDenied, TenantAccess};
%%end%%
%%if global%%
use crate::adapters::http::access::GlobalAccess;
%%end%%
use crate::adapters::http::views::Site;
use crate::adapters::http::views::%%RESOURCES%%::{
    %%TYPE%%Edit, %%TYPE%%FormValues, %%TYPE%%Index, %%TYPE%%New, %%TYPE%%NotFound, %%TYPE%%Row, %%TYPE%%Show,
};
use crate::application::use_cases::%%RESOURCES%%::{
    READ_PERMISSION, WRITE_PERMISSION, %%TYPE%%Error, %%TYPE%%Service,
};
use crate::domain::entities::%%RESOURCE%%::{
    %%TYPE%%, %%TYPE%%Attributes, %%TYPE%%Id, %%TYPE%%ValidationErrors,
};

const STALE_UPDATE: &str = "This %%NOUN%% was changed by someone else after you opened the form. \
     Review your changes and save again to overwrite.";
const STALE_DELETE: &str =
    "This %%NOUN%% was changed by someone else. Review it and delete it again.";

/// What every %%NOUN%% handler shares.
struct %%TYPE%%Routes {
    site: Arc<Site>,
    service: %%TYPE%%Service,
    access: Arc<dyn %%ACCESS_TRAIT%%>,
    read: Permission,
    write: Permission,
}

/// Registers the %%NOUN%% routes. `access` decides who may call them (see
/// `crate::adapters::http::access`); nothing is served before it agrees.
pub fn routes(
    router: &mut Router,
    site: &Arc<Site>,
    service: %%TYPE%%Service,
    access: Arc<dyn %%ACCESS_TRAIT%%>,
) -> Result<(), ComposeError> {
    let state = Arc::new(%%TYPE%%Routes {
        site: Arc::clone(site),
        service,
        access,
        read: Permission::new(READ_PERMISSION).map_err(ComposeError::other)?,
        write: Permission::new(WRITE_PERMISSION).map_err(ComposeError::other)?,
    });
    let collection = "%%COLLECTION_PATTERN%%";
    let member = "%%COLLECTION_PATTERN%%/{id}";
    route(router, &state, Method::GET, collection, index)?;
    route(router, &state, Method::GET, &format!("{collection}/new"), new)?;
    route(router, &state, Method::POST, collection, create)?;
    route(router, &state, Method::GET, member, show)?;
    route(router, &state, Method::GET, &format!("{member}/edit"), edit)?;
    route(router, &state, Method::PATCH, member, update)?;
    route(router, &state, Method::PUT, member, update)?;
    route(router, &state, Method::DELETE, member, destroy)?;
    Ok(())
}

fn route<H, F>(
    router: &mut Router,
    state: &Arc<%%TYPE%%Routes>,
    method: Method,
    path: &str,
    handler: H,
) -> Result<(), ComposeError>
where
    H: Fn(Arc<%%TYPE%%Routes>, Request) -> F + Send + Sync + 'static,
    F: Future<Output = Response> + Send + 'static,
{
    let state = Arc::clone(state);
    router.route(method, path, move |request: Request| {
        handler(Arc::clone(&state), request)
    })?;
    Ok(())
}

/// Query of the index page: the cursor of the page to show.
#[derive(serde::Deserialize)]
#[serde(deny_unknown_fields)]
struct IndexQuery {
    after: Option<%%TYPE%%Id>,
}

/// The submitted %%NOUN%% form. Fields that must parse are kept as text, so
/// a value that does not parse can be shown again next to its error.
#[derive(serde::Deserialize)]
#[serde(deny_unknown_fields)]
struct %%TYPE%%Form {
%%FORM_STRUCT_FIELDS%%
    /// The version the edit form was rendered with.
    #[serde(default)]
    version: Option<i64>,
}

/// The stored %%NOUN%% an edit form changes, at the version it expects.
#[derive(Clone, Copy)]
struct EditTarget {
    id: %%TYPE%%Id,
    expected: Version,
}

/// The delete form of the show page.
#[derive(serde::Deserialize)]
#[serde(deny_unknown_fields)]
struct DeleteForm {
    version: i64,
}

async fn index(state: Arc<%%TYPE%%Routes>, request: Request) -> Response {
%%AUTHORIZE_READ%%
    let collection = collection_path(%%CONTEXT_REF%%);
    let Ok(query) = request.query::<IndexQuery>() else {
        return not_found(&state, &request, &collection);
    };
    match state.service.list(%%CONTEXT_ARG_REF%%query.after).await {
        Ok(page) => forge::web::html(&%%TYPE%%Index {
            layout: state.site.layout(&request, "%%LABELS%%"),
            new_path: format!("{collection}/new"),
            rows: page
                .%%RESOURCES%%
                .iter()
                .map(|%%RESOURCE%%| row(&collection, %%RESOURCE%%))
                .collect(),
            next_path: page.next.map(|next| format!("{collection}?after={next}")),
        }),
        Err(error) => failure(&state, &request, &collection, error),
    }
}

async fn show(state: Arc<%%TYPE%%Routes>, request: Request) -> Response {
%%AUTHORIZE_READ%%
    let collection = collection_path(%%CONTEXT_REF%%);
    let Some(id) = path_id(&request) else {
        return not_found(&state, &request, &collection);
    };
    match state.service.find(%%CONTEXT_ARG_REF%%id).await {
        Ok(%%RESOURCE%%) => forge::web::html(&%%TYPE%%Show {
            layout: state.site.layout(&request, "%%LABEL%%"),
            csrf_field: csrf_field_for(&request),
            back_path: collection.clone(),
            version: %%RESOURCE%%.version().get(),
            %%RESOURCE%%: row(&collection, &%%RESOURCE%%),
        }),
        Err(error) => failure(&state, &request, &collection, error),
    }
}

async fn new(state: Arc<%%TYPE%%Routes>, request: Request) -> Response {
%%AUTHORIZE_WRITE%%
    let collection = collection_path(%%CONTEXT_REF%%);
    render_new(
        &state,
        &request,
        &collection,
        %%TYPE%%FormValues::default(),
        FieldErrors::new(),
        StatusCode::OK,
    )
}

async fn create(state: Arc<%%TYPE%%Routes>, request: Request) -> Response {
%%AUTHORIZE_WRITE%%
    let collection = collection_path(%%CONTEXT_REF%%);
    let form: %%TYPE%%Form = match request.form() {
        Ok(form) => form,
        Err(error) => {
            return render_new(
                &state,
                &request,
                &collection,
                %%TYPE%%FormValues::default(),
                decode_errors(&error),
                StatusCode::UNPROCESSABLE_ENTITY,
            );
        }
    };
    let values = form.values();
    let attributes = match form.attributes() {
        Ok(attributes) => attributes,
        Err(errors) => {
            return render_new(
                &state,
                &request,
                &collection,
                values,
                errors,
                StatusCode::UNPROCESSABLE_ENTITY,
            );
        }
    };
    match state.service.create(%%CONTEXT_ARG_REF%%attributes).await {
        Ok(%%RESOURCE%%) => redirect(
            &format!("{collection}/{}", %%RESOURCE%%.id()),
            Flash::new().with_notice("%%LABEL%% was successfully created."),
        ),
        Err(%%TYPE%%Error::Invalid(violations)) => render_new(
            &state,
            &request,
            &collection,
            values,
            field_errors(&violations),
            StatusCode::UNPROCESSABLE_ENTITY,
        ),
        Err(error) => failure(&state, &request, &collection, error),
    }
}

async fn edit(state: Arc<%%TYPE%%Routes>, request: Request) -> Response {
%%AUTHORIZE_WRITE%%
    let collection = collection_path(%%CONTEXT_REF%%);
    let Some(id) = path_id(&request) else {
        return not_found(&state, &request, &collection);
    };
    match state.service.find(%%CONTEXT_ARG_REF%%id).await {
        Ok(%%RESOURCE%%) => render_edit(
            &state,
            &request,
            &collection,
            &%%RESOURCE%%,
            form_values(&%%RESOURCE%%),
            FieldErrors::new(),
            StatusCode::OK,
        ),
        Err(error) => failure(&state, &request, &collection, error),
    }
}

async fn update(state: Arc<%%TYPE%%Routes>, request: Request) -> Response {
%%AUTHORIZE_WRITE%%
    let collection = collection_path(%%CONTEXT_REF%%);
    let Some(id) = path_id(&request) else {
        return not_found(&state, &request, &collection);
    };
    // A form that does not decode, or lacks its version, is shown again with
    // the stored values.
    let (form, expected) = match request.form::<%%TYPE%%Form>() {
        Ok(form) => match form.version.map(Version::new) {
            Some(Ok(expected)) => (form, expected),
            _ => {
                let mut errors = FieldErrors::new();
                errors.add(BASE_FIELD, "The form has no valid version; reload the page.");
                return reload_edit(&state, &request, &collection, %%CONTEXT_ARG_REF%%id, errors).await;
            }
        },
        Err(error) => {
            let errors = decode_errors(&error);
            return reload_edit(&state, &request, &collection, %%CONTEXT_ARG_REF%%id, errors).await;
        }
    };
    let values = form.values();
    let attributes = match form.attributes() {
        Ok(attributes) => attributes,
        Err(errors) => {
            return render_form_page(
                &state,
                &request,
                &collection,
                EditTarget { id, expected },
                values,
                errors,
                StatusCode::UNPROCESSABLE_ENTITY,
            );
        }
    };
    match state
        .service
        .update(%%CONTEXT_ARG_REF%%id, expected, attributes)
        .await
    {
        Ok(%%RESOURCE%%) => redirect(
            &format!("{collection}/{}", %%RESOURCE%%.id()),
            Flash::new().with_notice("%%LABEL%% was successfully updated."),
        ),
        Err(%%TYPE%%Error::Invalid(violations)) => render_form_page(
            &state,
            &request,
            &collection,
            EditTarget { id, expected },
            values,
            field_errors(&violations),
            StatusCode::UNPROCESSABLE_ENTITY,
        ),
        Err(%%TYPE%%Error::Conflict) => {
            // Keep the submitted values and carry the current version, so
            // saving again is a deliberate overwrite.
            match state.service.find(%%CONTEXT_ARG_REF%%id).await {
                Ok(current) => {
                    let mut errors = FieldErrors::new();
                    errors.add(BASE_FIELD, STALE_UPDATE);
                    let target = EditTarget {
                        id,
                        expected: current.version(),
                    };
                    render_form_page(
                        &state,
                        &request,
                        &collection,
                        target,
                        values,
                        errors,
                        StatusCode::CONFLICT,
                    )
                }
                Err(error) => failure(&state, &request, &collection, error),
            }
        }
        Err(error) => failure(&state, &request, &collection, error),
    }
}

async fn destroy(state: Arc<%%TYPE%%Routes>, request: Request) -> Response {
%%AUTHORIZE_WRITE%%
    let collection = collection_path(%%CONTEXT_REF%%);
    let Some(id) = path_id(&request) else {
        return not_found(&state, &request, &collection);
    };
    let member = format!("{collection}/{id}");
    let expected = request
        .form::<DeleteForm>()
        .ok()
        .and_then(|form| Version::new(form.version).ok());
    let Some(expected) = expected else {
        let alert = "The delete form has no valid version; reload the page.";
        return redirect(&member, Flash::new().with_alert(alert));
    };
    match state.service.delete(%%CONTEXT_ARG_REF%%id, expected).await {
        Ok(()) => redirect(
            &collection,
            Flash::new().with_notice("%%LABEL%% was successfully deleted."),
        ),
        Err(%%TYPE%%Error::Conflict) => redirect(&member, Flash::new().with_alert(STALE_DELETE)),
        Err(error) => failure(&state, &request, &collection, error),
    }
}

impl %%TYPE%%Form {
    fn values(&self) -> %%TYPE%%FormValues {
        %%TYPE%%FormValues {
%%FORM_TO_VALUES%%
        }
    }

    /// Parses the text fields. When one does not parse, the error reports it
    /// together with the business-rule violations of the other fields.
    fn attributes(&self) -> Result<%%TYPE%%Attributes, FieldErrors> {
        let mut errors = FieldErrors::new();
        let attributes = %%TYPE%%Attributes {
%%FORM_TO_ATTRIBUTES%%
        };
        if errors.is_empty() {
            return Ok(attributes);
        }
        if let Err(violations) = attributes.validate() {
            for (field, violation) in violations.iter() {
                if errors.get(field.name()).is_none() {
                    errors.add(field.name(), violation.to_string());
                }
            }
        }
        Err(errors)
    }
}

/// The form values of a stored %%NOUN%%.
fn form_values(%%RESOURCE%%: &%%TYPE%%) -> %%TYPE%%FormValues {
    %%TYPE%%FormValues {
%%ENTITY_TO_VALUES%%
    }
}

/// A %%NOUN%% as display text.
fn row(collection: &str, %%RESOURCE%%: &%%TYPE%%) -> %%TYPE%%Row {
    let show_path = format!("{collection}/{}", %%RESOURCE%%.id());
    %%TYPE%%Row {
        edit_path: format!("{show_path}/edit"),
        show_path,
%%ENTITY_TO_ROW%%
    }
}

fn render_new(
    state: &%%TYPE%%Routes,
    request: &Request,
    collection: &str,
    form: %%TYPE%%FormValues,
    errors: FieldErrors,
    status: StatusCode,
) -> Response {
    forge::web::html_with_status(
        status,
        &%%TYPE%%New {
            layout: state.site.layout(request, "New %%NOUN%%"),
            csrf_field: csrf_field_for(request),
            action: collection.to_owned(),
            method: None,
            version: None,
            submit: "Create %%NOUN%%",
            back_path: collection.to_owned(),
            form,
            errors,
        },
    )
}

fn render_edit(
    state: &%%TYPE%%Routes,
    request: &Request,
    collection: &str,
    %%RESOURCE%%: &%%TYPE%%,
    form: %%TYPE%%FormValues,
    errors: FieldErrors,
    status: StatusCode,
) -> Response {
    let target = EditTarget {
        id: %%RESOURCE%%.id(),
        expected: %%RESOURCE%%.version(),
    };
    render_form_page(state, request, collection, target, form, errors, status)
}

fn render_form_page(
    state: &%%TYPE%%Routes,
    request: &Request,
    collection: &str,
    target: EditTarget,
    form: %%TYPE%%FormValues,
    errors: FieldErrors,
    status: StatusCode,
) -> Response {
    let show_path = format!("{collection}/{}", target.id);
    forge::web::html_with_status(
        status,
        &%%TYPE%%Edit {
            layout: state.site.layout(request, "Editing %%NOUN%%"),
            csrf_field: csrf_field_for(request),
            action: show_path.clone(),
            method: Some("patch"),
            version: Some(target.expected.get()),
            submit: "Update %%NOUN%%",
            back_path: collection.to_owned(),
            show_path,
            form,
            errors,
        },
    )
}

/// Shows the edit form again with the stored values and `errors`.
async fn reload_edit(
    state: &%%TYPE%%Routes,
    request: &Request,
    collection: &str,
%%if tenant%%
    context: &TenantContext,
%%end%%
    id: %%TYPE%%Id,
    errors: FieldErrors,
) -> Response {
    match state.service.find(%%CONTEXT_ARG%%id).await {
        Ok(%%RESOURCE%%) => render_edit(
            state,
            request,
            collection,
            &%%RESOURCE%%,
            form_values(&%%RESOURCE%%),
            errors,
            StatusCode::UNPROCESSABLE_ENTITY,
        ),
        Err(error) => failure(state, request, collection, error),
    }
}

fn not_found(state: &%%TYPE%%Routes, request: &Request, collection: &str) -> Response {
    forge::web::html_with_status(
        StatusCode::NOT_FOUND,
        &%%TYPE%%NotFound {
            layout: state.site.layout(request, "%%LABEL%% not found"),
            back_path: collection.to_owned(),
        },
    )
}

/// Maps a use-case failure that the handler does not render itself.
fn failure(
    state: &%%TYPE%%Routes,
    request: &Request,
    collection: &str,
    error: %%TYPE%%Error,
) -> Response {
    match error {
        %%TYPE%%Error::NotFound => not_found(state, request, collection),
        %%TYPE%%Error::Invalid(_) => {
            Response::new(StatusCode::UNPROCESSABLE_ENTITY, "unprocessable entity")
        }
        %%TYPE%%Error::Conflict => Response::new(StatusCode::CONFLICT, "conflict"),
%%if tenant%%
        %%TYPE%%Error::Forbidden => AccessDenied::Forbidden.response(),
%%end%%
        // Logged with its cause chain; the client sees a generic report.
        %%TYPE%%Error::Store(error) => forge::web::error(
            &ForgeError::new(
                ErrorCategory::Infrastructure,
                "%%RESOURCE%%_storage_failed",
                "service temporarily unavailable",
            )
            .with_source(error),
        ),
    }
}

/// A body that does not decode was not sent by the generated form; its
/// caller-safe reason is shown above the form.
fn decode_errors(error: &FormError) -> FieldErrors {
    let mut errors = FieldErrors::new();
    errors.add(BASE_FIELD, error.kind().message());
    errors
}

fn field_errors(violations: &%%TYPE%%ValidationErrors) -> FieldErrors {
    let mut errors = FieldErrors::new();
    for (field, violation) in violations.iter() {
        errors.add(field.name(), violation.to_string());
    }
    errors
}

/// A `303 See Other` that carries `flash` to the next page.
fn redirect(location: &str, flash: Flash) -> Response {
    let Ok(mut response) = see_other(location) else {
        return Response::empty(StatusCode::INTERNAL_SERVER_ERROR);
    };
    if flash.set_on(&mut response).is_err() {
        return Response::empty(StatusCode::INTERNAL_SERVER_ERROR);
    }
    response
}

fn csrf_field_for(request: &Request) -> String {
    csrf_token(request)
        .map(|token| csrf_field(&token))
        .unwrap_or_default()
}

/// The `{id}` of the route; a value that is not a UUIDv7 is "not found".
fn path_id(request: &Request) -> Option<%%TYPE%%Id> {
    request.path_param_as("id").ok()
}

%%if tenant%%
/// `/tenants/<tenant id>/%%RESOURCES%%` of the authorized tenant (never the
/// raw path, which only selected the membership to check).
fn collection_path(context: &TenantContext) -> String {
    format!("/tenants/{}/%%RESOURCES%%", context.tenant_id())
}
%%end%%
%%if global%%
fn collection_path() -> String {
    "/%%RESOURCES%%".to_owned()
}
%%end%%
%%PARSE_HELPERS%%
