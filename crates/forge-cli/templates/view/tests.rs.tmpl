//! `templates/%%DIR%%/%%NAME%%.html` renders inside the application layout
//! and escapes what it is given. Generated by `forge generate view`.

use std::error::Error;

use app::adapters::http::views::%%MODULE%%::%%TYPE%%;
use askama::Template;
use forge::http::{HeaderMap, Method, Request, Router};

#[test]
fn the_page_renders_in_the_layout_and_escapes_its_text() -> Result<(), Box<dyn Error>> {
    let translator =
        app::adapters::http::views::locales::translator(&forge::config::AppConfig::default())?;
    let site = app::adapters::http::site(&mut Router::new(), translator)?;
    let request = Request::new_for_test(
        Method::GET,
        "/".parse()?,
        HeaderMap::new(),
        String::new().into(),
        "127.0.0.1:4000".parse()?,
        forge::core::Id::<Request>::new().into_uuid(),
    );
    let html = %%TYPE%% {
        layout: site.layout(&request),
        title: "Tom & <Jerry>",
        content: "<script>alert(1)</script>",
    }
    .render()?;
    // The text is in the page, escaped (as entities: no raw markup).
    assert!(html.contains("<h1>Tom &"), "{html}");
    assert!(html.contains("Jerry"), "{html}");
    assert!(!html.contains("<Jerry>"), "{html}");
    assert!(!html.contains("<script>alert(1)</script>"), "{html}");
    Ok(())
}
