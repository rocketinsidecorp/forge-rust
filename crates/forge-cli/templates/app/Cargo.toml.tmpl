[package]
name = "%%APP_NAME%%"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
name = "app"
path = "src/lib.rs"

[[bin]]
name = "%%APP_NAME%%"
path = "src/main.rs"

[dependencies]
%%if views%%
askama = { version = "0.16.1", default-features = false, features = ["derive", "std"] }
%%end%%
forge = %%FORGE_DEPENDENCY%%
serde = { version = "1", features = ["derive"] }
%%if database%%
argon2 = { version = "0.6.0", default-features = false, features = ["alloc", "getrandom", "password-hash", "zeroize"] }
async-trait = "0.1.92"
cookie = { version = "0.18.2", default-features = false }
getrandom = "0.4.3"
sha2 = { version = "0.11.0", default-features = false }
sqlx = { version = "0.9", default-features = false, features = ["chrono", "json", "macros", "migrate", "%%DATABASE_DRIVER%%", "runtime-tokio", "tls-rustls-ring-webpki", "uuid"] }
thiserror = "2.0.21"
tokio = { version = "1.53.1", features = ["rt"] }
%%end%%
%%if views%%

[build-dependencies]
# Only the asset embedding helper used by build.rs: no HTTP or template graph.
forge-views = %%FORGE_VIEWS_BUILD_DEPENDENCY%%

[dev-dependencies]
tokio = { version = "1.53.1", features = ["macros", "rt"] }
%%end%%

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
expect_used = "deny"
unwrap_used = "deny"

[profile.release]
codegen-units = 1
lto = "thin"
strip = "symbols"
