%%if !views%%
//! Rebuilds the binary when migrations change, so `sqlx::migrate!()` embeds
//! the current `migrations/` directory.

fn main() {
    println!("cargo:rerun-if-changed=migrations");
}
%%end%%
%%if views%%
//! Embeds every file under `assets/` in the binary with a content digest
//! (`$OUT_DIR/forge_assets.rs`, included by `src/adapters/http/views/mod.rs`).
%%if database%%
//! Also rebuilds the binary when migrations change, so `sqlx::migrate!()`
//! embeds the current `migrations/` directory.
%%end%%

fn main() {
%%if database%%
    println!("cargo:rerun-if-changed=migrations");
%%end%%
    if let Err(failure) = forge_views::build::embed_assets_with_crate_path("assets", "forge::views")
    {
        eprintln!("asset embedding failed: {failure}");
        std::process::exit(1);
    }
}
%%end%%
