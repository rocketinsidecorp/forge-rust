# Development settings for %%APP_NAME%%, read by `forge dev`, `forge test`,
# `forge doctor`, `forge migrate`, `forge rollback`, `forge seed`, `forge setup`
# and `forge db`. Variables already set in the environment win. Put personal
# overrides in .env.local (git-ignored). The application binary never reads
# this file; it is excluded from Docker images and must never hold real secrets.
FORGE_ENV=development
%%if database%%
%%if postgresql%%
# The application serves as app_runtime, which row-level security applies to
# and which cannot change the schema; migrations, rollbacks and `forge db
# create/drop/reset` run as app_migrator, which owns it
# (docker/postgres/init.sql creates both).
%%end%%
FORGE_DATABASE_URL=%%DATABASE_RUNTIME_URL_LOCAL%%
FORGE_MIGRATION_DATABASE_URL=%%DATABASE_MIGRATION_URL_LOCAL%%
%%end%%
