            );
            let body = text(&page);
            assert!(
                !body.contains("translation missing"),
                "{locale} {path}: {body}"
            );
            assert!(
                body.contains(&format!("<html lang=\"{locale}\">")),
                "{body}"
            );
        }
        let failed = browser
            .post(
