/// `POST /mfa` and `POST /mfa/confirm` need no code, so for an account that
/// already has a factor a right and a wrong password must get the same
/// answer, or a session holder could test passwords through them. Both are
/// audited as denied.
#[tokio::test]
async fn enrollment_routes_do_not_reveal_the_password_of_an_enrolled_account() -> TestResult {
    let fixture = fixture()?;
    let (key, codes) = enroll_ada(&fixture).await?;
    let mut browser = Browser::default();
    password_step(&fixture, &mut browser).await?;
    browser
        .post(&fixture.router, "/session/mfa", &[("code", &codes[0])])
        .await?;
    for (path, action) in [
        ("/mfa", "auth.mfa.enrollment_started"),
        ("/mfa/confirm", "auth.mfa.enabled"),
    ] {
        let denied = audit_count(&fixture.world, action, AuditOutcome::Denied);
        let mut answers = Vec::new();
        for password in [PASSWORD, "not the password"] {
            let code = totp(&key, 0)?;
            let refused = browser
                .post(
                    &fixture.router,
                    path,
                    &[("password", password), ("code", code.as_str())],
                )
                .await?;
            let body = text(&refused);
            assert!(!body.contains("mfa_key"), "{path}: {body}");
            assert!(!body.contains("otpauth://"), "{path}: {body}");
            let settings = browser.get(&fixture.router, "/mfa").await?;
            answers.push((
                refused.status(),
                header_of(&refused, header::LOCATION),
                body,
                text(&settings).contains("Two-factor authentication changed meanwhile."),
            ));
        }
        assert_eq!(answers[0], answers[1], "{path}");
        assert_eq!(answers[0].0, StatusCode::SEE_OTHER, "{path}");
        assert_eq!(answers[0].1.as_deref(), Some("/mfa"), "{path}");
        assert!(answers[0].3, "{path}: the settings page says why");
        assert_eq!(
            audit_count(&fixture.world, action, AuditOutcome::Denied),
            denied + 2,
            "{path}: both refusals are audited"
        );
    }
    // Nothing changed: the factor is on and the session still works.
    let on = browser.get(&fixture.router, "/mfa").await?;
    assert!(text(&on).contains("Two-factor authentication is on."));
    assert!(!audited(
        &fixture.world,
        "auth.mfa.enrollment_started",
        AuditOutcome::Failed
    ));
    Ok(())
}

/// A factor installed while a password sign-in is storing its session
/// revoked every session before that one existed: the sign-in checks again
/// once the session is stored, ends it and asks for the code instead.
#[tokio::test]
async fn a_factor_installed_during_a_sign_in_ends_its_password_only_session() -> TestResult {
    let world = Arc::new(World::default());
    let store = revoking_store(&world);
    let fixture = fixture_with_mfa(
        Arc::clone(&world),
        10,
        Some(MFA_KEY),
        Some(Arc::clone(&store)),
    )?;
    let ada = fixture.ada;
    let other = mfa_service(&world, Some(MFA_KEY), Some(Arc::clone(&store)))?;
    let check = mfa_service(&world, Some(MFA_KEY), Some(store))?;
    *lock(&world.before_session_insert) = Some(Box::pin(async move {
        let Some(now) = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .ok()
            .map(|elapsed| UnixTimestamp::from_secs(elapsed.as_secs()))
        else {
            return;
        };
        let change = forge::tenancy::MfaChangeRequest::Enrollment;
        if let Ok(enrollment) = other
            .begin(ada, change, "app", "ada@example.com", now)
            .await
        {
            let code = enrollment.secret.code_at(now);
            let _ = other.confirm(ada, change, &code, now).await;
        }
    }));
    let mut browser = Browser::default();
    let response = browser
        .sign_in(&fixture.router, "acme", "ada@example.com", PASSWORD)
        .await?;
    assert!(
        lock(&world.before_session_insert).is_none(),
        "the enrollment ran inside the session insert"
    );
    assert!(
        check.status(ada).await?.is_some(),
        "the enrollment committed"
    );
    assert_eq!(response.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        header_of(&response, header::LOCATION).as_deref(),
        Some("/session/mfa")
    );
    assert!(browser.cookie("__Host-forge_session").is_none());
    assert!(browser.cookie("__Host-forge_mfa").is_some());
    assert_eq!(live_sessions(&world, ada), 0);
    assert!(!audited(&world, "auth.sign_in", AuditOutcome::Succeeded));
    Ok(())
}
