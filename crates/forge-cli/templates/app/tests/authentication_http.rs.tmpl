    let prefix = "https://shop.example.com/passwords/edit?token=";
    let start = email.message.text.find(prefix).ok_or("a reset link")? + prefix.len();
    let token: String = email.message.text[start..]
        .chars()
        .take_while(char::is_ascii_hexdigit)
        .collect();
