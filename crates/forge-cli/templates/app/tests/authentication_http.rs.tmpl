type TestResult = Result<(), Box<dyn Error>>;

const FORM: &str = "application/x-www-form-urlencoded";
const BROWSER: &str = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8";
const PASSWORD: &str = "correct horse battery";
const INVALID: &str = "That organization, email and password do not match an account.";

struct Account {
    principal: PrincipalId,
    login: String,
    hash: PasswordHash,
    disabled: bool,
    version: u64,
}

struct Reset {
    grant: PasswordResetGrant,
    used: bool,
}

/// Work that runs inside the next session insert, before the session is
/// stored: what another request committing meanwhile looks like.
type BeforeInsert = Pin<Box<dyn Future<Output = ()> + Send>>;

/// Every fake port over one shared state.
#[derive(Default)]
struct World {
    accounts: Mutex<Vec<Account>>,
    sessions: Mutex<Vec<(Session, SessionCredentialDigest, CsrfTokenDigest)>>,
    memberships: Mutex<Vec<Membership>>,
    tenants: Mutex<HashMap<String, TenantId>>,
    resets: Mutex<Vec<Reset>>,
    deliveries: Mutex<Vec<(String, String)>>,
    audit: Mutex<Vec<(String, AuditOutcome)>>,
    hashes: Mutex<u32>,
    membership_lookups: Mutex<u32>,
    deliver_fails: bool,
    /// Says it cannot deliver, as `UndeliverablePasswordResets` does.
    undeliverable: bool,
    /// Delivers through the real mail adapter instead of recording tokens.
    mailer: Option<forge::mail::PasswordResetMailer>,
    /// Runs once, inside the next session insert.
    before_session_insert: Mutex<Option<BeforeInsert>>,
}

/// PostgreSQL's `lower()` under common collations folds `İ` to `i` (no
/// combining dot); the fake store matches logins the same way, so the tests
/// see what a look-alike spelling would match in production.
fn fold(login: &str) -> String {
    login.to_lowercase().replace('\u{307}', "")
}

fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
    match mutex.lock() {
        Ok(guard) => guard,
        Err(poisoned) => poisoned.into_inner(),
    }
}

fn fake_hash(password: &[u8]) -> Result<PasswordHash, PasswordHashError> {
    let hex: String = password.iter().map(|byte| format!("{byte:02x}")).collect();
    PasswordHash::new(format!("$argon2id$fake${hex}")).map_err(|_| PasswordHashError::InvalidHash)
}

#[async_trait]
impl PasswordHasher for World {
    async fn hash(&self, password: &[u8]) -> Result<PasswordHash, PasswordHashError> {
        *lock(&self.hashes) += 1;
        fake_hash(password)
    }

    async fn verify(
        &self,
        password: &[u8],
        expected: &PasswordHash,
    ) -> Result<bool, PasswordHashError> {
        *lock(&self.hashes) += 1;
        Ok(fake_hash(password)? == *expected)
    }
}

#[async_trait]
impl PasswordCredentialStore for World {
    async fn find_by_login(
        &self,
        login: &str,
    ) -> Result<Option<PasswordCredential>, PasswordCredentialStoreError> {
        lock(&self.accounts)
            .iter()
            .find(|account| fold(&account.login) == fold(login))
            .map(|account| {
                let version = PasswordCredentialVersion::new(account.version)
                    .ok_or(PasswordCredentialStoreError::CorruptRecord)?;
                Ok(PasswordCredential::new(
                    account.principal,
                    account.hash.clone(),
                    account.disabled,
                    version,
                )
                .with_login(account.login.clone()))
            })
            .transpose()
    }

    async fn find_by_principal(
        &self,
        principal: PrincipalId,
    ) -> Result<Option<PasswordCredential>, PasswordCredentialStoreError> {
        lock(&self.accounts)
            .iter()
            .find(|account| account.principal == principal)
            .map(|account| {
                let version = PasswordCredentialVersion::new(account.version)
                    .ok_or(PasswordCredentialStoreError::CorruptRecord)?;
                Ok(PasswordCredential::new(
                    account.principal,
                    account.hash.clone(),
                    account.disabled,
                    version,
                )
                .with_login(account.login.clone()))
            })
            .transpose()
    }

    async fn replace_password_hash(
        &self,
        _: PrincipalId,
        _: PasswordCredentialVersion,
        _: &PasswordHash,
    ) -> Result<(), PasswordCredentialStoreError> {
        Err(PasswordCredentialStoreError::Conflict)
    }
}

#[async_trait]
impl SessionStore for World {
    async fn insert(
        &self,
        session: &Session,
        credential: &SessionCredentialDigest,
        csrf: &CsrfTokenDigest,
    ) -> Result<(), SessionStoreError> {
        let before = lock(&self.before_session_insert).take();
        if let Some(before) = before {
            before.await;
        }
        lock(&self.sessions).push((session.clone(), *credential, *csrf));
        Ok(())
    }

    async fn find_by_credential(
        &self,
        credential: &SessionCredentialDigest,
    ) -> Result<Option<Session>, SessionStoreError> {
        Ok(lock(&self.sessions)
            .iter()
            .find(|(_, stored, _)| stored == credential)
            .map(|(session, _, _)| session.clone()))
    }

    async fn verify_csrf(
        &self,
        id: SessionId,
        csrf: &CsrfTokenDigest,
    ) -> Result<bool, SessionStoreError> {
        Ok(lock(&self.sessions).iter().any(|(session, _, stored)| {
            session.id() == id && stored == csrf && session.revoked_at().is_none()
        }))
    }

    async fn revoke(&self, id: SessionId, at: UnixTimestamp) -> Result<(), SessionStoreError> {
        for (session, _, _) in lock(&self.sessions).iter_mut() {
            if session.id() == id {
                return session.revoke(at).map_err(|_| SessionStoreError::Conflict);
            }
        }
        Err(SessionStoreError::Conflict)
    }

    async fn rotate(
        &self,
        _: SessionId,
        _: UnixTimestamp,
        _: &Session,
        _: &SessionCredentialDigest,
        _: &CsrfTokenDigest,
    ) -> Result<(), SessionStoreError> {
        Err(SessionStoreError::Unavailable)
    }
}

#[async_trait]
impl MembershipStore for World {
    async fn find(
        &self,
        tenant: TenantId,
        principal: PrincipalId,
    ) -> Result<Option<Membership>, MembershipStoreError> {
        *lock(&self.membership_lookups) += 1;
        Ok(lock(&self.memberships)
            .iter()
            .find(|membership| {
                membership.tenant_id() == tenant && membership.principal_id() == principal
            })
            .cloned())
    }

    async fn upsert(&self, membership: &Membership) -> Result<(), MembershipStoreError> {
        lock(&self.memberships).push(membership.clone());
        Ok(())
    }

    async fn suspend(&self, _: TenantId, _: PrincipalId) -> Result<(), MembershipStoreError> {
        Err(MembershipStoreError::new(
            MembershipStoreErrorKind::Unavailable,
            "unavailable",
            true,
        ))
    }
}

#[async_trait]
impl TenantDirectory for World {
    async fn find_by_slug(&self, slug: &TenantSlug) -> Result<Option<TenantId>, AccountStoreError> {
        Ok(lock(&self.tenants).get(slug.as_str()).copied())
    }
}

#[async_trait]
impl PasswordResetStore for World {
    async fn issue(&self, grant: &PasswordResetGrant) -> Result<(), AccountStoreError> {
        lock(&self.resets).push(Reset {
            grant: grant.clone(),
            used: false,
        });
        Ok(())
    }

    async fn is_redeemable(
        &self,
        digest: &PasswordResetTokenDigest,
        now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        Ok(lock(&self.resets).iter().any(|reset| {
            reset.grant.digest() == digest && !reset.used && reset.grant.expires_at() > now
        }))
    }

    /// The PostgreSQL adapter's contract, in memory.
    async fn redeem(
        &self,
        digest: &PasswordResetTokenDigest,
        now: UnixTimestamp,
        password_hash: &PasswordHash,
    ) -> Result<Option<RedeemedPasswordReset>, AccountStoreError> {
        let mut resets = lock(&self.resets);
        let Some(found) = resets
            .iter()
            .find(|reset| {
                reset.grant.digest() == digest && !reset.used && reset.grant.expires_at() > now
            })
            .map(|reset| (reset.grant.principal_id(), reset.grant.tenant_id()))
        else {
            return Ok(None);
        };
        let (principal, tenant) = found;
        let member = lock(&self.memberships).iter().any(|membership| {
            membership.principal_id() == principal
                && membership.tenant_id() == tenant
                && membership.state() == MembershipState::Active
        });
        let mut accounts = lock(&self.accounts);
        let Some(account) = accounts
            .iter_mut()
            .find(|account| account.principal == principal && !account.disabled)
        else {
            return Ok(None);
        };
        if !member {
            return Ok(None);
        }
        account.hash = password_hash.clone();
        account.version += 1;
        for (session, _, _) in lock(&self.sessions).iter_mut() {
            if session.principal_id() == principal {
                let _ = session.revoke(now);
            }
        }
        for reset in resets
            .iter_mut()
            .filter(|reset| reset.grant.principal_id() == principal)
        {
            reset.used = true;
        }
        Ok(Some(RedeemedPasswordReset {
            principal_id: principal,
            tenant_id: tenant,
        }))
    }
}

#[async_trait]
impl PasswordResetNotifier for World {
    async fn deliver(
        &self,
        delivery: &PasswordResetDelivery,
    ) -> Result<(), PasswordResetDeliveryError> {
        if self.deliver_fails {
            return Err(PasswordResetDeliveryError::NotConfigured);
        }
        if let Some(mailer) = &self.mailer {
            return mailer.deliver(delivery).await;
        }
        lock(&self.deliveries).push((
            delivery.login().to_owned(),
            delivery.token().expose().to_owned(),
        ));
        Ok(())
    }

    fn can_deliver(&self) -> bool {
        !self.undeliverable
    }
}

#[async_trait]
impl AuditSink for World {
    async fn append(&self, event: &AuditEvent) -> Result<AuditReceipt, AuditError> {
        lock(&self.audit).push((event.action().as_str().to_owned(), event.outcome()));
        Ok(AuditReceipt::stored(event.id()))
    }
}

/// `acme` with the active owner Ada and the disabled Eve; `globex`, where
/// Ada has no membership.
struct Fixture {
    world: Arc<World>,
    router: Router,
    ada: PrincipalId,
    /// The reset-request worker, stopped when the fixture is dropped.
    _workers: forge::RunningWorkers,
}

fn fixture() -> Result<Fixture, Box<dyn Error>> {
    fixture_with(false, 3)
}

fn fixture_with(deliver_fails: bool, pair_limit: u32) -> Result<Fixture, Box<dyn Error>> {
    fixture_for(
        World {
            deliver_fails,
            ..World::default()
        },
        pair_limit,
    )
}

/// `acme` with the active owner Ada and the disabled Eve; `globex`, where
/// Ada has no membership. Returns Ada.
fn seed(world: &World) -> Result<PrincipalId, Box<dyn Error>> {
    let acme = TenantId::new();
    lock(&world.tenants).insert("acme".to_owned(), acme);
    lock(&world.tenants).insert("globex".to_owned(), TenantId::new());
    let ada = PrincipalId::new();
    let eve = PrincipalId::new();
    for (principal, login, disabled) in [
        (ada, "ada@example.com", false),
        (eve, "eve@example.com", true),
        (PrincipalId::new(), "Victim@iCloud.com", false),
    ] {
        lock(&world.accounts).push(Account {
            principal,
            login: login.to_owned(),
            hash: fake_hash(PASSWORD.as_bytes())?,
            disabled,
            version: 1,
        });
        lock(&world.memberships).push(Membership::active(
            acme,
            principal,
            vec![Role::new("owner")?],
        ));
    }
    Ok(ada)
}

/// The `FORGE_AUTH_MFA_KEY` of the tests.
const MFA_KEY: [u8; 32] = [7; 32];

/// An in-memory MFA store that revokes the world's sessions as the
/// PostgreSQL adapter does.
fn revoking_store(world: &Arc<World>) -> Arc<MemoryMfaStore> {
    let sessions = Arc::clone(world);
    Arc::new(
        MemoryMfaStore::new().with_session_revoker(Arc::new(move |principal, now| {
            for (session, _, _) in lock(&sessions.sessions).iter_mut() {
                if session.principal_id() == principal {
                    let _ = session.revoke(now);
                }
            }
        })),
    )
}

/// Two-factor authentication over `store`, or over a [`revoking_store`].
fn mfa_service(
    world: &Arc<World>,
    key: Option<[u8; 32]>,
    store: Option<Arc<MemoryMfaStore>>,
) -> Result<MfaService, Box<dyn Error>> {
    let store = store.unwrap_or_else(|| revoking_store(world));
    let cipher = match key {
        Some(key) => Some(Arc::new(forge::auth::Aes256GcmSecretCipher::new(&key)?)
            as Arc<dyn forge::auth::SecretCipher>),
        None => None,
    };
    Ok(MfaService::new(
        store,
        cipher,
        Arc::new(MemoryLoginThrottle::new(mfa_throttle_config())?),
    ))
}

fn fixture_for(world: World, pair_limit: u32) -> Result<Fixture, Box<dyn Error>> {
    fixture_with_mfa(Arc::new(world), pair_limit, Some(MFA_KEY), None)
}

fn fixture_with_mfa(
    world: Arc<World>,
    pair_limit: u32,
    mfa_key: Option<[u8; 32]>,
    mfa_store: Option<Arc<MemoryMfaStore>>,
) -> Result<Fixture, Box<dyn Error>> {
    // A world served before (a second router over the same accounts) keeps them.
    let seeded = lock(&world.accounts)
        .iter()
        .find(|account| account.login == "ada@example.com")
        .map(|account| account.principal);
    let ada = match seeded {
        Some(ada) => ada,
        None => seed(&world)?,
    };

    let throttle = || -> Result<Arc<MemoryLoginThrottle>, Box<dyn Error>> {
        Ok(Arc::new(MemoryLoginThrottle::new(ThrottleConfig {
            window: Duration::from_secs(900),
            pair_limit,
            account_limit: 50,
            source_limit: 300,
            max_entries: 1_000,
        })?))
    };
    let ports = AuthenticationPorts {
        credentials: world.clone(),
        hasher: world.clone(),
        sessions: world.clone(),
        memberships: world.clone(),
        tenants: world.clone(),
        resets: world.clone(),
        notifier: world.clone(),
        audit: world.clone(),
        sign_in_throttle: throttle()?,
        reset_throttle: throttle()?,
        mfa: mfa_service(&world, mfa_key, mfa_store)?,
    };
    let config = forge::config::AppConfig::default();
    let mut router = Router::new();
    let translator = app::adapters::http::views::locales::translator(&config)?;
    let site = app::adapters::http::site(&mut router, translator)?;
    app::adapters::http::routes(&mut router, &site)?;
    let mut composition = forge::Composition::for_testing(&config, &mut router);
    routes(&mut composition, &site, ports)?;
    let workers = composition.start_workers();
    // A protected page: what an access policy answers without a session.
    router.route(Method::GET, "/protected", |_| async {
        Response::new(StatusCode::UNAUTHORIZED, "authentication required")
    })?;
    Ok(Fixture {
        world,
        router,
        ada,
        _workers: workers,
    })
}

/// A cookie jar that sends what responses set.
#[derive(Clone, Default)]
struct Browser {
    cookies: HashMap<String, String>,
    /// The reverse proxy the requests come through and the
    /// `X-Forwarded-For` it sends; `None` connects from 127.0.0.1 directly.
    via: Option<(&'static str, &'static str)>,
}

impl Browser {
    /// A browser whose requests reach the application from `peer` with
    /// `X-Forwarded-For: forwarded_for`.
    fn via(peer: &'static str, forwarded_for: &'static str) -> Self {
        Self {
            via: Some((peer, forwarded_for)),
            ..Self::default()
        }
    }

    fn keep(&mut self, response: &Response) {
        for value in response.headers().get_all(header::SET_COOKIE) {
            let Ok(value) = value.to_str() else { continue };
            let pair = value.split(';').next().unwrap_or_default();
            let Some((name, content)) = pair.split_once('=') else {
                continue;
            };
            if content.is_empty() || value.contains("Max-Age=0") {
                self.cookies.remove(name);
            } else {
                self.cookies.insert(name.to_owned(), content.to_owned());
            }
        }
    }

    fn cookie(&self, name: &str) -> Option<String> {
        self.cookies.get(name).cloned()
    }

    fn csrf(&self) -> String {
        self.cookie("__Host-forge_csrf").unwrap_or_default()
    }

    fn request(&self, method: Method, uri: &str, body: &str) -> Result<Request, Box<dyn Error>> {
        let mut headers = HeaderMap::new();
        headers.insert(header::ACCEPT, HeaderValue::from_static(BROWSER));
        if !body.is_empty() {
            headers.insert(header::CONTENT_TYPE, HeaderValue::from_static(FORM));
        }
        if !self.cookies.is_empty() {
            let cookies: Vec<String> = self
                .cookies
                .iter()
                .map(|(name, value)| format!("{name}={value}"))
                .collect();
            headers.insert(header::COOKIE, HeaderValue::from_str(&cookies.join("; "))?);
        }
        let peer = match self.via {
            Some((peer, forwarded_for)) => {
                headers.insert(X_FORWARDED_FOR, HeaderValue::from_static(forwarded_for));
                peer
            }
            None => "127.0.0.1:4000",
        };
        Ok(Request::new_for_test(
            method,
            uri.parse()?,
            headers,
            body.to_owned().into(),
            peer.parse()?,
            forge::core::Id::<Request>::new().into_uuid(),
        ))
    }

    async fn get(&mut self, router: &Router, uri: &str) -> Result<Response, Box<dyn Error>> {
        let response = router.dispatch(self.request(Method::GET, uri, "")?).await;
        self.keep(&response);
        Ok(response)
    }

    /// Posts `fields` with this browser's CSRF token.
    async fn post(
        &mut self,
        router: &Router,
        uri: &str,
        fields: &[(&str, &str)],
    ) -> Result<Response, Box<dyn Error>> {
        let mut body = format!("csrf_token={}", self.csrf());
        for (name, value) in fields {
            body.push_str(&format!("&{name}={}", encode(value)));
        }
        let response = router
            .dispatch(self.request(Method::POST, uri, &body)?)
            .await;
        self.keep(&response);
        Ok(response)
    }

    /// Opens the sign-in page (which issues the CSRF cookie) and signs in.
    async fn sign_in(
        &mut self,
        router: &Router,
        tenant: &str,
        email: &str,
        password: &str,
    ) -> Result<Response, Box<dyn Error>> {
        self.get(router, "/session/new").await?;
        self.post(
            router,
            "/session",
            &[("tenant", tenant), ("email", email), ("password", password)],
        )
        .await
    }
}

fn encode(value: &str) -> String {
    value
        .bytes()
        .map(|byte| match byte {
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' => {
                char::from(byte).to_string()
            }
            _ => format!("%{byte:02X}"),
        })
        .collect()
}

fn text(response: &Response) -> String {
    String::from_utf8_lossy(response.body()).into_owned()
}

fn header_of(response: &Response, name: header::HeaderName) -> Option<String> {
    response
        .headers()
        .get(name)
        .and_then(|value| value.to_str().ok())
        .map(str::to_owned)
}

/// Lets the reset-request worker finish what was queued.
async fn settle() {
    for _ in 0..100 {
        tokio::task::yield_now().await;
    }
}

fn audited(world: &World, action: &str, outcome: AuditOutcome) -> bool {
    audit_count(world, action, outcome) > 0
}

fn audit_count(world: &World, action: &str, outcome: AuditOutcome) -> usize {
    lock(&world.audit)
        .iter()
        .filter(|(recorded, result)| recorded == action && *result == outcome)
        .count()
}

fn live_sessions(world: &World, principal: PrincipalId) -> usize {
    lock(&world.sessions)
        .iter()
        .filter(|(session, _, _)| {
            session.principal_id() == principal && session.revoked_at().is_none()
        })
        .count()
}

#[tokio::test]
async fn signing_in_issues_a_fresh_session_and_csrf_token_and_returns_to_the_page() -> TestResult {
    let fixture = fixture()?;
    let mut browser = Browser::default();
    let page = browser
        .get(
            &fixture.router,
            "/session/new?return_to=%2Ftenants%2F1%2Fposts",
        )
        .await?;
    assert_eq!(page.status(), StatusCode::OK);
    assert!(text(&page).contains("name=\"return_to\" value=\"/tenants/1/posts\""));
    let anonymous = browser.csrf();
    assert_eq!(anonymous.len(), 64);

    let response = browser
        .post(
            &fixture.router,
            "/session",
            &[
                ("tenant", " ACME "),
                ("email", "Ada@Example.com"),
                ("password", PASSWORD),
                ("return_to", "/tenants/1/posts"),
            ],
        )
        .await?;

    assert_eq!(response.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        header_of(&response, header::LOCATION).as_deref(),
        Some("/tenants/1/posts")
    );
    assert_eq!(
        header_of(&response, header::CACHE_CONTROL).as_deref(),
        Some("no-store")
    );
    let session = browser
        .cookie("__Host-forge_session")
        .ok_or("session cookie")?;
    assert_eq!(session.len(), 64);
    assert_ne!(
        browser.csrf(),
        anonymous,
        "the CSRF token is rotated at sign-in"
    );
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 1);
    assert!(audited(
        &fixture.world,
        "auth.sign_in",
        AuditOutcome::Succeeded
    ));

    // The page shows the signed-in state and a sign-out form.
    let signed_in = browser.get(&fixture.router, "/session/new").await?;
    assert!(text(&signed_in).contains("You are signed in."));
    Ok(())
}

#[tokio::test]
async fn every_wrong_field_gets_the_same_answer() -> TestResult {
    let fixture = fixture_with(false, 100)?;
    for (tenant, email, password) in [
        ("acme", "ada@example.com", "wrong password!"),
        ("acme", "nobody@example.com", PASSWORD),
        ("globex", "ada@example.com", PASSWORD),
        ("initech", "ada@example.com", PASSWORD),
        ("Not A Slug!", "ada@example.com", PASSWORD),
        ("acme", "eve@example.com", PASSWORD),
        ("", "", ""),
    ] {
        let mut browser = Browser::default();
        let hashes = *lock(&fixture.world.hashes);
        let response = browser
            .sign_in(&fixture.router, tenant, email, password)
            .await?;

        assert_eq!(
            response.status(),
            StatusCode::UNPROCESSABLE_ENTITY,
            "{tenant} {email}"
        );
        let page = text(&response);
        assert!(page.contains(INVALID), "{tenant} {email}");
        assert!(
            !page.contains(password) || password.is_empty(),
            "the password is never echoed"
        );
        assert!(browser.cookie("__Host-forge_session").is_none());
        assert!(
            *lock(&fixture.world.hashes) > hashes,
            "every failure costs a hash: {email}"
        );
    }
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 0);
    assert!(audited(
        &fixture.world,
        "auth.sign_in",
        AuditOutcome::Failed
    ));
    Ok(())
}

