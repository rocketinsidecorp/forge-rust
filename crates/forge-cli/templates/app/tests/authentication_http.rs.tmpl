#[tokio::test]
async fn signing_out_needs_the_csrf_token_and_revokes_the_session() -> TestResult {
    let fixture = fixture()?;
    let mut browser = Browser::default();
    browser
        .sign_in(&fixture.router, "acme", "ada@example.com", PASSWORD)
        .await?;
    let token = browser.csrf();

    let forged = fixture
        .router
        .dispatch(browser.request(Method::POST, "/session", "_method=delete")?)
        .await;
    assert_eq!(forged.status(), StatusCode::FORBIDDEN);
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 1);

    let response = browser
        .post(&fixture.router, "/session", &[("_method", "delete")])
        .await?;
    assert_eq!(response.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        header_of(&response, header::LOCATION).as_deref(),
        Some("/session/new")
    );
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 0);
    assert!(browser.cookie("__Host-forge_session").is_none());
    assert_ne!(
        browser.csrf(),
        token,
        "the CSRF token is rotated at sign-out"
    );
    assert!(audited(
        &fixture.world,
        "auth.sign_out",
        AuditOutcome::Succeeded
    ));

    // Signing out again is harmless.
    let again = browser
        .post(&fixture.router, "/session", &[("_method", "delete")])
        .await?;
    assert_eq!(again.status(), StatusCode::SEE_OTHER);
    Ok(())
}

/// Status, location and flash cookie of a reset request.
async fn reset_request(
    fixture: &Fixture,
    tenant: &str,
    email: &str,
) -> Result<(StatusCode, Option<String>, Option<String>), Box<dyn Error>> {
    let mut browser = Browser::default();
    browser.get(&fixture.router, "/passwords/new").await?;
    let response = browser
        .post(
            &fixture.router,
            "/passwords",
            &[("tenant", tenant), ("email", email)],
        )
        .await?;
    settle().await;
    let flash = response
        .headers()
        .get_all(header::SET_COOKIE)
        .iter()
        .filter_map(|value| value.to_str().ok())
        .find(|value| value.starts_with("__Host-forge_flash="))
        .map(str::to_owned);
    Ok((
        response.status(),
        header_of(&response, header::LOCATION),
        flash,
    ))
}

#[tokio::test]
async fn reset_requests_answer_the_same_whether_or_not_the_account_exists() -> TestResult {
    for deliver_fails in [false, true] {
        let fixture = fixture_with(deliver_fails, 100)?;
        let known = reset_request(&fixture, "acme", "ada@example.com").await?;
        for (tenant, email) in [
            ("acme", "nobody@example.com"),
            ("acme", "eve@example.com"),
            ("globex", "ada@example.com"),
            ("Not A Slug!", "ada@example.com"),
        ] {
            assert_eq!(
                reset_request(&fixture, tenant, email).await?,
                known,
                "{tenant} {email}"
            );
        }
        assert_eq!(known.0, StatusCode::SEE_OTHER);
        assert_eq!(known.1.as_deref(), Some("/session/new"));
        let delivered = lock(&fixture.world.deliveries).len();
        assert_eq!(
            delivered,
            usize::from(!deliver_fails),
            "only the real account gets a link"
        );
        assert_eq!(lock(&fixture.world.resets).len(), 1);
    }
    Ok(())
}

#[tokio::test]
async fn a_reset_link_works_once_changes_the_password_and_revokes_sessions() -> TestResult {
    let fixture = fixture_with(false, 10)?;
    let mut signed_in = Browser::default();
    signed_in
        .sign_in(&fixture.router, "acme", "ada@example.com", PASSWORD)
        .await?;
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 1);

    reset_request(&fixture, "acme", "ada@example.com").await?;
    let token = lock(&fixture.world.deliveries)
        .first()
        .map(|(_, token)| token.clone())
        .ok_or("delivered")?;

    let mut browser = Browser::default();
    let page = browser
        .get(&fixture.router, &format!("/passwords/edit?token={token}"))
        .await?;
    assert_eq!(page.status(), StatusCode::OK);
    assert_eq!(
        header_of(&page, header::CACHE_CONTROL).as_deref(),
        Some("no-store")
    );
    assert_eq!(
        header_of(&page, header::REFERRER_POLICY).as_deref(),
        Some("no-referrer")
    );
    assert!(text(&page).contains(&format!("name=\"token\" value=\"{token}\"")));

    let short = browser
        .post(
            &fixture.router,
            "/passwords",
            &[
                ("_method", "patch"),
                ("token", &token),
                ("password", "short"),
                ("password_confirmation", "short"),
            ],
        )
        .await?;
    assert_eq!(short.status(), StatusCode::UNPROCESSABLE_ENTITY);
    assert!(text(&short).contains("at least 12 characters"));
    let mismatch = browser
        .post(
            &fixture.router,
            "/passwords",
            &[
                ("_method", "patch"),
                ("token", &token),
                ("password", "a brand new secret"),
                ("password_confirmation", "another secret!"),
            ],
        )
        .await?;
    assert_eq!(mismatch.status(), StatusCode::UNPROCESSABLE_ENTITY);

    let changed = browser
        .post(
            &fixture.router,
            "/passwords",
            &[
                ("_method", "patch"),
                ("token", &token),
                ("password", "a brand new secret"),
                ("password_confirmation", "a brand new secret"),
            ],
        )
        .await?;
    assert_eq!(changed.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        header_of(&changed, header::LOCATION).as_deref(),
        Some("/session/new")
    );
    assert_eq!(
        header_of(&changed, header::REFERRER_POLICY).as_deref(),
        Some("no-referrer")
    );
    assert_eq!(
        live_sessions(&fixture.world, fixture.ada),
        0,
        "every session is revoked"
    );
    assert!(audited(
        &fixture.world,
        "auth.password_reset.completed",
        AuditOutcome::Succeeded
    ));

    let reused = browser
        .post(
            &fixture.router,
            "/passwords",
            &[
                ("_method", "patch"),
                ("token", &token),
                ("password", "yet another secret"),
                ("password_confirmation", "yet another secret"),
            ],
        )
        .await?;
    assert_eq!(reused.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        header_of(&reused, header::LOCATION).as_deref(),
        Some("/passwords/new")
    );

    let old = Browser::default()
        .sign_in(&fixture.router, "acme", "ada@example.com", PASSWORD)
        .await?;
    assert_eq!(old.status(), StatusCode::UNPROCESSABLE_ENTITY);
    let new = Browser::default()
        .sign_in(
            &fixture.router,
            "acme",
            "ada@example.com",
            "a brand new secret",
        )
        .await?;
    assert_eq!(new.status(), StatusCode::SEE_OTHER);
    Ok(())
}

#[tokio::test]
async fn expired_or_malformed_reset_links_are_refused() -> TestResult {
    let fixture = fixture()?;
    reset_request(&fixture, "acme", "ada@example.com").await?;
    let token = lock(&fixture.world.deliveries)
        .first()
        .map(|(_, token)| token.clone())
        .ok_or("delivered")?;
    // Fifteen minutes later the grant has expired.
    {
        let mut resets = lock(&fixture.world.resets);
        let reset = resets.first_mut().ok_or("issued")?;
        let issued = reset.grant.issued_at().as_secs();
        reset.grant = PasswordResetGrant::new(
            reset.grant.principal_id(),
            reset.grant.tenant_id(),
            *reset.grant.digest(),
            UnixTimestamp::from_secs(issued - 1_000),
            UnixTimestamp::from_secs(issued - 100),
        )?;
    }
    let mut browser = Browser::default();
    browser.get(&fixture.router, "/passwords/new").await?;
    let expired = browser
        .post(
            &fixture.router,
            "/passwords",
            &[
                ("_method", "patch"),
                ("token", &token),
                ("password", "a brand new secret"),
                ("password_confirmation", "a brand new secret"),
            ],
        )
        .await?;
    assert_eq!(
        header_of(&expired, header::LOCATION).as_deref(),
        Some("/passwords/new")
    );

    let malformed = browser
        .get(&fixture.router, "/passwords/edit?token=not-a-token")
        .await?;
    assert_eq!(malformed.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        header_of(&malformed, header::LOCATION).as_deref(),
        Some("/passwords/new")
    );
    Ok(())
}

#[tokio::test]
async fn reset_links_go_to_the_stored_login_and_look_alikes_get_nothing() -> TestResult {
    let fixture = fixture_with(false, 100)?;
    let typed = reset_request(&fixture, "acme", "VICTIM@icloud.COM").await?;
    let delivered: Vec<String> = lock(&fixture.world.deliveries)
        .iter()
        .map(|(login, _)| login.clone())
        .collect();
    assert_eq!(
        delivered,
        vec!["Victim@iCloud.com".to_owned()],
        "never the typed address"
    );

    // `İ` folds to `i` in PostgreSQL: the look-alike would match the victim.
    let look_alike = reset_request(&fixture, "acme", "victim@\u{130}cloud.com").await?;
    assert_eq!(look_alike, typed, "the same answer");
    assert_eq!(
        lock(&fixture.world.deliveries).len(),
        1,
        "nothing for the look-alike"
    );
    Ok(())
}

#[tokio::test]
async fn letter_case_and_unicode_variants_do_not_get_fresh_guesses() -> TestResult {
    let fixture = fixture_with(false, 3)?;
    let mut browser = Browser::default();
    for variant in [
        "VICTIM@icloud.com",
        "Victim@iCloud.com",
        " victim@ICLOUD.com ",
    ] {
        let response = browser
            .sign_in(&fixture.router, "acme", variant, "wrong password!")
            .await?;
        assert_eq!(
            response.status(),
            StatusCode::UNPROCESSABLE_ENTITY,
            "{variant}"
        );
    }
    let throttled = browser
        .sign_in(&fixture.router, "acme", "victim@icloud.com", PASSWORD)
        .await?;
    assert_eq!(throttled.status(), StatusCode::TOO_MANY_REQUESTS);

    // `İ` spellings would match the victim in PostgreSQL; they are unknown
    // accounts, so they give no fresh guesses at the victim's password.
    for look_alike in ["vict\u{130}m@icloud.com", "victim@\u{130}cloud.com"] {
        let response = browser
            .sign_in(&fixture.router, "acme", look_alike, PASSWORD)
            .await?;
        assert_eq!(
            response.status(),
            StatusCode::UNPROCESSABLE_ENTITY,
            "{look_alike}"
        );
        assert!(
            browser.cookie("__Host-forge_session").is_none(),
            "{look_alike}"
        );
    }
    Ok(())
}

