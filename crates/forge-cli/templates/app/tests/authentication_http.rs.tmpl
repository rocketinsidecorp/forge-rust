/// Every page renders in every generated locale (chosen by the `locale`
/// cookie) without a missing translation, and a failed sign-in answers in
/// the visitor's language.
#[tokio::test]
async fn the_pages_are_translated_in_every_locale() -> TestResult {
    let fixture = fixture()?;
    let translator =
        app::adapters::http::views::locales::translator(&forge::config::AppConfig::default())?;
    for locale in translator.locales() {
        let mut browser = Browser::default();
        browser.cookies.insert("locale".to_owned(), locale.clone());
        for path in ["/session/new", "/passwords/new"] {
            let page = browser.get(&fixture.router, path).await?;
            assert_eq!(page.status(), StatusCode::OK, "{locale} {path}");
