    // The reset notifier `src/bootstrap/mod.rs` wires when FORGE_MAIL_URL is
    // set, over the in-memory test sender instead of SMTP.
    let outbox = Arc::new(forge::mail::testing::Recorder::new());
    let emails = forge::mail::PasswordResetEmails::new(
        forge::mail::Address::new("Shop", "no-reply@example.com")?,
