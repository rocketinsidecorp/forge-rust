        );
    }
    Ok(())
}

/// The current TOTP period.
fn period() -> Result<u64, Box<dyn Error>> {
    Ok(std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)?
        .as_secs()
        / forge::auth::TOTP_PERIOD_SECS)
}

/// The code of the period `offset` periods from now.
fn totp(key: &str, offset: u64) -> Result<String, Box<dyn Error>> {
    Ok(forge::auth::TotpSecret::from_base32(key)?.code(period()? + offset))
}

/// A six-digit code that is wrong in every accepted period.
fn wrong_totp(key: &str) -> Result<String, Box<dyn Error>> {
    let secret = forge::auth::TotpSecret::from_base32(key)?;
    let now = period()?;
    let taken: Vec<String> = (now.saturating_sub(2)..=now + 3)
        .map(|counter| secret.code(counter))
        .collect();
    Ok((0..10)
        .map(|digit| digit.to_string().repeat(6))
        .find(|candidate| !taken.contains(candidate))
        .unwrap_or_default())
}

/// The text of `<code id="mfa_key">` on the setup page.
fn mfa_key_of(page: &Response) -> Result<String, Box<dyn Error>> {
    let body = text(page);
    let key = body
        .split("<code id=\"mfa_key\">")
        .nth(1)
        .and_then(|rest| rest.split("</code>").next())
        .ok_or("the setup page shows the key")?;
    Ok(key.replace(' ', ""))
}

/// The backup codes listed on the backup-codes page.
fn backup_codes_of(page: &Response) -> Vec<String> {
    text(page)
        .split("<li><code>")
        .skip(1)
        .filter_map(|rest| rest.split("</code>").next())
        .map(str::to_owned)
        .collect()
}

/// Signs Ada in and turns two-factor on; returns the key and backup codes.
/// Every session of Ada ends with it.
async fn enroll_ada(fixture: &Fixture) -> Result<(String, Vec<String>), Box<dyn Error>> {
    let mut browser = Browser::default();
    browser
        .sign_in(&fixture.router, "acme", "ada@example.com", PASSWORD)
        .await?;
    let page = browser
        .post(&fixture.router, "/mfa", &[("password", PASSWORD)])
        .await?;
    assert_eq!(page.status(), StatusCode::OK, "{}", text(&page));
    assert_eq!(
        header_of(&page, header::CACHE_CONTROL).as_deref(),
        Some("no-store")
    );
    let key = mfa_key_of(&page)?;
    assert!(text(&page).contains("otpauth://totp/"));
    let confirmed = browser
        .post(
            &fixture.router,
            "/mfa/confirm",
            &[("password", PASSWORD), ("code", &totp(&key, 0)?)],
        )
        .await?;
    assert_eq!(confirmed.status(), StatusCode::OK, "{}", text(&confirmed));
    assert!(browser.cookie("__Host-forge_session").is_none());
    let codes = backup_codes_of(&confirmed);
    assert_eq!(codes.len(), 10);
    Ok((key, codes))
}

/// Signs in with the password: the answer of an account with a factor.
async fn password_step(
    fixture: &Fixture,
    browser: &mut Browser,
) -> Result<Response, Box<dyn Error>> {
    let response = browser
        .sign_in(&fixture.router, "acme", "ada@example.com", PASSWORD)
        .await?;
    assert_eq!(response.status(), StatusCode::SEE_OTHER);
    assert_eq!(
        header_of(&response, header::LOCATION).as_deref(),
        Some("/session/mfa")
    );
    assert!(browser.cookie("__Host-forge_session").is_none());
    assert!(browser.cookie("__Host-forge_mfa").is_some());
    Ok(response)
}

#[tokio::test]
async fn two_factor_sign_in_takes_a_code_once_and_a_backup_code_once() -> TestResult {
    let fixture = fixture()?;
    let (key, codes) = enroll_ada(&fixture).await?;
    assert!(audited(
        &fixture.world,
        "auth.mfa.enrollment_started",
        AuditOutcome::Succeeded
    ));
    assert!(audited(
        &fixture.world,
        "auth.mfa.enabled",
        AuditOutcome::Succeeded
    ));
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 0);

    // The password alone issues no session, only the challenge.
    let mut browser = Browser::default();
    password_step(&fixture, &mut browser).await?;
    let form = browser.get(&fixture.router, "/session/mfa").await?;
    assert_eq!(form.status(), StatusCode::OK);
    assert!(text(&form).contains("autocomplete=\"one-time-code\""));
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 0);

    let wrong = browser
        .post(
            &fixture.router,
            "/session/mfa",
            &[("code", &wrong_totp(&key)?)],
        )
        .await?;
    assert_eq!(wrong.status(), StatusCode::UNPROCESSABLE_ENTITY);
    assert!(text(&wrong).contains("That code did not work."));
    assert!(audited(
        &fixture.world,
        "auth.mfa.challenge_failed",
        AuditOutcome::Denied
    ));
    // The confirmation's code was recorded: replaying it fails.
    let replayed = browser
        .post(
            &fixture.router,
            "/session/mfa",
            &[("code", &totp(&key, 0)?)],
        )
        .await?;
    assert_eq!(replayed.status(), StatusCode::UNPROCESSABLE_ENTITY);

    let code = totp(&key, 1)?;
    let signed_in = browser
        .post(&fixture.router, "/session/mfa", &[("code", &code)])
        .await?;
    assert_eq!(
        signed_in.status(),
        StatusCode::SEE_OTHER,
        "{}",
        text(&signed_in)
    );
    assert_eq!(
        header_of(&signed_in, header::LOCATION).as_deref(),
        Some("/")
    );
    assert!(browser.cookie("__Host-forge_session").is_some());
    assert!(browser.cookie("__Host-forge_mfa").is_none());
    assert_eq!(live_sessions(&fixture.world, fixture.ada), 1);
    assert!(audited(
        &fixture.world,
        "auth.mfa.challenge_succeeded",
        AuditOutcome::Succeeded
    ));

    // The same code in a new sign-in is a replay.
    let mut again = Browser::default();
    password_step(&fixture, &mut again).await?;
    let replay = again
        .post(&fixture.router, "/session/mfa", &[("code", &code)])
        .await?;
    assert_eq!(replay.status(), StatusCode::UNPROCESSABLE_ENTITY);

    // A backup code signs in once.
    let backup = again
        .post(&fixture.router, "/session/mfa", &[("code", &codes[0])])
        .await?;
    assert_eq!(backup.status(), StatusCode::SEE_OTHER, "{}", text(&backup));
    assert!(audited(
        &fixture.world,
        "auth.mfa.backup_code_used",
        AuditOutcome::Succeeded
    ));
    let settings = again.get(&fixture.router, "/mfa").await?;
    assert!(
        text(&settings).contains("9 backup codes left."),
        "{}",
        text(&settings)
    );
    let mut third = Browser::default();
    password_step(&fixture, &mut third).await?;
    let reused = third
        .post(&fixture.router, "/session/mfa", &[("code", &codes[0])])
        .await?;
    assert_eq!(reused.status(), StatusCode::UNPROCESSABLE_ENTITY);
    Ok(())
}

