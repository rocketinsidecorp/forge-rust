        )
        .await?;
    assert_eq!(changed.status(), StatusCode::SEE_OTHER);
    let mut ada = Browser::default();
    let signed_in = ada
        .sign_in(
            &fixture.router,
            "acme",
            "ada@example.com",
            "a brand new secret",
        )
        .await?;
    assert_eq!(signed_in.status(), StatusCode::SEE_OTHER);
    Ok(())
}

