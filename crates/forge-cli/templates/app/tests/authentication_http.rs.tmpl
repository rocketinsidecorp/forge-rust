    )?;
    reset_request(&fixture, "acme", "nobody@example.com").await?;
    assert!(outbox.is_empty(), "unknown accounts get no email");
    reset_request(&fixture, "acme", "ada@example.com").await?;

    let email = outbox.last().ok_or("one email")?;
    assert_eq!(email.recipients, ["ada@example.com"]);
