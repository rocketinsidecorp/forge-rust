//! `setup` and the PostgreSQL authentication adapters against a real
//! database migrated with the application's migrations
//! (`forge::db::testing::TestDatabase`): one owner only, also under
//! concurrency; reset tokens that work once, expire and revoke sessions;
//! two-factor codes, backup codes and sign-in challenges that work once,
//! expire, die with a password change and fail closed on a wrong key or a
//! tampered seed.
//!
//! PostgreSQL tests need `FORGE_TEST_DATABASE_URL` (a role that may create
//! databases) and are ignored by default:
//! `cargo test -- --include-ignored`.

use std::error::Error;

use app::bootstrap::setup;
use app::infrastructure::accounts::{
    OWNER_ROLE, OwnerAccount, PgMfaStore, PgPasswordResetStore, PgTenantDirectory, SetupError,
    provision_owner,
};
use app::infrastructure::auth::{PostgresPasswordCredentialStore, PostgresSessionStore};
use app::infrastructure::security::{
    Argon2idPasswordHasher, authenticate_password, issue_persisted_session, verify_password,
};
use forge::CommandContext;
use forge::auth::{
    CanonicalLogin, PasswordHasher as _, PasswordResetToken, SessionStore as _, UnixTimestamp,
};
use forge::db::testing::TestDatabase;
use forge::tenancy::{
    PasswordResetGrant, PasswordResetStore as _, TenantDirectory as _, TenantSlug,
};

use std::net::{IpAddr, Ipv4Addr};
use std::sync::Arc;

use forge::auth::{Aes256GcmSecretCipher, MemoryLoginThrottle, MfaChallengeBinding};
use forge::tenancy::{MfaChange, MfaError, MfaService, mfa_throttle_config};

type TestResult = Result<(), Box<dyn Error>>;

static MIGRATOR: sqlx::migrate::Migrator = sqlx::migrate!();

const PASSWORD: &str = "correct horse battery";

fn now() -> Result<UnixTimestamp, Box<dyn Error>> {
    Ok(UnixTimestamp::from_secs(
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)?
            .as_secs(),
    ))
}

fn setup_arguments<'a>(tenant: &'a str, email: &'a str) -> [&'a str; 5] {
    ["--tenant", tenant, "--email", email, "--password-stdin"]
}

#[tokio::test]
async fn setup_refuses_password_arguments_and_short_passwords_before_touching_a_database()
-> TestResult {
    let argument = setup::run(CommandContext::for_testing(&[
        "--tenant",
        "acme",
        "--email",
        "owner@example.com",
        "--password",
        "hunter2hunter2",
    ]))
    .await
    .err()
    .ok_or("a password argument is refused")?;
    assert!(argument.to_string().contains("never accepted as arguments"));
    assert!(!argument.to_string().contains("hunter2"));

    let short = setup::run(
        CommandContext::for_testing(&setup_arguments("acme", "owner@example.com"))
            .with_stdin("too short\n"),
    )
    .await
    .err()
    .ok_or("a short password is refused")?;
    assert!(short.to_string().contains("at least 12 characters"));

    let unattended = setup::run(CommandContext::for_testing(&[
        "--tenant",
        "acme",
        "--email",
        "owner@example.com",
    ]))
    .await
    .err()
    .ok_or("no password source is refused")?;
    assert!(unattended.to_string().contains("--password-stdin"));
    Ok(())
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn setup_creates_one_owner_who_can_sign_in_and_refuses_afterwards() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let run = |tenant: &'static str, email: &'static str| {
        setup::run(
            CommandContext::for_testing(&setup_arguments(tenant, email))
                .with_stdin(&format!("{PASSWORD}\n"))
                .with_postgres(database.database().clone()),
        )
    };

    run("acme", "Owner@Example.com").await?;
    let again = run("acme", "owner@example.com")
        .await
        .err()
        .ok_or("refused")?;
    assert!(again.to_string().contains("already set up"), "{again}");
    let other = run("globex", "other@example.com")
        .await
        .err()
        .ok_or("refused")?;
    assert!(other.to_string().contains("already set up"), "{other}");

    let tenant = PgTenantDirectory::new(pool.clone())
        .find_by_slug(&TenantSlug::new("acme")?)
        .await?
        .ok_or("the tenant exists")?;
    let principal = authenticate_password(
        &PostgresPasswordCredentialStore::new(pool.clone()),
        &Argon2idPasswordHasher,
        "owner@example.com",
        PASSWORD.as_bytes(),
    )
    .await?;
    let (roles, state): (Vec<String>, String) = sqlx::query_as(
        "SELECT roles, state FROM forge_tenant_memberships WHERE tenant_id = $1 AND principal_id = $2",
    )
    .bind(tenant.into_uuid())
    .bind(principal.into_uuid())
    .fetch_one(&pool)
    .await?;
    assert_eq!(roles, vec![OWNER_ROLE.to_owned()]);
    let stored: String = sqlx::query_scalar("SELECT login FROM forge_principals")
        .fetch_one(&pool)
        .await?;
    assert_eq!(
        stored, "owner@example.com",
        "setup stores the canonical login"
    );
    assert_eq!(state, "active");
    let counts: (i64, i64, i64) = sqlx::query_as(
        "SELECT
            (SELECT count(*) FROM forge_tenants),
            (SELECT count(*) FROM forge_principals),
            (SELECT count(*) FROM forge_audit_events
              WHERE action = 'auth.setup.owner_provisioned' AND tenant_id = $1)",
    )
    .bind(tenant.into_uuid())
    .fetch_one(&pool)
    .await?;
    assert_eq!(counts, (1, 1, 1));
    database.cleanup().await?;
    Ok(())
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn concurrent_setups_create_exactly_one_tenant() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let password_hash = Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?;
    let mut runs = Vec::new();
    for index in 0..6 {
        let pool = pool.clone();
        let account = OwnerAccount {
            tenant: TenantSlug::new(format!("tenant-{index}"))?,
            organization: format!("Tenant {index}"),
            login: CanonicalLogin::parse(&format!("owner{index}@example.com"))?,
            password_hash: password_hash.clone(),
            now: now()?,
        };
        runs.push(tokio::spawn(async move {
            provision_owner(&pool, &account).await
        }));
    }
    let mut created = 0;
    for run in runs {
        match run.await? {
            Ok(_) => created += 1,
            Err(SetupError::AlreadyProvisioned) => {}
            Err(other) => return Err(other.into()),
        }
    }
    assert_eq!(created, 1);
    let tenants: i64 = sqlx::query_scalar("SELECT count(*) FROM forge_tenants")
        .fetch_one(&pool)
        .await?;
    let principals: i64 = sqlx::query_scalar("SELECT count(*) FROM forge_principals")
        .fetch_one(&pool)
        .await?;
    assert_eq!((tenants, principals), (1, 1));
    database.cleanup().await?;
    Ok(())
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn reset_tokens_work_once_expire_and_revoke_every_session() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let owner = provision_owner(
        &pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("owner@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?;
    let sessions = PostgresSessionStore::new(pool.clone());
    let later = UnixTimestamp::from_secs(now.as_secs() + 3_600);
    let first = issue_persisted_session(&sessions, owner.principal_id, now, later).await?;
    let second = issue_persisted_session(&sessions, owner.principal_id, now, later).await?;

    let resets = PgPasswordResetStore::new(pool.clone());
    let grant = |token: &PasswordResetToken, expires_at: u64| {
        PasswordResetGrant::new(
            owner.principal_id,
            owner.tenant_id,
            token.digest(),
            now,
            UnixTimestamp::from_secs(expires_at),
        )
    };
    let expired = PasswordResetToken::generate()?;
    resets.issue(&grant(&expired, now.as_secs() + 1)?).await?;
    let token = PasswordResetToken::generate()?;
    resets.issue(&grant(&token, now.as_secs() + 900)?).await?;
    let unrelated = PasswordResetToken::generate()?;
    let new_hash = Argon2idPasswordHasher.hash(b"a brand new secret").await?;

    let after_expiry = UnixTimestamp::from_secs(now.as_secs() + 2);
    assert!(resets.is_redeemable(&token.digest(), after_expiry).await?);
    assert!(
        !resets
            .is_redeemable(&expired.digest(), after_expiry)
            .await?
    );
    assert!(
        !resets
            .is_redeemable(&unrelated.digest(), after_expiry)
            .await?
    );
    assert_eq!(
        resets
            .redeem(&expired.digest(), after_expiry, &new_hash)
            .await?,
        None
    );
    assert_eq!(
        resets
            .redeem(&unrelated.digest(), after_expiry, &new_hash)
            .await?,
        None
    );
    let redeemed = resets
        .redeem(&token.digest(), after_expiry, &new_hash)
        .await?
        .ok_or("the token is redeemed")?;
    assert_eq!(redeemed.principal_id, owner.principal_id);
    assert_eq!(redeemed.tenant_id, owner.tenant_id);
    assert_eq!(
        resets
            .redeem(&token.digest(), after_expiry, &new_hash)
            .await?,
        None
    );
    assert!(!resets.is_redeemable(&token.digest(), after_expiry).await?);

    for issued in [first, second] {
        let session = sessions
            .find_by_credential(&issued.secrets.bearer_digest)
            .await?
            .ok_or("the session is kept as history")?;
        assert!(session.revoked_at().is_some(), "every session is revoked");
    }
    let credentials = PostgresPasswordCredentialStore::new(pool.clone());
    assert!(
        authenticate_password(
            &credentials,
            &Argon2idPasswordHasher,
            "owner@example.com",
            PASSWORD.as_bytes()
        )
        .await
        .is_err()
    );
    authenticate_password(
        &credentials,
        &Argon2idPasswordHasher,
        "owner@example.com",
        b"a brand new secret",
    )
    .await?;
    let stored: i64 = sqlx::query_scalar(
        "SELECT count(*) FROM forge_password_resets WHERE octet_length(token_digest) = 32 AND used_at IS NOT NULL",
    )
    .fetch_one(&pool)
    .await?;
    assert_eq!(
        stored, 2,
        "the redeemed and the outstanding token are used up"
    );
    database.cleanup().await?;
    Ok(())
}

/// Two-factor authentication over the PostgreSQL store, with `key`.
fn mfa(pool: &sqlx::PgPool, key: [u8; 32]) -> Result<MfaService, Box<dyn Error>> {
    Ok(MfaService::new(
        Arc::new(PgMfaStore::new(pool.clone())),
        Some(Arc::new(Aes256GcmSecretCipher::new(&key)?)),
        Arc::new(MemoryLoginThrottle::new(mfa_throttle_config())?),
    ))
}

fn after(now: UnixTimestamp, seconds: u64) -> UnixTimestamp {
    UnixTimestamp::from_secs(now.as_secs() + seconds)
}

fn binding() -> MfaChallengeBinding {
    MfaChallengeBinding::from_bytes([1; 32])
}

fn source() -> Option<IpAddr> {
    Some(IpAddr::V4(Ipv4Addr::LOCALHOST))
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn two_factor_codes_and_challenges_work_once_and_fail_closed() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let owner = provision_owner(
        &pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("owner@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?;
    let principal = owner.principal_id;
    let service = mfa(&pool, [7; 32])?;
    let sessions = PostgresSessionStore::new(pool.clone());
    let before = issue_persisted_session(&sessions, principal, now, after(now, 3_600)).await?;

    // Enrollment: pending until confirmed, then a factor with ten codes.
    let enrollment = service
        .begin(
            principal,
            MfaChange::Enrollment,
            "shop",
            "owner@example.com",
            now,
        )
        .await?;
    assert_eq!(service.status(principal).await?, None);
    let codes = service
        .confirm(
            principal,
            MfaChange::Enrollment,
            &enrollment.secret.code_at(now),
            now,
        )
        .await?;
    assert_eq!(
        service
            .status(principal)
            .await?
            .map(|status| status.remaining_backup_codes),
        Some(10)
    );
    let session = sessions
        .find_by_credential(&before.secrets.bearer_digest)
        .await?
        .ok_or("kept as history")?;
    assert!(
        session.revoked_at().is_some(),
        "enrolling signs out everywhere"
    );
    // Only ciphertext and digests are stored.
    let stored: Vec<u8> = sqlx::query_scalar("SELECT secret_ciphertext FROM forge_totp_factors")
        .fetch_one(&pool)
        .await?;
    assert_eq!(stored.len(), 12 + 20 + 16, "nonce, sealed seed and tag");
    assert!(
        !String::from_utf8_lossy(&stored).contains(&enrollment.secret.base32()),
        "never the seed in clear"
    );

    let credentials = PostgresPasswordCredentialStore::new(pool.clone());
    let verified = verify_password(
        &credentials,
        &Argon2idPasswordHasher,
        "owner@example.com",
        PASSWORD.as_bytes(),
    )
    .await?;
    let challenge = |at: UnixTimestamp| {
        let service = service.clone();
        async move {
            service
                .issue_challenge(
                    principal,
                    owner.tenant_id,
                    verified.version,
                    binding(),
                    after(at, 3_600),
                    at,
                )
                .await
        }
    };

    // The confirmation's period is used up; the next one signs in, once,
    // even when two requests race.
    let first = challenge(now).await?;
    let replay = service
        .complete(
            first.token.expose(),
            &binding(),
            &enrollment.secret.code_at(now),
            source(),
            now,
        )
        .await;
    assert_eq!(
        replay.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );
    let next = after(now, 30);
    let code = enrollment.secret.code_at(next);
    let bound = binding();
    let (one, two) = tokio::join!(
        service.complete(first.token.expose(), &bound, &code, source(), next),
        service.complete(first.token.expose(), &bound, &code, source(), next),
    );
    assert_eq!(
        usize::from(one.is_ok()) + usize::from(two.is_ok()),
        1,
        "{one:?} {two:?}"
    );
    let second = challenge(next).await?;
    let replayed = service
        .complete(second.token.expose(), &binding(), &code, source(), next)
        .await;
    assert_eq!(
        replayed.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );
    // Another browser session's binding.
    let foreign = service
        .complete(
            second.token.expose(),
            &MfaChallengeBinding::from_bytes([2; 32]),
            &enrollment.secret.code_at(after(now, 60)),
            source(),
            after(now, 60),
        )
        .await;
    assert_eq!(
        foreign.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );
    // Expired.
    let late = after(next, forge::tenancy::MFA_CHALLENGE_LIFETIME_SECS);
    let expired = service
        .complete(
            second.token.expose(),
            &binding(),
            &enrollment.secret.code_at(late),
            source(),
            late,
        )
        .await;
    assert_eq!(
        expired.err().map(|rejection| rejection.error),
        Some(MfaError::ChallengeExpired)
    );

    // A backup code works once.
    let third = challenge(after(now, 60)).await?;
    let signed_in = service
        .complete(
            third.token.expose(),
            &binding(),
            codes[0].expose(),
            source(),
            after(now, 60),
        )
        .await
        .map_err(|rejection| rejection.error)?;
    assert_eq!(signed_in.tenant_id, owner.tenant_id);
    let fourth = challenge(after(now, 60)).await?;
    let reused = service
        .complete(
            fourth.token.expose(),
            &binding(),
            codes[0].expose(),
            source(),
            after(now, 60),
        )
        .await;
    assert_eq!(
        reused.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );

    // A password change voids the pending challenge.
    sqlx::query("UPDATE forge_principals SET version = version + 1 WHERE id = $1")
        .bind(principal.into_uuid())
        .execute(&pool)
        .await?;
    let stale = service
        .complete(
            fourth.token.expose(),
            &binding(),
            &enrollment.secret.code_at(after(now, 90)),
            source(),
            after(now, 90),
        )
        .await;
    assert_eq!(
        stale.err().map(|rejection| rejection.error),
        Some(MfaError::ChallengeExpired)
    );
    assert_eq!(
        challenge(after(now, 90)).await.err(),
        Some(MfaError::NotEnabled)
    );

    // A wrong key and a tampered seed fail closed.
    let wrong_key = mfa(&pool, [8; 32])?;
    assert_eq!(
        wrong_key
            .verify_second_factor(
                principal,
                &enrollment.secret.code_at(after(now, 120)),
                after(now, 120)
            )
            .await,
        Err(MfaError::Mechanism)
    );
    sqlx::query(
        "UPDATE forge_totp_factors
         SET secret_ciphertext = set_byte(secret_ciphertext, 20, get_byte(secret_ciphertext, 20) # 1)",
    )
    .execute(&pool)
    .await?;
    assert_eq!(
        service
            .verify_second_factor(
                principal,
                &enrollment.secret.code_at(after(now, 120)),
                after(now, 120)
            )
            .await,
        Err(MfaError::Mechanism)
    );

    // Disabling removes the factor and its codes and signs out everywhere.
    let last = issue_persisted_session(&sessions, principal, now, after(now, 3_600)).await?;
    service.disable(principal, after(now, 150)).await?;
    assert_eq!(service.status(principal).await?, None);
    let remaining: i64 = sqlx::query_scalar("SELECT count(*) FROM forge_mfa_backup_codes")
        .fetch_one(&pool)
        .await?;
    assert_eq!(remaining, 0);
    let session = sessions
        .find_by_credential(&last.secrets.bearer_digest)
        .await?
        .ok_or("kept as history")?;
    assert!(session.revoked_at().is_some());
    database.cleanup().await?;
    Ok(())
}
