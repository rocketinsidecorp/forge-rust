const PASSWORD: &str = "correct horse battery";

fn now() -> Result<UnixTimestamp, Box<dyn Error>> {
    Ok(UnixTimestamp::from_secs(
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)?
            .as_secs(),
    ))
}

fn setup_arguments<'a>(tenant: &'a str, email: &'a str) -> [&'a str; 5] {
    ["--tenant", tenant, "--email", email, "--password-stdin"]
}

#[tokio::test]
async fn setup_refuses_password_arguments_and_short_passwords_before_touching_a_database()
-> TestResult {
    let argument = setup::run(CommandContext::for_testing(&[
        "--tenant",
        "acme",
        "--email",
        "owner@example.com",
        "--password",
        "hunter2hunter2",
    ]))
    .await
    .err()
    .ok_or("a password argument is refused")?;
    assert!(argument.to_string().contains("never accepted as arguments"));
    assert!(!argument.to_string().contains("hunter2"));

    let short = setup::run(
        CommandContext::for_testing(&setup_arguments("acme", "owner@example.com"))
            .with_stdin("too short\n"),
    )
    .await
    .err()
    .ok_or("a short password is refused")?;
    assert!(short.to_string().contains("at least 12 characters"));

    let unattended = setup::run(CommandContext::for_testing(&[
        "--tenant",
        "acme",
        "--email",
        "owner@example.com",
    ]))
    .await
    .err()
    .ok_or("no password source is refused")?;
    assert!(unattended.to_string().contains("--password-stdin"));
    Ok(())
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn setup_creates_one_owner_who_can_sign_in_and_refuses_afterwards() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let run = |tenant: &'static str, email: &'static str| {
        setup::run(
            CommandContext::for_testing(&setup_arguments(tenant, email))
                .with_stdin(&format!("{PASSWORD}\n"))
                .with_postgres(database.database().clone()),
        )
    };

    run("acme", "Owner@Example.com").await?;
    let again = run("acme", "owner@example.com")
        .await
        .err()
        .ok_or("refused")?;
    assert!(again.to_string().contains("already set up"), "{again}");
    let other = run("globex", "other@example.com")
        .await
        .err()
        .ok_or("refused")?;
    assert!(other.to_string().contains("already set up"), "{other}");

    let tenant = PgTenantDirectory::new(pool.clone())
        .find_by_slug(&TenantSlug::new("acme")?)
        .await?
        .ok_or("the tenant exists")?;
    let principal = authenticate_password(
        &PostgresPasswordCredentialStore::new(pool.clone()),
        &Argon2idPasswordHasher,
        "owner@example.com",
        PASSWORD.as_bytes(),
    )
    .await?;
    let (roles, state): (Vec<String>, String) = sqlx::query_as(
        "SELECT roles, state FROM forge_tenant_memberships WHERE tenant_id = $1 AND principal_id = $2",
    )
    .bind(tenant.into_uuid())
    .bind(principal.into_uuid())
    .fetch_one(&pool)
    .await?;
    assert_eq!(roles, vec![OWNER_ROLE.to_owned()]);
    let stored: String = sqlx::query_scalar("SELECT login FROM forge_principals")
        .fetch_one(&pool)
        .await?;
    assert_eq!(
        stored, "owner@example.com",
        "setup stores the canonical login"
    );
    assert_eq!(state, "active");
    let counts: (i64, i64, i64) = sqlx::query_as(
        "SELECT
            (SELECT count(*) FROM forge_tenants),
            (SELECT count(*) FROM forge_principals),
            (SELECT count(*) FROM forge_audit_events
              WHERE action = 'auth.setup.owner_provisioned' AND tenant_id = $1)",
    )
    .bind(tenant.into_uuid())
    .fetch_one(&pool)
    .await?;
    assert_eq!(counts, (1, 1, 1));
    database.cleanup().await?;
    Ok(())
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn concurrent_setups_create_exactly_one_tenant() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let password_hash = Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?;
    let mut runs = Vec::new();
    for index in 0..6 {
        let pool = pool.clone();
        let account = OwnerAccount {
            tenant: TenantSlug::new(format!("tenant-{index}"))?,
            organization: format!("Tenant {index}"),
            login: CanonicalLogin::parse(&format!("owner{index}@example.com"))?,
            password_hash: password_hash.clone(),
            now: now()?,
        };
        runs.push(tokio::spawn(async move {
            provision_owner(&pool, &account).await
        }));
    }
    let mut created = 0;
    for run in runs {
        match run.await? {
            Ok(_) => created += 1,
            Err(SetupError::AlreadyProvisioned) => {}
            Err(other) => return Err(other.into()),
        }
    }
    assert_eq!(created, 1);
    let tenants: i64 = sqlx::query_scalar("SELECT count(*) FROM forge_tenants")
        .fetch_one(&pool)
        .await?;
    let principals: i64 = sqlx::query_scalar("SELECT count(*) FROM forge_principals")
        .fetch_one(&pool)
        .await?;
    assert_eq!((tenants, principals), (1, 1));
    database.cleanup().await?;
    Ok(())
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn reset_tokens_work_once_expire_and_revoke_every_session() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let owner = provision_owner(
        &pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("owner@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?;
    let sessions = PostgresSessionStore::new(pool.clone());
    let later = UnixTimestamp::from_secs(now.as_secs() + 3_600);
    let first = issue_persisted_session(&sessions, owner.principal_id, now, later).await?;
    let second = issue_persisted_session(&sessions, owner.principal_id, now, later).await?;

    let resets = PgPasswordResetStore::new(pool.clone());
    let grant = |token: &PasswordResetToken, expires_at: u64| {
        PasswordResetGrant::new(
            owner.principal_id,
            owner.tenant_id,
            token.digest(),
            now,
            UnixTimestamp::from_secs(expires_at),
        )
    };
    let expired = PasswordResetToken::generate()?;
    resets.issue(&grant(&expired, now.as_secs() + 1)?).await?;
    let token = PasswordResetToken::generate()?;
    resets.issue(&grant(&token, now.as_secs() + 900)?).await?;
    let unrelated = PasswordResetToken::generate()?;
    let new_hash = Argon2idPasswordHasher.hash(b"a brand new secret").await?;

    let after_expiry = UnixTimestamp::from_secs(now.as_secs() + 2);
    assert!(resets.is_redeemable(&token.digest(), after_expiry).await?);
    assert!(
        !resets
            .is_redeemable(&expired.digest(), after_expiry)
            .await?
    );
    assert!(
        !resets
            .is_redeemable(&unrelated.digest(), after_expiry)
            .await?
    );
    assert_eq!(
        resets
            .redeem(&expired.digest(), after_expiry, &new_hash)
            .await?,
        None
    );
    assert_eq!(
        resets
            .redeem(&unrelated.digest(), after_expiry, &new_hash)
            .await?,
        None
    );
    let redeemed = resets
        .redeem(&token.digest(), after_expiry, &new_hash)
        .await?
        .ok_or("the token is redeemed")?;
    assert_eq!(redeemed.principal_id, owner.principal_id);
    assert_eq!(redeemed.tenant_id, owner.tenant_id);
    assert_eq!(
        resets
            .redeem(&token.digest(), after_expiry, &new_hash)
            .await?,
        None
    );
    assert!(!resets.is_redeemable(&token.digest(), after_expiry).await?);

    for issued in [first, second] {
        let session = sessions
            .find_by_credential(&issued.secrets.bearer_digest)
            .await?
            .ok_or("the session is kept as history")?;
        assert!(session.revoked_at().is_some(), "every session is revoked");
    }
    let credentials = PostgresPasswordCredentialStore::new(pool.clone());
    assert!(
        authenticate_password(
            &credentials,
            &Argon2idPasswordHasher,
            "owner@example.com",
            PASSWORD.as_bytes()
        )
        .await
        .is_err()
    );
    authenticate_password(
        &credentials,
        &Argon2idPasswordHasher,
        "owner@example.com",
        b"a brand new secret",
    )
    .await?;
    let stored: i64 = sqlx::query_scalar(
        "SELECT count(*) FROM forge_password_resets WHERE octet_length(token_digest) = 32 AND used_at IS NOT NULL",
    )
    .fetch_one(&pool)
    .await?;
    assert_eq!(
        stored, 2,
        "the redeemed and the outstanding token are used up"
    );
    database.cleanup().await?;
    Ok(())
}

/// Two-factor authentication over the PostgreSQL store, with `key`.
fn mfa(pool: &sqlx::PgPool, key: [u8; 32]) -> Result<MfaService, Box<dyn Error>> {
    Ok(MfaService::new(
        Arc::new(PgMfaStore::new(pool.clone())),
        Some(Arc::new(Aes256GcmSecretCipher::new(&key)?)),
        Arc::new(MemoryLoginThrottle::new(mfa_throttle_config())?),
    ))
}

fn after(now: UnixTimestamp, seconds: u64) -> UnixTimestamp {
    UnixTimestamp::from_secs(now.as_secs() + seconds)
}

fn binding() -> MfaChallengeBinding {
    MfaChallengeBinding::from_bytes([1; 32])
}

fn source() -> Option<IpAddr> {
    Some(IpAddr::V4(Ipv4Addr::LOCALHOST))
}

#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn two_factor_codes_and_challenges_work_once_and_fail_closed() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let owner = provision_owner(
        &pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("owner@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?;
    let principal = owner.principal_id;
    let service = mfa(&pool, [7; 32])?;
    let sessions = PostgresSessionStore::new(pool.clone());
    let before = issue_persisted_session(&sessions, principal, now, after(now, 3_600)).await?;

    // Enrollment: pending until confirmed, then a factor with ten codes.
    let enrollment = service
        .begin(
            principal,
            MfaChangeRequest::Enrollment,
            "shop",
            "owner@example.com",
            now,
        )
        .await?;
    assert_eq!(service.status(principal).await?, None);
    let codes = service
        .confirm(
            principal,
            MfaChangeRequest::Enrollment,
            &enrollment.secret.code_at(now),
            now,
        )
        .await?;
    assert_eq!(
        service
            .status(principal)
            .await?
            .map(|status| status.remaining_backup_codes),
        Some(10)
    );
    let session = sessions
        .find_by_credential(&before.secrets.bearer_digest)
        .await?
        .ok_or("kept as history")?;
    assert!(
        session.revoked_at().is_some(),
        "enrolling signs out everywhere"
    );
    // Only ciphertext and digests are stored.
    let stored: Vec<u8> = sqlx::query_scalar("SELECT secret_ciphertext FROM forge_totp_factors")
        .fetch_one(&pool)
        .await?;
    assert_eq!(stored.len(), 12 + 20 + 16, "nonce, sealed seed and tag");
    assert!(
        !String::from_utf8_lossy(&stored).contains(&enrollment.secret.base32()),
        "never the seed in clear"
    );

    let credentials = PostgresPasswordCredentialStore::new(pool.clone());
    let verified = verify_password(
        &credentials,
        &Argon2idPasswordHasher,
        "owner@example.com",
        PASSWORD.as_bytes(),
    )
    .await?;
    let challenge = |at: UnixTimestamp| {
        let service = service.clone();
        async move {
            service
                .issue_challenge(
                    principal,
                    owner.tenant_id,
                    verified.version,
                    binding(),
                    after(at, 3_600),
                    at,
                )
                .await
        }
    };

    // The confirmation's period is used up; the next one signs in, once,
    // even when two requests race.
    let first = challenge(now).await?;
    let replay = service
        .complete(
            first.token.expose(),
            &binding(),
            &enrollment.secret.code_at(now),
            source(),
            now,
        )
        .await;
    assert_eq!(
        replay.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );
    let next = after(now, 30);
    let code = enrollment.secret.code_at(next);
    let bound = binding();
    let (one, two) = tokio::join!(
        service.complete(first.token.expose(), &bound, &code, source(), next),
        service.complete(first.token.expose(), &bound, &code, source(), next),
    );
    assert_eq!(
        usize::from(one.is_ok()) + usize::from(two.is_ok()),
        1,
        "{one:?} {two:?}"
    );
    let second = challenge(next).await?;
    let replayed = service
        .complete(second.token.expose(), &binding(), &code, source(), next)
        .await;
    assert_eq!(
        replayed.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );
    // Another browser session's binding.
    let foreign = service
        .complete(
            second.token.expose(),
            &MfaChallengeBinding::from_bytes([2; 32]),
            &enrollment.secret.code_at(after(now, 60)),
            source(),
            after(now, 60),
        )
        .await;
    assert_eq!(
        foreign.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );
    // Expired.
    let late = after(next, forge::tenancy::MFA_CHALLENGE_LIFETIME_SECS);
    let expired = service
        .complete(
            second.token.expose(),
            &binding(),
            &enrollment.secret.code_at(late),
            source(),
            late,
        )
        .await;
    assert_eq!(
        expired.err().map(|rejection| rejection.error),
        Some(MfaError::ChallengeExpired)
    );

    // A backup code works once.
    let third = challenge(after(now, 60)).await?;
    let signed_in = service
        .complete(
            third.token.expose(),
            &binding(),
            codes[0].expose(),
            source(),
            after(now, 60),
        )
        .await
        .map_err(|rejection| rejection.error)?;
    assert_eq!(signed_in.tenant_id, owner.tenant_id);
    let fourth = challenge(after(now, 60)).await?;
    let reused = service
        .complete(
            fourth.token.expose(),
            &binding(),
            codes[0].expose(),
            source(),
            after(now, 60),
        )
        .await;
    assert_eq!(
        reused.err().map(|rejection| rejection.error),
        Some(MfaError::InvalidCode)
    );

    // A password change voids the pending challenge.
    sqlx::query("UPDATE forge_principals SET version = version + 1 WHERE id = $1")
        .bind(principal.into_uuid())
        .execute(&pool)
        .await?;
    let stale = service
        .complete(
            fourth.token.expose(),
            &binding(),
            &enrollment.secret.code_at(after(now, 90)),
            source(),
            after(now, 90),
        )
        .await;
    assert_eq!(
        stale.err().map(|rejection| rejection.error),
        Some(MfaError::ChallengeExpired)
    );
    assert_eq!(
        challenge(after(now, 90)).await.err(),
        Some(MfaError::NotEnabled)
    );

    // A wrong key and a tampered seed fail closed.
    let wrong_key = mfa(&pool, [8; 32])?;
    assert_eq!(
        wrong_key
            .verify_second_factor(
                principal,
                &enrollment.secret.code_at(after(now, 120)),
                after(now, 120)
            )
            .await,
        Err(MfaError::Mechanism)
    );
    sqlx::query(
        "UPDATE forge_totp_factors
         SET secret_ciphertext = set_byte(secret_ciphertext, 20, get_byte(secret_ciphertext, 20) # 1)",
    )
    .execute(&pool)
    .await?;
    assert_eq!(
        service
            .verify_second_factor(
                principal,
                &enrollment.secret.code_at(after(now, 120)),
                after(now, 120)
            )
            .await,
        Err(MfaError::Mechanism)
    );

    // Disabling removes the factor and its codes and signs out everywhere.
    let last = issue_persisted_session(&sessions, principal, now, after(now, 3_600)).await?;
    let proof = service
        .verify_step_up(principal, codes[1].expose(), after(now, 150))
        .await?;
    service.disable(principal, &proof, after(now, 150)).await?;
    assert_eq!(service.status(principal).await?, None);
    let remaining: i64 = sqlx::query_scalar("SELECT count(*) FROM forge_mfa_backup_codes")
        .fetch_one(&pool)
        .await?;
    assert_eq!(remaining, 0);
    let session = sessions
        .find_by_credential(&last.secrets.bearer_digest)
        .await?
        .ok_or("kept as history")?;
    assert!(session.revoked_at().is_some());
    database.cleanup().await?;
    Ok(())
}

/// Waits until a statement in this test's database waits for a lock.
async fn until_a_statement_waits(pool: &sqlx::PgPool) -> TestResult {
    for _ in 0..1_000 {
        let waiting: i64 = sqlx::query_scalar(
            "SELECT count(*)
             FROM pg_locks AS waiting
             JOIN pg_stat_activity AS activity ON activity.pid = waiting.pid
             WHERE NOT waiting.granted
               AND activity.datname = current_database()",
        )
        .fetch_one(pool)
        .await?;
        if waiting > 0 {
            return Ok(());
        }
        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
    }
    Err("no statement waited for the account lock".into())
}

/// Installs a factor for `principal` the way an enrollment confirmation does
/// (the account row locked, then the factor and its sessions), leaving the
/// transaction open.
async fn install_factor_uncommitted(
    pool: &sqlx::PgPool,
    principal: forge::security::PrincipalId,
    now: UnixTimestamp,
) -> Result<sqlx::Transaction<'static, sqlx::Postgres>, Box<dyn Error>> {
    let mut installation = pool.begin().await?;
    sqlx::query("SELECT 1 FROM forge_principals WHERE id = $1 FOR UPDATE")
        .bind(principal.into_uuid())
        .execute(&mut *installation)
        .await?;
    sqlx::query(
        "INSERT INTO forge_totp_factors (principal_id, secret_digest, secret_ciphertext)
         VALUES ($1, $2, $3)",
    )
    .bind(principal.into_uuid())
    .bind([9_u8; 32].as_slice())
    .bind([9_u8; 48].as_slice())
    .execute(&mut *installation)
    .await?;
    sqlx::query(
        "UPDATE forge_sessions SET revoked_at = to_timestamp($2::double precision)
         WHERE principal_id = $1 AND revoked_at IS NULL",
    )
    .bind(principal.into_uuid())
    .bind(i64::try_from(now.as_secs())?)
    .execute(&mut *installation)
    .await?;
    Ok(installation)
}

/// The pending seed of a rotation sits where an enrollment's does: the store
/// refuses to confirm it as an enrollment, leaving the factor, its backup
/// codes, the pending rotation and the sessions untouched. A factor change
/// that waited for the account lock sees a factor installed meanwhile, and a
/// password sign-in's session insert waits for that lock too, so the
/// sign-in's second look at the factor sees it.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn factor_changes_are_refused_under_the_account_lock() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let principal = provision_owner(
        &pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("owner@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?
    .principal_id;
    let store = PgMfaStore::new(pool.clone());
    let service = mfa(&pool, [7; 32])?;
    let sessions = PostgresSessionStore::new(pool.clone());

    // An enrollment confirmation of an account with a factor.
    let enrollment = service
        .begin(
            principal,
            MfaChangeRequest::Enrollment,
            "shop",
            "owner@example.com",
            now,
        )
        .await?;
    let codes = service
        .confirm(
            principal,
            MfaChangeRequest::Enrollment,
            &enrollment.secret.code_at(now),
            now,
        )
        .await?;
    let session = issue_persisted_session(&sessions, principal, now, after(now, 3_600)).await?;
    let proof = service
        .verify_step_up(principal, codes[1].expose(), now)
        .await?;
    let rotation = service
        .begin(
            principal,
            MfaChangeRequest::Rotation(&proof),
            "shop",
            "owner@example.com",
            now,
        )
        .await?;
    let (_, digests) = MfaBackupCode::generate_set(10)?;
    assert!(
        !store
            .activate(
                principal,
                MfaChange::Enrollment,
                &rotation.secret.digest(),
                1,
                &digests,
                None,
                now
            )
            .await?,
        "the store refuses an enrollment of an account with a factor"
    );
    assert_eq!(
        service
            .confirm(
                principal,
                MfaChangeRequest::Enrollment,
                &rotation.secret.code_at(now),
                now
            )
            .await
            .err(),
        Some(MfaError::AlreadyEnabled)
    );
    let factor: Vec<u8> =
        sqlx::query_scalar("SELECT secret_digest FROM forge_totp_factors WHERE principal_id = $1")
            .bind(principal.into_uuid())
            .fetch_one(&pool)
            .await?;
    assert_eq!(factor, enrollment.secret.digest().as_bytes().to_vec());
    let pending: i64 = sqlx::query_scalar(
        "SELECT count(*) FROM forge_totp_enrollments WHERE principal_id = $1 AND secret_digest = $2",
    )
    .bind(principal.into_uuid())
    .bind(rotation.secret.digest().as_bytes().as_slice())
    .fetch_one(&pool)
    .await?;
    assert_eq!(pending, 1, "the pending rotation is untouched");
    let unused: i64 = sqlx::query_scalar(
        "SELECT count(*) FROM forge_mfa_backup_codes WHERE principal_id = $1 AND consumed_at IS NULL",
    )
    .bind(principal.into_uuid())
    .fetch_one(&pool)
    .await?;
    assert_eq!(
        unused, 9,
        "the backup codes are untouched but the rotation's step-up code"
    );
    let live = sessions
        .find_by_credential(&session.secrets.bearer_digest)
        .await?
        .ok_or("session")?;
    assert!(live.revoked_at().is_none(), "no session was revoked");
    // The pending rotation is still confirmed as a rotation.
    let later = after(now, 30);
    let proof = service
        .verify_step_up(principal, codes[2].expose(), later)
        .await?;
    let rotated = service
        .confirm(
            principal,
            MfaChangeRequest::Rotation(&proof),
            &rotation.secret.code_at(later),
            later,
        )
        .await?;
    assert!(
        service
            .verify_second_factor(principal, codes[0].expose(), later)
            .await
            .is_err(),
        "the rotation replaced the backup codes"
    );
    let proof = service
        .verify_step_up(principal, rotated[0].expose(), later)
        .await?;
    service.disable(principal, &proof, later).await?;

    // An enrollment that waited for the account lock while a factor was
    // being installed sees that factor.
    let installation = install_factor_uncommitted(&pool, principal, now).await?;
    let (begun, committed) = tokio::join!(
        service.begin(
            principal,
            MfaChangeRequest::Enrollment,
            "shop",
            "owner@example.com",
            now
        ),
        async {
            until_a_statement_waits(&pool).await?;
            installation.commit().await?;
            TestResult::Ok(())
        },
    );
    committed?;
    assert_eq!(begun.err(), Some(MfaError::AlreadyEnabled));
    sqlx::query("DELETE FROM forge_totp_factors WHERE principal_id = $1")
        .bind(principal.into_uuid())
        .execute(&pool)
        .await?;

    // A password sign-in's session insert waits for the same lock, so its
    // second look at the factor sees one installed meanwhile.
    assert_eq!(service.status(principal).await?, None);
    let installation = install_factor_uncommitted(&pool, principal, now).await?;
    let (issued, committed) = tokio::join!(
        issue_persisted_session(&sessions, principal, now, after(now, 3_600)),
        async {
            until_a_statement_waits(&pool).await?;
            installation.commit().await?;
            TestResult::Ok(())
        },
    );
    committed?;
    issued?;
    assert!(
        service.status(principal).await?.is_some(),
        "the factor is visible once the session is stored"
    );
    database.cleanup().await?;
    Ok(())
}

/// A provisioned owner with a confirmed factor: the owner, the tenant, the
/// seed and the backup codes.
struct Enrolled {
    principal: forge::security::PrincipalId,
    tenant: forge::tenancy::TenantId,
    secret: forge::auth::TotpSecret,
    codes: Vec<MfaBackupCode>,
}

async fn enrolled_owner(
    pool: &sqlx::PgPool,
    service: &MfaService,
    now: UnixTimestamp,
) -> Result<Enrolled, Box<dyn Error>> {
    let owner = provision_owner(
        pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("owner@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?;
    let principal = owner.principal_id;
    let enrollment = service
        .begin(
            principal,
            MfaChangeRequest::Enrollment,
            "shop",
            "owner@example.com",
            now,
        )
        .await?;
    let codes = service
        .confirm(
            principal,
            MfaChangeRequest::Enrollment,
            &enrollment.secret.code_at(now),
            now,
        )
        .await?;
    Ok(Enrolled {
        principal,
        tenant: owner.tenant_id,
        secret: enrollment.secret,
        codes,
    })
}

/// What a factor change does once it holds the account row, done by hand
/// while a sign-in step waits for that row: the rows the step would need are
/// taken `NOWAIT`, which fails (`55P03`) if the waiting step held any of
/// them, then the factor and its backup codes are removed and the
/// challenges voided, as `disable` does.
async fn disable_while_waiting(
    pool: &sqlx::PgPool,
    mut holder: sqlx::Transaction<'static, sqlx::Postgres>,
    principal: forge::security::PrincipalId,
) -> TestResult {
    until_a_statement_waits(pool).await?;
    for statement in [
        "SELECT 1 FROM forge_totp_factors WHERE principal_id = $1 FOR UPDATE NOWAIT",
        "SELECT 1 FROM forge_mfa_backup_codes WHERE principal_id = $1 FOR UPDATE NOWAIT",
        "SELECT 1 FROM forge_mfa_challenges WHERE principal_id = $1 FOR UPDATE NOWAIT",
        "DELETE FROM forge_mfa_backup_codes WHERE principal_id = $1",
        "DELETE FROM forge_totp_factors WHERE principal_id = $1",
        "UPDATE forge_mfa_challenges SET consumed_at = clock_timestamp()
         WHERE principal_id = $1 AND consumed_at IS NULL",
    ] {
        sqlx::query(statement)
            .bind(principal.into_uuid())
            .execute(&mut *holder)
            .await
            .map_err(|error| format!("{statement}: {error}"))?;
    }
    holder.commit().await?;
    Ok(())
}

/// Locks the account row as a factor change does (`FOR UPDATE`), leaving
/// the transaction open.
async fn lock_account_row(
    pool: &sqlx::PgPool,
    principal: forge::security::PrincipalId,
) -> Result<sqlx::Transaction<'static, sqlx::Postgres>, Box<dyn Error>> {
    let mut holder = pool.begin().await?;
    sqlx::query("SELECT 1 FROM forge_principals WHERE id = $1 FOR UPDATE")
        .bind(principal.into_uuid())
        .execute(&mut *holder)
        .await?;
    Ok(holder)
}

/// Issuing and completing a sign-in challenge lock the account row before
/// any MFA row (the store's lock order). A sign-in step that runs while a
/// factor change holds the account row therefore waits holding nothing: the
/// change takes the factor, the backup codes and the challenges without
/// waiting and commits, and the step then refuses cleanly instead of
/// deadlocking (`40P01`, a `503`). Before, issuing locked the factor first
/// and completing locked the challenge first, then waited for rows the
/// change held.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn sign_in_steps_lock_the_account_before_any_mfa_row() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let service = mfa(&pool, [7; 32])?;
    let store = PgMfaStore::new(pool.clone());
    let owner = enrolled_owner(&pool, &service, now).await?;
    let principal = owner.principal;
    let credentials = PostgresPasswordCredentialStore::new(pool.clone());
    let verified = verify_password(
        &credentials,
        &Argon2idPasswordHasher,
        "owner@example.com",
        PASSWORD.as_bytes(),
    )
    .await?;
    let grant = || -> Result<MfaChallengeGrant, Box<dyn Error>> {
        Ok(MfaChallengeGrant {
            digest: MfaChallengeToken::generate()?.digest(),
            principal_id: principal,
            tenant_id: owner.tenant,
            credential_version: verified.version,
            binding: binding(),
            expires_at: after(now, 300),
            session_expires_at: after(now, 3_600),
        })
    };
    let reenroll = || async {
        let enrollment = service
            .begin(
                principal,
                MfaChangeRequest::Enrollment,
                "shop",
                "owner@example.com",
                now,
            )
            .await?;
        let codes = service
            .confirm(
                principal,
                MfaChangeRequest::Enrollment,
                &enrollment.secret.code_at(now),
                now,
            )
            .await?;
        Result::<_, Box<dyn Error>>::Ok((enrollment.secret, codes))
    };

    // Issuing a challenge while the factor is being disabled.
    let holder = lock_account_row(&pool, principal).await?;
    let pending = grant()?;
    let (issued, disabled) = tokio::join!(
        store.create_challenge(&pending),
        disable_while_waiting(&pool, holder, principal),
    );
    disabled?;
    assert!(
        !issued?,
        "the challenge waited for the change and saw no factor"
    );

    // Completing a challenge with a code while the factor is being disabled.
    let (secret, _) = reenroll().await?;
    let live = grant()?;
    assert!(store.create_challenge(&live).await?);
    let later = after(now, 30);
    let counter = forge::auth::TotpSecret::counter_at(later);
    let factor = secret.digest();
    let holder = lock_account_row(&pool, principal).await?;
    let (consumed, disabled) = tokio::join!(
        store.consume_challenge_with_totp(&live.digest, &factor, counter, later),
        disable_while_waiting(&pool, holder, principal),
    );
    disabled?;
    assert!(!consumed?, "the challenge died with the factor");

    // Completing a challenge with a backup code while the factor is being
    // disabled.
    let (_, codes) = reenroll().await?;
    let live = grant()?;
    assert!(store.create_challenge(&live).await?);
    let backup = MfaBackupCode::parse(codes[0].expose()).ok_or("backup code")?;
    let holder = lock_account_row(&pool, principal).await?;
    let (consumed, disabled) = tokio::join!(
        store.consume_challenge_with_backup_code(&live.digest, &backup, later),
        disable_while_waiting(&pool, holder, principal),
    );
    disabled?;
    assert!(!consumed?, "the challenge died with the factor");

    // The real operations racing each other end without an error.
    for _ in 0..5 {
        let (secret, codes) = reenroll().await?;
        let live = grant()?;
        assert!(store.create_challenge(&live).await?);
        let next = grant()?;
        let proof = service
            .verify_step_up(principal, codes[0].expose(), later)
            .await?;
        let factor = secret.digest();
        let (issued, consumed, disabled) = tokio::join!(
            store.create_challenge(&next),
            store.consume_challenge_with_totp(
                &live.digest,
                &factor,
                forge::auth::TotpSecret::counter_at(later),
                later,
            ),
            service.disable(principal, &proof, later),
        );
        issued?;
        consumed?;
        disabled?;
    }
    database.cleanup().await?;
    Ok(())
}

/// A step-up backup code is used up in the transaction of the change it
/// authorizes: a change that fails keeps it, and a code used meanwhile
/// refuses the change, which then changes nothing. The pending seed of a
/// rotation is never read as an enrollment's.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn step_up_backup_codes_are_used_up_only_by_a_change_that_commits() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let service = mfa(&pool, [7; 32])?;
    let store = PgMfaStore::new(pool.clone());
    let Enrolled {
        principal,
        secret,
        codes,
        ..
    } = enrolled_owner(&pool, &service, now).await?;
    let unused = || async {
        Result::<_, Box<dyn Error>>::Ok(
            service
                .status(principal)
                .await?
                .map(|status| status.remaining_backup_codes),
        )
    };

    let proof = service
        .verify_step_up(principal, codes[0].expose(), now)
        .await?;
    assert_eq!(unused().await?, Some(10), "checking uses nothing up");
    let rotation = service
        .begin(
            principal,
            MfaChangeRequest::Rotation(&proof),
            "shop",
            "owner@example.com",
            now,
        )
        .await?;
    assert_eq!(unused().await?, Some(9), "the rotation used the code up");
    assert!(
        store
            .pending(principal, MfaChange::Enrollment, now)
            .await?
            .is_none(),
        "a rotation's seed is not an enrollment's"
    );
    assert!(
        store
            .pending(principal, MfaChange::Rotation, now)
            .await?
            .is_some()
    );

    // A wrong code of the new key keeps the step-up code.
    let proof = service
        .verify_step_up(principal, codes[1].expose(), now)
        .await?;
    let wrong = if rotation.secret.code_at(now) == "000000" {
        "111111"
    } else {
        "000000"
    };
    assert_eq!(
        service
            .confirm(principal, MfaChangeRequest::Rotation(&proof), wrong, now)
            .await
            .err(),
        Some(MfaError::InvalidCode)
    );
    assert_eq!(unused().await?, Some(9));

    // Used elsewhere meanwhile: every change is refused and nothing changes.
    let backup = MfaBackupCode::parse(codes[1].expose()).ok_or("backup code")?;
    assert!(store.use_backup_code(principal, &backup, now).await?);
    let later = after(now, 30);
    assert_eq!(
        service
            .confirm(
                principal,
                MfaChangeRequest::Rotation(&proof),
                &rotation.secret.code_at(later),
                later
            )
            .await
            .err(),
        Some(MfaError::StepUpInvalid)
    );
    assert_eq!(
        service.disable(principal, &proof, later).await,
        Err(MfaError::StepUpInvalid)
    );
    assert_eq!(
        service
            .regenerate_backup_codes(principal, &proof, later)
            .await
            .err(),
        Some(MfaError::StepUpInvalid)
    );
    let factor: Vec<u8> =
        sqlx::query_scalar("SELECT secret_digest FROM forge_totp_factors WHERE principal_id = $1")
            .bind(principal.into_uuid())
            .fetch_one(&pool)
            .await?;
    assert_eq!(factor, secret.digest().as_bytes().to_vec(), "not rotated");
    assert_eq!(unused().await?, Some(8));
    assert!(
        store
            .pending(principal, MfaChange::Rotation, later)
            .await?
            .is_some(),
        "the rotation is still pending"
    );

    // A valid proof's rotation commits and uses the code up with it.
    let proof = service
        .verify_step_up(principal, codes[2].expose(), later)
        .await?;
    let fresh = service
        .confirm(
            principal,
            MfaChangeRequest::Rotation(&proof),
            &rotation.secret.code_at(later),
            later,
        )
        .await?;
    assert_eq!(fresh.len(), 10);
    assert!(
        !store
            .has_backup_code(
                principal,
                &MfaBackupCode::parse(codes[2].expose()).ok_or("backup code")?
            )
            .await?
    );
    database.cleanup().await?;
    Ok(())
}

/// Live (unrevoked) sessions of `principal`.
async fn live_sessions(
    pool: &sqlx::PgPool,
    principal: forge::security::PrincipalId,
) -> Result<i64, Box<dyn Error>> {
    Ok(sqlx::query_scalar(
        "SELECT count(*) FROM forge_sessions WHERE principal_id = $1 AND revoked_at IS NULL",
    )
    .bind(principal.into_uuid())
    .fetch_one(pool)
    .await?)
}

/// A completed second factor's session is stored and then checked: a factor
/// change or a password reset that committed between the challenge and the
/// session insert (which revoked every session before this one existed)
/// ends it. Without the check the session stayed live after its account
/// disabled the factor.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn a_factor_change_during_a_second_factor_sign_in_ends_its_session() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let service = mfa(&pool, [7; 32])?;
    let sessions = PostgresSessionStore::new(pool.clone());
    let credentials = PostgresPasswordCredentialStore::new(pool.clone());
    let Enrolled {
        principal,
        tenant,
        secret,
        ..
    } = enrolled_owner(&pool, &service, now).await?;
    let mut at = now;
    // A completed second step of the account's current factor.
    let complete = |at: UnixTimestamp, secret: forge::auth::TotpSecret| {
        let (service, credentials) = (service.clone(), credentials.clone());
        async move {
            let verified = verify_password(
                &credentials,
                &Argon2idPasswordHasher,
                "owner@example.com",
                PASSWORD.as_bytes(),
            )
            .await?;
            let issued = service
                .issue_challenge(
                    principal,
                    tenant,
                    verified.version,
                    binding(),
                    after(at, 3_600),
                    at,
                )
                .await?;
            let signed_in = service
                .complete(
                    issued.token.expose(),
                    &binding(),
                    &secret.code_at(at),
                    source(),
                    at,
                )
                .await
                .map_err(|rejection| rejection.error)?;
            Result::<_, Box<dyn Error>>::Ok(signed_in)
        }
    };

    // Nothing changed: the session is issued.
    at = after(at, 30);
    let signed_in = complete(at, secret.clone()).await?;
    let issued = issue_second_factor_session(&sessions, &credentials, &service, &signed_in, at)
        .await?
        .ok_or("issued")?;
    sessions.revoke(issued.session.id(), at).await?;

    // A disable commits while the session insert waits for the account row.
    at = after(at, 30);
    let signed_in = complete(at, secret.clone()).await?;
    let mut disable = pool.begin().await?;
    sqlx::query("SELECT 1 FROM forge_principals WHERE id = $1 FOR UPDATE")
        .bind(principal.into_uuid())
        .execute(&mut *disable)
        .await?;
    let (issued, disabled) = tokio::join!(
        issue_second_factor_session(&sessions, &credentials, &service, &signed_in, at),
        async {
            until_a_statement_waits(&pool).await?;
            for statement in [
                "DELETE FROM forge_mfa_backup_codes WHERE principal_id = $1",
                "DELETE FROM forge_totp_factors WHERE principal_id = $1",
                "UPDATE forge_sessions SET revoked_at = clock_timestamp()
                 WHERE principal_id = $1 AND revoked_at IS NULL",
            ] {
                sqlx::query(statement)
                    .bind(principal.into_uuid())
                    .execute(&mut *disable)
                    .await?;
            }
            disable.commit().await?;
            TestResult::Ok(())
        },
    );
    disabled?;
    assert!(issued?.is_none(), "the disable ended the session");
    assert_eq!(live_sessions(&pool, principal).await?, 0);

    // A rotation, and a password reset, committed in between.
    let enrollment = service
        .begin(
            principal,
            MfaChangeRequest::Enrollment,
            "shop",
            "owner@example.com",
            at,
        )
        .await?;
    let codes_now = service
        .confirm(
            principal,
            MfaChangeRequest::Enrollment,
            &enrollment.secret.code_at(at),
            at,
        )
        .await?;
    at = after(at, 30);
    let signed_in = complete(at, enrollment.secret.clone()).await?;
    let proof = service
        .verify_step_up(principal, codes_now[0].expose(), at)
        .await?;
    let rotation = service
        .begin(
            principal,
            MfaChangeRequest::Rotation(&proof),
            "shop",
            "owner@example.com",
            at,
        )
        .await?;
    let proof = service
        .verify_step_up(principal, codes_now[1].expose(), at)
        .await?;
    service
        .confirm(
            principal,
            MfaChangeRequest::Rotation(&proof),
            &rotation.secret.code_at(after(at, 30)),
            after(at, 30),
        )
        .await?;
    assert!(
        issue_second_factor_session(&sessions, &credentials, &service, &signed_in, at)
            .await?
            .is_none(),
        "the rotation ended the session"
    );
    at = after(at, 60);
    let signed_in = complete(at, rotation.secret.clone()).await?;
    sqlx::query("UPDATE forge_principals SET version = version + 1 WHERE id = $1")
        .bind(principal.into_uuid())
        .execute(&pool)
        .await?;
    assert!(
        issue_second_factor_session(&sessions, &credentials, &service, &signed_in, at)
            .await?
            .is_none(),
        "the password change ended the session"
    );
    assert_eq!(live_sessions(&pool, principal).await?, 0);
    database.cleanup().await?;
    Ok(())
}

/// Rotating a session locks the account row before the session row, so it
/// waits for a factor change (or reset) that holds the account row and then
/// revokes the account's sessions. Before, it locked the session row first
/// and waited for the account row in its foreign-key check while the change
/// waited for the session row: 40P01.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn rotating_a_session_waits_for_a_factor_change_instead_of_deadlocking() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let service = mfa(&pool, [7; 32])?;
    let principal = enrolled_owner(&pool, &service, now).await?.principal;
    let sessions = PostgresSessionStore::new(pool.clone());
    let issued = issue_persisted_session(&sessions, principal, now, after(now, 3_600)).await?;
    let mut previous = sessions
        .find_by_credential(&issued.secrets.bearer_digest)
        .await?
        .ok_or("session")?;
    let at = after(now, 1);
    let replacement = previous.rotate(at, after(at, 3_600))?;
    let secrets = app::infrastructure::security::issue_session_secrets()?;

    let mut change = pool.begin().await?;
    sqlx::query("SELECT 1 FROM forge_principals WHERE id = $1 FOR UPDATE")
        .bind(principal.into_uuid())
        .execute(&mut *change)
        .await?;
    let (rotated, changed) = tokio::join!(
        sessions.rotate(
            issued.session.id(),
            at,
            &replacement,
            &secrets.bearer_digest,
            &secrets.csrf_digest,
        ),
        async {
            until_a_statement_waits(&pool).await?;
            // What every factor change and reset does with the row held.
            sqlx::query(
                "UPDATE forge_sessions SET revoked_at = clock_timestamp()
                 WHERE principal_id = $1 AND revoked_at IS NULL",
            )
            .bind(principal.into_uuid())
            .execute(&mut *change)
            .await?;
            change.commit().await?;
            TestResult::Ok(())
        },
    );
    changed?;
    assert!(
        matches!(rotated, Err(forge::auth::SessionStoreError::Conflict)),
        "the revoked session cannot rotate: {rotated:?}"
    );
    assert_eq!(live_sessions(&pool, principal).await?, 0);
    database.cleanup().await?;
    Ok(())
}

/// Redeeming a reset link locks the account row before the token row, as
/// Forge-Go's ConsumeRecovery: a redemption that waits for another
/// redemption of the same account holds nothing, the other uses up every
/// token of the account, and this one then finds its token used. Before, it
/// locked its token first and then waited for the account row while the
/// other waited for its token: 40P01.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn two_reset_links_of_one_account_redeemed_together_do_not_deadlock() -> TestResult {
    let database = TestDatabase::<sqlx::Postgres>::create(&MIGRATOR).await?;
    let pool = database.database().pool().clone();
    let now = now()?;
    let owner = provision_owner(
        &pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("owner@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?;
    let resets = PgPasswordResetStore::new(pool.clone());
    let (first, second) = (
        PasswordResetToken::generate()?,
        PasswordResetToken::generate()?,
    );
    for token in [&first, &second] {
        resets
            .issue(&PasswordResetGrant::new(
                owner.principal_id,
                owner.tenant_id,
                token.digest(),
                now,
                after(now, 900),
            )?)
            .await?;
    }
    let hash = Argon2idPasswordHasher.hash(b"a brand new secret").await?;

    // The other redemption, in the new order: the account row, its token,
    // then every token of the account used up.
    let mut other = pool.begin().await?;
    sqlx::query("SELECT 1 FROM forge_principals WHERE id = $1 FOR UPDATE")
        .bind(owner.principal_id.into_uuid())
        .execute(&mut *other)
        .await?;
    sqlx::query("SELECT 1 FROM forge_password_resets WHERE token_digest = $1 FOR UPDATE")
        .bind(second.digest().as_bytes().as_slice())
        .execute(&mut *other)
        .await?;
    let digest = first.digest();
    let (redeemed, finished) = tokio::join!(resets.redeem(&digest, after(now, 1), &hash), async {
        until_a_statement_waits(&pool).await?;
        sqlx::query(
            "UPDATE forge_password_resets SET used_at = clock_timestamp()
                 WHERE principal_id = $1 AND used_at IS NULL",
        )
        .bind(owner.principal_id.into_uuid())
        .execute(&mut *other)
        .await?;
        other.commit().await?;
        TestResult::Ok(())
    },);
    finished?;
    assert_eq!(redeemed?, None, "the other redemption used this link up");
    database.cleanup().await?;
    Ok(())
}

type IdleFixture = (
    RlsTestDatabase,
    PostgresSessionStore,
    forge::security::PrincipalId,
);

/// A database migrated and served like production (the migration role
/// applies the migrations and creates the owner, the runtime role runs the
/// session store), a session store with `idle` as its idle timeout (the
/// default without one) and the owner.
async fn idle_fixture(idle: Option<std::time::Duration>) -> Result<IdleFixture, Box<dyn Error>> {
    let database = RlsTestDatabase::create([&MIGRATOR]).await?;
    let owner = provision_owner(
        database.migrator().pool(),
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("idle@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now: now()?,
        },
    )
    .await?;
    let mut sessions = PostgresSessionStore::new(database.runtime().pool().clone());
    if let Some(idle) = idle {
        sessions = sessions.with_idle_timeout(SessionIdleTimeout::new(idle)?);
    }
    Ok((database, sessions, owner.principal_id))
}

/// Moves the session's last use `ago` before the database clock (zero
/// leaves it alone) and returns the stored value in microseconds.
async fn last_seen(
    database: &RlsTestDatabase,
    session: &IssuedSession,
    ago: std::time::Duration,
) -> Result<i64, Box<dyn Error>> {
    let id = session.session.id().into_uuid();
    let admin = database.admin().pool();
    if !ago.is_zero() {
        sqlx::query(
            "UPDATE forge_sessions
             SET last_seen_at = now() - $2::bigint * interval '1 microsecond'
             WHERE id = $1",
        )
        .bind(id)
        .bind(i64::try_from(ago.as_micros())?)
        .execute(admin)
        .await?;
    }
    Ok(sqlx::query_scalar(
        "SELECT (EXTRACT(EPOCH FROM last_seen_at) * 1000000)::bigint FROM forge_sessions WHERE id = $1",
    )
    .bind(id)
    .fetch_one(admin)
    .await?)
}

/// A browser request carrying `session`'s cookie.
fn with_session_cookie(session: &IssuedSession) -> Result<forge::http::Request, Box<dyn Error>> {
    let mut headers = forge::http::HeaderMap::new();
    headers.insert(
        forge::http::header::COOKIE,
        forge::http::HeaderValue::from_str(&format!(
            "__Host-forge_session={}",
            session.secrets.bearer.expose()
        ))?,
    );
    Ok(forge::http::Request::new_for_test(
        forge::http::Method::GET,
        "/".parse()?,
        headers,
        String::new().into(),
        "127.0.0.1:4000".parse()?,
        forge::core::Id::<forge::http::Request>::new().into_uuid(),
    ))
}

const MINUTE: std::time::Duration = std::time::Duration::from_secs(60);

/// A session unused for the idle timeout no longer resolves, is refused
/// exactly as a revoked one and is not revived by the attempt; one used
/// within the timeout resolves and records the use; a revoked session keeps
/// its last use. Forge-Go's `TestSessionsEndAfterTheIdleTimeout`.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn sessions_end_after_the_idle_timeout_and_record_their_use() -> TestResult {
    let (database, sessions, principal) = idle_fixture(Some(30 * MINUTE)).await?;
    let now = now()?;
    let day = UnixTimestamp::from_secs(now.as_secs() + 86_400);
    let issue = || issue_persisted_session(&sessions, principal, now, day);

    let fresh = issue().await?;
    assert!(
        sessions
            .find_by_credential(&fresh.secrets.bearer_digest)
            .await?
            .is_some()
    );

    let idle = issue().await?;
    let before = last_seen(
        &database,
        &idle,
        30 * MINUTE + std::time::Duration::from_secs(1),
    )
    .await?;
    for _ in 0..2 {
        assert!(
            sessions
                .find_by_credential(&idle.secrets.bearer_digest)
                .await?
                .is_none(),
            "a session idle past the timeout is not found"
        );
    }
    assert_eq!(
        last_seen(&database, &idle, std::time::Duration::ZERO).await?,
        before,
        "resolving an idle session recorded a use"
    );
    // The request is refused exactly as with a revoked session: the
    // middleware answers 401, the pages redirect to the sign-in page.
    let revoked = issue().await?;
    sessions.revoke(revoked.session.id(), now).await?;
    let refused = authenticate_request(&sessions, &with_session_cookie(&idle)?, now).await;
    assert_eq!(refused, Err(RequestAuthError::InvalidSession));
    assert_eq!(
        authenticate_request(&sessions, &with_session_cookie(&revoked)?, now).await,
        refused,
        "an idle session is refused like a revoked one"
    );

    let active = issue().await?;
    let before = last_seen(&database, &active, 29 * MINUTE).await?;
    let principal_of_active =
        authenticate_request(&sessions, &with_session_cookie(&active)?, now).await?;
    assert_eq!(principal_of_active.principal_id(), principal);
    let after = last_seen(&database, &active, std::time::Duration::ZERO).await?;
    assert!(
        after > before + 28 * 60 * 1_000_000,
        "the use was recorded: {before} -> {after}"
    );

    // A revoked session is refused and its last use is left alone.
    sessions.revoke(active.session.id(), now).await?;
    let before = last_seen(&database, &active, 10 * MINUTE).await?;
    assert_eq!(
        authenticate_request(&sessions, &with_session_cookie(&active)?, now).await,
        Err(RequestAuthError::InvalidSession)
    );
    assert_eq!(
        last_seen(&database, &active, std::time::Duration::ZERO).await?,
        before,
        "resolving a revoked session recorded a use"
    );
    database.cleanup().await?;
    Ok(())
}

/// Without a configured timeout the store ends sessions after two hours.
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn sessions_use_the_default_idle_timeout_of_two_hours() -> TestResult {
    let (database, sessions, principal) = idle_fixture(None).await?;
    assert_eq!(
        sessions.idle_timeout().get(),
        std::time::Duration::from_secs(7_200)
    );
    let now = now()?;
    let session = issue_persisted_session(
        &sessions,
        principal,
        now,
        UnixTimestamp::from_secs(now.as_secs() + 86_400),
    )
    .await?;
    last_seen(&database, &session, 119 * MINUTE).await?;
    assert!(
        sessions
            .find_by_credential(&session.secrets.bearer_digest)
            .await?
            .is_some(),
        "used 1h59m ago"
    );
    last_seen(
        &database,
        &session,
        120 * MINUTE + std::time::Duration::from_secs(1),
    )
    .await?;
    assert!(
        sessions
            .find_by_credential(&session.secrets.bearer_digest)
            .await?
            .is_none(),
        "used just over 2h ago"
    );
    database.cleanup().await?;
    Ok(())
}

/// Resolutions within a minute of the recorded use only read; a stale use
/// is recorded once, even by 16 concurrent requests. A trigger counts every
/// write to `forge_sessions` (Forge-Go's
/// `TestSessionUseIsWrittenAtMostOncePerMinute`).
#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn a_session_use_is_written_at_most_once_a_minute() -> TestResult {
    let (database, sessions, principal) = idle_fixture(None).await?;
    // The migration role owns forge_sessions; the runtime role may insert
    // into the counting table through its default privileges.
    for statement in [
        "CREATE TABLE session_writes (n bigint NOT NULL)",
        "CREATE FUNCTION count_session_write() RETURNS trigger LANGUAGE plpgsql AS $$
         BEGIN INSERT INTO session_writes VALUES (1); RETURN NEW; END $$",
        "CREATE TRIGGER count_session_writes AFTER UPDATE ON forge_sessions
         FOR EACH ROW EXECUTE FUNCTION count_session_write()",
    ] {
        sqlx::query(statement)
            .execute(database.migrator().pool())
            .await?;
    }
    let admin = database.admin().pool().clone();
    let writes = || {
        let admin = admin.clone();
        async move {
            sqlx::query_scalar::<_, i64>("SELECT count(*) FROM session_writes")
                .fetch_one(&admin)
                .await
        }
    };
    let resolve_concurrently = |digest: forge::auth::SessionCredentialDigest| {
        let sessions = sessions.clone();
        async move {
            let mut resolutions = tokio::task::JoinSet::new();
            for _ in 0..16 {
                let sessions = sessions.clone();
                resolutions.spawn(async move { sessions.find_by_credential(&digest).await });
            }
            while let Some(resolved) = resolutions.join_next().await {
                if resolved??.is_none() {
                    return Err("a live session was not found".into());
                }
            }
            Ok::<(), Box<dyn Error>>(())
        }
    };

    let now = now()?;
    let session = issue_persisted_session(
        &sessions,
        principal,
        now,
        UnixTimestamp::from_secs(now.as_secs() + 86_400),
    )
    .await?;
    let digest = session.secrets.bearer_digest;
    let created = last_seen(&database, &session, std::time::Duration::ZERO).await?;
    resolve_concurrently(digest).await?;
    assert_eq!(
        writes().await?,
        0,
        "resolving a session used just now wrote"
    );
    assert_eq!(
        last_seen(&database, &session, std::time::Duration::ZERO).await?,
        created
    );

    last_seen(&database, &session, std::time::Duration::from_secs(59)).await?;
    let before = writes().await?;
    resolve_concurrently(digest).await?;
    assert_eq!(writes().await? - before, 0, "a use 59s old was rewritten");

    let stale = last_seen(&database, &session, std::time::Duration::from_secs(61)).await?;
    let before = writes().await?;
    resolve_concurrently(digest).await?;
    assert_eq!(
        writes().await? - before,
        1,
        "16 concurrent resolutions of a stale use write exactly once"
    );
    let recorded = last_seen(&database, &session, std::time::Duration::ZERO).await?;
    assert!(
        recorded > stale + 60 * 1_000_000,
        "the stale use was recorded: {stale} -> {recorded}"
    );
    let before = writes().await?;
    resolve_concurrently(digest).await?;
    assert_eq!(
        writes().await? - before,
        0,
        "resolving right after the recorded use wrote"
    );
    database.cleanup().await?;
    Ok(())
}

/// Upgrading a database whose sessions predate migration
/// 00000000000000000006: a session three days old counts as used at the
/// upgrade, so nobody is signed out; the down migration drops the column
/// (Forge-Go's `TestSessionIdleMigrationKeepsExistingSessions`).
#[tokio::test]
#[ignore = "needs FORGE_TEST_DATABASE_URL"]
async fn the_idle_timeout_migration_keeps_open_sessions_and_reverts() -> TestResult {
    const IDLE_MIGRATION: i64 = 6;
    let database = TestDatabase::<sqlx::Postgres>::create_empty().await?;
    let pool = database.database().pool().clone();
    MIGRATOR.run_to(IDLE_MIGRATION - 1, &pool).await?;
    let now = now()?;
    let owner = provision_owner(
        &pool,
        &OwnerAccount {
            tenant: TenantSlug::new("acme")?,
            organization: "Acme".to_owned(),
            login: CanonicalLogin::parse("old@example.com")?,
            password_hash: Argon2idPasswordHasher.hash(PASSWORD.as_bytes()).await?,
            now,
        },
    )
    .await?;
    // A session created three days ago by the code before the upgrade,
    // with that code's columns only.
    let secrets = app::infrastructure::security::issue_session_secrets()?;
    sqlx::query(
        "INSERT INTO forge_sessions
             (id, principal_id, credential_digest, csrf_digest, issued_at, expires_at)
         VALUES ($1, $2, $3, $4, now() - interval '3 days', now() + interval '20 days')",
    )
    .bind(forge::auth::SessionId::new().into_uuid())
    .bind(owner.principal_id.into_uuid())
    .bind(secrets.bearer_digest.as_bytes().as_slice())
    .bind(secrets.csrf_digest.as_bytes().as_slice())
    .execute(&pool)
    .await?;

    MIGRATOR.run_to(IDLE_MIGRATION, &pool).await?;
    let sessions = PostgresSessionStore::new(pool.clone());
    assert!(
        sessions
            .find_by_credential(&secrets.bearer_digest)
            .await?
            .is_some(),
        "a session from before the upgrade still resolves"
    );

    MIGRATOR.undo(&pool, IDLE_MIGRATION - 1).await?;
    let columns: i64 = sqlx::query_scalar(
        "SELECT count(*) FROM information_schema.columns
         WHERE table_name = 'forge_sessions' AND column_name = 'last_seen_at'",
    )
    .fetch_one(&pool)
    .await?;
    assert_eq!(columns, 0, "the down migration drops last_seen_at");
    let kept: i64 = sqlx::query_scalar("SELECT count(*) FROM forge_sessions")
        .fetch_one(&pool)
        .await?;
    assert_eq!(kept, 1, "the down migration keeps the sessions");
    database.cleanup().await?;
    Ok(())
}
