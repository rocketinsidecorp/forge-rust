//! PostgreSQL persistence of browser authentication (ADR 0026): the tenant
//! directory used at sign-in, one-time password reset tokens, TOTP
//! multi-factor authentication (ADR 0040) and the first tenant and owner
//! created by `setup`.
//!
//! Reset tokens are stored only as SHA-256 digests. Redeeming one changes the
//! password, revokes every session of the account and uses up its other reset
//! tokens in a single transaction.
//!
//! TOTP seeds are stored only as AES-256-GCM ciphertext (the key,
//! `FORGE_AUTH_MFA_KEY`, never reaches the database) beside their digest;
//! backup codes and sign-in challenges only as SHA-256 digests. Every change
//! of a factor, a backup code or a challenge is one transaction that locks
//! the rows it reads, so a code is accepted once even under concurrency.
//!
//! Lock order: every transaction that changes an account's MFA rows, sessions
//! or reset tokens locks the account's `forge_principals` row first and only
//! then its enrollment, factor, backup code, session, challenge and reset
//! rows (redeeming a reset token too; `PostgresSessionStore::rotate` takes
//! the row `FOR KEY SHARE` before the session row). Factor changes take it `FOR UPDATE` ([`lock_account`]);
//! issuing and completing a sign-in challenge take it `FOR NO KEY UPDATE`
//! ([`lock_sign_in`]). The two modes conflict with each other and with
//! themselves, so the MFA transactions of one account run one at a time and
//! none of them ever waits for the account row while it holds an MFA row: no
//! two of them can deadlock (a sign-in that locked its factor first and then
//! waited for the account row, which a disable held while waiting for the
//! factor, ended in `40P01`). The single statements that wait without holding
//! anything (`use_totp_counter`, `use_backup_code`, session inserts and
//! revocations) close no cycle. `FOR NO KEY UPDATE` still lets a session
//! insert take its foreign-key lock on the account row, while `FOR UPDATE`
//! makes it wait for a factor change, which the password sign-in relies on.

use async_trait::async_trait;
use forge::audit::{AuditAction, AuditActor, AuditEvent, AuditOutcome};
use forge::auth::{
    CanonicalLogin, MfaBackupCodeDigest, MfaChallengeBinding, MfaChallengeDigest,
    PasswordCredentialVersion, PasswordHash, PasswordResetTokenDigest, SealedTotpSecret,
    TotpSecretDigest, UnixTimestamp,
};
use forge::core::Id;
use forge::security::PrincipalId;
use forge::tenancy::{
    AccountStoreError, ActiveTotp, MfaChallengeGrant, MfaChallengeRecord, MfaChange, MfaStatus,
    MfaStore, PasswordResetGrant, PasswordResetStore, PendingTotp, RedeemedPasswordReset,
    TenantDirectory, TenantId, TenantSlug,
};
use sqlx::{PgPool, Postgres, Transaction, types::Uuid};

/// The role `setup` gives the first member of the first tenant. Generated
/// access policies grant it every permission of the resources they protect.
pub const OWNER_ROLE: &str = "owner";

/// Advisory lock name that serializes concurrent `setup` runs.
const SETUP_LOCK: &str = "forge:identity_setup";

/// Tenants by slug.
#[derive(Clone, Debug)]
pub struct PgTenantDirectory {
    pool: PgPool,
}

impl PgTenantDirectory {
    /// Creates a directory using the least-privilege runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl TenantDirectory for PgTenantDirectory {
    async fn find_by_slug(&self, slug: &TenantSlug) -> Result<Option<TenantId>, AccountStoreError> {
        let id = sqlx::query_scalar::<_, Uuid>("SELECT id FROM forge_tenants WHERE slug = $1")
            .bind(slug.as_str())
            .fetch_optional(&self.pool)
            .await
            .map_err(classify)?;
        id.map(|id| TenantId::from_uuid(id).map_err(|_| AccountStoreError::Corrupt))
            .transpose()
    }
}

/// Marker of password reset record identifiers.
#[derive(Debug)]
pub enum PasswordResetMarker {}

/// One-time password reset tokens.
#[derive(Clone, Debug)]
pub struct PgPasswordResetStore {
    pool: PgPool,
}

impl PgPasswordResetStore {
    /// Creates a store using the least-privilege runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl PasswordResetStore for PgPasswordResetStore {
    async fn issue(&self, grant: &PasswordResetGrant) -> Result<(), AccountStoreError> {
        sqlx::query(
            "INSERT INTO forge_password_resets (
                id, principal_id, tenant_id, token_digest, issued_at, expires_at
             ) VALUES (
                $1, $2, $3, $4,
                to_timestamp($5::double precision),
                to_timestamp($6::double precision)
             )",
        )
        .bind(Id::<PasswordResetMarker>::new().into_uuid())
        .bind(grant.principal_id().into_uuid())
        .bind(grant.tenant_id().into_uuid())
        .bind(grant.digest().as_bytes().as_slice())
        .bind(seconds(grant.issued_at())?)
        .bind(seconds(grant.expires_at())?)
        .execute(&self.pool)
        .await
        .map_err(classify)?;
        Ok(())
    }

    async fn is_redeemable(
        &self,
        digest: &PasswordResetTokenDigest,
        now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        sqlx::query_scalar::<_, bool>(
            "SELECT EXISTS (
                SELECT 1 FROM forge_password_resets
                WHERE token_digest = $1
                  AND used_at IS NULL
                  AND expires_at > to_timestamp($2::double precision)
             )",
        )
        .bind(digest.as_bytes().as_slice())
        .bind(seconds(now)?)
        .fetch_one(&self.pool)
        .await
        .map_err(classify)
    }

    async fn redeem(
        &self,
        digest: &PasswordResetTokenDigest,
        now: UnixTimestamp,
        password_hash: &PasswordHash,
    ) -> Result<Option<RedeemedPasswordReset>, AccountStoreError> {
        let now = seconds(now)?;
        let mut transaction = self.pool.begin().await.map_err(classify)?;

        // The account row first (see the module's lock order), as Forge-Go's
        // ConsumeRecovery: the token is looked up without a lock, then the
        // account row is locked `FOR UPDATE` before the token row. Locking
        // the token first deadlocked two redemptions of different links of
        // one account (each held its token, one waited for the account row,
        // the other for the first's token). `FOR UPDATE` also makes a
        // session insert of the account wait for the reset, so a sign-in
        // finishing meanwhile sees the new credential version.
        let Some(principal) = sqlx::query_scalar::<_, Uuid>(
            "SELECT principal_id FROM forge_password_resets WHERE token_digest = $1",
        )
        .bind(digest.as_bytes().as_slice())
        .fetch_optional(&mut *transaction)
        .await
        .map_err(classify)?
        else {
            transaction.rollback().await.map_err(classify)?;
            return Ok(None);
        };
        sqlx::query("SELECT 1 FROM forge_principals WHERE id = $1 FOR UPDATE")
            .bind(principal)
            .execute(&mut *transaction)
            .await
            .map_err(classify)?;

        // Locks the token row, so a concurrent redemption waits and then sees
        // it used. The account must still be enabled and an active member of
        // the tenant the reset was requested through.
        let row = sqlx::query_as::<_, (Uuid, Uuid)>(
            "SELECT reset.principal_id, reset.tenant_id
             FROM forge_password_resets AS reset
             JOIN forge_principals AS principal ON principal.id = reset.principal_id
             JOIN forge_tenant_memberships AS membership
               ON membership.principal_id = reset.principal_id
              AND membership.tenant_id = reset.tenant_id
             WHERE reset.token_digest = $1
               AND reset.used_at IS NULL
               AND reset.expires_at > to_timestamp($2::double precision)
               AND principal.disabled_at IS NULL
               AND membership.state = 'active'
             FOR UPDATE OF reset",
        )
        .bind(digest.as_bytes().as_slice())
        .bind(now)
        .fetch_optional(&mut *transaction)
        .await
        .map_err(classify)?;
        let Some((principal_id, tenant_id)) = row else {
            transaction.rollback().await.map_err(classify)?;
            return Ok(None);
        };

        let changed = sqlx::query(
            "UPDATE forge_principals
             SET password_hash = $2,
                 updated_at = clock_timestamp(),
                 version = version + 1
             WHERE id = $1
               AND disabled_at IS NULL",
        )
        .bind(principal_id)
        .bind(password_hash.expose())
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;
        if changed.rows_affected() != 1 {
            return Err(AccountStoreError::Conflict);
        }

        sqlx::query(
            "UPDATE forge_sessions
             SET revoked_at = GREATEST(issued_at, to_timestamp($2::double precision))
             WHERE principal_id = $1
               AND revoked_at IS NULL",
        )
        .bind(principal_id)
        .bind(now)
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;

        sqlx::query(
            "UPDATE forge_password_resets
             SET used_at = GREATEST(issued_at, to_timestamp($2::double precision))
             WHERE principal_id = $1
               AND used_at IS NULL",
        )
        .bind(principal_id)
        .bind(now)
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;

        transaction.commit().await.map_err(classify)?;
        Ok(Some(RedeemedPasswordReset {
            principal_id: PrincipalId::from_uuid(principal_id)
                .map_err(|_| AccountStoreError::Corrupt)?,
            tenant_id: TenantId::from_uuid(tenant_id).map_err(|_| AccountStoreError::Corrupt)?,
        }))
    }
}

/// Marker of backup code record identifiers.
#[derive(Debug)]
pub enum MfaBackupCodeMarker {}

/// Marker of sign-in challenge record identifiers.
#[derive(Debug)]
pub enum MfaChallengeMarker {}

/// TOTP factors, pending seeds, backup codes and sign-in challenges
/// (Forge-Go's `auth/postgres` MFA repository).
#[derive(Clone, Debug)]
pub struct PgMfaStore {
    pool: PgPool,
}

impl PgMfaStore {
    /// Creates a store using the least-privilege runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

/// The tables of a challenge query: the challenge, its account, the factor
/// it was issued for and the account's membership of its tenant.
macro_rules! challenge_tables {
    () => {
        " FROM forge_mfa_challenges AS challenge
          JOIN forge_principals AS principal ON principal.id = challenge.principal_id
          JOIN forge_totp_factors AS factor
            ON factor.principal_id = challenge.principal_id
           AND factor.secret_digest = challenge.factor_secret_digest
          JOIN forge_tenant_memberships AS membership
            ON membership.principal_id = challenge.principal_id
           AND membership.tenant_id = challenge.tenant_id "
    };
}

/// A live challenge ($1 its digest, $2 now): unconsumed and unexpired, its
/// account enabled with the credential version the password step verified
/// and its membership of the tenant active.
macro_rules! live_challenge {
    () => {
        " WHERE challenge.token_digest = $1
            AND challenge.consumed_at IS NULL
            AND challenge.expires_at > to_timestamp($2::double precision)
            AND challenge.session_expires_at > to_timestamp($2::double precision)
            AND principal.disabled_at IS NULL
            AND principal.version = challenge.credential_version
            AND membership.state = 'active' "
    };
}

#[async_trait]
impl MfaStore for PgMfaStore {
    async fn status(&self, principal: PrincipalId) -> Result<Option<MfaStatus>, AccountStoreError> {
        let remaining = sqlx::query_scalar::<_, i64>(
            "SELECT (
                SELECT count(*) FROM forge_mfa_backup_codes AS code
                WHERE code.principal_id = factor.principal_id
                  AND code.consumed_at IS NULL
             )
             FROM forge_totp_factors AS factor
             WHERE factor.principal_id = $1",
        )
        .bind(principal.into_uuid())
        .fetch_optional(&self.pool)
        .await
        .map_err(classify)?;
        remaining
            .map(|count| {
                u32::try_from(count)
                    .map(|remaining_backup_codes| MfaStatus {
                        remaining_backup_codes,
                    })
                    .map_err(|_| AccountStoreError::Corrupt)
            })
            .transpose()
    }

    async fn begin(
        &self,
        principal: PrincipalId,
        change: MfaChange,
        pending: &PendingTotp,
        step_up: Option<&MfaBackupCodeDigest>,
    ) -> Result<bool, AccountStoreError> {
        let mut transaction = self.pool.begin().await.map_err(classify)?;
        let Some(enabled) = lock_account(&mut transaction, principal).await? else {
            return Ok(false);
        };
        if enabled != (change == MfaChange::Rotation)
            || !spend_step_up(&mut transaction, principal, step_up).await?
        {
            return Ok(false);
        }
        sqlx::query(
            "INSERT INTO forge_totp_enrollments (
                principal_id, secret_digest, secret_ciphertext, expires_at
             ) VALUES ($1, $2, $3, to_timestamp($4::double precision))
             ON CONFLICT (principal_id) DO UPDATE
             SET secret_digest = EXCLUDED.secret_digest,
                 secret_ciphertext = EXCLUDED.secret_ciphertext,
                 expires_at = EXCLUDED.expires_at,
                 created_at = clock_timestamp()",
        )
        .bind(principal.into_uuid())
        .bind(pending.sealed.digest().as_bytes().as_slice())
        .bind(pending.sealed.ciphertext())
        .bind(seconds(pending.expires_at)?)
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;
        transaction.commit().await.map_err(classify)?;
        Ok(true)
    }

    async fn pending(
        &self,
        principal: PrincipalId,
        change: MfaChange,
        now: UnixTimestamp,
    ) -> Result<Option<PendingTotp>, AccountStoreError> {
        // One statement, one snapshot: the seed is a rotation's exactly when
        // the account has a factor.
        let row = sqlx::query_as::<_, (Vec<u8>, Vec<u8>, i64)>(
            "SELECT pending.secret_digest, pending.secret_ciphertext,
                    EXTRACT(EPOCH FROM pending.expires_at)::bigint
             FROM forge_totp_enrollments AS pending
             JOIN forge_principals AS principal ON principal.id = pending.principal_id
             WHERE pending.principal_id = $1
               AND pending.expires_at > to_timestamp($2::double precision)
               AND principal.disabled_at IS NULL
               AND EXISTS (
                   SELECT 1 FROM forge_totp_factors AS factor
                   WHERE factor.principal_id = pending.principal_id
               ) = $3",
        )
        .bind(principal.into_uuid())
        .bind(seconds(now)?)
        .bind(change == MfaChange::Rotation)
        .fetch_optional(&self.pool)
        .await
        .map_err(classify)?;
        row.map(|(digest, ciphertext, expires_at)| {
            Ok(PendingTotp {
                sealed: sealed(ciphertext, digest)?,
                expires_at: timestamp(expires_at)?,
            })
        })
        .transpose()
    }

    async fn activate(
        &self,
        principal: PrincipalId,
        change: MfaChange,
        digest: &TotpSecretDigest,
        counter: u64,
        backup_codes: &[MfaBackupCodeDigest],
        step_up: Option<&MfaBackupCodeDigest>,
        now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        let counter = i64::try_from(counter).map_err(|_| AccountStoreError::Corrupt)?;
        let at = seconds(now)?;
        let mut transaction = self.pool.begin().await.map_err(classify)?;
        let Some(enabled) = lock_account(&mut transaction, principal).await? else {
            return Ok(false);
        };
        // The pending seed of a rotation sits where an enrollment's does. With
        // the account locked, an enrollment of an account that has a factor
        // (and a rotation of one that has none) is refused here, explicitly,
        // rather than by the statements below failing on the factor's key.
        if enabled != (change == MfaChange::Rotation) {
            return Ok(false);
        }
        let Some(ciphertext) = sqlx::query_scalar::<_, Vec<u8>>(
            "SELECT secret_ciphertext
             FROM forge_totp_enrollments
             WHERE principal_id = $1
               AND secret_digest = $2
               AND expires_at > to_timestamp($3::double precision)
             FOR UPDATE",
        )
        .bind(principal.into_uuid())
        .bind(digest.as_bytes().as_slice())
        .bind(at)
        .fetch_optional(&mut *transaction)
        .await
        .map_err(classify)?
        else {
            return Ok(false);
        };
        if !spend_step_up(&mut transaction, principal, step_up).await? {
            return Ok(false);
        }

        let installed = match change {
            MfaChange::Enrollment => sqlx::query(
                "INSERT INTO forge_totp_factors (
                    principal_id, secret_digest, secret_ciphertext, last_counter
                 ) VALUES ($1, $2, $3, $4)",
            ),
            MfaChange::Rotation => sqlx::query(
                "UPDATE forge_totp_factors
                 SET secret_digest = $2,
                     secret_ciphertext = $3,
                     last_counter = $4,
                     updated_at = clock_timestamp()
                 WHERE principal_id = $1",
            ),
        }
        .bind(principal.into_uuid())
        .bind(digest.as_bytes().as_slice())
        .bind(ciphertext)
        .bind(counter)
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;
        if installed.rows_affected() != 1 {
            return Err(AccountStoreError::Conflict);
        }
        store_backup_codes(&mut transaction, principal, backup_codes).await?;
        sqlx::query("DELETE FROM forge_totp_enrollments WHERE principal_id = $1")
            .bind(principal.into_uuid())
            .execute(&mut *transaction)
            .await
            .map_err(classify)?;
        sign_out_everywhere(&mut transaction, principal, at).await?;
        transaction.commit().await.map_err(classify)?;
        Ok(true)
    }

    async fn disable(
        &self,
        principal: PrincipalId,
        step_up: Option<&MfaBackupCodeDigest>,
        now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        let mut transaction = self.pool.begin().await.map_err(classify)?;
        if lock_account(&mut transaction, principal).await? != Some(true)
            || !spend_step_up(&mut transaction, principal, step_up).await?
        {
            return Ok(false);
        }
        for statement in [
            "DELETE FROM forge_mfa_backup_codes WHERE principal_id = $1",
            "DELETE FROM forge_totp_enrollments WHERE principal_id = $1",
            "DELETE FROM forge_totp_factors WHERE principal_id = $1",
        ] {
            sqlx::query(statement)
                .bind(principal.into_uuid())
                .execute(&mut *transaction)
                .await
                .map_err(classify)?;
        }
        sign_out_everywhere(&mut transaction, principal, seconds(now)?).await?;
        transaction.commit().await.map_err(classify)?;
        Ok(true)
    }

    async fn active(
        &self,
        principal: PrincipalId,
    ) -> Result<Option<ActiveTotp>, AccountStoreError> {
        let row = sqlx::query_as::<_, (Vec<u8>, Vec<u8>, i64)>(
            "SELECT factor.secret_digest, factor.secret_ciphertext, factor.last_counter
             FROM forge_totp_factors AS factor
             JOIN forge_principals AS principal ON principal.id = factor.principal_id
             WHERE factor.principal_id = $1
               AND principal.disabled_at IS NULL",
        )
        .bind(principal.into_uuid())
        .fetch_optional(&self.pool)
        .await
        .map_err(classify)?;
        row.map(|(digest, ciphertext, last_counter)| {
            Ok(ActiveTotp {
                sealed: sealed(ciphertext, digest)?,
                last_counter: counter_from(last_counter)?,
            })
        })
        .transpose()
    }

    async fn use_totp_counter(
        &self,
        principal: PrincipalId,
        digest: &TotpSecretDigest,
        counter: u64,
    ) -> Result<bool, AccountStoreError> {
        // One statement: of two concurrent uses of a code, one updates.
        let updated = sqlx::query(
            "UPDATE forge_totp_factors
             SET last_counter = $3, updated_at = clock_timestamp()
             WHERE principal_id = $1
               AND secret_digest = $2
               AND last_counter < $3",
        )
        .bind(principal.into_uuid())
        .bind(digest.as_bytes().as_slice())
        .bind(i64::try_from(counter).map_err(|_| AccountStoreError::Corrupt)?)
        .execute(&self.pool)
        .await
        .map_err(classify)?;
        Ok(updated.rows_affected() == 1)
    }

    async fn use_backup_code(
        &self,
        principal: PrincipalId,
        code: &MfaBackupCodeDigest,
        now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        let used = sqlx::query(
            "UPDATE forge_mfa_backup_codes AS code
             SET consumed_at = to_timestamp($3::double precision)
             WHERE code.principal_id = $1
               AND code.code_digest = $2
               AND code.consumed_at IS NULL
               AND EXISTS (
                   SELECT 1 FROM forge_totp_factors AS factor
                   WHERE factor.principal_id = code.principal_id
               )",
        )
        .bind(principal.into_uuid())
        .bind(code.as_bytes().as_slice())
        .bind(seconds(now)?)
        .execute(&self.pool)
        .await
        .map_err(classify)?;
        Ok(used.rows_affected() == 1)
    }

    async fn has_backup_code(
        &self,
        principal: PrincipalId,
        code: &MfaBackupCodeDigest,
    ) -> Result<bool, AccountStoreError> {
        sqlx::query_scalar::<_, bool>(
            "SELECT EXISTS (
                SELECT 1
                FROM forge_mfa_backup_codes AS code
                JOIN forge_totp_factors AS factor ON factor.principal_id = code.principal_id
                JOIN forge_principals AS principal ON principal.id = code.principal_id
                WHERE code.principal_id = $1
                  AND code.code_digest = $2
                  AND code.consumed_at IS NULL
                  AND principal.disabled_at IS NULL
             )",
        )
        .bind(principal.into_uuid())
        .bind(code.as_bytes().as_slice())
        .fetch_one(&self.pool)
        .await
        .map_err(classify)
    }

    async fn replace_backup_codes(
        &self,
        principal: PrincipalId,
        backup_codes: &[MfaBackupCodeDigest],
        step_up: Option<&MfaBackupCodeDigest>,
        _now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        let mut transaction = self.pool.begin().await.map_err(classify)?;
        if lock_account(&mut transaction, principal).await? != Some(true)
            || !spend_step_up(&mut transaction, principal, step_up).await?
        {
            return Ok(false);
        }
        store_backup_codes(&mut transaction, principal, backup_codes).await?;
        transaction.commit().await.map_err(classify)?;
        Ok(true)
    }

    async fn create_challenge(&self, grant: &MfaChallengeGrant) -> Result<bool, AccountStoreError> {
        let version = i64::try_from(grant.credential_version.get())
            .map_err(|_| AccountStoreError::Corrupt)?;
        let mut transaction = self.pool.begin().await.map_err(classify)?;
        // The account row first (see the module's lock order), with the
        // credential version the password step verified: the factor below
        // can then change only after this transaction ends.
        if !lock_sign_in(
            &mut transaction,
            grant.principal_id.into_uuid(),
            Some(version),
        )
        .await?
        {
            return Ok(false);
        }
        let factor = sqlx::query_scalar::<_, Vec<u8>>(
            "SELECT secret_digest FROM forge_totp_factors WHERE principal_id = $1",
        )
        .bind(grant.principal_id.into_uuid())
        .fetch_optional(&mut *transaction)
        .await
        .map_err(classify)?;
        let Some(factor) = factor else {
            return Ok(false);
        };
        // One pending challenge per account: a new sign-in voids the last.
        sqlx::query(
            "UPDATE forge_mfa_challenges
             SET consumed_at = clock_timestamp()
             WHERE principal_id = $1
               AND consumed_at IS NULL",
        )
        .bind(grant.principal_id.into_uuid())
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;
        sqlx::query(
            "INSERT INTO forge_mfa_challenges (
                id, token_digest, principal_id, tenant_id, credential_version,
                factor_secret_digest, binding_digest, expires_at, session_expires_at
             ) VALUES (
                $1, $2, $3, $4, $5, $6, $7,
                to_timestamp($8::double precision),
                to_timestamp($9::double precision)
             )",
        )
        .bind(Id::<MfaChallengeMarker>::new().into_uuid())
        .bind(grant.digest.as_bytes().as_slice())
        .bind(grant.principal_id.into_uuid())
        .bind(grant.tenant_id.into_uuid())
        .bind(version)
        .bind(factor)
        .bind(grant.binding.as_bytes().as_slice())
        .bind(seconds(grant.expires_at)?)
        .bind(seconds(grant.session_expires_at)?)
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;
        transaction.commit().await.map_err(classify)?;
        Ok(true)
    }

    async fn challenge(
        &self,
        digest: &MfaChallengeDigest,
        now: UnixTimestamp,
    ) -> Result<Option<MfaChallengeRecord>, AccountStoreError> {
        type Row = (Uuid, Uuid, i64, Vec<u8>, Vec<u8>, Vec<u8>, i64, i64, i64);
        let row = sqlx::query_as::<_, Row>(concat!(
            "SELECT challenge.principal_id, challenge.tenant_id, challenge.credential_version,
                    challenge.binding_digest,
                    factor.secret_digest, factor.secret_ciphertext, factor.last_counter,
                    EXTRACT(EPOCH FROM challenge.expires_at)::bigint,
                    EXTRACT(EPOCH FROM challenge.session_expires_at)::bigint",
            challenge_tables!(),
            live_challenge!(),
        ))
        .bind(digest.as_bytes().as_slice())
        .bind(seconds(now)?)
        .fetch_optional(&self.pool)
        .await
        .map_err(classify)?;
        row.map(
            |(principal, tenant, version, binding, factor, ciphertext, last, expires, session)| {
                Ok(MfaChallengeRecord {
                    principal_id: PrincipalId::from_uuid(principal)
                        .map_err(|_| AccountStoreError::Corrupt)?,
                    tenant_id: TenantId::from_uuid(tenant)
                        .map_err(|_| AccountStoreError::Corrupt)?,
                    credential_version: u64::try_from(version)
                        .ok()
                        .and_then(PasswordCredentialVersion::new)
                        .ok_or(AccountStoreError::Corrupt)?,
                    binding: MfaChallengeBinding::from_bytes(digest32(binding)?),
                    factor: ActiveTotp {
                        sealed: sealed(ciphertext, factor)?,
                        last_counter: counter_from(last)?,
                    },
                    expires_at: timestamp(expires)?,
                    session_expires_at: timestamp(session)?,
                })
            },
        )
        .transpose()
    }

    async fn consume_challenge_with_totp(
        &self,
        digest: &MfaChallengeDigest,
        factor: &TotpSecretDigest,
        counter: u64,
        now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        let counter = i64::try_from(counter).map_err(|_| AccountStoreError::Corrupt)?;
        let mut transaction = self.pool.begin().await.map_err(classify)?;
        if !lock_challenge_account(&mut transaction, digest).await? {
            return Ok(false);
        }
        let row = sqlx::query_as::<_, (Uuid, Uuid, i64)>(concat!(
            "SELECT challenge.id, challenge.principal_id, factor.last_counter",
            challenge_tables!(),
            live_challenge!(),
            "AND challenge.factor_secret_digest = $3
             FOR UPDATE OF challenge, factor",
        ))
        .bind(digest.as_bytes().as_slice())
        .bind(seconds(now)?)
        .bind(factor.as_bytes().as_slice())
        .fetch_optional(&mut *transaction)
        .await
        .map_err(classify)?;
        let Some((challenge, principal, last_counter)) = row else {
            return Ok(false);
        };
        if counter <= last_counter {
            return Ok(false);
        }
        let advanced = sqlx::query(
            "UPDATE forge_totp_factors
             SET last_counter = $3, updated_at = clock_timestamp()
             WHERE principal_id = $1
               AND secret_digest = $2
               AND last_counter < $3",
        )
        .bind(principal)
        .bind(factor.as_bytes().as_slice())
        .bind(counter)
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;
        if advanced.rows_affected() != 1 {
            return Ok(false);
        }
        consume_challenge(&mut transaction, challenge, seconds(now)?).await?;
        transaction.commit().await.map_err(classify)?;
        Ok(true)
    }

    async fn consume_challenge_with_backup_code(
        &self,
        digest: &MfaChallengeDigest,
        code: &MfaBackupCodeDigest,
        now: UnixTimestamp,
    ) -> Result<bool, AccountStoreError> {
        let at = seconds(now)?;
        let mut transaction = self.pool.begin().await.map_err(classify)?;
        if !lock_challenge_account(&mut transaction, digest).await? {
            return Ok(false);
        }
        let row = sqlx::query_as::<_, (Uuid, Uuid)>(concat!(
            "SELECT challenge.id, code.id",
            challenge_tables!(),
            "JOIN forge_mfa_backup_codes AS code
               ON code.principal_id = challenge.principal_id
              AND code.code_digest = $3
              AND code.consumed_at IS NULL",
            live_challenge!(),
            "FOR UPDATE OF challenge, code",
        ))
        .bind(digest.as_bytes().as_slice())
        .bind(at)
        .bind(code.as_bytes().as_slice())
        .fetch_optional(&mut *transaction)
        .await
        .map_err(classify)?;
        let Some((challenge, code)) = row else {
            return Ok(false);
        };
        let used = sqlx::query(
            "UPDATE forge_mfa_backup_codes
             SET consumed_at = to_timestamp($2::double precision)
             WHERE id = $1
               AND consumed_at IS NULL",
        )
        .bind(code)
        .bind(at)
        .execute(&mut *transaction)
        .await
        .map_err(classify)?;
        if used.rows_affected() != 1 {
            return Ok(false);
        }
        consume_challenge(&mut transaction, challenge, at).await?;
        transaction.commit().await.map_err(classify)?;
        Ok(true)
    }
}

/// Locks an enabled account's row; `Some(has a factor)`, or `None` when the
/// account is missing or disabled.
///
/// The factor is looked up by a second statement, once the lock is held:
/// under READ COMMITTED a statement reads the rows committed before it
/// started, so the locking statement itself would miss a factor installed by
/// the transaction it waited for.
async fn lock_account(
    transaction: &mut Transaction<'_, Postgres>,
    principal: PrincipalId,
) -> Result<Option<bool>, AccountStoreError> {
    let locked = sqlx::query_scalar::<_, i32>(
        "SELECT 1
         FROM forge_principals
         WHERE id = $1
           AND disabled_at IS NULL
         FOR UPDATE",
    )
    .bind(principal.into_uuid())
    .fetch_optional(&mut **transaction)
    .await
    .map_err(classify)?;
    if locked.is_none() {
        return Ok(None);
    }
    let enabled = sqlx::query_scalar::<_, bool>(
        "SELECT EXISTS (SELECT 1 FROM forge_totp_factors WHERE principal_id = $1)",
    )
    .bind(principal.into_uuid())
    .fetch_one(&mut **transaction)
    .await
    .map_err(classify)?;
    Ok(Some(enabled))
}

/// Locks the account row of a sign-in step (issuing or completing a
/// challenge) `FOR NO KEY UPDATE`, before any MFA row (see the module's lock
/// order); `false` when the account is missing, disabled or, with
/// `version`, at another credential version.
async fn lock_sign_in(
    transaction: &mut Transaction<'_, Postgres>,
    principal: Uuid,
    version: Option<i64>,
) -> Result<bool, AccountStoreError> {
    let locked = sqlx::query_scalar::<_, i32>(
        "SELECT 1
         FROM forge_principals
         WHERE id = $1
           AND disabled_at IS NULL
           AND ($2::bigint IS NULL OR version = $2)
         FOR NO KEY UPDATE",
    )
    .bind(principal)
    .bind(version)
    .fetch_optional(&mut **transaction)
    .await
    .map_err(classify)?;
    Ok(locked.is_some())
}

/// [`lock_sign_in`] for the account of the challenge `digest`; `false` when
/// there is no such challenge or account. The challenge row itself is
/// locked afterwards, with the account row held.
async fn lock_challenge_account(
    transaction: &mut Transaction<'_, Postgres>,
    digest: &MfaChallengeDigest,
) -> Result<bool, AccountStoreError> {
    let principal = sqlx::query_scalar::<_, Uuid>(
        "SELECT principal_id FROM forge_mfa_challenges WHERE token_digest = $1",
    )
    .bind(digest.as_bytes().as_slice())
    .fetch_optional(&mut **transaction)
    .await
    .map_err(classify)?;
    match principal {
        Some(principal) => lock_sign_in(transaction, principal, None).await,
        None => Ok(false),
    }
}

/// Uses up `step_up`, a backup code given for step-up authentication, with
/// the account row locked: `true` when it was an unused code of the account
/// (or there is none), `false` otherwise, and the caller then changes
/// nothing (its transaction rolls back).
async fn spend_step_up(
    transaction: &mut Transaction<'_, Postgres>,
    principal: PrincipalId,
    step_up: Option<&MfaBackupCodeDigest>,
) -> Result<bool, AccountStoreError> {
    let Some(code) = step_up else {
        return Ok(true);
    };
    let used = sqlx::query(
        "UPDATE forge_mfa_backup_codes
         SET consumed_at = clock_timestamp()
         WHERE principal_id = $1
           AND code_digest = $2
           AND consumed_at IS NULL",
    )
    .bind(principal.into_uuid())
    .bind(code.as_bytes().as_slice())
    .execute(&mut **transaction)
    .await
    .map_err(classify)?;
    Ok(used.rows_affected() == 1)
}

/// Replaces the account's backup codes with `codes`.
async fn store_backup_codes(
    transaction: &mut Transaction<'_, Postgres>,
    principal: PrincipalId,
    codes: &[MfaBackupCodeDigest],
) -> Result<(), AccountStoreError> {
    sqlx::query("DELETE FROM forge_mfa_backup_codes WHERE principal_id = $1")
        .bind(principal.into_uuid())
        .execute(&mut **transaction)
        .await
        .map_err(classify)?;
    for code in codes {
        sqlx::query(
            "INSERT INTO forge_mfa_backup_codes (id, principal_id, code_digest)
             VALUES ($1, $2, $3)",
        )
        .bind(Id::<MfaBackupCodeMarker>::new().into_uuid())
        .bind(principal.into_uuid())
        .bind(code.as_bytes().as_slice())
        .execute(&mut **transaction)
        .await
        .map_err(classify)?;
    }
    Ok(())
}

/// Revokes every session of the account and voids its pending challenges.
async fn sign_out_everywhere(
    transaction: &mut Transaction<'_, Postgres>,
    principal: PrincipalId,
    at: i64,
) -> Result<(), AccountStoreError> {
    for statement in [
        "UPDATE forge_sessions
         SET revoked_at = GREATEST(issued_at, to_timestamp($2::double precision))
         WHERE principal_id = $1
           AND revoked_at IS NULL",
        "UPDATE forge_mfa_challenges
         SET consumed_at = to_timestamp($2::double precision)
         WHERE principal_id = $1
           AND consumed_at IS NULL",
    ] {
        sqlx::query(statement)
            .bind(principal.into_uuid())
            .bind(at)
            .execute(&mut **transaction)
            .await
            .map_err(classify)?;
    }
    Ok(())
}

async fn consume_challenge(
    transaction: &mut Transaction<'_, Postgres>,
    challenge: Uuid,
    at: i64,
) -> Result<(), AccountStoreError> {
    let consumed = sqlx::query(
        "UPDATE forge_mfa_challenges
         SET consumed_at = to_timestamp($2::double precision)
         WHERE id = $1
           AND consumed_at IS NULL",
    )
    .bind(challenge)
    .bind(at)
    .execute(&mut **transaction)
    .await
    .map_err(classify)?;
    if consumed.rows_affected() == 1 {
        Ok(())
    } else {
        Err(AccountStoreError::Conflict)
    }
}

fn digest32(bytes: Vec<u8>) -> Result<[u8; 32], AccountStoreError> {
    <[u8; 32]>::try_from(bytes.as_slice()).map_err(|_| AccountStoreError::Corrupt)
}

fn sealed(ciphertext: Vec<u8>, digest: Vec<u8>) -> Result<SealedTotpSecret, AccountStoreError> {
    Ok(SealedTotpSecret::new(
        ciphertext,
        TotpSecretDigest::from_bytes(digest32(digest)?),
    ))
}

/// The persisted last counter: -1 before the first accepted code.
fn counter_from(value: i64) -> Result<Option<u64>, AccountStoreError> {
    match value {
        -1 => Ok(None),
        _ => u64::try_from(value)
            .map(Some)
            .map_err(|_| AccountStoreError::Corrupt),
    }
}

fn timestamp(value: i64) -> Result<UnixTimestamp, AccountStoreError> {
    u64::try_from(value)
        .map(UnixTimestamp::from_secs)
        .map_err(|_| AccountStoreError::Corrupt)
}

/// The first tenant and its owner, as `setup` creates them.
#[derive(Debug)]
pub struct OwnerAccount {
    /// The tenant's slug, typed at sign-in.
    pub tenant: TenantSlug,
    /// The tenant's display name.
    pub organization: String,
    /// The owner's login (email address), stored in its canonical form.
    pub login: CanonicalLogin,
    /// The owner's hashed password.
    pub password_hash: PasswordHash,
    /// When the owner is created (also the audit event time).
    pub now: UnixTimestamp,
}

/// What `provision_owner` created.
#[derive(Clone, Copy, Debug, Eq, PartialEq)]
pub struct ProvisionedOwner {
    /// The new tenant.
    pub tenant_id: TenantId,
    /// The new owner.
    pub principal_id: PrincipalId,
}

/// Why `setup` created nothing.
#[derive(Debug, thiserror::Error)]
pub enum SetupError {
    /// A tenant exists: `setup` only bootstraps an empty identity database,
    /// so it can never add an account to, or take over, a running
    /// installation.
    #[error(
        "identity is already set up: a tenant exists, and setup only provisions an empty \
         identity database"
    )]
    AlreadyProvisioned,
    /// A principal with the owner's login exists.
    #[error("a principal with this login already exists")]
    LoginTaken,
    /// The database refused or failed the transaction.
    #[error("the database failed while creating the owner")]
    Database(#[source] sqlx::Error),
    /// A value could not be represented.
    #[error("invalid setup value")]
    Invalid,
}

impl From<sqlx::Error> for SetupError {
    fn from(error: sqlx::Error) -> Self {
        Self::Database(error)
    }
}

/// Creates the first tenant, its owner principal and the owner's active
/// membership with the [`OWNER_ROLE`], plus an `auth.setup.owner_provisioned`
/// audit event, in one transaction.
///
/// A transaction-scoped advisory lock serializes concurrent runs, and the
/// transaction refuses with [`SetupError::AlreadyProvisioned`] when any
/// tenant exists, so repeated or concurrent runs create nothing more.
/// Identifiers are UUIDv7 values generated in Rust. `pool` must use the
/// migration credential: the runtime role cannot create principals.
pub async fn provision_owner(
    pool: &PgPool,
    account: &OwnerAccount,
) -> Result<ProvisionedOwner, SetupError> {
    let tenant_id = TenantId::new();
    let principal_id = PrincipalId::new();
    let action =
        AuditAction::new("auth.setup.owner_provisioned").map_err(|_| SetupError::Invalid)?;
    let event = AuditEvent::new(
        account.now,
        AuditActor::System,
        Some(tenant_id),
        action,
        AuditOutcome::Succeeded,
    );
    let occurred_at =
        i64::try_from(event.occurred_at().as_secs()).map_err(|_| SetupError::Invalid)?;

    let mut transaction = pool.begin().await?;
    sqlx::query("SELECT pg_advisory_xact_lock($1)")
        .bind(forge::db::advisory_key(SETUP_LOCK))
        .execute(&mut *transaction)
        .await?;
    let provisioned = sqlx::query_scalar::<_, bool>("SELECT EXISTS (SELECT 1 FROM forge_tenants)")
        .fetch_one(&mut *transaction)
        .await?;
    if provisioned {
        return Err(SetupError::AlreadyProvisioned);
    }
    let taken = sqlx::query_scalar::<_, bool>(
        "SELECT EXISTS (SELECT 1 FROM forge_principals WHERE lower(login) = lower($1))",
    )
    .bind(account.login.as_str())
    .fetch_one(&mut *transaction)
    .await?;
    if taken {
        return Err(SetupError::LoginTaken);
    }

    sqlx::query("INSERT INTO forge_tenants (id, slug, name) VALUES ($1, $2, $3)")
        .bind(tenant_id.into_uuid())
        .bind(account.tenant.as_str())
        .bind(&account.organization)
        .execute(&mut *transaction)
        .await?;
    sqlx::query("INSERT INTO forge_principals (id, login, password_hash) VALUES ($1, $2, $3)")
        .bind(principal_id.into_uuid())
        .bind(account.login.as_str())
        .bind(account.password_hash.expose())
        .execute(&mut *transaction)
        .await?;
    sqlx::query(
        "INSERT INTO forge_tenant_memberships (tenant_id, principal_id, roles, state)
         VALUES ($1, $2, $3, 'active')",
    )
    .bind(tenant_id.into_uuid())
    .bind(principal_id.into_uuid())
    .bind(vec![OWNER_ROLE.to_owned()])
    .execute(&mut *transaction)
    .await?;
    sqlx::query(
        "INSERT INTO forge_audit_events (
            id, occurred_at_unix, actor_kind, principal_id, tenant_id, action, outcome
         ) VALUES ($1, $2, 'system', NULL, $3, $4, 'succeeded')",
    )
    .bind(event.id().into_uuid())
    .bind(occurred_at)
    .bind(tenant_id.into_uuid())
    .bind(event.action().as_str())
    .execute(&mut *transaction)
    .await?;
    transaction.commit().await?;

    Ok(ProvisionedOwner {
        tenant_id,
        principal_id,
    })
}

fn seconds(timestamp: UnixTimestamp) -> Result<i64, AccountStoreError> {
    i64::try_from(timestamp.as_secs()).map_err(|_| AccountStoreError::Corrupt)
}

fn classify(error: sqlx::Error) -> AccountStoreError {
    match error
        .as_database_error()
        .and_then(|database| database.code())
    {
        Some(code) if code == "23505" || code == "23503" || code == "23514" => {
            AccountStoreError::Conflict
        }
        _ => AccountStoreError::Unavailable,
    }
}
