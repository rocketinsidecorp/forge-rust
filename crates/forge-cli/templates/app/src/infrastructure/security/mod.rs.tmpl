//! Authentication mechanisms used by the generated application.
//!
//! Cryptographic primitives come from reviewed crates. This module owns
//! algorithm parameters, random credential generation, digesting, and HTTP
//! cookie serialization/parsing.

use argon2::{
    Algorithm, Argon2, Params, Version,
    password_hash::{PasswordHasher as _, PasswordVerifier as _},
};
use async_trait::async_trait;
use cookie::{Cookie, SameSite};
use forge::auth::{
    AuthenticatedPrincipal, CsrfToken, CsrfTokenDigest, PasswordCredentialStore,
    PasswordCredentialStoreError, PasswordHash, PasswordHashError, PasswordHasher, Session,
    SessionBearerToken, SessionCredentialDigest, SessionError, SessionStore, SessionStoreError,
    UnixTimestamp,
};
use forge::http::{Method, Request, header};
use forge::security::PrincipalId;
use sha2::{Digest, Sha256};

/// Name of the host-only session cookie.
///
/// The __Host- prefix requires Secure, Path=/ and no Domain attribute in
/// conforming browsers.
pub const SESSION_COOKIE_NAME: &str = "__Host-forge_session";

/// Header expected on cookie-authenticated state-changing requests.
pub const CSRF_HEADER_NAME: &str = "x-csrf-token";

const ARGON2_MEMORY_KIB: u32 = 19_456;
const ARGON2_ITERATIONS: u32 = 2;
const ARGON2_PARALLELISM: u32 = 1;
const ARGON2_OUTPUT_BYTES: usize = 32;
const MAX_PASSWORD_BYTES: usize = 1024;

/// Password hashing adapter using Argon2id v19 with the project policy.
#[derive(Clone, Copy, Debug, Default)]
pub struct Argon2idPasswordHasher;

#[async_trait]
impl PasswordHasher for Argon2idPasswordHasher {
    async fn hash(&self, password: &[u8]) -> Result<PasswordHash, PasswordHashError> {
        if password.is_empty() || password.len() > MAX_PASSWORD_BYTES {
            return Err(PasswordHashError::InvalidPassword);
        }
        let password = password.to_vec();
        tokio::task::spawn_blocking(move || hash_password_blocking(&password))
            .await
            .map_err(|_| PasswordHashError::Unavailable)?
    }

    async fn verify(
        &self,
        password: &[u8],
        expected: &PasswordHash,
    ) -> Result<bool, PasswordHashError> {
        if password.is_empty() || password.len() > MAX_PASSWORD_BYTES {
            return Err(PasswordHashError::InvalidPassword);
        }
        let password = password.to_vec();
        let expected = expected.expose().to_owned();
        tokio::task::spawn_blocking(move || verify_password_blocking(&password, &expected))
            .await
            .map_err(|_| PasswordHashError::Unavailable)?
    }

    fn needs_rehash(&self, expected: &PasswordHash) -> Result<bool, PasswordHashError> {
        password_hash_needs_rehash(expected)
    }
}

fn argon2id() -> Result<Argon2<'static>, PasswordHashError> {
    let params = Params::new(
        ARGON2_MEMORY_KIB,
        ARGON2_ITERATIONS,
        ARGON2_PARALLELISM,
        Some(ARGON2_OUTPUT_BYTES),
    )
    .map_err(|_| PasswordHashError::Unavailable)?;

    Ok(Argon2::new(Algorithm::Argon2id, Version::V0x13, params))
}

fn hash_password_blocking(password: &[u8]) -> Result<PasswordHash, PasswordHashError> {
    let encoded = argon2id()?
        .hash_password(password)
        .map_err(|_| PasswordHashError::Unavailable)?
        .to_string();

    PasswordHash::new(encoded).map_err(|_| PasswordHashError::InvalidHash)
}

fn verify_password_blocking(password: &[u8], expected: &str) -> Result<bool, PasswordHashError> {
    let parsed = argon2::PasswordHash::new(expected).map_err(|_| PasswordHashError::InvalidHash)?;

    // Verification intentionally uses the parameters encoded in the stored PHC
    // string, while restricting the accepted algorithm to Argon2id.
    if parsed.algorithm.as_str() != "argon2id" {
        return Err(PasswordHashError::InvalidHash);
    }

    Ok(Argon2::default().verify_password(password, &parsed).is_ok())
}

fn password_hash_needs_rehash(expected: &PasswordHash) -> Result<bool, PasswordHashError> {
    let encoded = expected.expose();
    let parsed = argon2::PasswordHash::new(encoded).map_err(|_| PasswordHashError::InvalidHash)?;
    if parsed.algorithm.as_str() != "argon2id" {
        return Err(PasswordHashError::InvalidHash);
    }

    let parts: Vec<&str> = encoded.split('$').collect();
    if parts.len() != 6 || !parts[0].is_empty() || parts[1] != "argon2id" {
        return Err(PasswordHashError::InvalidHash);
    }
    if parts[2] != "v=19" {
        return Ok(true);
    }

    let mut memory = None;
    let mut iterations = None;
    let mut parallelism = None;
    for parameter in parts[3].split(',') {
        let Some((name, value)) = parameter.split_once('=') else {
            return Err(PasswordHashError::InvalidHash);
        };
        let value = value
            .parse::<u32>()
            .map_err(|_| PasswordHashError::InvalidHash)?;
        match name {
            "m" if memory.replace(value).is_none() => {}
            "t" if iterations.replace(value).is_none() => {}
            "p" if parallelism.replace(value).is_none() => {}
            _ => return Err(PasswordHashError::InvalidHash),
        }
    }

    Ok(memory != Some(ARGON2_MEMORY_KIB)
        || iterations != Some(ARGON2_ITERATIONS)
        || parallelism != Some(ARGON2_PARALLELISM))
}

/// Authenticates a login/password without exposing account existence.
///
/// Missing/invalid login identifiers still perform one Argon2id operation via
/// the supplied hasher. Disabled accounts verify against their stored hash but
/// are always denied. The public result therefore does not distinguish unknown
/// login, disabled account, or wrong password.
pub async fn authenticate_password(
    store: &dyn PasswordCredentialStore,
    hasher: &dyn PasswordHasher,
    login: &str,
    password: &[u8],
) -> Result<PrincipalId, LoginError> {
    let login_valid = !login.trim().is_empty()
        && login.len() <= 320
        && !login.bytes().any(|byte| byte.is_ascii_control());
    let password_valid = !password.is_empty() && password.len() <= MAX_PASSWORD_BYTES;

    if !login_valid || !password_valid {
        perform_dummy_password_work(hasher).await?;
        return Err(LoginError::InvalidCredentials);
    }

    let credential = store
        .find_by_login(login)
        .await
        .map_err(map_credential_store_error)?;

    let Some(credential) = credential else {
        perform_dummy_password_work(hasher).await?;
        return Err(LoginError::InvalidCredentials);
    };

    let verified = hasher
        .verify(password, credential.password_hash())
        .await
        .map_err(map_password_hash_error)?;

    if !verified || credential.disabled() {
        return Err(LoginError::InvalidCredentials);
    }

    if hasher
        .needs_rehash(credential.password_hash())
        .map_err(map_password_hash_error)?
    {
        let replacement = hasher
            .hash(password)
            .await
            .map_err(map_password_hash_error)?;
        store
            .replace_password_hash(
                credential.principal_id(),
                credential.version(),
                &replacement,
            )
            .await
            .map_err(map_credential_store_error)?;
    }

    Ok(credential.principal_id())
}

async fn perform_dummy_password_work(hasher: &dyn PasswordHasher) -> Result<(), LoginError> {
    hasher
        .hash(b"forge-login-enumeration-dummy")
        .await
        .map(|_| ())
        .map_err(map_password_hash_error)
}

fn map_password_hash_error(_error: PasswordHashError) -> LoginError {
    LoginError::AuthenticationUnavailable
}

fn map_credential_store_error(error: PasswordCredentialStoreError) -> LoginError {
    match error {
        PasswordCredentialStoreError::Conflict => LoginError::InvalidCredentials,
        PasswordCredentialStoreError::Unavailable | PasswordCredentialStoreError::CorruptRecord => {
            LoginError::AuthenticationUnavailable
        }
    }
}

/// Public login result deliberately collapses all credential denials.
#[derive(Clone, Copy, Debug, thiserror::Error, Eq, PartialEq)]
pub enum LoginError {
    /// Login/password pair is not accepted.
    #[error("invalid credentials")]
    InvalidCredentials,
    /// Authentication dependencies could not complete safely.
    #[error("authentication unavailable")]
    AuthenticationUnavailable,
}

/// Fresh bearer/CSRF secrets plus their persistence digests.
#[derive(Debug)]
pub struct IssuedSessionSecrets {
    /// Secret value written to the HttpOnly session cookie.
    pub bearer: SessionBearerToken,
    /// SHA-256 digest persisted for bearer lookup.
    pub bearer_digest: SessionCredentialDigest,
    /// Secret CSRF value returned to trusted same-origin client code.
    pub csrf: CsrfToken,
    /// SHA-256 digest persisted with the session.
    pub csrf_digest: CsrfTokenDigest,
}

/// Newly persisted server-side session and the only two client-side secrets.
#[derive(Debug)]
pub struct IssuedSession {
    /// Server-side session model.
    pub session: Session,
    /// Bearer/CSRF secrets and their persistence digests.
    pub secrets: IssuedSessionSecrets,
}

/// Creates and persists a new server-side session.
///
/// The database receives only bearer/CSRF digests. The returned bearer should be
/// sent only through session_set_cookie(); the CSRF token is returned separately
/// to trusted same-origin client code and must not be put in an HttpOnly cookie.
pub async fn issue_persisted_session(
    store: &dyn SessionStore,
    principal_id: PrincipalId,
    issued_at: UnixTimestamp,
    expires_at: UnixTimestamp,
) -> Result<IssuedSession, SessionIssueError> {
    let session =
        Session::new(principal_id, issued_at, expires_at).map_err(SessionIssueError::Session)?;
    let secrets = issue_session_secrets().map_err(SessionIssueError::Mechanism)?;

    store
        .insert(&session, &secrets.bearer_digest, &secrets.csrf_digest)
        .await
        .map_err(SessionIssueError::Store)?;

    Ok(IssuedSession { session, secrets })
}

/// Failure while issuing/persisting a session.
#[derive(Debug, thiserror::Error)]
pub enum SessionIssueError {
    /// Requested lifetime violates session invariants.
    #[error("invalid session")]
    Session(#[source] SessionError),
    /// Randomness/token generation failed.
    #[error("session credential generation unavailable")]
    Mechanism(#[source] SecurityMechanismError),
    /// Durable session persistence failed.
    #[error("session persistence unavailable")]
    Store(#[source] SessionStoreError),
}

/// Generates independent 256-bit bearer and CSRF tokens from the OS CSPRNG.
pub fn issue_session_secrets() -> Result<IssuedSessionSecrets, SecurityMechanismError> {
    let bearer = random_token()?;
    let csrf = random_token()?;

    let bearer = SessionBearerToken::new(bearer)
        .map_err(|_| SecurityMechanismError::InvalidGeneratedToken)?;
    let csrf = CsrfToken::new(csrf).map_err(|_| SecurityMechanismError::InvalidGeneratedToken)?;

    Ok(IssuedSessionSecrets {
        bearer_digest: SessionCredentialDigest::from_bytes(sha256(bearer.expose())),
        csrf_digest: CsrfTokenDigest::from_bytes(sha256(csrf.expose())),
        bearer,
        csrf,
    })
}

/// Computes the persistence digest for a presented session bearer token.
#[must_use]
pub fn bearer_digest(token: &SessionBearerToken) -> SessionCredentialDigest {
    SessionCredentialDigest::from_bytes(sha256(token.expose()))
}

/// Computes the persistence digest for a presented CSRF token.
#[must_use]
pub fn csrf_digest(token: &CsrfToken) -> CsrfTokenDigest {
    CsrfTokenDigest::from_bytes(sha256(token.expose()))
}

/// Serializes the host-only session cookie.
///
/// SameSite=Lax blocks cookie attachment on most cross-site mutations while the
/// independent CSRF token remains mandatory for every unsafe method.
#[must_use]
pub fn session_set_cookie(token: &SessionBearerToken) -> String {
    Cookie::build((SESSION_COOKIE_NAME, token.expose().to_owned()))
        .path("/")
        .secure(true)
        .http_only(true)
        .same_site(SameSite::Lax)
        .build()
        .to_string()
}

/// Serializes a cookie that immediately removes the current session cookie.
#[must_use]
pub fn session_remove_cookie() -> String {
    Cookie::build(SESSION_COOKIE_NAME)
        .path("/")
        .secure(true)
        .http_only(true)
        .same_site(SameSite::Lax)
        .removal()
        .build()
        .to_string()
}

/// Extracts and validates the session bearer from a raw Cookie header.
///
/// Malformed cookie pairs are ignored; an invalid value for the Forge session
/// cookie fails the extraction rather than being silently normalized.
pub fn session_from_cookie_header(
    header_value: &str,
) -> Result<Option<SessionBearerToken>, SecurityMechanismError> {
    for parsed in Cookie::split_parse(header_value) {
        let cookie = match parsed {
            Ok(cookie) => cookie,
            Err(_) => continue,
        };
        if cookie.name() == SESSION_COOKIE_NAME {
            return SessionBearerToken::new(cookie.value().to_owned())
                .map(Some)
                .map_err(|_| SecurityMechanismError::InvalidSessionCookie);
        }
    }
    Ok(None)
}

/// Parses a CSRF header into the canonical token type.
pub fn csrf_from_header(header_value: &str) -> Result<CsrfToken, SecurityMechanismError> {
    CsrfToken::new(header_value.to_owned()).map_err(|_| SecurityMechanismError::InvalidCsrfToken)
}

/// Authenticates a Forge HTTP request from the host-only session cookie.
///
/// The database contains only the SHA-256 digest, so a leaked session table does
/// not directly reveal replayable bearer values.
pub async fn authenticate_request(
    store: &dyn SessionStore,
    request: &Request,
    now: UnixTimestamp,
) -> Result<AuthenticatedPrincipal, RequestAuthError> {
    let mut bearer = None;
    for value in request.headers().get_all(header::COOKIE).iter() {
        let value = value
            .to_str()
            .map_err(|_| RequestAuthError::InvalidSession)?;
        if let Some(found) =
            session_from_cookie_header(value).map_err(|_| RequestAuthError::InvalidSession)?
        {
            if bearer.is_some() {
                return Err(RequestAuthError::InvalidSession);
            }
            bearer = Some(found);
        }
    }

    let bearer = bearer.ok_or(RequestAuthError::MissingSession)?;
    let digest = bearer_digest(&bearer);
    let session = store
        .find_by_credential(&digest)
        .await
        .map_err(map_session_store_error)?
        .ok_or(RequestAuthError::InvalidSession)?;

    session
        .authenticate(now)
        .map_err(|_| RequestAuthError::InvalidSession)
}

/// Enforces CSRF for methods that can mutate state.
///
%%if views%%
/// Safe methods do not require a token. Unsafe methods require exactly one
/// canonical token, from the `x-csrf-token` header or the `csrf_token` field
/// of a form body (read with the same rules as `forge::views::CsrfProtection`),
/// whose digest is bound to the authenticated server-side session. At login,
/// set the form CSRF cookie to the session's token with
/// `forge::views::csrf_cookie` so HTML forms carry it.
%%end%%
%%if !views%%
/// Safe methods do not require the CSRF header. Unsafe methods require exactly
/// one canonical token whose digest is bound to the authenticated server-side
/// session.
%%end%%
pub async fn enforce_csrf(
    store: &dyn SessionStore,
    request: &Request,
    authenticated: AuthenticatedPrincipal,
) -> Result<(), RequestAuthError> {
    if is_safe_method(request.method()) {
        return Ok(());
    }

%%if views%%
    let token = forge::views::presented_csrf_token(request)
        .map_err(|_| RequestAuthError::InvalidCsrf)?
        .ok_or(RequestAuthError::MissingCsrf)?;
%%end%%
%%if !views%%
    let mut values = request.headers().get_all(CSRF_HEADER_NAME).iter();
    let value = values.next().ok_or(RequestAuthError::MissingCsrf)?;
    if values.next().is_some() {
        return Err(RequestAuthError::InvalidCsrf);
    }
    let value = value.to_str().map_err(|_| RequestAuthError::InvalidCsrf)?;
    let token = csrf_from_header(value).map_err(|_| RequestAuthError::InvalidCsrf)?;
%%end%%
    let digest = csrf_digest(&token);

    match store
        .verify_csrf(authenticated.session_id(), &digest)
        .await
        .map_err(map_session_store_error)?
    {
        true => Ok(()),
        false => Err(RequestAuthError::InvalidCsrf),
    }
}

/// Returns whether a method is safe according to HTTP semantics.
#[must_use]
pub fn is_safe_method(method: &Method) -> bool {
    method == Method::GET
        || method == Method::HEAD
        || method == Method::OPTIONS
        || method == Method::TRACE
}

fn map_session_store_error(error: SessionStoreError) -> RequestAuthError {
    match error {
        SessionStoreError::Unavailable => RequestAuthError::AuthenticationUnavailable,
        SessionStoreError::Conflict | SessionStoreError::CorruptRecord => {
            RequestAuthError::InvalidSession
        }
    }
}

/// Generic request authentication failure suitable for mapping to 401/403/503
/// without revealing whether a session ID, token, principal or CSRF value existed.
#[derive(Clone, Copy, Debug, thiserror::Error, Eq, PartialEq)]
pub enum RequestAuthError {
    /// No Forge session cookie was supplied.
    #[error("authentication required")]
    MissingSession,
    /// Session cookie/session record was invalid, expired or revoked.
    #[error("invalid session")]
    InvalidSession,
    /// Required CSRF proof was not supplied.
    #[error("CSRF token required")]
    MissingCsrf,
    /// CSRF proof was malformed or did not match the authenticated session.
    #[error("invalid CSRF token")]
    InvalidCsrf,
    /// Durable authentication storage is unavailable.
    #[error("authentication unavailable")]
    AuthenticationUnavailable,
}

fn random_token() -> Result<String, SecurityMechanismError> {
    let mut bytes = [0_u8; 32];
    getrandom::fill(&mut bytes).map_err(|_| SecurityMechanismError::RandomnessUnavailable)?;
    Ok(hex_lower(&bytes))
}

fn sha256(value: &str) -> [u8; 32] {
    let output = Sha256::digest(value.as_bytes());
    let mut bytes = [0_u8; 32];
    bytes.copy_from_slice(&output);
    bytes
}

fn hex_lower(bytes: &[u8]) -> String {
    const HEX: &[u8; 16] = b"0123456789abcdef";
    let mut encoded = String::with_capacity(bytes.len() * 2);
    for byte in bytes {
        encoded.push(char::from(HEX[usize::from(byte >> 4)]));
        encoded.push(char::from(HEX[usize::from(byte & 0x0f)]));
    }
    encoded
}

/// Failure in authentication infrastructure without secret-bearing diagnostics.
#[derive(Clone, Copy, Debug, thiserror::Error, Eq, PartialEq)]
pub enum SecurityMechanismError {
    /// OS randomness source could not provide a complete credential.
    #[error("secure randomness unavailable")]
    RandomnessUnavailable,
    /// Generated token failed the framework's own canonical encoding invariant.
    #[error("generated authentication token was invalid")]
    InvalidGeneratedToken,
    /// Session cookie contained a malformed Forge bearer token.
    #[error("invalid session cookie")]
    InvalidSessionCookie,
    /// CSRF header contained a malformed token.
    #[error("invalid CSRF token")]
    InvalidCsrfToken,
}

#[cfg(test)]
mod tests {
    use super::*;

    fn result_ok<T, E: std::fmt::Debug>(result: Result<T, E>, context: &str) -> T {
        match result {
            Ok(value) => value,
            Err(error) => panic!("{context}: {error:?}"),
        }
    }

    fn option_some<T>(value: Option<T>, context: &str) -> T {
        match value {
            Some(value) => value,
            None => panic!("{context}"),
        }
    }

    #[test]
    fn argon2id_policy_hashes_and_verifies_passwords() {
        let hash = result_ok(
            hash_password_blocking(b"correct horse battery staple"),
            "Argon2id hashing should succeed",
        );
        assert!(hash.expose().starts_with("$argon2id$v=19$m=19456,t=2,p=1$"));
        assert!(result_ok(
            verify_password_blocking(b"correct horse battery staple", hash.expose()),
            "stored PHC hash should verify",
        ));
        assert!(!result_ok(
            verify_password_blocking(b"wrong password", hash.expose()),
            "wrong password should be a normal denial",
        ));
    }

    #[test]
    fn argon2id_policy_detects_hashes_that_need_upgrade() {
        let current = result_ok(
            hash_password_blocking(b"upgrade me"),
            "current policy hash should succeed",
        );
        assert!(!result_ok(
            password_hash_needs_rehash(&current),
            "current policy should parse",
        ));

        let weaker = current
            .expose()
            .replacen("m=19456,t=2,p=1", "m=8192,t=1,p=1", 1);
        let weaker = result_ok(
            PasswordHash::new(weaker),
            "weaker PHC string should satisfy the framework envelope",
        );
        assert!(result_ok(
            password_hash_needs_rehash(&weaker),
            "older policy should request rehash",
        ));
    }

    #[test]
    fn issued_secrets_are_independent_and_canonical() {
        let issued = result_ok(issue_session_secrets(), "OS randomness should be available");
        assert_eq!(issued.bearer.expose().len(), 64);
        assert_eq!(issued.csrf.expose().len(), 64);
        assert_ne!(issued.bearer.expose(), issued.csrf.expose());
        assert_eq!(bearer_digest(&issued.bearer), issued.bearer_digest);
        assert_eq!(csrf_digest(&issued.csrf), issued.csrf_digest);
    }

    #[test]
    fn cookie_is_host_only_secure_http_only_and_lax() {
        let token = result_ok(SessionBearerToken::new("ab".repeat(32)), "valid token");
        let rendered = session_set_cookie(&token);
        assert!(rendered.starts_with("__Host-forge_session="));
        assert!(rendered.contains("Path=/"));
        assert!(rendered.contains("Secure"));
        assert!(rendered.contains("HttpOnly"));
        assert!(rendered.contains("SameSite=Lax"));
        assert!(!rendered.contains("Domain="));
    }

    #[test]
    fn csrf_is_required_only_for_unsafe_methods() {
        for safe in [Method::GET, Method::HEAD, Method::OPTIONS, Method::TRACE] {
            assert!(is_safe_method(&safe));
        }
        for unsafe_method in [Method::POST, Method::PUT, Method::PATCH, Method::DELETE] {
            assert!(!is_safe_method(&unsafe_method));
        }
    }

    #[test]
    fn cookie_parser_uses_cookie_grammar_and_rejects_bad_session_value() {
        let token = "ab".repeat(32);
        let header = format!("other=1; {SESSION_COOKIE_NAME}={token}; another=2");
        let parsed = option_some(
            result_ok(
                session_from_cookie_header(&header),
                "cookie header should parse",
            ),
            "session cookie should exist",
        );
        assert_eq!(parsed.expose(), token);

        assert_eq!(
            session_from_cookie_header("__Host-forge_session=short"),
            Err(SecurityMechanismError::InvalidSessionCookie)
        );
    }
}
