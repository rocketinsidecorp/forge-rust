};

/// The sign-in page. Protected pages send signed-out browsers here.
pub const SIGN_IN_PATH: &str = "/session/new";
/// Where a sign-in without a valid return path lands.
pub const AFTER_SIGN_IN_PATH: &str = "/";
/// How long a session lasts after signing in.
pub const SESSION_LIFETIME: Duration = Duration::from_secs(24 * 60 * 60);

const NEW_PASSWORD_PATH: &str = "/passwords/new";

/// Reset requests waiting for the background worker; more are dropped
/// (and logged) rather than slowing or failing the page.
pub const RESET_QUEUE_CAPACITY: usize = 256;
/// The reset-request page never answers faster than this, whatever
/// happened, so its timing does not tell whether an account exists.
pub const RESET_RESPONSE_TIME: Duration = Duration::from_millis(100);

/// The only message a failed sign-in shows: it must not say whether the
/// organization, the email or the password was wrong.
const INVALID_CREDENTIALS: &str = "That organization, email and password do not match an account.";
/// The only answer to a reset request, whether or not the account exists.
const RESET_REQUESTED: &str =
    "If that account exists, password reset instructions are on their way to its email address.";
const RESET_INVALID: &str = "That reset link is invalid or has expired. Request a new one.";

/// What the pages need: the identity stores, the password hasher, the
/// reset-link notifier, the audit sink and the attempt throttles.
#[derive(Clone)]
pub struct AuthenticationPorts {
    pub credentials: Arc<dyn PasswordCredentialStore>,
    pub hasher: Arc<dyn PasswordHasher>,
    pub sessions: Arc<dyn SessionStore>,
    pub memberships: Arc<dyn MembershipStore>,
    pub tenants: Arc<dyn TenantDirectory>,
    pub resets: Arc<dyn PasswordResetStore>,
    /// Delivers reset links: `forge::mail::PasswordResetMailer` when mail is
    /// configured, otherwise `forge::auth::UndeliverablePasswordResets`,
    /// which delivers nothing (see `forge::mail::password_reset_notifier`).
    pub notifier: Arc<dyn PasswordResetNotifier>,
    pub audit: Arc<dyn AuditSink>,
    /// Sign-in attempts per account and source.
    pub sign_in_throttle: Arc<dyn LoginThrottle>,
    /// Reset requests and reset submissions per account (or link) and source.
    pub reset_throttle: Arc<dyn LoginThrottle>,
}

struct Pages {
    site: Arc<Site>,
    ports: AuthenticationPorts,
    resets: WorkQueue<ResetRequest>,
}

/// A reset request for the background worker: a syntactically valid
/// organization and login, whether or not they exist.
struct ResetRequest {
    tenant: TenantSlug,
    login: CanonicalLogin,
    received_at: UnixTimestamp,
}

/// Registers the pages, the reset-request worker (a bounded queue owned by
/// the process lifecycle) and the [`SignInRedirect`] layer that sends
/// signed-out browsers asking for a protected page (a `401` from an access
/// policy) to [`SIGN_IN_PATH`]; JSON clients keep the `401`. The site's
/// CSRF and flash layers must be registered first (`Site::register`).
pub fn routes(
    composition: &mut Composition<'_>,
    site: &Arc<Site>,
    ports: AuthenticationPorts,
) -> Result<(), ComposeError> {
    let worker_ports = ports.clone();
    let resets = composition.work_queue(
        "password_resets",
        RESET_QUEUE_CAPACITY,
        move |request: ResetRequest| {
            let ports = worker_ports.clone();
            async move {
                if let Err(failure) = request_reset(&ports, &request).await {
                    // Logged for operators; the visitor already got the
                    // uniform answer.
                    forge::web::report(&failure);
                }
            }
        },
    );
    let router = composition.router();
    router.layer(SignInRedirect::new(SIGN_IN_PATH).map_err(ComposeError::other)?);
    let pages = Arc::new(Pages {
        site: Arc::clone(site),
        ports,
        resets,
    });
    route(router, &pages, Method::GET, SIGN_IN_PATH, new_session)?;
    route(router, &pages, Method::POST, "/session", create_session)?;
    route(router, &pages, Method::DELETE, "/session", destroy_session)?;
    route(router, &pages, Method::GET, NEW_PASSWORD_PATH, new_password)?;
    route(router, &pages, Method::POST, "/passwords", create_password)?;
    route(
        router,
        &pages,
        Method::GET,
        "/passwords/edit",
        edit_password,
    )?;
    route(router, &pages, Method::PATCH, "/passwords", update_password)?;
    Ok(())
}

fn route<H, F>(
    router: &mut forge::http::Router,
    pages: &Arc<Pages>,
    method: Method,
    path: &str,
    handler: H,
) -> Result<(), ComposeError>
where
    H: Fn(Arc<Pages>, Request) -> F + Send + Sync + 'static,
    F: Future<Output = Response> + Send + 'static,
{
    let pages = Arc::clone(pages);
    router.route(method, path, move |request: Request| {
        handler(Arc::clone(&pages), request)
    })?;
    Ok(())
}

/// `?tenant=` pre-fills the organization; `?return_to=` comes from
/// `SignInRedirect`.
#[derive(Default, serde::Deserialize)]
struct SignInQuery {
    tenant: Option<String>,
    return_to: Option<String>,
}

#[derive(Default, serde::Deserialize)]
struct SignInForm {
    #[serde(default)]
    tenant: String,
    #[serde(default)]
    email: String,
    #[serde(default)]
    password: String,
    #[serde(default)]
    return_to: String,
}

#[derive(Default, serde::Deserialize)]
struct ResetRequestForm {
    #[serde(default)]
    tenant: String,
    #[serde(default)]
    email: String,
}

#[derive(Default, serde::Deserialize)]
struct ResetQuery {
    token: Option<String>,
}

#[derive(Default, serde::Deserialize)]
struct ResetForm {
    #[serde(default)]
    token: String,
    #[serde(default)]
    password: String,
    #[serde(default)]
    password_confirmation: String,
}

/// The sign-in form, as shown again after a failure (never the password).
struct SignInValues {
    tenant: String,
    email: String,
    return_to: String,
}

async fn new_session(pages: Arc<Pages>, request: Request) -> Response {
    let query = request.query::<SignInQuery>().unwrap_or_default();
    let values = SignInValues {
        tenant: query.tenant.unwrap_or_default(),
        email: String::new(),
        return_to: local_path(query.return_to.as_deref()),
    };
    let signed_in = match now() {
        Some(now) => authenticate_request(pages.ports.sessions.as_ref(), &request, now)
            .await
            .is_ok(),
        None => false,
    };
    render_sign_in(&pages, &request, values, None, signed_in, StatusCode::OK)
}

/// Signs in. Security steps: CSRF verified, throttle before any credential
/// check, one uniform failure, a fresh session and CSRF token, a validated
/// return path.
async fn create_session(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return forbidden();
    }
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let form = request.form::<SignInForm>().unwrap_or_default();
    let values = SignInValues {
        tenant: form.tenant.trim().to_owned(),
        email: form.email.trim().to_owned(),
        return_to: local_path(Some(&form.return_to)),
    };
    let ports = &pages.ports;
    // A login that is not canonical (non-ASCII, for example) is an unknown
    // account: it is checked as an empty login, which costs the same hash.
    let login = CanonicalLogin::parse(&values.email).ok();

    let key = ThrottleKey::new(
        "sign_in",
        &account_key(login.as_ref(), &values.email),
        Some(request.client_ip()),
    );
    match ports.sign_in_throttle.attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => {
            let message = too_many_attempts("sign-in", retry_after);
            let mut response = render_sign_in(
                &pages,
                &request,
                values,
                Some(message),
                false,
                StatusCode::TOO_MANY_REQUESTS,
            );
            set_retry_after(&mut response, retry_after);
            return response;
        }
        Err(_) => return unavailable("sign_in_throttle_unavailable"),
    }

    // The password is verified first, also for an unknown organization, and
    // the tenant lookups run either way, so every failure costs the same.
    let principal = match authenticate_password(
        ports.credentials.as_ref(),
        ports.hasher.as_ref(),
        login.as_ref().map_or("", CanonicalLogin::as_str),
        form.password.as_bytes(),
    )
    .await
    {
        Ok(principal) => Some(principal),
        Err(LoginError::InvalidCredentials) => None,
        Err(LoginError::AuthenticationUnavailable) => {
            return unavailable("authentication_unavailable");
        }
    };
    let member = match active_tenant(ports, &values.tenant, principal).await {
        Ok(tenant) => principal.zip(tenant),
        Err(failure) => return failed(failure),
    };
    let Some((principal, tenant)) = member else {
        record(
            ports,
            now,
            AuditActor::Anonymous,
            None,
            "auth.sign_in",
            AuditOutcome::Failed,
        )
        .await;
        return render_sign_in(
            &pages,
            &request,
            values,
            Some(INVALID_CREDENTIALS.to_owned()),
            false,
            StatusCode::UNPROCESSABLE_ENTITY,
        );
    };
    if ports.sign_in_throttle.success(&key).await.is_err() {
        return unavailable("sign_in_throttle_unavailable");
    }

    // Session fixation: a session this browser already holds ends here.
    match authenticate_request(ports.sessions.as_ref(), &request, now).await {
        Ok(previous) => {
            if ports
                .sessions
                .revoke(previous.session_id(), now)
                .await
                .is_err()
            {
                return unavailable("session_store_unavailable");
            }
        }
        Err(RequestAuthError::AuthenticationUnavailable) => {
            return unavailable("session_store_unavailable");
        }
        Err(_) => {}
    }
    let Some(expires_at) = now.as_secs().checked_add(SESSION_LIFETIME.as_secs()) else {
        return unavailable("clock_unavailable");
    };
    let issued = match issue_persisted_session(
        ports.sessions.as_ref(),
        principal,
        now,
        UnixTimestamp::from_secs(expires_at),
    )
    .await
    {
        Ok(issued) => issued,
        Err(error) => return unavailable_because("session_store_unavailable", error),
    };
    record(
        ports,
        now,
        AuditActor::Principal(principal),
        Some(tenant),
        "auth.sign_in",
        AuditOutcome::Succeeded,
    )
    .await;

    let target = if values.return_to.is_empty() {
        AFTER_SIGN_IN_PATH
    } else {
        values.return_to.as_str()
    };
    let mut response = redirect(target, Flash::new().with_notice("Signed in."));
    set_cookie(&mut response, &session_set_cookie(&issued.secrets.bearer));
    // The form CSRF cookie now holds the new session's CSRF token, so pages
    // render it and the session-bound check (ADR 0014) agrees.
    set_cookie(&mut response, &csrf_cookie(&issued.secrets.csrf));
    no_store(&mut response);
    response
}

/// Signs out: revokes the session (after its session-bound CSRF check),
/// clears the session cookie and rotates the CSRF token. Idempotent for a
/// browser without a valid session.
async fn destroy_session(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return forbidden();
    }
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let ports = &pages.ports;
    match authenticate_request(ports.sessions.as_ref(), &request, now).await {
        Ok(principal) => {
            if enforce_csrf(ports.sessions.as_ref(), &request, principal)
                .await
                .is_err()
            {
                return forbidden();
            }
            if ports
                .sessions
                .revoke(principal.session_id(), now)
                .await
                .is_err()
            {
                return unavailable("session_store_unavailable");
            }
            record(
                ports,
                now,
                AuditActor::Principal(principal.principal_id()),
                None,
                "auth.sign_out",
                AuditOutcome::Succeeded,
            )
            .await;
        }
        Err(RequestAuthError::AuthenticationUnavailable) => {
            return unavailable("session_store_unavailable");
        }
        Err(_) => {}
    }
    signed_out(SIGN_IN_PATH, Flash::new().with_notice("Signed out."))
}

async fn new_password(pages: Arc<Pages>, request: Request) -> Response {
    let tenant = request
        .query::<SignInQuery>()
        .unwrap_or_default()
        .tenant
        .unwrap_or_default();
    render_password_new(
        &pages,
        &request,
        tenant,
        String::new(),
        None,
        StatusCode::OK,
    )
}

/// Asks for a reset link. Every outcome but throttling answers the same,
/// no sooner than [`RESET_RESPONSE_TIME`]: the account is looked up, and the
/// link issued and delivered, by the background worker, so neither the
/// answer nor its timing tells whether an account exists or a link was
/// delivered.
async fn create_password(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return forbidden();
    }
    forge::web::at_least(RESET_RESPONSE_TIME, request_password_reset(pages, request)).await
}

async fn request_password_reset(pages: Arc<Pages>, request: Request) -> Response {
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let form = request.form::<ResetRequestForm>().unwrap_or_default();
    let tenant = form.tenant.trim().to_owned();
    let email = form.email.trim().to_owned();
    let login = CanonicalLogin::parse(&email).ok();
    let key = ThrottleKey::new(
        "password_reset",
        &account_key(login.as_ref(), &email),
        Some(request.client_ip()),
    );
    match pages.ports.reset_throttle.attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => {
            let message = too_many_attempts("reset", retry_after);
            let mut response = render_password_new(
                &pages,
                &request,
                tenant,
                email,
                Some(message),
                StatusCode::TOO_MANY_REQUESTS,
            );
            set_retry_after(&mut response, retry_after);
            return response;
        }
        Err(_) => return unavailable("password_reset_throttle_unavailable"),
    }
    // Only well-formed requests are worth queueing; the rest name no
    // account and get the same answer.
    if let (Ok(tenant), Some(login)) = (TenantSlug::parse_input(&tenant), login) {
        let queued = pages.resets.submit(ResetRequest {
            tenant,
            login,
            received_at: now,
        });
        if let Err(error) = queued {
            forge::web::report(
                &ForgeError::new(
                    ErrorCategory::Infrastructure,
                    "password_reset_queue_full",
                    "password reset request dropped",
                )
                .with_source(error),
            );
        }
    }
    redirect(SIGN_IN_PATH, Flash::new().with_notice(RESET_REQUESTED))
}

/// The background worker's step: issues and delivers a reset link when the
/// request names an enabled account with an active membership; otherwise
/// does nothing. The link goes to the login as stored, never as typed.
async fn request_reset(
    ports: &AuthenticationPorts,
    request: &ResetRequest,
) -> Result<(), ForgeError> {
    let failed = |code: &'static str| {
        ForgeError::new(ErrorCategory::Infrastructure, code, "password reset failed")
    };
    let Some(tenant_id) = ports
        .tenants
        .find_by_slug(&request.tenant)
        .await
        .map_err(|error| failed("tenant_directory_unavailable").with_source(error))?
    else {
        return Ok(());
    };
    let Some(credential) = ports
        .credentials
        .find_by_login(request.login.as_str())
        .await
        .map_err(|error| failed("credential_store_unavailable").with_source(error))?
    else {
        return Ok(());
    };
    if credential.disabled() {
        return Ok(());
    }
    let Some(stored_login) = credential.login().map(str::to_owned) else {
        // A store that does not return the stored login cannot be trusted
        // with an address: deliver nothing.
        return Err(failed("password_reset_without_stored_login"));
    };
    let principal = credential.principal_id();
    let active = ports
        .memberships
        .find(tenant_id, principal)
        .await
        .map_err(|error| failed("membership_store_unavailable").with_source(error))?
        .is_some_and(|membership| membership.state() == MembershipState::Active);
    if !active {
        return Ok(());
    }

    let now = request.received_at;
    let token = PasswordResetToken::generate()
        .map_err(|error| failed("password_reset_token_unavailable").with_source(error))?;
    let expires_at =
        UnixTimestamp::from_secs(now.as_secs().saturating_add(PASSWORD_RESET_LIFETIME_SECS));
    let grant = PasswordResetGrant::new(principal, tenant_id, token.digest(), now, expires_at)
        .map_err(|error| failed("password_reset_invalid").with_source(error))?;
    ports
        .resets
        .issue(&grant)
        .await
        .map_err(|error| failed("password_reset_store_unavailable").with_source(error))?;
    record(
        ports,
        now,
        AuditActor::Principal(principal),
        Some(tenant_id),
        "auth.password_reset.requested",
        AuditOutcome::Succeeded,
    )
    .await;
    // The token leaves this process only through the notifier.
    ports
        .notifier
        .deliver(&PasswordResetDelivery::new(stored_login, token, expires_at))
        .await
        .map_err(|error| failed("password_reset_delivery_failed").with_source(error))
}

/// The page a reset link opens. Only the token's format is checked here;
/// the token moves into a hidden field of a `no-store`, `no-referrer` page.
async fn edit_password(pages: Arc<Pages>, request: Request) -> Response {
    let query = request.query::<ResetQuery>().unwrap_or_default();
    let Some(token) = query
        .token
        .and_then(|token| PasswordResetToken::new(token).ok())
    else {
        return reset_page(redirect(
            NEW_PASSWORD_PATH,
            Flash::new().with_alert(RESET_INVALID),
        ));
    };
    render_password_edit(
        &pages,
        &request,
        &token,
        None,
        FieldErrors::new(),
        StatusCode::OK,
    )
}

/// Sets the new password with a reset token: the token is redeemed once,
/// the password changes and every session of the account is revoked.
async fn update_password(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return reset_page(forbidden());
    }
    let Some(now) = now() else {
        return reset_page(unavailable("clock_unavailable"));
    };
    let form = request.form::<ResetForm>().unwrap_or_default();
    let Ok(token) = PasswordResetToken::new(form.token) else {
        return reset_page(redirect(
            NEW_PASSWORD_PATH,
            Flash::new().with_alert(RESET_INVALID),
        ));
    };
    let ports = &pages.ports;
    let key = ThrottleKey::new("password_update", token.expose(), Some(request.client_ip()));
    match ports.reset_throttle.attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => {
            let message = too_many_attempts("reset", retry_after);
            let mut response = render_password_edit(
                &pages,
                &request,
                &token,
                Some(message),
                FieldErrors::new(),
                StatusCode::TOO_MANY_REQUESTS,
            );
            set_retry_after(&mut response, retry_after);
            return response;
        }
        Err(_) => return reset_page(unavailable("password_reset_throttle_unavailable")),
    }
    // An unknown, used or expired token ends here, before the expensive
    // password hash.
    match ports.resets.is_redeemable(&token.digest(), now).await {
        Ok(true) => {}
        Ok(false) => {
            return reset_page(redirect(
                NEW_PASSWORD_PATH,
                Flash::new().with_alert(RESET_INVALID),
            ));
        }
        Err(error) => {
            return reset_page(unavailable_because(
                "password_reset_store_unavailable",
                error,
            ));
        }
    }

    let mut errors = FieldErrors::new();
    let password = match NewPassword::new(form.password.as_str()) {
        Ok(password) => Some(password),
        Err(violation) => {
            errors.add("password", violation.to_string());
            None
        }
    };
    if form.password_confirmation != form.password {
        errors.add("password_confirmation", "does not match the password");
    }
    let Some(password) = password.filter(|_| errors.is_empty()) else {
        return render_password_edit(
            &pages,
            &request,
            &token,
            None,
            errors,
            StatusCode::UNPROCESSABLE_ENTITY,
        );
    };

    let hash = match ports.hasher.hash(password.expose()).await {
        Ok(hash) => hash,
        Err(_) => return reset_page(unavailable("password_hashing_unavailable")),
    };
    match ports.resets.redeem(&token.digest(), now, &hash).await {
        Ok(Some(redeemed)) => {
            record(
                ports,
                now,
                AuditActor::Principal(redeemed.principal_id),
                Some(redeemed.tenant_id),
                "auth.password_reset.completed",
                AuditOutcome::Succeeded,
            )
            .await;
            reset_page(signed_out(
                SIGN_IN_PATH,
                Flash::new()
                    .with_notice("Your password was changed. Sign in with the new password."),
            ))
        }
        Ok(None) => reset_page(redirect(
            NEW_PASSWORD_PATH,
            Flash::new().with_alert(RESET_INVALID),
        )),
        Err(error) => reset_page(unavailable_because(
            "password_reset_store_unavailable",
            error,
        )),
    }
}

/// The tenant named `tenant` when `principal` is an active member of it.
///
/// The same lookups run whatever was typed and whether or not the password
/// was right: a malformed organization looks up a random slug, an unknown
/// one a random tenant, a wrong password a random principal, so the
/// response time does not tell these cases apart.
async fn active_tenant(
    ports: &AuthenticationPorts,
    tenant: &str,
    principal: Option<PrincipalId>,
) -> Result<Option<TenantId>, ForgeError> {
    let failed = |code: &'static str| {
        ForgeError::new(
            ErrorCategory::Infrastructure,
            code,
            "service temporarily unavailable",
        )
    };
    let slug = TenantSlug::parse_input(tenant);
    let lookup = match &slug {
        Ok(slug) => slug.clone(),
        Err(_) => {
            random_slug().map_err(|error| failed("tenant_slug_invalid").with_source(error))?
        }
    };
    let found = ports
        .tenants
        .find_by_slug(&lookup)
        .await
        .map_err(|error| failed("tenant_directory_unavailable").with_source(error))?
        .filter(|_| slug.is_ok());
    // `default()` ids are new random UUIDv7 values that match nothing.
    let active = ports
        .memberships
        .find(found.unwrap_or_default(), principal.unwrap_or_default())
        .await
        .map_err(|error| failed("membership_store_unavailable").with_source(error))?
        .is_some_and(|membership| membership.state() == MembershipState::Active);
    Ok(found.filter(|_| active && principal.is_some()))
}

/// A valid slug no tenant has: `z` and 32 random hex digits.
fn random_slug() -> Result<TenantSlug, forge::tenancy::TenantSlugError> {
    TenantSlug::new(format!("z{}", TenantId::new().into_uuid().simple()))
}

/// Appends an audit event. A failed write is logged and does not change
/// the response (the visitor's outcome is already decided).
async fn record(
    ports: &AuthenticationPorts,
    now: UnixTimestamp,
    actor: AuditActor,
    tenant: Option<TenantId>,
    action: &'static str,
    outcome: AuditOutcome,
) {
    let failure = |code: &'static str| {
        ForgeError::new(
            ErrorCategory::Infrastructure,
            code,
            "audit event not recorded",
        )
    };
    let action = match AuditAction::new(action) {
        Ok(action) => action,
        Err(error) => {
            return forge::web::report(&failure("audit_action_invalid").with_source(error));
        }
    };
    let event = AuditEvent::new(now, actor, tenant, action, outcome);
    if let Err(error) = ports.audit.append(&event).await {
        forge::web::report(&failure("audit_unavailable").with_source(error));
    }
}

fn render_sign_in(
    pages: &Pages,
    request: &Request,
    values: SignInValues,
    error: Option<String>,
    signed_in: bool,
    status: StatusCode,
) -> Response {
    let mut response = forge::web::html_with_status(
        status,
        &SessionNew {
            layout: pages.site.layout(request, "Sign in"),
            csrf_field: csrf_field_for(request),
            tenant: values.tenant,
            email: values.email,
            return_to: values.return_to,
            error,
            signed_in,
        },
    );
    no_store(&mut response);
    response
}

fn render_password_new(
    pages: &Pages,
    request: &Request,
    tenant: String,
    email: String,
    error: Option<String>,
    status: StatusCode,
) -> Response {
    forge::web::html_with_status(
        status,
        &PasswordNew {
            layout: pages.site.layout(request, "Forgot your password?"),
            csrf_field: csrf_field_for(request),
            tenant,
            email,
            error,
        },
    )
}

fn render_password_edit(
    pages: &Pages,
    request: &Request,
    token: &PasswordResetToken,
    error: Option<String>,
    errors: FieldErrors,
    status: StatusCode,
) -> Response {
    reset_page(forge::web::html_with_status(
        status,
        &PasswordEdit {
