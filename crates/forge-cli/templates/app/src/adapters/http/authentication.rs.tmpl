async fn render_mfa_show(
    pages: &Pages,
    request: &Request,
    principal: PrincipalId,
    error: Option<String>,
    status: StatusCode,
) -> Response {
    let status_of = match pages.ports.mfa.status(principal).await {
        Ok(status_of) => status_of,
        Err(failure) => return unavailable_because("mfa_unavailable", failure),
    };
    let i18n = pages.site.i18n(request);
    let remaining = status_of
        .map(|factor| {
            i18n.t("mfa.show.remaining")
                .count(factor.remaining_backup_codes)
                .text()
        })
        .unwrap_or_default();
    let mut response = forge::web::html_with_status(
        status,
        &MfaShow {
            layout: pages.site.layout(request),
            csrf_field: csrf_field_for(request),
            configured: pages.ports.mfa.is_configured(),
            enabled: status_of.is_some(),
            remaining,
            error,
        },
    );
    no_store(&mut response);
    response
}

fn render_mfa_new(
    pages: &Pages,
    request: &Request,
    enrollment: &TotpEnrollment,
    change: MfaChange,
    error: Option<String>,
    status: StatusCode,
) -> Response {
    let key = enrollment.secret.base32();
    let grouped = key
        .as_bytes()
        .chunks(4)
        .map(|chunk| String::from_utf8_lossy(chunk).into_owned())
        .collect::<Vec<_>>()
        .join(" ");
    reset_page(forge::web::html_with_status(
        status,
        &MfaNew {
            layout: pages.site.layout(request),
            csrf_field: csrf_field_for(request),
            rotation: change == MfaChange::Rotation,
            key: grouped,
            provisioning_uri: enrollment.provisioning_uri.expose().to_owned(),
            error,
        },
    ))
}

fn render_backup_codes(
    pages: &Pages,
    request: &Request,
    codes: Vec<String>,
    signed_out: bool,
) -> Response {
    reset_page(forge::web::html_with_status(
        StatusCode::OK,
        &MfaBackupCodes {
            layout: pages.site.layout(request),
            codes,
            signed_out,
        },
    ))
}

/// `candidate` when it is a local path to return to, empty otherwise.
fn local_path(candidate: Option<&str>) -> String {
    candidate
        .and_then(return_path)
        .unwrap_or_default()
        .to_owned()
}

/// The identity a throttle counts attempts against, whether or not it exists.
///
/// Passwords belong to the principal, not to a tenant, so the key is the
/// canonical login alone: changing the organization field or the letter
/// case does not reset the count. A login that is not canonical can match
/// no account; it is counted by its trimmed text.
fn account_key(login: Option<&CanonicalLogin>, typed: &str) -> String {
    match login {
        Some(login) => login.as_str().to_owned(),
        None => format!("invalid\0{}", typed.trim()),
    }
}

fn now() -> Option<UnixTimestamp> {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .ok()
        .map(|elapsed| UnixTimestamp::from_secs(elapsed.as_secs()))
}

/// The throttling message `message` (a `throttled.*` key, plural by
/// minutes) for a wait of `retry_after`.
fn too_many_attempts(message: Translation<'_>, retry_after: Duration) -> String {
    let minutes = retry_after.as_secs().div_ceil(60).max(1);
    message.count(minutes).text()
}

/// The answer to a reset link that is unknown, used or expired.
fn invalid_link(pages: &Pages, request: &Request) -> String {
    pages.site.i18n(request).t("passwords.invalid_link").text()
}

fn set_retry_after(response: &mut Response, retry_after: Duration) {
    let seconds = retry_after.as_secs().max(1);
    if let Ok(value) = HeaderValue::from_str(&seconds.to_string()) {
        response.headers_mut().insert(header::RETRY_AFTER, value);
    }
}

/// A `303 See Other` to a local path, carrying `flash`.
fn redirect(location: &str, flash: Flash) -> Response {
    let Ok(mut response) = see_other(location) else {
        return Response::empty(StatusCode::INTERNAL_SERVER_ERROR);
    };
    if flash.set_on(&mut response).is_err() {
        return Response::empty(StatusCode::INTERNAL_SERVER_ERROR);
    }
    no_store(&mut response);
    response
}

/// A redirect that clears the session cookie and rotates the CSRF token.
fn signed_out(location: &str, flash: Flash) -> Response {
    let Ok(secrets) = issue_session_secrets() else {
        return unavailable("csrf_token_unavailable");
    };
    let mut response = redirect(location, flash);
    set_cookie(&mut response, &session_remove_cookie());
    set_cookie(&mut response, &csrf_cookie(&secrets.csrf));
    response
}

/// Marks a response of the reset pages: never cached, never sends the
/// page's URL (which may carry the token) as a referrer.
fn reset_page(mut response: Response) -> Response {
    no_store(&mut response);
    response.headers_mut().insert(
        header::REFERRER_POLICY,
        HeaderValue::from_static("no-referrer"),
    );
    response
}

fn set_cookie(response: &mut Response, cookie: &str) {
    match HeaderValue::from_str(cookie) {
        Ok(value) => {
            response.headers_mut().append(header::SET_COOKIE, value);
        }
        Err(_) => *response = Response::empty(StatusCode::INTERNAL_SERVER_ERROR),
    }
}

fn no_store(response: &mut Response) {
    response
        .headers_mut()
        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
}

fn forbidden() -> Response {
    Response::new(StatusCode::FORBIDDEN, "forbidden")
}

/// `503` with a generic body.
fn unavailable(code: &'static str) -> Response {
    failed(ForgeError::new(
        ErrorCategory::Infrastructure,
        code,
        "service temporarily unavailable",
    ))
}

/// `503` with a generic body; `source` is logged, never shown.
fn unavailable_because(
    code: &'static str,
    source: impl std::error::Error + Send + Sync + 'static,
) -> Response {
    failed(
        ForgeError::new(
            ErrorCategory::Infrastructure,
            code,
            "service temporarily unavailable",
        )
        .with_source(source),
    )
}

/// The caller-safe report of `failure` (logged with its causes), never cached.
fn failed(failure: ForgeError) -> Response {
    let mut response = forge::web::error(&failure);
    no_store(&mut response);
    response
}

fn csrf_field_for(request: &Request) -> String {
    csrf_token(request)
        .map(|token| csrf_field(&token))
        .unwrap_or_default()
}
