/// The sign-in page. Protected pages send signed-out browsers here.
pub const SIGN_IN_PATH: &str = "/session/new";
/// Where a sign-in without a valid return path lands.
pub const AFTER_SIGN_IN_PATH: &str = "/";
/// How long a session lasts after signing in.
pub const SESSION_LIFETIME: Duration = Duration::from_secs(24 * 60 * 60);

const NEW_PASSWORD_PATH: &str = "/passwords/new";

/// The second step of a sign-in for accounts with two-factor authentication.
pub const MFA_CHALLENGE_PATH: &str = "/session/mfa";
/// The two-factor settings of the signed-in account.
pub const MFA_PATH: &str = "/mfa";
/// The host-only cookie holding a pending sign-in challenge (Forge-Go's name).
pub const MFA_COOKIE_NAME: &str = "__Host-forge_mfa";
/// The issuer shown in authenticator apps.
const MFA_ISSUER: &str = env!("CARGO_PKG_NAME");

/// Reset requests waiting for the background worker; more are dropped
/// (and logged) rather than slowing or failing the page.
pub const RESET_QUEUE_CAPACITY: usize = 256;
/// The reset-request page never answers faster than this, whatever
/// happened, so its timing does not tell whether an account exists.
pub const RESET_RESPONSE_TIME: Duration = Duration::from_millis(100);

// Messages are the `sessions.*`, `passwords.*` and `throttled.*` keys of
// config/locales/authentication.LOCALE.json. A failed sign-in shows one
// message (`sessions.invalid_credentials`) whatever was wrong, and a reset
// request one answer (`passwords.reset_requested`) whether or not the
// account exists, in every locale.

/// What the pages need: the identity stores, the password hasher, the
/// reset-link notifier, the audit sink and the attempt throttles.
#[derive(Clone)]
pub struct AuthenticationPorts {
    pub credentials: Arc<dyn PasswordCredentialStore>,
    pub hasher: Arc<dyn PasswordHasher>,
    pub sessions: Arc<dyn SessionStore>,
    pub memberships: Arc<dyn MembershipStore>,
    pub tenants: Arc<dyn TenantDirectory>,
    pub resets: Arc<dyn PasswordResetStore>,
    /// Delivers reset links: `forge::mail::PasswordResetMailer` when mail is
    /// configured, otherwise `forge::auth::UndeliverablePasswordResets`,
    /// which delivers nothing (see `forge::mail::password_reset_notifier`).
    pub notifier: Arc<dyn PasswordResetNotifier>,
    pub audit: Arc<dyn AuditSink>,
    /// Sign-in attempts per account and source.
    pub sign_in_throttle: Arc<dyn LoginThrottle>,
    /// Reset requests and reset submissions per account (or link) and source.
    pub reset_throttle: Arc<dyn LoginThrottle>,
    /// Two-factor authentication (ADR 0040): the factor store, the seed
    /// cipher when `FORGE_AUTH_MFA_KEY` is set and the second-factor
    /// throttle (`forge::tenancy::mfa_throttle_config`).
    pub mfa: MfaService,
}

struct Pages {
    site: Arc<Site>,
    ports: AuthenticationPorts,
    resets: WorkQueue<ResetRequest>,
}

/// A reset request for the background worker: a syntactically valid
/// organization and login, whether or not they exist.
struct ResetRequest {
    tenant: TenantSlug,
    login: CanonicalLogin,
    received_at: UnixTimestamp,
}

/// Registers the pages, the reset-request worker (a bounded queue owned by
/// the process lifecycle) and the [`SignInRedirect`] layer that sends
/// signed-out browsers asking for a protected page (a `401` from an access
/// policy) to [`SIGN_IN_PATH`]; JSON clients keep the `401`. The site's
/// CSRF and flash layers must be registered first (`Site::register`).
pub fn routes(
    composition: &mut Composition<'_>,
    site: &Arc<Site>,
    ports: AuthenticationPorts,
) -> Result<(), ComposeError> {
    let worker_ports = ports.clone();
    let resets = composition.work_queue(
        "password_resets",
        RESET_QUEUE_CAPACITY,
        move |request: ResetRequest| {
            let ports = worker_ports.clone();
            async move {
                if let Err(failure) = request_reset(&ports, &request).await {
                    // Logged for operators; the visitor already got the
                    // uniform answer.
                    forge::web::report(&failure);
                }
            }
        },
    );
    let router = composition.router();
    router.layer(SignInRedirect::new(SIGN_IN_PATH).map_err(ComposeError::other)?);
    let pages = Arc::new(Pages {
        site: Arc::clone(site),
        ports,
        resets,
    });
    route(router, &pages, Method::GET, SIGN_IN_PATH, new_session)?;
    route(router, &pages, Method::POST, "/session", create_session)?;
    route(router, &pages, Method::DELETE, "/session", destroy_session)?;
    route(router, &pages, Method::GET, NEW_PASSWORD_PATH, new_password)?;
    route(router, &pages, Method::POST, "/passwords", create_password)?;
    route(
        router,
        &pages,
        Method::GET,
        "/passwords/edit",
        edit_password,
    )?;
    route(router, &pages, Method::PATCH, "/passwords", update_password)?;
    route(
        router,
        &pages,
        Method::GET,
        MFA_CHALLENGE_PATH,
        new_mfa_challenge,
    )?;
    route(
        router,
        &pages,
        Method::POST,
        MFA_CHALLENGE_PATH,
        complete_mfa_challenge,
    )?;
    route(router, &pages, Method::GET, MFA_PATH, show_mfa)?;
    route(router, &pages, Method::POST, MFA_PATH, enable_mfa)?;
    route(router, &pages, Method::POST, "/mfa/confirm", confirm_mfa)?;
    route(router, &pages, Method::POST, "/mfa/rotation", rotate_mfa)?;
    route(
        router,
        &pages,
        Method::POST,
        "/mfa/rotation/confirm",
        confirm_mfa_rotation,
    )?;
    route(
        router,
        &pages,
        Method::POST,
        "/mfa/backup_codes",
        regenerate_backup_codes,
    )?;
    route(router, &pages, Method::DELETE, MFA_PATH, disable_mfa)?;
    Ok(())
}

fn route<H, F>(
    router: &mut forge::http::Router,
    pages: &Arc<Pages>,
    method: Method,
    path: &str,
    handler: H,
) -> Result<(), ComposeError>
where
    H: Fn(Arc<Pages>, Request) -> F + Send + Sync + 'static,
    F: Future<Output = Response> + Send + 'static,
{
    let pages = Arc::clone(pages);
    router.route(method, path, move |request: Request| {
        handler(Arc::clone(&pages), request)
    })?;
    Ok(())
}

/// `?tenant=` pre-fills the organization; `?return_to=` comes from
/// `SignInRedirect`.
#[derive(Default, serde::Deserialize)]
struct SignInQuery {
    tenant: Option<String>,
    return_to: Option<String>,
}

#[derive(Default, serde::Deserialize)]
struct SignInForm {
    #[serde(default)]
    tenant: String,
    #[serde(default)]
    email: String,
    #[serde(default)]
    password: String,
    #[serde(default)]
    return_to: String,
}

#[derive(Default, serde::Deserialize)]
struct ReturnQuery {
    return_to: Option<String>,
}

/// The second step of a sign-in.
#[derive(Default, serde::Deserialize)]
struct MfaCodeForm {
    #[serde(default)]
    code: String,
    #[serde(default)]
    return_to: String,
}

/// Confirms a pending key: a code of the new key, after step-up
/// authentication (the password, and for a rotation a current code), so a
/// session alone can neither confirm the key nor see it again.
#[derive(Default, serde::Deserialize)]
struct MfaConfirmForm {
    #[serde(default)]
    password: String,
    #[serde(default)]
    current_code: String,
    #[serde(default)]
    code: String,
}

/// Step-up authentication: the password, and a current code once two-factor
/// authentication is on.
#[derive(Default, serde::Deserialize)]
struct StepUpForm {
    #[serde(default)]
    password: String,
    #[serde(default)]
    code: String,
}

#[derive(Default, serde::Deserialize)]
struct ResetRequestForm {
    #[serde(default)]
    tenant: String,
    #[serde(default)]
    email: String,
}

#[derive(Default, serde::Deserialize)]
struct ResetQuery {
    token: Option<String>,
}

#[derive(Default, serde::Deserialize)]
struct ResetForm {
    #[serde(default)]
    token: String,
    #[serde(default)]
    password: String,
    #[serde(default)]
    password_confirmation: String,
}

/// The sign-in form, as shown again after a failure (never the password).
struct SignInValues {
    tenant: String,
    email: String,
    return_to: String,
}

async fn new_session(pages: Arc<Pages>, request: Request) -> Response {
    let query = request.query::<SignInQuery>().unwrap_or_default();
    let values = SignInValues {
        tenant: query.tenant.unwrap_or_default(),
        email: String::new(),
        return_to: local_path(query.return_to.as_deref()),
    };
    let signed_in = match now() {
        Some(now) => authenticate_request(pages.ports.sessions.as_ref(), &request, now)
            .await
            .is_ok(),
        None => false,
    };
    render_sign_in(&pages, &request, values, None, signed_in, StatusCode::OK)
}

/// Signs in. Security steps: CSRF verified, throttle before any credential
/// check, one uniform failure, a fresh session and CSRF token, a validated
/// return path.
async fn create_session(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return forbidden();
    }
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let form = request.form::<SignInForm>().unwrap_or_default();
    let values = SignInValues {
        tenant: form.tenant.trim().to_owned(),
        email: form.email.trim().to_owned(),
        return_to: local_path(Some(&form.return_to)),
    };
    let ports = &pages.ports;
    // A login that is not canonical (non-ASCII, for example) is an unknown
    // account: it is checked as an empty login, which costs the same hash.
    let login = CanonicalLogin::parse(&values.email).ok();

    let key = ThrottleKey::new(
        "sign_in",
        &account_key(login.as_ref(), &values.email),
        Some(request.client_ip()),
    );
    match ports.sign_in_throttle.attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => {
            let message = too_many_attempts(
                pages.site.i18n(&request).t("throttled.sign_in"),
                retry_after,
            );
            let mut response = render_sign_in(
                &pages,
                &request,
                values,
                Some(message),
                false,
                StatusCode::TOO_MANY_REQUESTS,
            );
            set_retry_after(&mut response, retry_after);
            return response;
        }
        Err(_) => return unavailable("sign_in_throttle_unavailable"),
    }

    // The password is verified first, also for an unknown organization, and
    // the tenant lookups run either way, so every failure costs the same.
    let verified = match verify_password(
        ports.credentials.as_ref(),
        ports.hasher.as_ref(),
        login.as_ref().map_or("", CanonicalLogin::as_str),
        form.password.as_bytes(),
    )
    .await
    {
        Ok(verified) => Some(verified),
        Err(LoginError::InvalidCredentials) => None,
        Err(LoginError::AuthenticationUnavailable) => {
            return unavailable("authentication_unavailable");
        }
    };
    let principal = verified.map(|verified| verified.principal_id);
    let member = match active_tenant(ports, &values.tenant, principal).await {
        Ok(tenant) => verified.zip(tenant),
        Err(failure) => return failed(failure),
    };
    let Some((
        VerifiedPassword {
            principal_id: principal,
            version,
        },
        tenant,
    )) = member
    else {
        record(
            ports,
            now,
            AuditActor::Anonymous,
            None,
            "auth.sign_in",
            AuditOutcome::Failed,
        )
        .await;
        return render_sign_in(
            &pages,
            &request,
            values,
            Some(
                pages
                    .site
                    .i18n(&request)
                    .t("sessions.invalid_credentials")
                    .text(),
            ),
            false,
            StatusCode::UNPROCESSABLE_ENTITY,
        );
    };
    if ports.sign_in_throttle.success(&key).await.is_err() {
        return unavailable("sign_in_throttle_unavailable");
    }

    // Session fixation: a session this browser already holds ends here.
    match authenticate_request(ports.sessions.as_ref(), &request, now).await {
        Ok(previous) => {
            if ports
                .sessions
                .revoke(previous.session_id(), now)
                .await
                .is_err()
            {
                return unavailable("session_store_unavailable");
            }
        }
        Err(RequestAuthError::AuthenticationUnavailable) => {
            return unavailable("session_store_unavailable");
        }
        Err(_) => {}
    }
    let Some(expires_at) = now.as_secs().checked_add(SESSION_LIFETIME.as_secs()) else {
        return unavailable("clock_unavailable");
    };
    // Second factor (ADR 0040): an account with a TOTP factor gets a
    // challenge, not a session. Without FORGE_AUTH_MFA_KEY it cannot sign in.
    match ports.mfa.status(principal).await {
        Ok(Some(_)) => {
            return challenge_second_factor(
                &pages,
                &request,
                values,
                (principal, tenant, version),
                UnixTimestamp::from_secs(expires_at),
                now,
            )
            .await;
        }
        Ok(None) => {}
        Err(error) => return unavailable_because("mfa_unavailable", error),
    }
    let issued = match issue_persisted_session(
        ports.sessions.as_ref(),
        principal,
        now,
        UnixTimestamp::from_secs(expires_at),
    )
    .await
    {
        Ok(issued) => issued,
        Err(error) => return unavailable_because("session_store_unavailable", error),
    };
    // A factor installed after the check above revoked every session of the
    // account before this one existed, so check again now that it is stored:
    // on PostgreSQL its insert waits for the account row the installation
    // locks (the foreign key), so that factor is visible here. The session's
    // cookie has not been sent; it ends, and the code is asked for instead.
    match ports.mfa.status(principal).await {
        Ok(None) => {}
        Ok(Some(_)) => {
            if ports
                .sessions
                .revoke(issued.session.id(), now)
                .await
                .is_err()
            {
                return unavailable("session_store_unavailable");
            }
            return challenge_second_factor(
                &pages,
                &request,
                values,
                (principal, tenant, version),
                UnixTimestamp::from_secs(expires_at),
                now,
            )
            .await;
        }
        Err(error) => {
            // Never sent, so unusable; revoked anyway when the store answers.
            let _ = ports.sessions.revoke(issued.session.id(), now).await;
            return unavailable_because("mfa_unavailable", error);
        }
    }
    record(
        ports,
        now,
        AuditActor::Principal(principal),
        Some(tenant),
        "auth.sign_in",
        AuditOutcome::Succeeded,
    )
    .await;

    let target = if values.return_to.is_empty() {
        AFTER_SIGN_IN_PATH
    } else {
        values.return_to.as_str()
    };
    let notice = pages.site.i18n(&request).t("sessions.signed_in").text();
    let mut response = redirect(target, Flash::new().with_notice(notice));
    set_cookie(&mut response, &session_set_cookie(&issued.secrets.bearer));
    // The form CSRF cookie now holds the new session's CSRF token, so pages
    // render it and the session-bound check (ADR 0014) agrees.
    set_cookie(&mut response, &csrf_cookie(&issued.secrets.csrf));
    no_store(&mut response);
    response
}

/// Signs out: revokes the session (after its session-bound CSRF check),
/// clears the session cookie and rotates the CSRF token. Idempotent for a
/// browser without a valid session.
async fn destroy_session(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return forbidden();
    }
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let ports = &pages.ports;
    match authenticate_request(ports.sessions.as_ref(), &request, now).await {
        Ok(principal) => {
            if enforce_csrf(ports.sessions.as_ref(), &request, principal)
                .await
                .is_err()
            {
                return forbidden();
            }
            if ports
                .sessions
                .revoke(principal.session_id(), now)
                .await
                .is_err()
            {
                return unavailable("session_store_unavailable");
            }
            record(
                ports,
                now,
                AuditActor::Principal(principal.principal_id()),
                None,
                "auth.sign_out",
                AuditOutcome::Succeeded,
            )
            .await;
        }
        Err(RequestAuthError::AuthenticationUnavailable) => {
            return unavailable("session_store_unavailable");
        }
        Err(_) => {}
    }
    let notice = pages.site.i18n(&request).t("sessions.signed_out").text();
    signed_out(SIGN_IN_PATH, Flash::new().with_notice(notice))
}

async fn new_password(pages: Arc<Pages>, request: Request) -> Response {
    let tenant = request
        .query::<SignInQuery>()
        .unwrap_or_default()
        .tenant
        .unwrap_or_default();
    render_password_new(
        &pages,
        &request,
        tenant,
        String::new(),
        None,
        StatusCode::OK,
    )
}

/// Asks for a reset link. Every outcome but throttling answers the same,
/// no sooner than [`RESET_RESPONSE_TIME`]: the account is looked up, and the
/// link issued and delivered, by the background worker, so neither the
/// answer nor its timing tells whether an account exists or a link was
/// delivered.
async fn create_password(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return forbidden();
    }
    forge::web::at_least(RESET_RESPONSE_TIME, request_password_reset(pages, request)).await
}

async fn request_password_reset(pages: Arc<Pages>, request: Request) -> Response {
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let form = request.form::<ResetRequestForm>().unwrap_or_default();
    let tenant = form.tenant.trim().to_owned();
    let email = form.email.trim().to_owned();
    let login = CanonicalLogin::parse(&email).ok();
    let key = ThrottleKey::new(
        "password_reset",
        &account_key(login.as_ref(), &email),
        Some(request.client_ip()),
    );
    match pages.ports.reset_throttle.attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => {
            let message =
                too_many_attempts(pages.site.i18n(&request).t("throttled.reset"), retry_after);
            let mut response = render_password_new(
                &pages,
                &request,
                tenant,
                email,
                Some(message),
                StatusCode::TOO_MANY_REQUESTS,
            );
            set_retry_after(&mut response, retry_after);
            return response;
        }
        Err(_) => return unavailable("password_reset_throttle_unavailable"),
    }
    // Only well-formed requests are worth queueing; the rest name no
    // account and get the same answer.
    if let (Ok(tenant), Some(login)) = (TenantSlug::parse_input(&tenant), login) {
        let queued = pages.resets.submit(ResetRequest {
            tenant,
            login,
            received_at: now,
        });
        if let Err(error) = queued {
            forge::web::report(
                &ForgeError::new(
                    ErrorCategory::Infrastructure,
                    "password_reset_queue_full",
                    "password reset request dropped",
                )
                .with_source(error),
            );
        }
    }
    let notice = pages
        .site
        .i18n(&request)
        .t("passwords.reset_requested")
        .text();
    redirect(SIGN_IN_PATH, Flash::new().with_notice(notice))
}

/// The background worker's step: issues and delivers a reset link when the
/// request names an enabled account with an active membership; otherwise
/// does nothing. The link goes to the login as stored, never as typed.
async fn request_reset(
    ports: &AuthenticationPorts,
    request: &ResetRequest,
) -> Result<(), ForgeError> {
    let failed = |code: &'static str| {
        ForgeError::new(ErrorCategory::Infrastructure, code, "password reset failed")
    };
    let Some(tenant_id) = ports
        .tenants
        .find_by_slug(&request.tenant)
        .await
        .map_err(|error| failed("tenant_directory_unavailable").with_source(error))?
    else {
        return Ok(());
    };
    let Some(credential) = ports
        .credentials
        .find_by_login(request.login.as_str())
        .await
        .map_err(|error| failed("credential_store_unavailable").with_source(error))?
    else {
        return Ok(());
    };
    if credential.disabled() {
        return Ok(());
    }
    let Some(stored_login) = credential.login().map(str::to_owned) else {
        // A store that does not return the stored login cannot be trusted
        // with an address: deliver nothing.
        return Err(failed("password_reset_without_stored_login"));
    };
    let principal = credential.principal_id();
    let active = ports
        .memberships
        .find(tenant_id, principal)
        .await
        .map_err(|error| failed("membership_store_unavailable").with_source(error))?
        .is_some_and(|membership| membership.state() == MembershipState::Active);
    if !active {
        return Ok(());
    }

    let now = request.received_at;
    let token = PasswordResetToken::generate()
        .map_err(|error| failed("password_reset_token_unavailable").with_source(error))?;
    let expires_at =
        UnixTimestamp::from_secs(now.as_secs().saturating_add(PASSWORD_RESET_LIFETIME_SECS));
    let grant = PasswordResetGrant::new(principal, tenant_id, token.digest(), now, expires_at)
        .map_err(|error| failed("password_reset_invalid").with_source(error))?;
    ports
        .resets
        .issue(&grant)
        .await
        .map_err(|error| failed("password_reset_store_unavailable").with_source(error))?;
    record(
        ports,
        now,
        AuditActor::Principal(principal),
        Some(tenant_id),
        "auth.password_reset.requested",
        AuditOutcome::Succeeded,
    )
    .await;
    // The token leaves this process only through the notifier.
    ports
        .notifier
        .deliver(&PasswordResetDelivery::new(stored_login, token, expires_at))
        .await
        .map_err(|error| failed("password_reset_delivery_failed").with_source(error))
}

/// The page a reset link opens. Only the token's format is checked here;
/// the token moves into a hidden field of a `no-store`, `no-referrer` page.
async fn edit_password(pages: Arc<Pages>, request: Request) -> Response {
    let query = request.query::<ResetQuery>().unwrap_or_default();
    let Some(token) = query
        .token
        .and_then(|token| PasswordResetToken::new(token).ok())
    else {
        return reset_page(redirect(
            NEW_PASSWORD_PATH,
            Flash::new().with_alert(invalid_link(&pages, &request)),
        ));
    };
    render_password_edit(
        &pages,
        &request,
        &token,
        None,
        FieldErrors::new(),
        StatusCode::OK,
    )
}

/// Sets the new password with a reset token: the token is redeemed once,
/// the password changes and every session of the account is revoked.
async fn update_password(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return reset_page(forbidden());
    }
    let Some(now) = now() else {
        return reset_page(unavailable("clock_unavailable"));
    };
    let form = request.form::<ResetForm>().unwrap_or_default();
    let Ok(token) = PasswordResetToken::new(form.token) else {
        return reset_page(redirect(
            NEW_PASSWORD_PATH,
            Flash::new().with_alert(invalid_link(&pages, &request)),
        ));
    };
    let ports = &pages.ports;
    let key = ThrottleKey::new("password_update", token.expose(), Some(request.client_ip()));
    match ports.reset_throttle.attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => {
            let message =
                too_many_attempts(pages.site.i18n(&request).t("throttled.reset"), retry_after);
            let mut response = render_password_edit(
                &pages,
                &request,
                &token,
                Some(message),
                FieldErrors::new(),
                StatusCode::TOO_MANY_REQUESTS,
            );
            set_retry_after(&mut response, retry_after);
            return response;
        }
        Err(_) => return reset_page(unavailable("password_reset_throttle_unavailable")),
    }
    // An unknown, used or expired token ends here, before the expensive
    // password hash.
    match ports.resets.is_redeemable(&token.digest(), now).await {
        Ok(true) => {}
        Ok(false) => {
            return reset_page(redirect(
                NEW_PASSWORD_PATH,
                Flash::new().with_alert(invalid_link(&pages, &request)),
            ));
        }
        Err(error) => {
            return reset_page(unavailable_because(
                "password_reset_store_unavailable",
                error,
            ));
        }
    }

    let mut errors = FieldErrors::new();
    let password = match NewPassword::new(form.password.as_str()) {
        Ok(password) => Some(password),
        Err(violation) => {
            let i18n = pages.site.i18n(&request);
            let message = match violation {
                PasswordPolicyError::TooShort => i18n
                    .t("passwords.errors.too_short")
                    .count(MIN_PASSWORD_CHARS)
                    .text(),
                _ => i18n.t("passwords.errors.invalid").text(),
            };
            errors.add("password", message);
            None
        }
    };
    if form.password_confirmation != form.password {
        let message = pages
            .site
            .i18n(&request)
            .t("passwords.errors.mismatch")
            .text();
        errors.add("password_confirmation", message);
    }
    let Some(password) = password.filter(|_| errors.is_empty()) else {
        return render_password_edit(
            &pages,
            &request,
            &token,
            None,
            errors,
            StatusCode::UNPROCESSABLE_ENTITY,
        );
    };

    let hash = match ports.hasher.hash(password.expose()).await {
        Ok(hash) => hash,
        Err(_) => return reset_page(unavailable("password_hashing_unavailable")),
    };
    match ports.resets.redeem(&token.digest(), now, &hash).await {
        Ok(Some(redeemed)) => {
            record(
                ports,
                now,
                AuditActor::Principal(redeemed.principal_id),
                Some(redeemed.tenant_id),
                "auth.password_reset.completed",
                AuditOutcome::Succeeded,
            )
            .await;
            reset_page(signed_out(
                SIGN_IN_PATH,
                Flash::new().with_notice(pages.site.i18n(&request).t("passwords.changed").text()),
            ))
        }
        Ok(None) => reset_page(redirect(
            NEW_PASSWORD_PATH,
            Flash::new().with_alert(invalid_link(&pages, &request)),
        )),
        Err(error) => reset_page(unavailable_because(
            "password_reset_store_unavailable",
            error,
        )),
    }
}

/// Issues the challenge of a right password for an account with a second
/// factor: a fresh CSRF token (the challenge is bound to it, so the cookie
/// is useless in another browser session) and the challenge cookie, then
/// the code form.
async fn challenge_second_factor(
    pages: &Pages,
    request: &Request,
    values: SignInValues,
    (principal, tenant, version): (PrincipalId, TenantId, PasswordCredentialVersion),
    session_expires_at: UnixTimestamp,
    now: UnixTimestamp,
) -> Response {
    let ports = &pages.ports;
    if !ports.mfa.is_configured() {
        // Fail closed: the factor cannot be checked without the seed key.
        return unavailable("mfa_not_configured");
    }
    let Ok(secrets) = issue_session_secrets() else {
        return unavailable("csrf_token_unavailable");
    };
    let binding = MfaChallengeBinding::from_bytes(*secrets.csrf_digest.as_bytes());
    match ports
        .mfa
        .issue_challenge(principal, tenant, version, binding, session_expires_at, now)
        .await
    {
        Ok(issued) => {
            let target = with_return_to(MFA_CHALLENGE_PATH, &values.return_to);
            let mut response = redirect(&target, Flash::new());
            set_cookie(&mut response, &mfa_cookie(&issued.token));
            set_cookie(&mut response, &csrf_cookie(&secrets.csrf));
            response
        }
        // The factor or the password changed meanwhile: sign in again.
        Err(MfaError::NotEnabled) => {
            let message = pages
                .site
                .i18n(request)
                .t("sessions.invalid_credentials")
                .text();
            render_sign_in(
                pages,
                request,
                values,
                Some(message),
                false,
                StatusCode::UNPROCESSABLE_ENTITY,
            )
        }
        Err(error) => unavailable_because("mfa_unavailable", error),
    }
}

/// The code form while a challenge is pending; without one, back to sign in.
async fn new_mfa_challenge(pages: Arc<Pages>, request: Request) -> Response {
    let query = request.query::<ReturnQuery>().unwrap_or_default();
    if mfa_challenge_cookie(&request).is_none() {
        return expired_challenge(&pages, &request);
    }
    render_mfa_challenge(
        &pages,
        &request,
        local_path(query.return_to.as_deref()),
        None,
        StatusCode::OK,
    )
}

/// Completes a sign-in with an authenticator or backup code. Security steps:
/// CSRF verified, the challenge bound to this browser's CSRF token, the
/// attempt counted before the code is checked, the challenge and the code
/// consumed together, then a fresh session and CSRF token.
async fn complete_mfa_challenge(pages: Arc<Pages>, request: Request) -> Response {
    if csrf_verified(&request).is_none() {
        return forbidden();
    }
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let form = request.form::<MfaCodeForm>().unwrap_or_default();
    let return_to = local_path(Some(&form.return_to));
    let Some(token) = mfa_challenge_cookie(&request) else {
        return expired_challenge(&pages, &request);
    };
    let Some(csrf) = csrf_token(&request) else {
        return forbidden();
    };
    let binding = MfaChallengeBinding::from_bytes(*csrf_digest(&csrf).as_bytes());
    let ports = &pages.ports;
    let signed_in = match ports
        .mfa
        .complete(
            token.expose(),
            &binding,
            &form.code,
            Some(request.client_ip()),
            now,
        )
        .await
    {
        Ok(signed_in) => signed_in,
        Err(rejection) => {
            let outcome = match rejection.error {
                MfaError::Unavailable | MfaError::Mechanism | MfaError::NotConfigured => {
                    AuditOutcome::Failed
                }
                _ => AuditOutcome::Denied,
            };
            let actor = rejection
                .principal_id
                .map_or(AuditActor::Anonymous, AuditActor::Principal);
            record(
                ports,
                now,
                actor,
                rejection.tenant_id,
                "auth.mfa.challenge_failed",
                outcome,
            )
            .await;
            return match rejection.error {
                MfaError::InvalidCode => {
                    let message = pages.site.i18n(&request).t("sessions.invalid_code").text();
                    render_mfa_challenge(
                        &pages,
                        &request,
                        return_to,
                        Some(message),
                        StatusCode::UNPROCESSABLE_ENTITY,
                    )
                }
                MfaError::Throttled { retry_after } => {
                    let message = too_many_attempts(
                        pages.site.i18n(&request).t("throttled.code"),
                        retry_after,
                    );
                    let mut response = render_mfa_challenge(
                        &pages,
                        &request,
                        return_to,
                        Some(message),
                        StatusCode::TOO_MANY_REQUESTS,
                    );
                    set_retry_after(&mut response, retry_after);
                    response
                }
                MfaError::ChallengeExpired => expired_challenge(&pages, &request),
                error => unavailable_because("mfa_unavailable", error),
            };
        }
    };

    let principal = signed_in.principal_id;
    match authenticate_request(ports.sessions.as_ref(), &request, now).await {
        Ok(previous) => {
            if ports
                .sessions
                .revoke(previous.session_id(), now)
                .await
                .is_err()
            {
                return unavailable("session_store_unavailable");
            }
        }
        Err(RequestAuthError::AuthenticationUnavailable) => {
            return unavailable("session_store_unavailable");
        }
        Err(_) => {}
    }
    let issued = match issue_persisted_session(
        ports.sessions.as_ref(),
        principal,
        now,
        signed_in.session_expires_at,
    )
    .await
    {
        Ok(issued) => issued,
        Err(error) => return unavailable_because("session_store_unavailable", error),
    };
    let actor = AuditActor::Principal(principal);
    let tenant = Some(signed_in.tenant_id);
    if signed_in.factor == SecondFactor::BackupCode {
        record(
            ports,
            now,
            actor,
            tenant,
            "auth.mfa.backup_code_used",
            AuditOutcome::Succeeded,
        )
        .await;
    }
    record(
        ports,
        now,
        actor,
        tenant,
        "auth.mfa.challenge_succeeded",
        AuditOutcome::Succeeded,
    )
    .await;
    record(
        ports,
        now,
        actor,
        tenant,
        "auth.sign_in",
        AuditOutcome::Succeeded,
    )
    .await;

    let target = if return_to.is_empty() {
        AFTER_SIGN_IN_PATH
    } else {
        return_to.as_str()
    };
    let notice = pages.site.i18n(&request).t("sessions.signed_in").text();
    let mut response = redirect(target, Flash::new().with_notice(notice));
    set_cookie(&mut response, &session_set_cookie(&issued.secrets.bearer));
    set_cookie(&mut response, &csrf_cookie(&issued.secrets.csrf));
    set_cookie(&mut response, &mfa_cookie_removal());
    response
}

/// The two-factor settings page of the signed-in account.
async fn show_mfa(pages: Arc<Pages>, request: Request) -> Response {
    let principal = match signed_in(&pages, &request).await {
        Ok((principal, _)) => principal.principal_id(),
        Err(response) => return *response,
    };
    render_mfa_show(&pages, &request, principal, None, StatusCode::OK).await
}

/// Turns two-factor authentication on: after the password, a new key to add
/// to an authenticator app, pending until a code confirms it.
async fn enable_mfa(pages: Arc<Pages>, request: Request) -> Response {
    begin_mfa_change(pages, request, MfaChange::Enrollment).await
}

/// Starts replacing the authenticator: after the password and a current
/// code, a new key; the old one keeps working until the new one is confirmed.
async fn rotate_mfa(pages: Arc<Pages>, request: Request) -> Response {
    begin_mfa_change(pages, request, MfaChange::Rotation).await
}

async fn begin_mfa_change(pages: Arc<Pages>, request: Request, change: MfaChange) -> Response {
    let (principal, now) = match signed_in_form(&pages, &request).await {
        Ok(signed_in) => signed_in,
        Err(response) => return *response,
    };
    let action = match change {
        MfaChange::Enrollment => "auth.mfa.enrollment_started",
        MfaChange::Rotation => "auth.mfa.rotation_started",
    };
    let form = request.form::<StepUpForm>().unwrap_or_default();
    let code = (change == MfaChange::Rotation).then_some(form.code.as_str());
    let login = match step_up(&pages, &request, principal, &form.password, code, now).await {
        Ok(login) => login,
        Err(failure) => {
            return step_up_failed(&pages, &request, principal, action, failure, now).await;
        }
    };
    let ports = &pages.ports;
    match ports
        .mfa
        .begin(principal, change, MFA_ISSUER, &login, now)
        .await
    {
        Ok(enrollment) => {
            record(
                ports,
                now,
                AuditActor::Principal(principal),
                None,
                action,
                AuditOutcome::Succeeded,
            )
            .await;
            render_mfa_new(&pages, &request, &enrollment, change, None, StatusCode::OK)
        }
        Err(error) => {
            record(
                ports,
                now,
                AuditActor::Principal(principal),
                None,
                action,
                AuditOutcome::Failed,
            )
            .await;
            mfa_change_failed(&pages, &request, error)
        }
    }
}

/// Confirms the pending key with a code of it and turns two-factor
/// authentication on. Every session ends; the backup codes show once.
async fn confirm_mfa(pages: Arc<Pages>, request: Request) -> Response {
    confirm_mfa_change(pages, request, MfaChange::Enrollment).await
}

/// Confirms the new key and replaces the authenticator. Every session ends;
/// the new backup codes show once.
async fn confirm_mfa_rotation(pages: Arc<Pages>, request: Request) -> Response {
    confirm_mfa_change(pages, request, MfaChange::Rotation).await
}

async fn confirm_mfa_change(pages: Arc<Pages>, request: Request, change: MfaChange) -> Response {
    let (principal, now) = match signed_in_form(&pages, &request).await {
        Ok(signed_in) => signed_in,
        Err(response) => return *response,
    };
    let action = match change {
        MfaChange::Enrollment => "auth.mfa.enabled",
        MfaChange::Rotation => "auth.mfa.rotated",
    };
    let form = request.form::<MfaConfirmForm>().unwrap_or_default();
    // The pending key was shown only after step-up; confirming it, or seeing
    // it again after a wrong code, takes the same step-up, so a stolen
    // session can neither read the key nor guess its codes.
    let current_code = (change == MfaChange::Rotation).then_some(form.current_code.as_str());
    let login = match step_up(
        &pages,
        &request,
        principal,
        &form.password,
        current_code,
        now,
    )
    .await
    {
        Ok(login) => login,
        Err(failure) => {
            return step_up_failed(&pages, &request, principal, action, failure, now).await;
        }
    };
    let ports = &pages.ports;
    let result = ports.mfa.confirm(principal, change, &form.code, now).await;
    let outcome = if result.is_ok() {
        AuditOutcome::Succeeded
    } else {
        AuditOutcome::Failed
    };
    record(
        ports,
        now,
        AuditActor::Principal(principal),
        None,
        action,
        outcome,
    )
    .await;
    match result {
        // The store revoked every session, this one too: the page says so
        // and clears the cookie.
        Ok(codes) => {
            let codes = codes.iter().map(|code| code.expose().to_owned()).collect();
            let mut response = render_backup_codes(&pages, &request, codes, true);
            let Ok(secrets) = issue_session_secrets() else {
                return unavailable("csrf_token_unavailable");
            };
            set_cookie(&mut response, &session_remove_cookie());
            set_cookie(&mut response, &csrf_cookie(&secrets.csrf));
            response
        }
        Err(MfaError::InvalidCode) => {
            match ports.mfa.pending(principal, MFA_ISSUER, &login, now).await {
                Ok(Some(enrollment)) => {
                    let message = pages
                        .site
                        .i18n(&request)
                        .t("mfa.errors.invalid_code")
                        .text();
                    render_mfa_new(
                        &pages,
                        &request,
                        &enrollment,
                        change,
                        Some(message),
                        StatusCode::UNPROCESSABLE_ENTITY,
                    )
                }
                Ok(None) => mfa_change_failed(&pages, &request, MfaError::EnrollmentInvalid),
                Err(error) => mfa_change_failed(&pages, &request, error),
            }
        }
        Err(error) => mfa_change_failed(&pages, &request, error),
    }
}

/// New backup codes after the password and a current code; the old ones
/// stop working.
async fn regenerate_backup_codes(pages: Arc<Pages>, request: Request) -> Response {
    let (principal, now) = match signed_in_form(&pages, &request).await {
        Ok(signed_in) => signed_in,
        Err(response) => return *response,
    };
    let action = "auth.mfa.backup_codes_regenerated";
    let form = request.form::<StepUpForm>().unwrap_or_default();
    if let Err(failure) = step_up(
        &pages,
        &request,
        principal,
        &form.password,
        Some(&form.code),
        now,
    )
    .await
    {
        return step_up_failed(&pages, &request, principal, action, failure, now).await;
    }
    let ports = &pages.ports;
    match ports.mfa.regenerate_backup_codes(principal, now).await {
        Ok(codes) => {
            record(
                ports,
                now,
                AuditActor::Principal(principal),
                None,
                action,
                AuditOutcome::Succeeded,
            )
            .await;
            let codes = codes.iter().map(|code| code.expose().to_owned()).collect();
            render_backup_codes(&pages, &request, codes, false)
        }
        Err(error) => mfa_change_failed(&pages, &request, error),
    }
}

/// Turns two-factor authentication off after the password and a current
/// code. Every session ends.
async fn disable_mfa(pages: Arc<Pages>, request: Request) -> Response {
    let (principal, now) = match signed_in_form(&pages, &request).await {
        Ok(signed_in) => signed_in,
        Err(response) => return *response,
    };
    let action = "auth.mfa.disabled";
    let form = request.form::<StepUpForm>().unwrap_or_default();
    if let Err(failure) = step_up(
        &pages,
        &request,
        principal,
        &form.password,
        Some(&form.code),
        now,
    )
    .await
    {
        return step_up_failed(&pages, &request, principal, action, failure, now).await;
    }
    let ports = &pages.ports;
    match ports.mfa.disable(principal, now).await {
        Ok(()) => {
            record(
                ports,
                now,
                AuditActor::Principal(principal),
                None,
                action,
                AuditOutcome::Succeeded,
            )
            .await;
            let notice = pages.site.i18n(&request).t("mfa.disabled").text();
            signed_out(SIGN_IN_PATH, Flash::new().with_notice(notice))
        }
        Err(error) => {
            record(
                ports,
                now,
                AuditActor::Principal(principal),
                None,
                action,
                AuditOutcome::Failed,
            )
            .await;
            mfa_change_failed(&pages, &request, error)
        }
    }
}

/// Why a step-up check refused.
enum StepUpFailure {
    /// A wrong password or code (one answer for both).
    Denied,
    /// A step-up without a code (turning two-factor on or confirming it) of
    /// an account that already has a factor, refused before the password is
    /// checked: the same answer whatever the password.
    AlreadyEnabled,
    /// Too many attempts.
    Throttled(Duration),
    /// A dependency failed.
    Unavailable(&'static str),
}

/// Step-up authentication of the signed-in `principal`: the password, and
/// `code` (an authenticator or backup code, used up) when given. Counted on
/// the second-factor throttle before anything is checked. Without `code`, an
/// account that already has a factor is refused next, before the password
/// is checked, so the answer never tells a right password from a wrong one.
/// A success clears the counters: it checked a code or the account has no
/// factor. Returns the stored login, the account label of the authenticator
/// entry.
async fn step_up(
    pages: &Pages,
    request: &Request,
    principal: PrincipalId,
    password: &str,
    code: Option<&str>,
    now: UnixTimestamp,
) -> Result<String, StepUpFailure> {
    let ports = &pages.ports;
    let key = ThrottleKey::new(
        "mfa_step_up",
        &principal.to_string(),
        Some(request.client_ip()),
    );
    match ports.mfa.throttle().attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => {
            return Err(StepUpFailure::Throttled(retry_after));
        }
        Err(_) => return Err(StepUpFailure::Unavailable("mfa_throttle_unavailable")),
    }
    // With no code to check (turning two-factor on, confirming it), a wrong
    // password (`422`) and a right one (`303`, "changed") of an account that
    // already has a factor would tell a session holder the password: such an
    // account is refused before the password is checked, whatever it is. A
    // pending rotation is confirmed only with a current code.
    if code.is_none() {
        match ports.mfa.status(principal).await {
            Ok(None) => {}
            Ok(Some(_)) => return Err(StepUpFailure::AlreadyEnabled),
            Err(_) => return Err(StepUpFailure::Unavailable("mfa_unavailable")),
        }
    }
    let login = match verify_principal_password(
        ports.credentials.as_ref(),
        ports.hasher.as_ref(),
        principal,
        password.as_bytes(),
    )
    .await
    {
        Ok(login) => login,
        Err(LoginError::InvalidCredentials) => return Err(StepUpFailure::Denied),
        Err(LoginError::AuthenticationUnavailable) => {
            return Err(StepUpFailure::Unavailable("authentication_unavailable"));
        }
    };
    if let Some(code) = code {
        match ports.mfa.verify_second_factor(principal, code, now).await {
            Ok(_) => {}
            Err(MfaError::InvalidCode | MfaError::NotEnabled) => {
                return Err(StepUpFailure::Denied);
            }
            Err(_) => return Err(StepUpFailure::Unavailable("mfa_unavailable")),
        }
    }
    // A code was checked, or the account has no factor (checked above): the
    // password alone never clears the counters of an account with a factor,
    // since they guard its codes, and clearing them would let a session
    // holding the password mix unlimited code guesses with password-only
    // step-ups.
    if ports.mfa.throttle().success(&key).await.is_err() {
        return Err(StepUpFailure::Unavailable("mfa_throttle_unavailable"));
    }
    Ok(login)
}

/// Records a refused step-up as the denied `action` and shows the settings
/// page again with one message (`422`, or `429` when throttled); an account
/// that already has a factor goes back to `/mfa` (`303`, "changed").
async fn step_up_failed(
    pages: &Pages,
    request: &Request,
    principal: PrincipalId,
    action: &'static str,
    failure: StepUpFailure,
    now: UnixTimestamp,
) -> Response {
    let (outcome, status, message, retry) = match failure {
        StepUpFailure::Unavailable(code) => return unavailable(code),
        StepUpFailure::AlreadyEnabled => {
            // Audited whatever the password, so the trail does not depend
            // on it either.
            record(
                &pages.ports,
                now,
                AuditActor::Principal(principal),
                None,
                action,
                AuditOutcome::Denied,
            )
            .await;
            return mfa_change_failed(pages, request, MfaError::AlreadyEnabled);
        }
        StepUpFailure::Denied => (
            AuditOutcome::Denied,
            StatusCode::UNPROCESSABLE_ENTITY,
            pages.site.i18n(request).t("mfa.errors.step_up").text(),
            None,
        ),
        StepUpFailure::Throttled(retry_after) => (
            AuditOutcome::Denied,
            StatusCode::TOO_MANY_REQUESTS,
            too_many_attempts(pages.site.i18n(request).t("throttled.code"), retry_after),
            Some(retry_after),
        ),
    };
    record(
        &pages.ports,
        now,
        AuditActor::Principal(principal),
        None,
        action,
        outcome,
    )
    .await;
    let mut response = render_mfa_show(pages, request, principal, Some(message), status).await;
    if let Some(retry_after) = retry {
        set_retry_after(&mut response, retry_after);
    }
    response
}

/// The answer to an MFA change the service refused.
fn mfa_change_failed(pages: &Pages, request: &Request, error: MfaError) -> Response {
    let i18n = pages.site.i18n(request);
    let alert = match error {
        MfaError::EnrollmentInvalid => i18n.t("mfa.errors.expired").text(),
        MfaError::AlreadyEnabled | MfaError::NotEnabled => i18n.t("mfa.errors.changed").text(),
        MfaError::NotConfigured => i18n.t("mfa.show.unavailable").text(),
        error => return unavailable_because("mfa_unavailable", error),
    };
    redirect(MFA_PATH, Flash::new().with_alert(alert))
}

/// The signed-in principal of a settings page, or the response that ends
/// the request: signed-out browsers go to sign in and come back here.
async fn signed_in(
    pages: &Pages,
    request: &Request,
) -> Result<(AuthenticatedPrincipal, UnixTimestamp), Box<Response>> {
    let Some(now) = now() else {
        return Err(Box::new(unavailable("clock_unavailable")));
    };
    match authenticate_request(pages.ports.sessions.as_ref(), request, now).await {
        Ok(principal) => Ok((principal, now)),
        Err(RequestAuthError::AuthenticationUnavailable) => {
            Err(Box::new(unavailable("session_store_unavailable")))
        }
        Err(_) => Err(Box::new(redirect(
            &with_return_to(SIGN_IN_PATH, MFA_PATH),
            Flash::new(),
        ))),
    }
}

/// [`signed_in`] for a form submission: the site's CSRF check and the
/// session-bound one (ADR 0014) must both pass.
async fn signed_in_form(
    pages: &Pages,
    request: &Request,
) -> Result<(PrincipalId, UnixTimestamp), Box<Response>> {
    if csrf_verified(request).is_none() {
        return Err(Box::new(forbidden()));
    }
    let (principal, now) = signed_in(pages, request).await?;
    if enforce_csrf(pages.ports.sessions.as_ref(), request, principal)
        .await
        .is_err()
    {
        return Err(Box::new(forbidden()));
    }
    Ok((principal.principal_id(), now))
}

/// Back to the sign-in page: the challenge is missing, used or expired.
fn expired_challenge(pages: &Pages, request: &Request) -> Response {
    let alert = pages.site.i18n(request).t("sessions.expired").text();
    let mut response = redirect(SIGN_IN_PATH, Flash::new().with_alert(alert));
    if request_has_cookie(request, MFA_COOKIE_NAME) {
        set_cookie(&mut response, &mfa_cookie_removal());
    }
    response
}

/// The one well-formed challenge cookie of the request.
fn mfa_challenge_cookie(request: &Request) -> Option<MfaChallengeToken> {
    let mut found = None;
    for value in request.headers().get_all(header::COOKIE) {
        let value = value.to_str().ok()?;
        for parsed in cookie::Cookie::split_parse(value).flatten() {
            if parsed.name() == MFA_COOKIE_NAME {
                if found.is_some() {
                    return None;
                }
                found = Some(MfaChallengeToken::new(parsed.value()).ok()?);
            }
        }
    }
    found
}

fn request_has_cookie(request: &Request, name: &str) -> bool {
    request
        .headers()
        .get_all(header::COOKIE)
        .iter()
        .filter_map(|value| value.to_str().ok())
        .flat_map(|value| cookie::Cookie::split_parse(value).flatten())
        .any(|parsed| parsed.name() == name)
}

/// The host-only challenge cookie, as long as the challenge lives.
fn mfa_cookie(token: &MfaChallengeToken) -> String {
    let lifetime = i64::try_from(forge::tenancy::MFA_CHALLENGE_LIFETIME_SECS).unwrap_or(300);
    cookie::Cookie::build((MFA_COOKIE_NAME, token.expose().to_owned()))
        .path("/")
        .secure(true)
        .http_only(true)
        .same_site(cookie::SameSite::Lax)
        .max_age(cookie::time::Duration::seconds(lifetime))
        .build()
        .to_string()
}

fn mfa_cookie_removal() -> String {
    cookie::Cookie::build(MFA_COOKIE_NAME)
        .path("/")
        .secure(true)
        .http_only(true)
        .same_site(cookie::SameSite::Lax)
        .removal()
        .build()
        .to_string()
}

/// `path` with `?return_to=` when `return_to` is a local path.
fn with_return_to(path: &str, return_to: &str) -> String {
    match return_path(return_to) {
        Some(target) if !target.is_empty() => {
            let encoded: String = target
                .bytes()
                .map(|byte| match byte {
                    b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' => {
                        char::from(byte).to_string()
                    }
                    _ => format!("%{byte:02X}"),
                })
                .collect();
            format!("{path}?return_to={encoded}")
        }
        _ => path.to_owned(),
    }
}

/// The tenant named `tenant` when `principal` is an active member of it.
///
/// The same lookups run whatever was typed and whether or not the password
/// was right: a malformed organization looks up a random slug, an unknown
/// one a random tenant, a wrong password a random principal, so the
/// response time does not tell these cases apart.
async fn active_tenant(
    ports: &AuthenticationPorts,
    tenant: &str,
    principal: Option<PrincipalId>,
) -> Result<Option<TenantId>, ForgeError> {
    let failed = |code: &'static str| {
        ForgeError::new(
            ErrorCategory::Infrastructure,
            code,
            "service temporarily unavailable",
        )
    };
    let slug = TenantSlug::parse_input(tenant);
    let lookup = match &slug {
        Ok(slug) => slug.clone(),
        Err(_) => {
            random_slug().map_err(|error| failed("tenant_slug_invalid").with_source(error))?
        }
    };
    let found = ports
        .tenants
        .find_by_slug(&lookup)
        .await
        .map_err(|error| failed("tenant_directory_unavailable").with_source(error))?
        .filter(|_| slug.is_ok());
    // `default()` ids are new random UUIDv7 values that match nothing.
    let active = ports
        .memberships
        .find(found.unwrap_or_default(), principal.unwrap_or_default())
        .await
        .map_err(|error| failed("membership_store_unavailable").with_source(error))?
        .is_some_and(|membership| membership.state() == MembershipState::Active);
    Ok(found.filter(|_| active && principal.is_some()))
}

/// A valid slug no tenant has: `z` and 32 random hex digits.
fn random_slug() -> Result<TenantSlug, forge::tenancy::TenantSlugError> {
    TenantSlug::new(format!("z{}", TenantId::new().into_uuid().simple()))
}

/// Appends an audit event. A failed write is logged and does not change
/// the response (the visitor's outcome is already decided).
async fn record(
    ports: &AuthenticationPorts,
    now: UnixTimestamp,
    actor: AuditActor,
    tenant: Option<TenantId>,
    action: &'static str,
    outcome: AuditOutcome,
) {
    let failure = |code: &'static str| {
        ForgeError::new(
            ErrorCategory::Infrastructure,
            code,
            "audit event not recorded",
        )
    };
    let action = match AuditAction::new(action) {
        Ok(action) => action,
        Err(error) => {
            return forge::web::report(&failure("audit_action_invalid").with_source(error));
        }
    };
    let event = AuditEvent::new(now, actor, tenant, action, outcome);
    if let Err(error) = ports.audit.append(&event).await {
        forge::web::report(&failure("audit_unavailable").with_source(error));
    }
}

fn render_sign_in(
    pages: &Pages,
    request: &Request,
    values: SignInValues,
    error: Option<String>,
    signed_in: bool,
    status: StatusCode,
) -> Response {
    let mut response = forge::web::html_with_status(
        status,
        &SessionNew {
            layout: pages.site.layout(request),
            csrf_field: csrf_field_for(request),
            tenant: values.tenant,
            email: values.email,
            return_to: values.return_to,
            error,
            signed_in,
        },
    );
    no_store(&mut response);
    response
}

