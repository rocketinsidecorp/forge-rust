//! The JSON authentication API for API clients, generated by
//! `forge new --api-auth` (or `forge generate authentication --api-auth`):
//! Forge-Go's bearer sign-in, beside the HTML sign-in pages.
//!
//! | Method | Path | Answer |
//! | --- | --- | --- |
//! | `POST` | `/auth/login` | `{"email", "password", "tenant"}`: `200` with a bearer token, `401 credentials_invalid`, `403 mfa_required`, `429 login_throttled` |
//! | `POST` | `/auth/logout` | revokes the bearer token: `204`, also for an unknown or revoked one |
//! | `GET` | `/v1/auth/session` | the signed-in client: principal, tenant and roles |
//!
//! How it stays safe:
//!
//! - The token is 256 bits from the OS CSPRNG
//!   (`forge::auth::SessionBearerToken::generate`), returned once with
//!   `Cache-Control: no-store` and stored only as its SHA-256 digest
//!   (`forge_bearer_sessions`). It is bound to the tenant named at sign-in:
//!   every request resolves the membership and the RBAC grants again, so a
//!   suspended membership or a removed grant takes effect at once.
//! - Sign-in counts every attempt in the sign-in throttle of the pages
//!   (the same `sign_in` keys: 5 per login and source, 50 per login and 300
//!   per source in 15 minutes), so the JSON API adds no guessing budget.
//!   A wrong organization, email or password, a disabled account and an
//!   inactive membership all answer `401 credentials_invalid`; unknown
//!   logins still cost one Argon2id hash.
//! - An account with two-factor authentication gets no bearer token
//!   (`403 mfa_required`): it signs in through the pages, which ask for the
//!   code. Forge-Go completes such a sign-in at `POST /auth/mfa/complete`,
//!   which Forge-Rust has not ported yet.
//! - A token ends when it expires ([`TOKEN_LIFETIME`]), is revoked
//!   (`/auth/logout`), goes unused for `FORGE_AUTH_SESSION_IDLE_TIMEOUT`, or
//!   when the account's password changes, the account is disabled or turns
//!   two-factor authentication on.
//! - Only `Authorization: Bearer` authenticates these routes: cookies,
//!   query parameters and other headers are never read. A missing header is
//!   `401 credentials_required`, anything else wrong `401
//!   credentials_invalid`, both with `WWW-Authenticate: Bearer`.
//! - Sign-ins and sign-outs are audited (`auth.sign_in`, `auth.sign_out`).

use std::sync::Arc;
use std::time::{Duration, SystemTime, UNIX_EPOCH};

use forge::ComposeError;
use forge::audit::{AuditAction, AuditActor, AuditEvent, AuditOutcome, AuditSink};
use forge::auth::{
    CanonicalLogin, LoginThrottle, PasswordCredentialStore, PasswordCredentialStoreError,
    PasswordCredentialVersion, PasswordHasher, Session, SessionBearerToken, ThrottleDecision,
    ThrottleKey, UnixTimestamp,
};
use forge::core::{ErrorCategory, ForgeError, Timestamp};
use forge::http::{HeaderValue, Method, Request, Response, Router, StatusCode, header};
use forge::openapi::{OpenApiSchema, Operation, describe};
use forge::security::PrincipalId;
use forge::tenancy::{
    BearerDenied, BearerSession, BearerSessionStore, MembershipState, MembershipStore, MfaStore,
    TenantDirectory, TenantId, TenantSlug, resolve_bearer,
};
use serde::{Deserialize, Serialize};

use crate::infrastructure::security::{LoginError, VerifiedPassword, verify_password};

/// How long a bearer token lasts after signing in (Forge-Go's default).
pub const TOKEN_LIFETIME: Duration = Duration::from_secs(24 * 60 * 60);

/// What the JSON authentication API needs: the identity stores, the
/// password hasher, the audit sink and the sign-in throttle the pages use.
#[derive(Clone)]
pub struct ApiAuthenticationPorts {
    pub credentials: Arc<dyn PasswordCredentialStore>,
    pub hasher: Arc<dyn PasswordHasher>,
    pub sessions: Arc<dyn BearerSessionStore>,
    pub memberships: Arc<dyn MembershipStore>,
    pub tenants: Arc<dyn TenantDirectory>,
    /// Two-factor factors: an account with one gets no bearer token.
    pub factors: Arc<dyn MfaStore>,
    pub audit: Arc<dyn AuditSink>,
    /// The sign-in throttle of the pages, so both count one budget.
    pub sign_in_throttle: Arc<dyn LoginThrottle>,
}

/// A sign-in: the login, the password and the tenant (its slug).
#[derive(Deserialize, OpenApiSchema)]
pub struct LoginRequest {
    #[openapi(doc = "The account's login.", example = "alice@example.com")]
    pub email: String,
    #[openapi(doc = "The account's password.")]
    pub password: String,
    #[openapi(
        doc = "The tenant the account belongs to: a lowercase slug.",
        example = "acme"
    )]
    pub tenant: String,
}

/// A bearer token: a secret, shown once.
#[derive(Serialize, OpenApiSchema)]
pub struct LoginResponse {
    #[openapi(doc = "Opaque bearer session token, a secret: send it as Authorization: Bearer.")]
    pub access_token: String,
    #[openapi(doc = "Always Bearer.")]
    pub token_type: &'static str,
    #[openapi(doc = "When the session expires.")]
    pub expires_at: Timestamp,
}

/// The signed-in client of `GET /v1/auth/session`.
#[derive(Serialize, OpenApiSchema)]
pub struct SessionResponse {
    #[openapi(doc = "The signed-in principal.")]
    pub subject_id: String,
    #[openapi(doc = "The tenant the token was issued for.")]
    pub tenant_id: String,
    #[openapi(
        doc = "The principal's roles in the tenant (the application's RbacPolicy grants permissions to them)."
    )]
    pub roles: Vec<String>,
}

/// Registers the routes on `router`. The site's CSRF layer lets their JSON
/// and bearer requests through (a cross-site page cannot send them), after
/// its cross-site check.
pub fn routes(router: &mut Router, ports: ApiAuthenticationPorts) -> Result<(), ComposeError> {
    let ports = Arc::new(ports);
    let login = Arc::clone(&ports);
    router.route(
        Method::POST,
        "/auth/login",
        describe(
            move |request: Request| {
                let ports = Arc::clone(&login);
                async move { sign_in(&ports, &request).await }
            },
            Operation::new()
                .id("authLogin")
                .summary("Sign in and get a bearer token")
                .tag("authentication")
                .request::<LoginRequest>()
                .json::<LoginResponse>(200)
                .errors([401, 403, 429, 503]),
        ),
    )?;
    let logout = Arc::clone(&ports);
    router.route(
        Method::POST,
        "/auth/logout",
        describe(
            move |request: Request| {
                let ports = Arc::clone(&logout);
                async move { sign_out(&ports, &request).await }
            },
            Operation::new()
                .id("authLogout")
                .summary("Revoke the bearer token")
                .tag("authentication")
                .bearer()
                .response(forge::openapi::Response::empty(204))
                .errors([503]),
        ),
    )?;
    router.route(
        Method::GET,
        "/v1/auth/session",
        describe(
            move |request: Request| {
                let ports = Arc::clone(&ports);
                async move { current_session(&ports, &request).await }
            },
            Operation::new()
                .id("authSession")
                .summary("The signed-in session")
                .tag("authentication")
                .bearer()
                .json::<SessionResponse>(200)
                .errors([403, 503]),
        ),
    )?;
    Ok(())
}

/// `POST /auth/login`. Security steps: throttle before any credential
/// check, one uniform failure, no token for a two-factor account, a fresh
/// token bound to the tenant and to the password that was verified.
async fn sign_in(ports: &ApiAuthenticationPorts, request: &Request) -> Response {
    let body: LoginRequest = match forge::web::decode_json_strict(request) {
        Ok(body) => body,
        Err(failure) => return no_store(forge::web::error(&failure)),
    };
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    // A login that is not canonical (non-ASCII, for example) is an unknown
    // account: it is checked as an empty login, which costs the same hash.
    let login = CanonicalLogin::parse(body.email.trim()).ok();
    let key = ThrottleKey::new(
        "sign_in",
        &account_key(login.as_ref(), &body.email),
        Some(request.client_ip()),
    );
    match ports.sign_in_throttle.attempt(&key).await {
        Ok(ThrottleDecision::Allowed) => {}
        Ok(ThrottleDecision::Throttled { retry_after }) => return throttled(retry_after),
        Err(_) => return unavailable("sign_in_throttle_unavailable"),
    }

    let verified = match verify_password(
        ports.credentials.as_ref(),
        ports.hasher.as_ref(),
        login.as_ref().map_or("", CanonicalLogin::as_str),
        body.password.as_bytes(),
    )
    .await
    {
        Ok(verified) => Some(verified),
        Err(LoginError::InvalidCredentials) => None,
        Err(LoginError::AuthenticationUnavailable) => {
            return unavailable("authentication_unavailable");
        }
    };
    let principal = verified.map(|verified| verified.principal_id);
    let member = match active_tenant(ports, body.tenant.trim(), principal).await {
        Ok(tenant) => verified.zip(tenant),
        Err(failure) => return no_store(forge::web::error(&failure)),
    };
    let Some((
        VerifiedPassword {
            principal_id: principal,
            version,
        },
        tenant,
    )) = member
    else {
        record(
            ports,
            now,
            AuditActor::Anonymous,
            None,
            "auth.sign_in",
            AuditOutcome::Failed,
        )
        .await;
        return invalid_credentials();
    };
    if ports.sign_in_throttle.success(&key).await.is_err() {
        return unavailable("sign_in_throttle_unavailable");
    }
    match ports.factors.status(principal).await {
        Ok(None) => {}
        Ok(Some(_)) => {
            return no_store(forge::web::error(&ForgeError::new(
                ErrorCategory::Forbidden,
                "mfa_required",
                "this account uses two-factor authentication: sign in through the sign-in pages",
            )));
        }
        Err(error) => return unavailable_because("mfa_unavailable", error),
    }

    let Some(expires_at) = now.as_secs().checked_add(TOKEN_LIFETIME.as_secs()) else {
        return unavailable("clock_unavailable");
    };
    let expires_at = UnixTimestamp::from_secs(expires_at);
    let token = match SessionBearerToken::generate() {
        Ok(token) => token,
        Err(error) => return unavailable_because("token_unavailable", error),
    };
    let session = match Session::new(principal, now, expires_at) {
        Ok(session) => BearerSession::new(session, tenant),
        Err(error) => return unavailable_because("session_invalid", error),
    };
    if let Err(error) = ports.sessions.insert(&session, &token.digest()).await {
        return unavailable_because("session_store_unavailable", error);
    }
    // A password reset that committed after the password was verified
    // revoked nothing of this session; the store bound it to the version it
    // read, so check that it is still the one verified here. The token has
    // not been sent: it ends, and the old password is refused like a wrong
    // one.
    match password_is_current(ports.credentials.as_ref(), principal, version).await {
        Ok(true) => {}
        Ok(false) => {
            if ports
                .sessions
                .revoke(session.session().id(), now)
                .await
                .is_err()
            {
                return unavailable("session_store_unavailable");
            }
            record(
                ports,
                now,
                AuditActor::Principal(principal),
                Some(tenant),
                "auth.sign_in",
                AuditOutcome::Failed,
            )
            .await;
            return invalid_credentials();
        }
        Err(error) => {
            // Never sent, so unusable; revoked anyway when the store answers.
            let _ = ports.sessions.revoke(session.session().id(), now).await;
            return unavailable_because("authentication_unavailable", error);
        }
    }
    record(
        ports,
        now,
        AuditActor::Principal(principal),
        Some(tenant),
        "auth.sign_in",
        AuditOutcome::Succeeded,
    )
    .await;
    let Some(expires) = timestamp(expires_at) else {
        return unavailable("clock_unavailable");
    };
    no_store(forge::web::json(
        StatusCode::OK,
        &LoginResponse {
            access_token: token.expose().to_owned(),
            token_type: "Bearer",
            expires_at: expires,
        },
    ))
}

/// `POST /auth/logout`: revokes the presented token. A well-formed token
/// that is unknown or already revoked still answers `204`, so the endpoint
/// tells nothing about tokens.
async fn sign_out(ports: &ApiAuthenticationPorts, request: &Request) -> Response {
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let session = match resolve_bearer(ports.sessions.as_ref(), authorization(request), now).await {
        Ok(session) => Some(session),
        Err(BearerDenied::InvalidCredentials)
            if forge::auth::bearer_credential(authorization(request)).is_ok() =>
        {
            None
        }
        Err(denied) => return forge::web::bearer_refusal(denied),
    };
    if let Some(session) = session {
        if ports
            .sessions
            .revoke(session.session().id(), now)
            .await
            .is_err()
        {
            return unavailable("session_store_unavailable");
        }
        record(
            ports,
            now,
            AuditActor::Principal(session.session().principal_id()),
            Some(session.tenant_id()),
            "auth.sign_out",
            AuditOutcome::Succeeded,
        )
        .await;
    }
    no_store(Response::empty(StatusCode::NO_CONTENT))
}

/// `GET /v1/auth/session`: who the token signs in, in which tenant, and
/// the membership's current roles.
async fn current_session(ports: &ApiAuthenticationPorts, request: &Request) -> Response {
    let Some(now) = now() else {
        return unavailable("clock_unavailable");
    };
    let session = match resolve_bearer(ports.sessions.as_ref(), authorization(request), now).await {
        Ok(session) => session,
        Err(denied) => return forge::web::bearer_refusal(denied),
    };
    let principal = session.session().principal_id();
    let membership = match ports.memberships.find(session.tenant_id(), principal).await {
        Ok(Some(membership)) if membership.state() == MembershipState::Active => membership,
        Ok(_) => return forge::web::bearer_refusal(BearerDenied::Forbidden),
        Err(_) => return forge::web::bearer_refusal(BearerDenied::Unavailable),
    };
    no_store(forge::web::json(
        StatusCode::OK,
        &SessionResponse {
            subject_id: principal.to_string(),
            tenant_id: session.tenant_id().to_string(),
            roles: membership
                .roles()
                .iter()
                .map(|role| role.as_str().to_owned())
                .collect(),
        },
    ))
}

/// The request's `Authorization` header values, the only credential these
/// routes read.
fn authorization(request: &Request) -> impl Iterator<Item = &[u8]> {
    request
        .headers()
        .get_all(header::AUTHORIZATION)
        .iter()
        .map(HeaderValue::as_bytes)
}

/// The tenant named `tenant` when `principal` is an active member of it.
/// The lookups run for a malformed slug and an unknown principal too, so
/// every failure costs the same.
async fn active_tenant(
    ports: &ApiAuthenticationPorts,
    tenant: &str,
    principal: Option<PrincipalId>,
) -> Result<Option<TenantId>, ForgeError> {
    let failed = |code: &'static str| {
        ForgeError::new(
            ErrorCategory::Infrastructure,
            code,
            "service temporarily unavailable",
        )
    };
    let slug = TenantSlug::parse_input(tenant);
    let lookup = match &slug {
        Ok(slug) => slug.clone(),
        Err(_) => TenantSlug::new(format!("z{}", TenantId::new().into_uuid().simple()))
            .map_err(|error| failed("tenant_slug_invalid").with_source(error))?,
    };
    let found = ports
        .tenants
        .find_by_slug(&lookup)
        .await
        .map_err(|error| failed("tenant_directory_unavailable").with_source(error))?
        .filter(|_| slug.is_ok());
    // `default()` ids are new random UUIDv7 values that match nothing.
    let active = ports
        .memberships
        .find(found.unwrap_or_default(), principal.unwrap_or_default())
        .await
        .map_err(|error| failed("membership_store_unavailable").with_source(error))?
        .is_some_and(|membership| membership.state() == MembershipState::Active);
    Ok(found.filter(|_| active && principal.is_some()))
}

async fn password_is_current(
    credentials: &dyn PasswordCredentialStore,
    principal: PrincipalId,
    verified_version: PasswordCredentialVersion,
) -> Result<bool, PasswordCredentialStoreError> {
    let credential = credentials.find_by_principal(principal).await?;
    Ok(credential.is_some_and(|credential| {
        !credential.disabled() && credential.version() == verified_version
    }))
}

/// The identity the throttle counts attempts against, as the pages count
/// it: the canonical login, whatever tenant was named.
fn account_key(login: Option<&CanonicalLogin>, typed: &str) -> String {
    match login {
        Some(login) => login.as_str().to_owned(),
        None => format!("invalid\0{}", typed.trim()),
    }
}

/// Appends an audit event. A failed write is logged and does not change
/// the response.
async fn record(
    ports: &ApiAuthenticationPorts,
    now: UnixTimestamp,
    actor: AuditActor,
    tenant: Option<TenantId>,
    action: &'static str,
    outcome: AuditOutcome,
) {
    let failure = |code: &'static str| {
        ForgeError::new(
            ErrorCategory::Infrastructure,
            code,
            "audit event not recorded",
        )
    };
    let action = match AuditAction::new(action) {
        Ok(action) => action,
        Err(error) => {
            return forge::web::report(&failure("audit_action_invalid").with_source(error));
        }
    };
    let event = AuditEvent::new(now, actor, tenant, action, outcome);
    if let Err(error) = ports.audit.append(&event).await {
        forge::web::report(&failure("audit_unavailable").with_source(error));
    }
}

fn now() -> Option<UnixTimestamp> {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .ok()
        .map(|elapsed| UnixTimestamp::from_secs(elapsed.as_secs()))
}

fn timestamp(at: UnixTimestamp) -> Option<Timestamp> {
    let micros = i64::try_from(at.as_secs()).ok()?.checked_mul(1_000_000)?;
    Timestamp::from_unix_micros(micros).ok()
}

fn invalid_credentials() -> Response {
    no_store(forge::web::bearer_refusal(BearerDenied::InvalidCredentials))
}

/// `429 login_throttled` with `Retry-After` in whole seconds.
fn throttled(retry_after: Duration) -> Response {
    let mut response = forge::web::error(
        &ForgeError::new(
            ErrorCategory::RateLimited,
            "login_throttled",
            "too many login attempts",
        )
        .with_retryable(true),
    );
    let seconds = retry_after.as_secs().max(1);
    if let Ok(value) = HeaderValue::from_str(&seconds.to_string()) {
        response.headers_mut().insert(header::RETRY_AFTER, value);
    }
    no_store(response)
}

/// `503` with a generic body.
fn unavailable(code: &'static str) -> Response {
    let failure = ForgeError::new(
        ErrorCategory::Infrastructure,
        code,
        "service temporarily unavailable",
    );
    forge::web::report(&failure);
    no_store(forge::web::json(
        StatusCode::SERVICE_UNAVAILABLE,
        &failure.report(),
    ))
}

/// `503` with a generic body; `source` is logged, never shown.
fn unavailable_because(
    code: &'static str,
    source: impl std::error::Error + Send + Sync + 'static,
) -> Response {
    let failure = ForgeError::new(
        ErrorCategory::Infrastructure,
        code,
        "service temporarily unavailable",
    )
    .with_source(source);
    forge::web::report(&failure);
    no_store(forge::web::json(
        StatusCode::SERVICE_UNAVAILABLE,
        &failure.report(),
    ))
}

/// Responses of these routes carry or refuse credentials: never cached.
fn no_store(mut response: Response) -> Response {
    response
        .headers_mut()
        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
    response
        .headers_mut()
        .insert(header::PRAGMA, HeaderValue::from_static("no-cache"));
    response
}
