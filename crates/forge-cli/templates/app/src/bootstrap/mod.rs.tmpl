//! Composition root: selects concrete implementations and owns the process
//! lifecycle. Forge provides the runtime, configuration, structured logging,
//! health routes and graceful shutdown.
%%if database%%
//!
//! The database backend is declared once below. Forge owns the connection pool,
//! runs the embedded migrations (`migrate`, `rollback`) and reports database
//! readiness. SQLx is confined to this outer composition/infrastructure boundary.
//! The `seed` command (and `setup`, with the sign-in pages) runs with the
//! migration credential, `FORGE_MIGRATION_DATABASE_URL`.
%%end%%
%%if postgresql%%
//!
//! The persistent job queue (`forge::jobs`, ADR 0025) is part of the process
//! lifecycle: `serve` runs its workers next to the HTTP server, `jobs work`
//! runs them alone, and both stop claiming, drain and release their jobs on
//! shutdown. Register jobs in `jobs_configure`.
%%end%%

%%if database%%
pub mod seeds;
%%end%%
%%if authentication%%
pub mod setup;
%%end%%
%%if database%%

%%end%%
use std::process::ExitCode;

/// Runs the command selected on the command line (serve by default).
pub fn run() -> ExitCode {
    forge::App::new(env!("CARGO_PKG_NAME"))
        .version(env!("CARGO_PKG_VERSION"))
%%if postgresql%%
        .postgres(sqlx::migrate!())
        // `serve` runs the job workers; `WorkerMode::Dedicated` leaves them
        // to `jobs work` so web and worker processes scale separately.
        .jobs(forge::WorkerMode::InServe)
%%end%%
%%if mysql_family%%
        .mysql(sqlx::migrate!())
%%end%%
%%if sqlite%%
        .sqlite(sqlx::migrate!())
%%end%%
%%if views%%
        .compose(compose)
%%end%%
%%if !views%%
        .routes(crate::adapters::http::routes)
%%end%%
%%if postgresql%%
        .compose(jobs_configure)
%%end%%
%%if authentication%%
        .command("setup", setup::SUMMARY, setup::run)
%%end%%
%%if database%%
        .command("seed", seeds::SUMMARY, seeds::run)
%%end%%
        .run()
}
%%if views%%

/// Wires the HTTP adapter: the translations of `config/locales`, the site
/// (digested assets and the HTML request layers) and the routes. `forge
/// generate scaffold` prints the lines that wire each generated resource at
/// the end of this function.
fn compose(composition: &mut forge::Composition<'_>) -> Result<(), forge::ComposeError> {
    let translator = crate::adapters::http::views::locales::translator(composition.config())
        .map_err(forge::ComposeError::other)?;
    let site = crate::adapters::http::site(composition.router(), translator)?;
    crate::adapters::http::routes(composition.router(), &site)?;
%%if authentication%%
    // Sign-in, sign-out, password-reset and two-factor pages (ADR 0026,
    // ADR 0040), with the PostgreSQL identity stores, Argon2id and attempt
    // throttles kept in PostgreSQL (forge_login_throttle), so every replica
    // shares one budget and a restart resets nothing.
    // Reset links are emailed (ADR 0035) once FORGE_MAIL_URL, FORGE_MAIL_FROM
    // and FORGE_AUTH_PASSWORD_RESET_URL are set; without FORGE_MAIL_URL the
    // notifier fails closed and delivers nothing, and FORGE_MAIL_URL without
    // the reset URL stops start-up. Signed-out browsers asking for a
    // protected page are sent to sign in.
    let notifier = forge::mail::password_reset_notifier(
        composition.config(),
        env!("CARGO_PKG_NAME"),
        composition.telemetry(),
    )
    .map_err(forge::ComposeError::other)?;
    // FORGE_MAIL_PREVIEW=true (development and test only) shows the reset
    // email at /_mail without sending it.
    if composition.config().mail.preview {
        let preview = forge::mail::PasswordResetEmails::for_preview(
            composition.config(),
            env!("CARGO_PKG_NAME"),
        )
        .map_err(forge::ComposeError::other)?
        .preview();
        let previews =
            forge::mail::PreviewHandler::new(composition.config(), "/_mail", vec![preview])
                .map_err(forge::ComposeError::other)?;
        composition.router().layer(previews);
    }
    let pool = composition.postgres()?.pool().clone();
    let throttle = |config| {
        forge::auth::PgLoginThrottle::new(pool.clone(), config)
            .map(std::sync::Arc::new)
            .map_err(forge::ComposeError::other)
    };
    // TOTP two-factor authentication (ADR 0040): seeds are encrypted with
    // FORGE_AUTH_MFA_KEY (canonical unpadded base64url of 32 bytes; an
    // invalid key stops start-up). Without it, enrolling is refused and an
    // account with a factor cannot sign in.
    let mfa_cipher = composition
        .config()
        .auth
        .mfa_key_bytes()
        .map_err(forge::ComposeError::other)?
        .map(|key| forge::auth::Aes256GcmSecretCipher::new(&key))
        .transpose()
        .map_err(forge::ComposeError::other)?
        .map(|cipher| std::sync::Arc::new(cipher) as std::sync::Arc<dyn forge::auth::SecretCipher>);
    let mfa = forge::tenancy::MfaService::new(
        std::sync::Arc::new(crate::infrastructure::accounts::PgMfaStore::new(
            pool.clone(),
        )),
        mfa_cipher,
        throttle(forge::tenancy::mfa_throttle_config())?,
    );
    let ports = crate::adapters::http::authentication::AuthenticationPorts {
        credentials: std::sync::Arc::new(
            crate::infrastructure::auth::PostgresPasswordCredentialStore::new(pool.clone()),
        ),
        hasher: std::sync::Arc::new(crate::infrastructure::security::Argon2idPasswordHasher),
        sessions: std::sync::Arc::new(crate::infrastructure::auth::PostgresSessionStore::new(
            pool.clone(),
        )),
        memberships: std::sync::Arc::new(crate::infrastructure::tenancy::PgMembershipStore::new(
            pool.clone(),
        )),
        tenants: std::sync::Arc::new(crate::infrastructure::accounts::PgTenantDirectory::new(
            pool.clone(),
        )),
        resets: std::sync::Arc::new(crate::infrastructure::accounts::PgPasswordResetStore::new(
            pool.clone(),
        )),
        notifier,
        audit: std::sync::Arc::new(crate::infrastructure::audit::PgAuditSink::new(pool.clone())),
        sign_in_throttle: throttle(forge::auth::ThrottleConfig::default())?,
        // Forge-Go's recovery limits: 3 per login and source, 10 per login
        // and 30 per source in an hour.
        reset_throttle: throttle(forge::auth::password_reset_throttle_config())?,
        mfa,
    };
    crate::adapters::http::authentication::routes(composition, &site, ports)?;
%%end%%
    Ok(())
}
%%end%%
%%if postgresql%%

/// Configures the persistent job queue (ADR 0025): the handlers, their
/// queues' concurrency and the cron schedules. Each queue with a handler gets
/// one bounded worker loop, owned by the process with the scheduler and the
/// pruning of finished jobs; nothing runs detached. `forge generate job NAME
/// --queue` writes a job and prints the line that registers it here.
fn jobs_configure(composition: &mut forge::Composition<'_>) -> Result<(), forge::ComposeError> {
    // At most 4 attempts of each queue run at once.
    composition
        .jobs()?
        .settings(forge::jobs::WorkerSettings::default().default_concurrency(4));
    // Register application jobs here, e.g.:
    // crate::adapters::jobs::cleanup::register(composition.jobs()?)
    //     .map_err(forge::ComposeError::other)?;
    // composition
    //     .jobs()?
    //     .schedule(
    //         forge::jobs::Schedule::new(
    //             "cleanup.daily",
    //             "0 3 * * *".parse().map_err(forge::ComposeError::other)?, // UTC
    //             &crate::adapters::jobs::cleanup::Cleanup {},
    //         )
    //         .map_err(forge::ComposeError::other)?,
    //     )
    //     .map_err(forge::ComposeError::other)?;
    Ok(())
}
%%end%%
