/* Every file under assets/ is digested and embedded in the binary by
   build.rs; the layout links this stylesheet by its digested URL. */

:root {
  color-scheme: light dark;
  font-family: system-ui, sans-serif;
  line-height: 1.5;
}

body {
  margin: 0 auto;
  max-width: 48rem;
  padding: 2rem 1rem;
}

.brand-logo {
  aspect-ratio: 1;
  display: block;
  height: auto;
  margin: 0 auto 1.5rem;
  max-width: 100%;
}

.skip-link {
  left: 1rem;
  position: absolute;
  top: -3rem;
}

.skip-link:focus {
  top: 1rem;
}

.masthead,
.eyebrow,
.muted {
  color: #6b6b6b;
  font-size: 0.875rem;
}

.lede {
  font-size: 1.125rem;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.endpoints {
  display: flex;
  gap: 1rem;
  list-style: none;
  padding: 0;
}

.flash {
  border-radius: 0.375rem;
  padding: 0.75rem 1rem;
}

.flash-notice {
  background: #e7f6ec;
  color: #14532d;
}

.flash-alert {
  background: #fdecec;
  color: #7f1d1d;
}

/* Turbo's progress bar. Turbo would inject these rules as an inline style
   element, which the strict Content-Security-Policy blocks. */
.turbo-progress-bar {
  position: fixed;
  top: 0;
  left: 0;
  height: 3px;
  background: #0076ff;
  z-index: 2147483647;
  transition: width 300ms ease-out, opacity 150ms 150ms ease-in;
  transform: translate3d(0, 0, 0);
}
