{% extends "layouts/application.html" %}

{% block title %}{{ layout.i18n.t("passwords.edit.title") }}{% endblock %}

{% block content %}
<h1>{{ layout.i18n.t("passwords.edit.title") }}</h1>
{% if let Some(error) = error %}<p class="flash flash-alert" role="alert">{{ error }}</p>{% endif %}
<form action="/passwords" method="post">
  {{ csrf_field|safe }}
  <input type="hidden" name="_method" value="patch">
  <input type="hidden" name="token" value="{{ token }}">
  <div>
    <label for="password_password">{{ layout.i18n.t("passwords.edit.password") }}</label>
    <input type="password" id="password_password" name="password" required minlength="12" maxlength="1024" autocomplete="new-password">
    {% if let Some(message) = errors.get("password") %}<p class="flash flash-alert" role="alert">{{ message }}</p>{% endif %}
  </div>
  <div>
    <label for="password_password_confirmation">{{ layout.i18n.t("passwords.edit.password_confirmation") }}</label>
    <input type="password" id="password_password_confirmation" name="password_confirmation" required minlength="12" maxlength="1024" autocomplete="new-password">
    {% if let Some(message) = errors.get("password_confirmation") %}<p class="flash flash-alert" role="alert">{{ message }}</p>{% endif %}
  </div>
  <button type="submit">{{ layout.i18n.t("passwords.edit.submit") }}</button>
</form>
{% endblock %}
