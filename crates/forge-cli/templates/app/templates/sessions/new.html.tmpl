{% extends "layouts/application.html" %}

{% block title %}{{ layout.i18n.t("sessions.new.title") }}{% endblock %}

{% block content %}
<h1>{{ layout.i18n.t("sessions.new.title") }}</h1>
{% if signed_in %}
<p>{{ layout.i18n.t("sessions.new.already_signed_in") }}</p>
{% include "sessions/_sign_out.html" %}
{% endif %}
{% if let Some(error) = error %}<p class="flash flash-alert" role="alert">{{ error }}</p>{% endif %}
<form action="/session" method="post">
  {{ csrf_field|safe }}
  {% if !return_to.is_empty() %}<input type="hidden" name="return_to" value="{{ return_to }}">{% endif %}
  <div>
    <label for="session_tenant">{{ layout.i18n.t("sessions.new.organization") }}</label>
    <input type="text" id="session_tenant" name="tenant" value="{{ tenant }}" required autocomplete="organization" autocapitalize="none" spellcheck="false" maxlength="63" aria-describedby="session_tenant_hint">
    <p class="muted" id="session_tenant_hint">{{ layout.i18n.t("sessions.new.organization_hint_html") }}</p>
  </div>
  <div>
    <label for="session_email">{{ layout.i18n.t("sessions.new.email") }}</label>
    <input type="email" id="session_email" name="email" value="{{ email }}" required autocomplete="username" maxlength="320">
  </div>
  <div>
    <label for="session_password">{{ layout.i18n.t("sessions.new.password") }}</label>
    <input type="password" id="session_password" name="password" required autocomplete="current-password" maxlength="1024">
  </div>
  <button type="submit">{{ layout.i18n.t("sessions.new.submit") }}</button>
</form>
<p><a href="/passwords/new">{{ layout.i18n.t("sessions.new.forgot_password") }}</a></p>
{% endblock %}
