# Grafana Tempo (single binary, local disk) for the local observability stack.
# Traces arrive from the OpenTelemetry Collector over OTLP/HTTP and are kept for
# seven days. Not a production deployment: no replication, no object storage.
stream_over_http_enabled: true

server:
  http_listen_port: 3200
  log_level: warn

distributor:
  receivers:
    otlp:
      protocols:
        http:
          endpoint: 0.0.0.0:4318

compactor:
  compaction:
    block_retention: 168h

storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks

usage_report:
  reporting_enabled: false
