-- Forge browser authentication (ADR 0026): tenants named by slug at sign-in
-- and one-time password reset tokens. Only SHA-256 digests of reset tokens
-- are stored. Identity tables come from migration 00000000000000000002.

CREATE TABLE forge_tenants (
    id uuid PRIMARY KEY,
    slug text NOT NULL UNIQUE CHECK (slug ~ '^[a-z][a-z0-9-]{1,62}$'),
    name text NOT NULL CHECK (char_length(name) BETWEEN 1 AND 200),
    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    updated_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    version bigint NOT NULL DEFAULT 1 CHECK (version > 0)
);

CREATE TABLE forge_password_resets (
    id uuid PRIMARY KEY,
    principal_id uuid NOT NULL REFERENCES forge_principals(id) ON DELETE CASCADE,
    tenant_id uuid NOT NULL REFERENCES forge_tenants(id) ON DELETE CASCADE,
    token_digest bytea NOT NULL UNIQUE,
    issued_at timestamptz NOT NULL,
    expires_at timestamptz NOT NULL,
    used_at timestamptz,
    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    CHECK (octet_length(token_digest) = 32),
    CHECK (expires_at > issued_at),
    CHECK (used_at IS NULL OR used_at >= issued_at)
);

CREATE INDEX forge_password_resets_unused
ON forge_password_resets (principal_id)
WHERE used_at IS NULL;

CREATE FUNCTION forge_guard_password_reset_update()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    IF NEW.id IS DISTINCT FROM OLD.id
        OR NEW.principal_id IS DISTINCT FROM OLD.principal_id
        OR NEW.tenant_id IS DISTINCT FROM OLD.tenant_id
        OR NEW.token_digest IS DISTINCT FROM OLD.token_digest
        OR NEW.issued_at IS DISTINCT FROM OLD.issued_at
        OR NEW.expires_at IS DISTINCT FROM OLD.expires_at
        OR NEW.created_at IS DISTINCT FROM OLD.created_at
    THEN
        RAISE EXCEPTION 'forge password reset identity, digest and lifetime are immutable';
    END IF;

    IF OLD.used_at IS NOT NULL
        AND NEW.used_at IS DISTINCT FROM OLD.used_at
    THEN
        RAISE EXCEPTION 'forge password reset use is final';
    END IF;

    RETURN NEW;
END;
$$;

CREATE TRIGGER forge_password_resets_guard_update
BEFORE UPDATE ON forge_password_resets
FOR EACH ROW
EXECUTE FUNCTION forge_guard_password_reset_update();

REVOKE ALL ON TABLE forge_tenants FROM PUBLIC;
REVOKE ALL ON TABLE forge_password_resets FROM PUBLIC;

-- The runtime role resolves tenants and issues and redeems reset tokens. It
-- cannot create tenants or principals: `setup` runs with the migration role.
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_runtime') THEN
        REVOKE ALL ON TABLE forge_tenants FROM app_runtime;
        REVOKE ALL ON TABLE forge_password_resets FROM app_runtime;

        GRANT SELECT ON TABLE forge_tenants TO app_runtime;
        GRANT SELECT, INSERT ON TABLE forge_password_resets TO app_runtime;
        GRANT UPDATE (used_at) ON TABLE forge_password_resets TO app_runtime;
    END IF;
END
$$;
