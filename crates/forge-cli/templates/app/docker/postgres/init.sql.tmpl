-- Development-only PostgreSQL role bootstrap.
-- Runtime is intentionally unable to own schema objects, create databases or
-- bypass RLS. The migration role may create databases so that `forge db
-- reset` (drop, then create) works against this container; give a production
-- migration role CREATEDB only if your deployment runs `db create` at all.

CREATE ROLE app_migrator
    LOGIN PASSWORD 'app_migrator'
    NOSUPERUSER CREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;

CREATE ROLE app_runtime
    LOGIN PASSWORD 'app_runtime'
    NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;

CREATE DATABASE %%DATABASE_NAME%% OWNER app_migrator;

\connect %%DATABASE_NAME%%

REVOKE CONNECT, TEMPORARY ON DATABASE %%DATABASE_NAME%% FROM PUBLIC;
GRANT CONNECT ON DATABASE %%DATABASE_NAME%% TO app_migrator, app_runtime;

REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT ALL ON SCHEMA public TO app_migrator;
GRANT USAGE ON SCHEMA public TO app_runtime;

ALTER DEFAULT PRIVILEGES FOR ROLE app_migrator IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_runtime;

ALTER DEFAULT PRIVILEGES FOR ROLE app_migrator IN SCHEMA public
    GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO app_runtime;
