# syntax=docker/dockerfile:1

# Production image for %%APP_NAME%%.
#
#   docker build -t %%APP_NAME%% .
#   docker run --rm -p 3000:3000 %%APP_NAME%%
#
# The runtime stage is distroless: no shell, no package manager and a numeric
# non-root user. Pin both base images by digest (image@sha256:...) for release
# builds. RUST_VERSION must match rust-toolchain.toml (see tests/container.rs).

ARG RUST_VERSION=%%RUST_VERSION%%

FROM rust:${RUST_VERSION}-slim-trixie AS build
WORKDIR /app
COPY . .
# Cargo.lock is required: the image is built from the reviewed dependency graph.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --release --locked --bin %%APP_NAME%% \
    && install -D -m 0755 target/release/%%APP_NAME%% /out/%%APP_NAME%%
%%if sqlite%%
# SQLite data directory. The runtime stage has no shell, so it is created here
# and copied with the runtime uid as owner; a named volume mounted at /data
# inherits that ownership on first use.
RUN mkdir -p /out/data
%%end%%
FROM gcr.io/distroless/cc-debian13:nonroot AS runtime
COPY --from=build /out/%%APP_NAME%% /usr/local/bin/%%APP_NAME%%
ENV FORGE_ENV=production \
    FORGE_BIND=0.0.0.0:3000
%%if sqlite%%
COPY --from=build --chown=65532:65532 /out/data /data
%%end%%
USER 65532:65532
EXPOSE 3000
# The binary probes its own /health/live endpoint; no curl or shell is needed.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --start-interval=1s --retries=3 \
    CMD ["/usr/local/bin/%%APP_NAME%%", "healthcheck"]
# Exec form: the application is PID 1 and receives SIGTERM for graceful shutdown.
ENTRYPOINT ["/usr/local/bin/%%APP_NAME%%"]
CMD ["serve"]
