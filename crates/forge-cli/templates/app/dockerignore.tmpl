# Keep the image build context small and free of secrets.
/.git
/.github
**/target
**/.env
**/.env.*
**/*.pem
**/*.key
/Dockerfile
/.dockerignore
/compose.yaml
# Local observability stack configuration; not part of the application image.
/compose.observability.yaml
/observability
/README.md
# The builder image pins the same toolchain through RUST_VERSION;
# tests/container.rs fails when the two versions drift apart.
/rust-toolchain.toml
%%if sqlite%%
# Local SQLite databases must never enter the image.
/storage
%%end%%
