# Development settings for hello-forge, read by `forge dev`, `forge test`,
# `forge doctor`, `forge migrate`, `forge rollback`, `forge seed`, `forge setup`
# and `forge db`. Variables already set in the environment win. Put personal
# overrides in .env.local (git-ignored). The application binary never reads
# this file; it is excluded from Docker images and must never hold real secrets.
FORGE_ENV=development
